---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Portgas D. Ace OP16 Deck Guide";
const description = "Portgas D. Ace OP16 deck guide for the OP17 format with decklist, curve guide, deck overview, tactics and matchups.";
const icon = "/assets/guides/Ace-op16.png";

const card = (code, name, img, count = 4, role = "Character") => ({ code, name, img, count, role });
const leader = card("OP16-001", "Portgas D. Ace", "/Cards/OP16/OP16-001.jpg", 1, "Leader");
const garp = card("OP13-016", "Monkey D. Garp", "/Cards/OP13/OP13-016.jpg");
const namule = card("OP16-010", "Namule", "/Cards/OP16/OP16-010.jpg", 2);
const sanji = card("OP10-005", "Sanji", "/Cards/OP10/OP10-005.jpg", 2);
const luffy = card("OP16-015", "Monkey D. Luffy", "/Cards/OP16/OP16-015.jpg");
const oars = card("OP16-017", "LittleOars Jr.", "/Cards/OP16/OP16-017.jpg");
const ace = card("OP16-118", "Portgas D. Ace", "/Cards/OP16/OP16-118.jpg", 2);
const vista = card("OP16-011", "Vista", "/Cards/OP16/OP16-011.jpg", 3);
const marco = card("OP16-014", "Marco", "/Cards/OP16/OP16-014.jpg", 3);
const uta = card("ST23-001", "Uta", "/Cards/ST23/ST23-001.jpg", 2);
const curiel = card("OP16-004", "Curiel", "/Cards/OP16/OP16-004.jpg");
const kingdew = card("OP17-006", "Kingdew", "/Cards/OP17/New OP17/OP17-006.jpg");
const newgate = card("OP16-003", "Edward Newgate", "/Cards/OP16/OP16-003.jpg", 3);
const thatch = card("OP16-005", "Thatch", "/Cards/OP16/OP16-005.jpg", 2);
const newgateOp17 = card("OP17-005", "Edward Newgate", "/Cards/OP17/New OP17/OP17-005.jpg");
const event = card("OP16-020", "If You're Gonna Protect Something, Do It All the Way!!!", "/Cards/OP16/OP16-020.jpg", 3, "Event");
const mobyDick = card("OP16-021", "Moby Dick", "/Cards/OP16/OP16-021.jpg", 4, "Stage");
const saboOp13 = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg", null, "Leader");
const rocksOp17 = card("OP17-039", "Rocks D. Xebec OP17", "/Cards/OP17/New OP17/OP17-039.jpg", null, "Leader");
const mihawkOp14 = card("OP14-020", "Dracule Mihawk OP14", "/Cards/OP14/OP14-020.jpg", null, "Leader");
const kaidoOp17 = card("OP17-058", "Kaido OP17", "/Cards/OP17/New OP17/OP17-058.jpg", null, "Leader");
const aceLeaderOp16 = card("OP16-001", "Portgas D. Ace OP16", "/Cards/OP16/OP16-001.jpg", null, "Leader");
const linlinOp17 = card("OP17-099", "Charlotte Linlin OP17", "/Cards/OP17/New OP17/OP17-099.jpg", null, "Leader");
const luffyOp17 = card("OP17-079", "Monkey D. Luffy OP17", "/Cards/OP17/New OP17/OP17-079.jpg", null, "Leader");
const shanksOp17 = card("OP17-020", "Shanks OP17", "/Cards/OP17/New OP17/OP17-020.jpg", null, "Leader");
const enelOp15 = card("OP15-058", "Enel OP15", "/Cards/OP15/OP15-058.jpg", null, "Leader");
const boaOp14 = card("OP14-041", "Boa Hancock OP14", "/Cards/OP14/OP14-041.jpg", null, "Leader");
const nicoRobinOp09 = card("OP09-062", "Nico Robin OP09", "/Cards/OP09/OP09-062.jpg", null, "Leader");
const luffyAceSt30 = card("ST30-001", "Luffy & Ace ST30", "/Cards/ST30/ST30-001.jpg", null, "Leader");

const matchupIcons = {
	"OP13-004": "/assets/guides/Sabo OP13-004.png",
	"OP17-039": "/assets/guides/Rocks.DXebec op17.png",
	"OP14-020": "/assets/guides/dracule-mihawk-op14.png",
	"OP17-058": "/assets/guides/Kaido op17.png",
	"OP16-001": "/assets/guides/Ace-op16.png",
	"OP17-099": "/assets/guides/Charlotte Linlin op17.png",
	"OP17-079": "/assets/guides/Monkey.D.Luffy op17.png",
	"OP17-020": "/assets/guides/Shanks op17.png",
	"OP15-058": "/assets/guides/enel-op15.png",
	"OP14-041": "/assets/guides/boa-hancock-op14.png",
	"OP09-062": "/assets/guides/Nico-Robin-op09.png",
	"ST30-001": "/assets/guides/Luffy-st30.png",
};

const decklist = [leader, garp, namule, sanji, luffy, oars, ace, vista, marco, uta, curiel, kingdew, newgate, thatch, newgateOp17, event, mobyDick];
const simDeckCode = decklist.map((entry) => `${entry.count}x${entry.code}`).join("\n");

const matchupGroups = [
	{ label: "Favorable", icon: "&uarr;", tone: "up", cards: [mihawkOp14, saboOp13, shanksOp17] },
	{ label: "Slightly Favorable", icon: "&uarr;", tone: "slightly-up", cards: [luffyOp17] },
	{ label: "Slightly Unfavorable", icon: "&darr;", tone: "slightly-down", cards: [kaidoOp17] },
	{ label: "Unfavorable", icon: "&darr;", tone: "down", cards: [nicoRobinOp09, rocksOp17, linlinOp17, luffyAceSt30, enelOp15, boaOp14] },
];

const goSecond = [
	{ label: "2 DON!!", cards: [garp, mobyDick], text: "Your priority is consistency, not damage. Garp and Moby Dick find the Whitebeard Pirates package and, most importantly, 4c Luffy. Use Garp when you need a body now; use Moby Dick when you want repeatable searches on the following turns. If your hand already has Luffy, search for an 8000 Power body or the counters that let you protect your Life." },
	{ label: "4 DON!!", cards: [luffy], text: "4c Luffy is the key defensive setup. By trashing an 8000 Power card, he raises Ace to 7000 Power for the turn, which changes the opponent's attack math immediately. Develop him before committing your large bodies whenever possible: the following turns are safer, and the 8000 Power cards you kept can now become Rush attackers instead of dead cards in hand." },
	{ label: "6 DON!!", cards: [marco], text: "Marco is the stable tempo play. He is an 8000 Power Whitebeard Pirates body, so Ace gives him Rush the moment he enters play. Attack a small Character to keep the opponent off-board, or pressure Life when their hand is already stretched. His protection effect also makes this line much better into removal-heavy decks, because an 8000 Power card in hand can keep your investment alive." },
	{ label: "8 DON!!", cards: [newgate], text: "Edward Newgate OP16 is the aggressive 8-DON!! payoff. During your turn, your Leader gains Double Attack and +2000 Power. On Play, reveal two 8000 Power Character cards from your hand to give up to one opposing Character -6000 Power for the turn. This clears a key blocker or makes a large body easy to attack through while Ace swings twice at 7000 Power. Only commit Newgate when you can reveal the two 8000 Power cards: otherwise you lose the removal half of the play. Use the turn to convert a developed board into lethal pressure, while keeping enough counters for the next turn." },
];

const goFirst = [
	{ label: "1 DON!!", cards: [garp], text: "Going first starts more slowly, so Garp is the cleanest opener. He finds the cards that turn the awkward odd curve into real pressure. Prioritize 4c Luffy if you do not have him; otherwise take the 8000 Power body or the matchup-specific answer you will need next." },
	{ label: "3 DON!!", cards: [sanji], text: "Sanji is your early development play when you need a board before the big turns. He adds an attacker without consuming the 8000 Power cards that fuel Luffy and Marco. Into decks that establish Blockers, keep Sanji available for the turns where Unblockable can convert an otherwise stalled attack into lethal pressure." },
	{ label: "5 DON!!", cards: [luffy], text: "On the odd curve, Luffy is still the most important investment. Play him as early as you can, then discard the least useful 8000 Power card only when the 7000 Power Leader will actually protect Life or force inefficient attacks. If the opponent cannot threaten your Life yet, preserve the card instead for a future Rush turn." },
	{ label: "7 DON!!", cards: [vista], text: "Vista turns 7 DON!! into immediate board control. He enters as an 8000 Power Rush attacker, draws a card, and can remove a small opposing Character before it creates value. Choose Vista over a passive development turn when the opponent is trying to go wide; against a tall board, consider holding him and setting up Newgate or Marco for the stronger next turn." },
];

const strengths = ["Leader can gain Double Attack and hit for massive numbers.", "10c Newgate makes Ace an 8000 base power Leader during the opponent's turn.", "Excellent board clear against small units using Vista and Rakuyo."];

const weaknesses = ["Runs around 28 “bricks” (characters with 0 Counter).", "Highly reliant on Moby Dick and Garp to fix your unplayable opening hands.", "Struggles if you don't find 4c Luffy early to defend your life."];

const coreEngine = ["Leader: Gives Rush to your giant Boss characters.", "4c Luffy: Trashes 8K bricks from your hand to make your Leader 7000 Power defensively for the entire turn.", "OP17 10c Edward Newgate: A 12000 Power body that sets your Leader to 8000 base power until the opponent's next turn."];

---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags"><span class="hero-chip">Deck Guide</span><span class="hero-chip hero-chip-accent">OP17 Format</span></div>
				<h1>Portgas D. Ace OP16 Deck Guide</h1>
				<p class="hero-intro">The 8K Base Leader. Red Ace just got the biggest OP17 upgrade thanks to his dad. Turn your Leader into an 8000 Power defensive wall while swinging with massive 12000 Power Rush attackers.</p>
				<div class="hero-actions"><a class="btn btn-primary" href="#curve">Curve Guide</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div>
			</div>
			<div class="guide-icon"><img src={icon} alt="Portgas D. Ace OP16 deck guide" loading="eager" /></div>
		</div>
	</section>

	<section id="decklist" class="list-section">
		<div class="container article-stack">
			<div class="glow-block">
				<div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>Copy for Sim</button></div></div>
				<div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><span class="deck-count">{entry.count}x</span><div><div class="deck-name">{entry.name}</div><div class="deck-code">{entry.code}</div></div></div><span class="deck-role">{entry.role}</span></button>)}</div>
			</div>

			<div id="curve" class="glow-block feature-block">
				<div class="section-header feature-header"><div><h2>Curve Guide</h2></div></div>
				<div class="curve-guide-block">
					<h3>Go Second</h3>
					<p>Going second is mathematically your best option. It lets you curve perfectly into your massive Whitebeard drops without floating DON!!</p>
					<div class="curve-rows">
						{goSecond.map((slot) => (
							<div class="curve-row">
								<div class="curve-label">{slot.label}</div>
								<div class="curve-cards">
									{slot.cards.map((entry, index) => (
										<>
											{index > 0 && <span class="curve-join">+</span>}
											<button class="mini-card curve-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}>
												<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
											</button>
										</>
									))}
								</div>
							</div>
						))}
					</div>
				</div>

				<div class="curve-guide-block">
					<h3>Go First</h3>
					<p>Going first is awkward, but it allows you to dominate decks that swarm the board with cheap units.</p>
					<div class="curve-rows">
						{goFirst.map((slot) => (
							<div class="curve-row">
								<div class="curve-label">{slot.label}</div>
								<div class="curve-cards">
									{slot.cards.map((entry, index) => (
										<>
											{index > 0 && <span class={`curve-join ${slot.mode === "or" ? "curve-join-or" : ""}`}>{slot.mode === "or" ? "or" : "+"}</span>}
											<button class="mini-card curve-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}>
												<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
											</button>
										</>
									))}
								</div>
							</div>
						))}
					</div>
				</div>
			</div>

			<div class="glow-block feature-block"><div class="section-header feature-header"><div><h2>Deck Overview</h2><h3>The Mechanic</h3><p>A super aggressive deck that completely breaks the rules of Ace's Leader ability, giving any 8000 Power Whitebeard Pirate or Luffy character Rush. In OP17, you can use the new Edward Newgate cards to buff your Leader's base power to 8000, making you almost impossible to kill while you swing for lethal.</p></div></div><div class="nutshell-grid"><div class="info-panel"><div class="section-tag section-tag-light">Strength</div><ul class="summary-list">{strengths.map((item) => <li>{item}</li>)}</ul></div><div class="info-panel"><div class="section-tag section-tag-light">Weakness</div><ul class="summary-list">{weaknesses.map((item) => <li>{item}</li>)}</ul></div></div><div class="core-panel"><div class="section-tag section-tag-light">The Core Engine</div><ul class="summary-list">{coreEngine.map((item) => <li>{item}</li>)}</ul></div></div>

			<div class="glow-block feature-block"><div class="section-header feature-header"><div><h2>OP17 Pro Tactics &amp; Combos</h2></div></div><div class="combo-grid"><div class="combo-card"><button class="detail-card" type="button" data-card-preview data-full={newgateOp17.img} data-name={`${newgateOp17.code} ${newgateOp17.name}`} data-code={newgateOp17.code}><img src={newgateOp17.img} alt={`${newgateOp17.code} ${newgateOp17.name}`} loading="lazy" /></button><div><h3>The OP17 Newgate Cheat</h3><p>The new 10c Newgate reduces its own cost by 4 if the opponent has a 10000+ power character on the board. Against Elbaph decks, you can play your 12000 Power Boss for only 6 DON!!, leaving you 4 DON!! to defend with events or play a Blocker like Little Oars Jr.</p></div></div><div class="combo-card"><button class="detail-card" type="button" data-card-preview data-full={marco.img} data-name={`${marco.code} ${marco.name}`} data-code={marco.code}><img src={marco.img} alt={`${marco.code} ${marco.name}`} loading="lazy" /></button><div><h3>The Marco Wall</h3><p>Marco is essential against decks with heavy effect removal. If an effect would KO or bottom deck Marco, you simply trash an 8000 power card from your hand to keep him alive. They can never get rid of him.</p></div></div></div></div>

			<div id="matchups" class="glow-block feature-block">
				<div class="section-header feature-header"><div><h2>Matchups</h2><p>OP17 matchup spread for Portgas D. Ace OP16.</p></div></div>
				<div class="matchup-grid">
					{matchupGroups.map((group) => (
						<div class="matchup-card">
							<div class={`matchup-badge badge-${group.tone}`}><span class="badge-icon" set:html={group.icon}></span><span>{group.label}</span></div>
							<div class="matchup-list">
								{group.cards.map((entry) => (
									<button class="matchup-entry" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}>
										<img class="matchup-leader-icon" src={matchupIcons[entry.code] ?? entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
										<span>{entry.name}</span>
									</button>
								))}
							</div>
						</div>
					))}
				</div>
			</div>

			<div class="glow-block conclusions-card"><div class="section-tag section-tag-light">Conclusion</div><p class="ability-copy">Find 4c Luffy early, build with 8000 Power Whitebeard Pirates, and use OP17 Edward Newgate to make Ace an 8000 base Power Leader. This deck turns every giant body into immediate Rush pressure.</p></div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true"><div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview"><button class="modal-close" type="button" data-close>Close</button><img src="" alt="" data-modal-image /></div></div>
</MainLayout>

<script>
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const closeModal = () => { modal?.classList.remove("is-open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; };
	document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !modalImage) return; modalImage.src = button.dataset.full || ""; modalImage.alt = button.dataset.name || "Card preview"; modal.classList.add("is-open"); modal.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; }));
	document.querySelector("[data-close]")?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
	document.querySelectorAll("[data-copy-sim]").forEach((button) => button.addEventListener("click", async () => {
		const simDeck = button.dataset.simDeck;
		if (!simDeck) return;
		const previous = button.textContent?.trim() || "Copy for Sim";
		try {
			if (navigator.clipboard?.writeText) {
				await navigator.clipboard.writeText(simDeck);
			} else {
				const textarea = document.createElement("textarea");
				textarea.value = simDeck;
				textarea.setAttribute("readonly", "");
				textarea.style.position = "fixed";
				textarea.style.opacity = "0";
				document.body.appendChild(textarea);
				textarea.select();
				document.execCommand("copy");
				textarea.remove();
			}
			button.textContent = "Copied";
		} catch {
			button.textContent = "Copy failed";
		}
		window.setTimeout(() => { button.textContent = previous; }, 1800);
	}));
</script>

<style>
	:root { --first-look-accent: #ff6b3d; --first-look-accent-soft: rgba(255, 107, 61, 0.18); --first-look-border: rgba(255, 107, 61, 0.28); }
	.guide-hero { padding-top: 3.2rem; }
	.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 415px); gap: 2rem; align-items: center; }
	.hero-tags { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1rem; }
	.hero-chip, .publish-banner { display: inline-flex; align-items: center; padding: 0.7rem 1.1rem; border-radius: 999px; border: 1px solid var(--first-look-border); background: rgba(12, 17, 30, 0.85); color: #f3f7ff; }
	.hero-chip { font-size: 0.95rem; font-weight: 600; }
	.hero-chip-accent { color: var(--accent); }
	.hero-intro { max-width: 60ch; }
	.guide-icon { display: flex; justify-content: center; }
	.guide-icon img { width: min(415px, 100%); border-radius: 18px; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 30px 60px rgba(0,0,0,0.35); }
	.article-stack, .feature-block, .curve-guide-block, .curve-rows, .nutshell-grid, .info-panel, .core-panel { display: grid; gap: 1rem; }
	.matchup-grid { display: grid; grid-template-columns: 1fr; gap: 1.4rem; }
	.glow-block { background: rgba(12, 17, 30, 0.9); border: 1px solid var(--first-look-border); border-radius: 26px; padding: 1.25rem; box-shadow: 0 0 0 1px rgba(255,107,61,0.16), 0 0 22px rgba(255,107,61,0.08), 0 0 52px rgba(255,107,61,0.05); }
	.hero-actions, .decklist-title-row { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
	.decklist-title-row { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto; justify-content: initial; }
	.decklist-title-row h2 { margin: 0; min-width: 0; }
	.decklist-title-row .copy-sim-button { justify-self: end; width: auto; flex: 0 0 auto; }
	.deck-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.9rem; margin-top: 1rem; }
	.deck-card { background: rgba(12,17,30,0.9); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.75rem; display: grid; gap: 0.65rem; text-align: left; cursor: pointer; }
	.deck-card img { width: 100%; max-width: 110px; margin: 0 auto; border-radius: 12px; }
	.deck-info { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; align-items: center; }
	.deck-count { color: var(--accent); font-weight: 700; }
	.deck-name { font-size: 0.92rem; font-weight: 600; line-height: 1.25; }
	.deck-code, .deck-role { color: var(--text-300); font-size: 0.78rem; }
	.deck-role { text-transform: uppercase; letter-spacing: 1px; }
	.curve-guide-block + .curve-guide-block { margin-top: 1rem; }
	.curve-row { display: grid; grid-template-columns: 1fr; gap: 0.75rem; align-items: start; padding: 1rem; border-radius: 22px; border: 1px solid var(--first-look-border); background: rgba(8,12,22,0.72); }
	.curve-label { color: var(--accent); font-weight: 700; }
	.curve-cards { display: flex; align-items: center; flex-wrap: nowrap; gap: 0.9rem; justify-content: flex-start; width: 100%; overflow-x: auto; }
	.curve-card { flex: 0 0 auto; background: transparent; border: 0; padding: 0; }
	.curve-card img { display: block; width: 100%; max-width: 120px; border-radius: 14px; box-shadow: 0 16px 32px rgba(0,0,0,0.28); }
	.curve-join { color: var(--accent); font-size: 1.8rem; font-weight: 700; }
	.curve-join-or { font-size: 1rem; }
	.curve-note { margin: 0; line-height: 1.6; }
	.nutshell-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.info-panel, .core-panel { padding: 1rem; border-radius: 22px; border: 1px solid var(--first-look-border); background: rgba(8,12,22,0.72); }
	.summary-list { margin: 0; padding-left: 1.15rem; display: grid; gap: 0.55rem; }
	.core-panel { margin-top: 1rem; }
	.combo-grid { display: grid; gap: 1rem; }
	.combo-card { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 1.25rem; align-items: center; padding: 1rem; border: 1px solid var(--first-look-border); border-radius: 22px; background: rgba(8,12,22,0.72); }
	.detail-card { display: block; background: transparent; border: 0; padding: 0; cursor: pointer; }
	.combo-card img { width: 100%; max-width: 160px; border-radius: 16px; }
	.combo-card h3 { margin: 0 0 0.5rem; color: #ff8d76; }
	.combo-card p, .matchup-card p, .curve-guide-block p { margin: 0; line-height: 1.6; }
	.matchup-card { display: grid; gap: 0.9rem; align-content: start; padding: 1rem; border: 1px solid var(--first-look-border); border-radius: 22px; background: rgba(8,12,22,0.72); }
	.matchup-badge { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.45rem 0.9rem; border-radius: 999px; font-weight: 600; }
	.badge-up { background: rgba(74,222,128,0.14); color: #65f59b; }
	.badge-down { background: rgba(255,107,107,0.14); color: #ff7c7c; }
	.badge-slightly-up { background: rgba(163,230,53,0.14); color: #bef264; }
	.badge-slightly-down { background: rgba(251,146,60,0.14); color: #fdba74; }
	.badge-even { background: rgba(148,163,184,0.16); color: #cbd5e1; }
	.badge-icon { display: inline-flex; align-items: center; justify-content: center; width: 1.1rem; height: 1.1rem; border-radius: 999px; background: currentColor; color: #08101b; font-size: 0.78rem; }
