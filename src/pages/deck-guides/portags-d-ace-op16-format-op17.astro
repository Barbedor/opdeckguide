---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Portgas D. Ace OP16 Deck Guide OP17: Decklist, Mulligan & Curve";
const description = "Master Portgas D. Ace OP16 in OP17 with the updated decklist, mulligan priorities, curve guide, tech cards, matchup spread, and Whitebeard Pirates gameplay tips.";
const icon = "/assets/guides/Ace-op16.png";
const card = (code, name, img, count = 4, role = "Character") => ({ code, name, img, count, role });

const leader = card("OP16-001", "Portgas D. Ace", "/Cards/OP16/OP16-001.jpg", 1, "Leader");
const garp = card("OP13-016", "Monkey D. Garp", "/Cards/OP13/OP13-016.jpg");
const rakuyo = card("OP17-016", "Rakuyo", "/Cards/OP17/New OP17/OP17-016.jpg", 2);
const luffy = card("OP16-015", "Monkey D. Luffy", "/Cards/OP16/OP16-015.jpg");
const oars = card("OP16-017", "Little Oars Jr.", "/Cards/OP16/OP16-017.jpg");
const vista = card("OP16-011", "Vista", "/Cards/OP16/OP16-011.jpg");
const marco = card("OP16-014", "Marco", "/Cards/OP16/OP16-014.jpg");
const uta = card("ST23-001", "Uta", "/Cards/ST23/ST23-001.jpg", 2);
const curiel = card("OP16-004", "Curiel", "/Cards/OP16/OP16-004.jpg");
const kingdew = card("OP17-006", "Kingdew", "/Cards/OP17/New OP17/OP17-006.jpg");
const newgate16 = card("OP16-003", "Edward Newgate", "/Cards/OP16/OP16-003.jpg");
const thatch = card("OP16-005", "Thatch", "/Cards/OP16/OP16-005.jpg", 2);
const newgate17 = card("OP17-005", "Edward Newgate", "/Cards/OP17/New OP17/OP17-005.jpg");
const badManners = card("OP04-016", "Bad Manners Kick Course", "/Cards/OP04/OP04-016.png", 2, "Event");
const gahHaHa = card("OP17-017", "Ga Ha Ha Ha!!", "/Cards/OP17/New OP17/OP17-017.jpg", 2, "Event");
const mobyDick = card("OP16-021", "Moby Dick", "/Cards/OP16/OP16-021.jpg", 4, "Stage");
const aceFiveCost = card("OP16-118", "Portgas D. Ace", "/Cards/OP16/OP16-118.jpg", null);
const roger = card("OP09-118", "Gol D. Roger", "/Cards/OP09/OP09-118.jpg", null);
const sanji = card("OP10-005", "Sanji", "/Cards/OP10/OP10-005.jpg", null);
const zoro = card("EB04-007", "Roronoa Zoro", "/Cards/EB04/EB04-007.jpg", null);

// Existing matchup data, intentionally unchanged.
const saboOp13 = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg", null, "Leader");
const rocksOp17 = card("OP17-039", "Rocks D. Xebec OP17", "/Cards/OP17/New OP17/OP17-039.jpg", null, "Leader");
const mihawkOp14 = card("OP14-020", "Dracule Mihawk OP14", "/Cards/OP14/OP14-020.jpg", null, "Leader");
const kaidoOp17 = card("OP17-058", "Kaido OP17", "/Cards/OP17/New OP17/OP17-058.jpg", null, "Leader");
const linlinOp17 = card("OP17-099", "Charlotte Linlin OP17", "/Cards/OP17/New OP17/OP17-099.jpg", null, "Leader");
const luffyOp17 = card("OP17-079", "Monkey D. Luffy OP17", "/Cards/OP17/New OP17/OP17-079.jpg", null, "Leader");
const shanksOp17 = card("OP17-020", "Shanks OP17", "/Cards/OP17/New OP17/OP17-020.jpg", null, "Leader");
const enelOp15 = card("OP15-058", "Enel OP15", "/Cards/OP15/OP15-058.jpg", null, "Leader");
const boaOp14 = card("OP14-041", "Boa Hancock OP14", "/Cards/OP14/OP14-041.jpg", null, "Leader");
const nicoRobinOp09 = card("OP09-062", "Nico Robin OP09", "/Cards/OP09/OP09-062.jpg", null, "Leader");
const luffyAceSt30 = card("ST30-001", "Luffy & Ace ST30", "/Cards/ST30/ST30-001.jpg", null, "Leader");
const matchupIcons = { "OP13-004": "/assets/guides/Sabo OP13-004.png", "OP17-039": "/assets/guides/Rocks.DXebec op17.png", "OP14-020": "/assets/guides/dracule-mihawk-op14.png", "OP17-058": "/assets/guides/Kaido op17.png", "OP17-099": "/assets/guides/Charlotte Linlin op17.png", "OP17-079": "/assets/guides/Monkey.D.Luffy op17.png", "OP17-020": "/assets/guides/Shanks op17.png", "OP15-058": "/assets/guides/enel-op15.png", "OP14-041": "/assets/guides/boa-hancock-op14.png", "OP09-062": "/assets/guides/Nico-Robin-op09.png", "ST30-001": "/assets/guides/Luffy-st30.png" };
const matchupGroups = [
	{ label: "Favorable", icon: "&uarr;", tone: "up", cards: [mihawkOp14, saboOp13, shanksOp17] },
	{ label: "Slightly Favorable", icon: "&uarr;", tone: "slightly-up", cards: [luffyOp17] },
	{ label: "Slightly Unfavorable", icon: "&darr;", tone: "slightly-down", cards: [kaidoOp17] },
	{ label: "Unfavorable", icon: "&darr;", tone: "down", cards: [nicoRobinOp09, rocksOp17, linlinOp17, luffyAceSt30, enelOp15, boaOp14] },
];

const decklist = [leader, garp, rakuyo, luffy, oars, vista, marco, uta, curiel, kingdew, newgate16, thatch, newgate17, badManners, gahHaHa, mobyDick];
const simDeckCode = decklist.map((entry) => `${entry.count}x${entry.code}`).join("\n");
const priorityKeeps = [
	{ title: "Monkey D. Garp OP13-016", card: garp, text: "Your primary searcher. He looks at the top four cards and can add a cost 3 or greater card to your hand. Nearly every Character in the deck qualifies, so he reliably finds the pieces you need." },
	{ title: "Moby Dick OP16-021", card: mobyDick, text: "Your second consistency engine. It looks at the top three cards and lets you add one to your hand without revealing it. Later, you can trash the Stage to attach a rested DON!! to your Leader or one of your Characters." },
	{ title: "Monkey D. Luffy OP16-015", card: luffy, text: "Try to keep Luffy for your 4-DON!! turn. He is an important early piece because the 8000-Power Characters in your hand can make your defense significantly stronger." },
];
const matchupKeeps = [
	{ title: "Against Mihawk: Marco OP16-014", card: marco, text: "Marco is especially important against versions using Vander Decken and other removal effects. If the opponent tries to remove one of your Characters by effect, Marco can be K.O.'d instead, then return active by trashing an 8000-Power Character from your hand. He does not protect against rest or freeze effects." },
	{ title: "Against Elbaf decks: Vista OP16-011", card: vista, text: "Vista is a priority because his When Attacking effect can K.O. up to two opposing Characters with 2000 base Power or less, keeping smaller Elbaf Characters from staying on the board." },
];
const firstCurve = [
	{ label: "1 DON!! — Garp or Moby Dick", mode: "OR", cards: [garp, mobyDick], text: "Start with Monkey D. Garp to find your next Character or Moby Dick to keep improving your hand. Moby Dick can later be trashed to attach a rested DON!! to your Leader or a Character, improving your following turns." },
	{ label: "3 DON!! — Searchers or Rakuyo", connectors: ["+", "OR"], cards: [garp, mobyDick, rakuyo], text: "Keep finding the pieces you need with Garp and Moby Dick. Rakuyo is the better option when the opponent has several small Characters. Against Elbaf Luffy, a Rodo plus Usopp board can be punished immediately because Rakuyo can K.O. two Characters with 2000 base Power or less." },
	{ label: "5 DON!! — Monkey D. Luffy", cards: [luffy], text: "Play Monkey D. Luffy OP16-015, then use your remaining DON!! to keep searching or strengthen your Leader attack. When the opponent attacks, trash an 8000-Power Character from hand to make both Luffy and your Leader 7000 Power for the turn." },
	{ label: "7 DON!! — Vista", cards: [vista], text: "Play Vista OP16-011. Attach 1 DON!! to him, then give him Rush with your Leader to use his When Attacking effect immediately. You get a 9000-Power attack while K.O.'ing up to two opposing Characters with 2000 base Power or less. If Moby Dick is in play, attach a rested DON!! to your Leader or Vista to optimize the line." },
	{ label: "9 DON!! — Edward Newgate OP16-003", cards: [newgate16], text: "Prioritize Edward Newgate OP16-003 before the 10-cost Newgate when you do not immediately need the protection from the latter. It gives your Leader +2000 Power and Double Attack. You can reveal two 8000-Power Characters from hand to give an opposing Character -6000 Power, then give Newgate Rush with the Leader effect to attack at 10000 Power right away." },
	{ label: "10 DON!! — Edward Newgate", mode: "OR", cards: [newgate16, newgate17], text: "At 10 DON!!, continue with Edward Newgate OP16-003 or OP17-005 based on the board. If OP16-003 is already in play when OP17-005 enters, their Power increases stack and your Leader can make a 10000-Power Double Attack that turn." },
];
const secondCurve = [
	{ label: "2 DON!! — Garp + Moby Dick", mode: "+", cards: [garp, mobyDick], text: "Use your 2 DON!! to play Monkey D. Garp and Moby Dick, preparing your hand and your following turns." },
	{ label: "4 DON!! — Monkey D. Luffy", cards: [luffy], text: "Your main play is Monkey D. Luffy OP16-015. He turns your 8000-Power Characters into defensive resources. Against Elbaf Luffy, Loki can become 11000 Power on your next turn after using its effect to K.O. Luffy. That allows Edward Newgate OP17-005 to receive its cost reduction and be played for only 6 DON!!." },
	{ label: "6 DON!! — Marco or Vista", mode: "OR", cards: [marco, vista], text: "Choose the 6-cost for the matchup. Vista is best when you need to clear smaller Characters: give him Rush to attack and remove immediately, especially if Moby Dick can attach a rested DON!!. Marco is better when opposing removal is a serious threat. If he is K.O.'d, he can return active by trashing an 8000-Power Character from hand." },
	{ label: "8 DON!! — Edward Newgate OP16-003", cards: [newgate16], text: "Play your 8-cost, use the -6000 Power effect when needed, then give him Rush. Your Leader gains +2000 Power and Double Attack, creating immediate pressure while handling an opposing Character." },
	{ label: "10 DON!! — Edward Newgate OP16-003 or OP17-005", mode: "OR", cards: [newgate16, newgate17], text: "Continue developing your Edward Newgates. OP17-005 attacks immediately at 12000 Power and sets your Leader's base Power to 8000 through the end of your opponent's next turn." },
];
const techCards = [
	{ card: rakuyo, title: "Rakuyo OP17-016", text: "Rakuyo is mainly for matchups where the opponent plays several small Characters, especially Elbaf Luffy and Purple Enel. His On Play can K.O. up to two opposing Characters with 2000 base Power or less. Base Power is what matters, so a Character that received a boost can still be a valid target. Rakuyo is especially strong going first: at 3 DON!!, he can remove two small Characters and stop the opponent from building a board. His 2000 Counter also keeps him useful when removal is not needed." },
	{ card: oars, title: "Little Oars Jr. OP16-017", text: "Little Oars Jr. can be played for only 4 DON!!, but loses 4000 Power until you control another Whitebeard Pirates Character that costs 8 or more. You can develop him early, then wait for your larger Characters. Once the condition is met, he is an 8000-Power Blocker. Thatch OP16-005, itself an 8-cost, can also turn that condition on. Little Oars Jr. is an 8000-Power card in hand, so he can pay this deck's reveal and trash costs." },
	{ card: thatch, title: "Thatch OP16-005", text: "Thatch is an 8-cost, 8000-Power Blocker, but his cost is reduced by 3 when you already have an 8000-Power Character on the board. He can become a 5-cost Blocker while also turning on Little Oars Jr. Like Little Oars Jr., he is an 8000-Power card in hand for the deck's effects." },
	{ card: uta, title: "Uta ST23-001", text: "Uta is a two-of defensive option. When you control a 10000-Power Character, her cost is reduced by 4, allowing you to play this Blocker for only 2 DON!!. It adds defense without dedicating most of your DON!! to it and also has 2000 Counter, but remains a flexible option because some matchups can bypass or neutralize Blockers." },
	{ card: badManners, title: "Bad Manners Kick Course OP04-016", text: "Bad Manners Kick Course turns another card in your hand into a +3000 Counter, which is important in a deck with many cards that have no Counter. Its Trigger can also give an opposing Leader or Character -3000 Power during the opponent's turn, sometimes making an attack much easier to defend." },
	{ card: gahHaHa, title: "Ga Ha Ha Ha!! OP17-017", text: "For 1 DON!!, Ga Ha Ha Ha!! gives a Whitebeard Pirates Leader or Character +2000 Power during a battle, then gives an opposing Leader or Character -2000 Power for the rest of the turn. It can represent up to 4000 Power of defensive value. If +2000 is enough for the current attack, use the -2000 on a Character that still needs to attack and prepare the next defense." },
];
const otherOptions = [
	{ card: aceFiveCost, title: "Portgas D. Ace OP16-118", text: "This alternative gives the 8000-Power Characters in your hand 2000 Counter and can search for a Monkey D. Luffy or Whitebeard Pirates card twice through its On Play and On K.O. effects. This list usually prefers the immediate impact of Luffy at 4 or 5 DON!!, then Vista or Marco at 6 DON!!, both of which can receive Rush from the Leader." },
	{ card: roger, title: "Gol D. Roger OP09-118", text: "Consider Roger against decks that rely heavily on Blockers. He has Rush, and when either player is at 0 Life, his effect becomes especially threatening because the opponent cannot simply rely on a Blocker to stop the attack." },
	{ card: sanji, title: "Sanji OP10-005", text: "Sanji is a more aggressive early option: a 3-cost, 6000-Power attacker during your turn that draws a card when it is K.O.'d." },
	{ card: zoro, title: "Roronoa Zoro EB04-007", text: "Zoro supports a more resilient version. His On Play gives your Leader +2000 Power through the end of your opponent's next turn, and he gains Rush when an opposing 8000-Power or greater Character is in play. Combined with Luffy, your Leader becomes much harder to attack." },
];
const tips = [
	{ cards: [leader, vista, marco], text: "Take advantage of Rush. Ace lets your larger Whitebeard Pirates attack immediately, which is especially effective against rest, freeze, and removal. Even if the Character is controlled on the following turn, it has already attacked." },
	{ cards: [luffy, marco, vista, newgate16], text: "Your 8000-Power Characters fuel several effects: Luffy turns them into defense, Marco uses them to return to play, Vista uses them to draw, and Edward Newgate OP16-003 reveals them for -6000 Power. They are more than cards you simply want to play." },
	{ cards: [vista, mobyDick], text: "When small targets are present, attach 1 DON!! to Vista, then give him Rush with Ace. You get an immediate 9000-Power attack while being able to K.O. up to two Characters with 2000 base Power or less." },
	{ cards: [marco], text: "Marco is excellent against removal because he can protect another Character and return to play by trashing an 8000-Power Character from your hand. He does not protect against rest or freeze." },
	{ cards: [newgate16, newgate17], text: "Do not automatically play Edward Newgate OP17-005 before OP16-003. If you do not need 8000 base Power immediately to survive, OP16-003 gives your Leader +2000 Power and Double Attack on each of your turns. The two Newgates can later combine for a 10000-Power Double Attack." },
	{ cards: [newgate17], text: "Watch for opposing Characters with 10000 Power or more: they let Edward Newgate OP17-005 cost only 6 DON!!." },
	{ cards: [gahHaHa], text: "In the late game, keeping 1 DON!! active can matter a great deal. If +2000 is enough to defend the current attack, apply -2000 Power to another opposing Character that still needs to attack and make the next defense easier." },
	{ cards: [luffy, badManners, newgate17], text: "If the opponent attacks Monkey D. Luffy, those are attacks not aimed at your Leader. Use Luffy's defensive effect before he leaves play. Do not rely only on Blockers: against decks that can rest them, combine Luffy, Edward Newgate OP17-005, Bad Manners Kick Course, and Ga Ha Ha Ha!! to defend." },
	{ cards: [marco, newgate16, newgate17], text: "Against Robin, do not slow down too much because of Triggers. Keep enough pressure on before the opponent stabilizes with larger turns. Marco and the Edward Newgates are essential for maintaining that pace." },
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span>Deck Guide</span><span>OP17 Format</span></div><h1>Portgas D. Ace OP16 Deck Guide</h1><p>Build a consistent hand with Garp and Moby Dick, establish Luffy on curve, then give your Whitebeard Pirates Rush while turning Ace into an 8000-Power defensive wall.</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Curve Guide</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div></div><div class="guide-icon"><img src={icon} alt="Portgas D. Ace OP16 deck guide icon" loading="eager" /></div></div></section>
	<section id="decklist" class="list-section"><div class="container article-stack">
		<section class="glow-block"><div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>Copy for Sim</button></div></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><span class="deck-count">{entry.count}x</span><div><div class="deck-name">{entry.name}</div><div class="deck-code">{entry.code}</div></div></div><span class="deck-role">{entry.role}</span></button>)}</div></section>
		<section class="glow-block"><header><h2>Mulligan</h2><p>Your priority is finding your searchers to stabilize your hand, then Monkey D. Luffy OP16-015 for your 4-DON!! turn. The deck contains many cards without Counter, so prepare your hand before you reach the turns where you play your larger Characters.</p></header><div class="mulligan-list"><h3>Priority Keeps</h3>{priorityKeeps.map((item) => <article class="mulligan-item"><h4>{item.title}</h4><div class="item-layout"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`} data-code={item.card.code}><img src={item.card.img} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><p>{item.text}</p></div></article>)}<h3 class="section-break">Matchup-Specific Keeps</h3><p>Some cards matter enough in specific matchups that they are worth finding during the mulligan.</p>{matchupKeeps.map((item) => <article class="mulligan-item"><h4>{item.title}</h4><div class="item-layout"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`} data-code={item.card.code}><img src={item.card.img} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><p>{item.text}</p></div></article>)}<article class="mulligan-item"><h3>Don’t Overprioritize Your Late Game</h3><div class="item-layout"><button class="mini-card" type="button" data-card-preview data-full={newgate17.img} data-name={`${newgate17.code} ${newgate17.name}`} data-code={newgate17.code}><img src={newgate17.img} alt={`${newgate17.code} ${newgate17.name}`} loading="lazy" /></button><p>You naturally want access to your Edward Newgates, especially the new Edward Newgate OP17-005, but they do not come before your searchers and Luffy in the mulligan. Once Garp or Moby Dick into Luffy and your mid game are prepared, find Newgate naturally as the game develops. The important exception is an opponent who can establish a 10000-Power or greater Character early: Edward Newgate OP17-005 can then receive its -4 cost reduction and become available much sooner.</p></div></article></div></section>
		<section id="curve" class="glow-block"><header><h2>Curve Guide</h2><p>Ace performs best with a simple line: searchers, then Luffy, then Vista or Marco, then Edward Newgate. Going second is especially strong because it lines up the deck's main Characters on 4, 6, 8, and 10 DON!!.</p></header>{[["Going First", firstCurve], ["Going Second", secondCurve]].map(([heading, curve]) => <div class="curve-block"><h3>{heading}</h3><div class="curve-list">{curve.map((item) => <article class="curve-item"><div><strong>{item.label}</strong><div class={`card-set ${item.cards.length === 3 ? "card-set-three" : ""}`}>{item.cards.map((entry, index) => <><button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>{item.cards.length > 1 && index < item.cards.length - 1 && <span class="connector">{item.connectors?.[index] ?? item.mode ?? "+"}</span>}</>)}</div></div><p>{item.text}</p></article>)}</div></div>)}</section>
		<section class="glow-block"><header><h2>Tech Cards</h2><p>This decklist includes cards that do more than simply follow the curve. Some improve specific matchups, while others take advantage of the deck’s many 8000-Power Characters.</p></header><div class="tech-list">{techCards.map((item) => <article class="tech-item"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`} data-code={item.card.code}><img src={item.card.img} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div><h3 class="section-break">Other Options</h3><div class="tech-list">{otherOptions.map((item) => <article class="tech-item"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`} data-code={item.card.code}><img src={item.card.img} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>
		<section id="matchups" class="glow-block"><div class="section-header"><div><h2>Matchups</h2><p>OP17 matchup spread for Portgas D. Ace OP16.</p></div></div><div class="matchup-grid">{matchupGroups.map((group) => <div class="matchup-card"><div class={`matchup-badge badge-${group.tone}`}><span class="badge-icon" set:html={group.icon}></span><span>{group.label}</span></div><div class="matchup-list">{group.cards.map((entry) => <button class="matchup-entry" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={matchupIcons[entry.code] ?? entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /><span>{entry.name}</span></button>)}</div></div>)}</div></section>
		<section class="glow-block"><header><h2>Tips</h2><p>Ace rewards a clean sequence: prepare your hand, pressure immediately with Rush, and turn your 8000-Power Characters into both offense and defense.</p></header><div class="tips-list">{tips.map((item) => <article class="tip-item"><div class={`card-set ${item.cards.length === 3 ? "card-set-three" : ""}`}>{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>{item.text}</p></article>)}</div></section>
	</div></section>
	<div class="card-modal" data-modal aria-hidden="true"><div><button type="button" data-close>Close</button><img src="" alt="" data-modal-image /></div></div>
</MainLayout>

<script>
	const modal = document.querySelector("[data-modal]"); const image = document.querySelector("[data-modal-image]");
	const close = () => { modal?.classList.remove("open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; };
	document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !image) return; image.setAttribute("src", button.getAttribute("data-full") || ""); image.setAttribute("alt", button.getAttribute("data-name") || "Card preview"); modal.classList.add("open"); modal.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; }));
	document.querySelector("[data-close]")?.addEventListener("click", close); modal?.addEventListener("click", (event) => { if (event.target === modal) close(); });
	document.querySelectorAll("[data-copy-sim]").forEach((button) => button.addEventListener("click", async () => { const initial = button.textContent; try { await navigator.clipboard.writeText(button.getAttribute("data-sim-deck") || ""); button.textContent = "Copied"; } catch { button.textContent = "Copy failed"; } setTimeout(() => { button.textContent = initial; }, 1800); }));
</script>

<style>
	.guide-hero { padding-top:3rem; } .hero-grid { display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:2.5rem; align-items:center; } .hero-tags,.hero-actions { display:flex; flex-wrap:wrap; gap:.7rem; align-items:center; } .hero-tags span { border:1px solid rgba(255,107,53,.45); border-radius:999px; padding:.3rem .7rem; font-weight:800; font-size:.8rem; } .hero-copy p,header p,.item-layout p,.curve-item p,.tech-item p,.tip-item p { line-height:1.6; } .guide-icon img { width:100%; border-radius:18px; box-shadow:0 24px 52px rgba(0,0,0,.35); }
