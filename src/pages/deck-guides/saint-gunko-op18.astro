  .guide-hero{padding:3rem 0 2rem}.hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(220px,.9fr);gap:3rem;align-items:center}.hero-copy h1{margin:0;font-size:clamp(2.1rem,5vw,3.3rem);line-height:1.05}.hero-tags,.hero-actions,.card-row{display:flex;flex-wrap:wrap;gap:.65rem;align-items:flex-start}.hero-tags{margin-bottom:1rem}.hero-tags span{padding:.4rem .8rem;border:1px solid rgba(255,138,42,.3);border-radius:999px;color:#ffb47c;font-size:.8rem;font-weight:800}.guide-icon img{display:block;width:min(190px,100%);margin-left:auto;border-radius:12px;border:1px solid rgba(255,255,255,.08)}.hero-intro{max-width:44rem;color:var(--text-200);line-height:1.6}.article-stack,.content-list{display:grid;gap:1rem}.article-stack{padding-bottom:2rem}.glow-block{padding:1.25rem;border:2px solid rgba(255,107,53,.48);border-radius:18px;background:rgba(8,12,24,.82)}.glow-block h2,.glow-block h3,.glow-block p{margin-top:0}.decklist-title-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1rem}.deck-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.85rem}.deck-card{display:grid;gap:.55rem;padding:.7rem;border:1px solid rgba(255,107,53,.26);border-radius:12px;background:rgba(0,0,0,.22);color:inherit;text-align:left}.deck-card img{width:100%;max-width:110px;margin:auto;border-radius:10px}.deck-info{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.5rem}.deck-count{color:#ff8a42}.deck-code,.deck-role{display:block;color:var(--text-300);font-size:.75rem}.content-item,.tech-card{padding:1rem;border:1px solid rgba(255,107,53,.3);border-radius:14px;background:rgba(0,0,0,.2)}.content-item h3,.tech-card h3{margin-bottom:.7rem}.mini-card{border:0;padding:0;background:transparent;cursor:pointer}.mini-card img{display:block;width:88px;border-radius:10px;aspect-ratio:480 / 670;object-fit:contain}.paragraphs p,.matchup-card p{line-height:1.6}.curve-block{margin-top:1.5rem}.curve-item{padding:1rem;border:1px solid rgba(255,107,53,.3);border-radius:14px;background:rgba(0,0,0,.2)}.curve-item>strong{display:block;margin-bottom:.7rem;color:#ff6b35}.curve-content{display:grid;grid-template-columns:minmax(220px,300px) minmax(0,1fr);gap:1rem;align-items:center}.curve-content .card-set{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem}.curve-content .mini-card img{width:88px}.curve-content .card-set.four{flex-wrap:nowrap;gap:.3rem}.curve-content .card-set.four .mini-card img{width:68px}.curve-content .card-set.connected{flex-wrap:nowrap;gap:.25rem}.curve-content .card-set.connected .mini-card img{width:80px}.curve-content .card-set.option-rows{flex-wrap:wrap;max-width:300px}.curve-content .card-set.option-rows .option-break{flex:0 0 100%;text-align:left;padding-left:68px;line-height:1.1}.curve-content .card-set.option-rows .mini-card img{width:64px}.curve-content .card-option-row{display:flex;align-items:center;gap:.4rem}.curve-content .card-set.option-rows{flex-direction:column;align-items:flex-start}.curve-content .connector{color:#ff6b35;font-weight:900}.curve-content .card-count-label{color:#ff8a42;font-weight:900;font-size:.9rem;align-self:center}.curve-note p{line-height:1.6}.curve-note p:last-child{margin-bottom:0}.matchup-group{margin-top:1.25rem}.matchup-group>h3{margin:0 0 .8rem;color:#ff6b35}.matchup-heading{display:flex;align-items:center;gap:1rem;margin-bottom:.85rem}.matchup-heading h3{margin:0}.matchup-leader-card{flex:0 0 auto}.matchup-leader-card img{width:88px}.matchup-guide-icon{width:88px;flex:0 0 auto;align-self:center;border-radius:10px}.card-modal{position:fixed;inset:0;z-index:40;display:grid;place-items:center;padding:1rem;background:rgba(0,0,0,.78)}.card-modal[aria-hidden="true"]{display:none}.card-modal-inner{position:relative;max-width:min(440px,92vw)}.card-modal img{display:block;width:100%;max-height:84vh;object-fit:contain}.modal-close{position:absolute;right:0;top:-2.5rem;border:0;border-radius:999px;padding:.5rem .9rem;background:#ff6b35;color:#ff