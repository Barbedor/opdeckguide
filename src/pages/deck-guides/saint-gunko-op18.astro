---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Saint Gunko OP18 Deck Guide";
const description = "OP18 Saint Gunko deck guide with decklist, mulligan priorities, going-first and going-second curves, tech cards, and matchups.";
const guideIcon = "/assets/guides/Gunko%20OP18.png";
const card = (code, name, file, count = null, role = "Character") => ({ code, name, img: `/Cards/${file}`, count, role });

const leader = card("OP18-060", "Saint Gunko", "OP18/OP18-060 Saint Gunko.jpg", 1, "Leader");
const gunkoSearch = card("OP18-084", "Saint Gunko", "OP18/OP18-084 Gunko.jpg", 4);
const cerberus = card("OP18-085", "Cerberus", "OP18/OP18-085 Cerberus.jpg", 4);
const zoro = card("OP17-095", "Roronoa Zoro", "OP17/New OP17/OP17-095.jpg", 4);
const warcury = card("OP13-089", "St. Topman Warcury", "OP13/OP13-089.jpg", 1);
const killinghamPurple = card("OP18-064", "Saint Killingham", "OP18/OP18-064 Saint Killingham.jpg", 4);
const killinghamBlack = card("OP18-083", "Saint Killingham", "OP18/OP18-083 Saint Killingham.jpg", 4);
const mars = card("OP13-091", "St. Marcus Mars", "OP13/OP13-091.jpg", 1);
const sommers = card("OP18-088", "Saint Sommers", "OP18/OP18-088 Saint Sommers .jpg", 4);
const shamrock = card("OP18-119", "Saint Shamrock", "OP18/OP18-119 Saint Shamrock.jpg", 4);
const sleeptids = card("OP18-093", "Sleeptids", "OP18/OP18-093 Sleeptids.jpg", 4);
const gunkoBig = card("OP18-065", "Saint Gunko", "OP18/OP18-065 Saint Gunko.jpg", 4);
const eldersEvent = card("OP13-096", "The Five Elders Are at Your Service!!!", "OP13/OP13-096.jpg", 4, "Event");
const callEvent = card("OP18-096", "I'll Make the Call", "OP18/OP18-096 I'll Summon Them.jpg", 4, "Event");
const abyss = card("OP18-097", "Abyss Pentagram", "OP18/OP18-097 Abyss.jpg", 4, "Stage");
const spandamLeader = card("OP18-079", "Spandam", "OP18/OP18-079 Spandam.jpg", null, "Leader");
const sundayLeader = card("OP18-041", "Ms. All Sunday", "OP18/OP18-041 Ms. All Sunday.jpg", null, "Leader");
const kaidoLeader = card("OP17-058", "Kaido", "OP17/New OP17/OP17-058.jpg", null, "Leader");

const decklist = [leader, gunkoSearch, cerberus, zoro, warcury, killinghamPurple, killinghamBlack, mars, sommers, shamrock, sleeptids, gunkoBig, eldersEvent, callEvent, abyss];
const simDeckCode = decklist.flatMap((entry) => { const lines = []; let remaining = entry.count; while (remaining > 4) { lines.push(`4x${entry.code}`); remaining -= 4; } if (remaining > 0) lines.push(`${remaining}x${entry.code}`); return lines; }).join("\n");

const mulliganIntro = [
  "OP18 Saint Gunko has two priorities: keeping your Searchers in hand and preparing your Trash so you can quickly play your Holy Knights. Thanks to the deck's revival effects, Characters sent to your Trash can become resources you can use right away.",
  "A good opening hand should let you develop your board from the first few turns while preparing your future combinations with Saint Killingham, Saint Shamrock, and Saint Gunko."
];
const mulligan = [
  { title: "OP18-084 Saint Gunko — Your Mulligan Priority", cards: [gunkoSearch], paragraphs: [
    "OP18-084 Saint Gunko is one of the best cards to keep in your opening hand.",
    "This 1-Cost Searcher looks at the top four cards of your deck, lets you add a Holy Knights of God card to your hand, and sends the others to your Trash.",
    "Its main advantage is combining this search with an Activate: Main effect: by resting 4 DON!!, you can play a Holy Knights of God Character with a Cost of 6 or less from your Trash.",
    "When going second, you can therefore play Saint Gunko on your first turn, then activate its effect on your next turn when you have 4 DON!!.",
    "This sequence lets you play OP18-083 Saint Killingham, OP18-064 Saint Killingham, or OP18-088 Saint Sommers quickly, depending on the cards in your Trash and what the game requires.",
    "The benefit is that you can quickly play a 6000-Power Character without normally playing it from your hand. You can also use your Leader's effect to draw two cards and then discard one, since you played a Character from your Trash."
  ]},
  { title: "OP13-096 The Five Elders Are at Your Service!!! — Another Search Option", cards: [eldersEvent], paragraphs: [
    "This Event is another excellent card to keep in your opening hand, especially when you do not have OP18-084 Saint Gunko.",
    "It lets you search for your Celestial Dragons, including your Holy Knights, while also filling your Trash.",
    "You can therefore pick up an important piece like Saint Shamrock or Saint Killingham, while the cards you do not choose help prepare future plays from your Trash.",
    "Using both Searchers together is especially useful: it increases your chances of finding the Characters you need to develop while giving you more targets in your Trash.",
    "However, be careful about the cards your Searchers send to your Trash, especially OP17-095 Roronoa Zoro, which is unsearchable and unrecoverable by your Searchers."
  ]},
  { title: "OP18-097 Abyss Pentagram — Prepare Your Development", cards: [abyss], paragraphs: [
    "Abyss Pentagram is an excellent opening card when you already have a Searcher or a hand that can quickly develop your board.",
    "For 1 DON!!, its On Play effect lets you draw one card and send the top two cards of your deck to your Trash.",
    "Its ongoing effect also reduces the Cost by 1 of Holy Knights of God and Five Elders Characters costing at least 2 DON!! when they are played from your hand.",
    "This reduction lets you play OP18-119 Saint Shamrock for 7 DON!! instead of 8; OP18-065 Saint Gunko for 9 DON!! instead of 10; and your Saint Killingham and Saint Sommers for one less DON!! when played from your hand.",
    "Abyss Pentagram therefore considerably improves your future turns while preparing your Trash right away.",
    "However, if your hand only has the Stage and several large Characters, with no Searcher or way to develop, you should mulligan."
  ]},
  { title: "OP18-083 Saint Killingham and OP18-093 Sleeptids — Set Up a Strong Defense", cards: [killinghamBlack, sleeptids], paragraphs: [
    "OP18-083 Saint Killingham becomes especially useful when Sleeptids is already in your Trash.",
    "Its On Play effect lets you play a Sleeptids from your Trash, giving you a Blocker right away.",
    "This combination is even more valuable when you can play Saint Killingham with OP18-084 Saint Gunko.",
    "You can then play two Characters with one activation: a 6000-Power Saint Killingham and a Sleeptids Blocker.",
    "Sleeptids also has a 2000 Counter, so you can use it to defend your Leader before recovering it from your Trash.",
    "You do not need to always keep Sleeptids in your opening hand. Saint Killingham, however, can be an excellent card to keep if you already have a way to put Sleeptids in your Trash.",
    "This interaction is especially useful against aggressive decks because you can play an attacker while setting up your defense."
  ]},
  { title: "OP17-095 Roronoa Zoro — A Priority Against Removal Decks", cards: [zoro], paragraphs: [
    "Roronoa Zoro can become one of your most important opening-hand cards against certain Leaders, especially OP18 Spandam.",
    "His effect lets you protect your Characters from Removal by using resources in your Trash.",
    "This protection is essential against strategies that can remove several Characters with their effects or Triggers. Without Zoro, you risk losing your board before you can use your key Characters.",
    "Unlike your Holy Knights, Zoro is unsearchable and unrecoverable by your Searchers. It is therefore especially valuable to keep him in your opening hand when you know your opponent has many Removal effects.",
    "Your Leader can also help you find him with its draw effect when you replay Characters from your Trash.",
    "Against decks that mainly apply offensive pressure without removing your Characters, prioritize your Searchers and revival engine instead."
  ]},
  { title: "Which Hands Should You Prioritize?", cards: [], paragraphs: [
    "The best opening hand generally has OP18-084 Saint Gunko or OP13-096 The Five Elders Are at Your Service!!!, ideally alongside Abyss Pentagram.",
    "When going second, OP18-084 Saint Gunko is even more valuable because it can let you play a Holy Knight from your Trash on your 4 DON!! turn.",
    "A hand with OP18-083 Saint Killingham and a way to put Sleeptids in your Trash is also a good defensive start.",
    "Finally, adapt your opening hand to your opponent: against Spandam, having Roronoa Zoro can be just as important as getting your initial development started.",
    "Above all, avoid hands full of large Characters without a way to prepare your Trash. Your deck is much more effective when you can use its effects to play from your Trash rather than relying only on Characters normally played from your hand."
  ]}
];

const curveFirst = [
  { title: "1 DON!! — Saint Gunko (OP18-084) or Abyss Pentagram", cards: [gunkoSearch, abyss], connectors: ["OR"], paragraphs: ["Play Saint Gunko to search for a Holy Knight and fill your Trash, or Abyss Pentagram to draw and prepare your Cost reductions."] },
  { title: "3 DON!! — Prepare Plays from Your Trash", cards: [gunkoSearch, eldersEvent], connectors: ["+"], paragraphs: ["Use your Searchers to find your key pieces and fill your Trash. In particular, try to put Saint Killingham (OP18-083) and Sleeptids there.", "Against Spandam, avoid triggering his Triggers too early. Roronoa Zoro protects your board, but you have to draw him naturally: your Searchers cannot find him."] },
  { title: "5 DON!! — Develop Your Board", cards: [killinghamBlack, sleeptids, killinghamPurple], connectors: ["+", "OR"], paragraphs: ["With Abyss Pentagram, you can play Saint Killingham (OP18-083) from your hand for 4 DON!!, or play him from your Trash with your Saint Gunko Searcher's effect.", "If he brings back Sleeptids from your Trash, you get a Blocker and trigger your Leader's draw effect. Against an aggressive board, Saint Killingham (OP18-064) is an alternative for neutralizing opposing attackers."] },
  { title: "7 DON!! — Saint Shamrock (OP18-119)", cards: [shamrock, cerberus], connectors: ["+"], paragraphs: ["With Abyss Pentagram, Shamrock costs 7 DON!! instead of 8. Use his effect to play a Holy Knight with a Cost of 6 or less from your Trash.", "Since Shamrock has 9000 Power, you can then use your Leader's effect to get 1 active DON!!, play Cerberus, and give Shamrock Rush. This develops your board while letting you attack right away."] },
  { title: "9 DON!! — Saint Gunko (OP18-065)", cards: [gunkoBig, killinghamBlack, sleeptids, gunkoBig, killinghamPurple, gunkoBig, warcury], connectors: ["+", "+", "OR", "+", "OR", "+"], optionRows: true, paragraphs: ["With Abyss Pentagram, Saint Gunko costs 9 DON!! instead of 10. Its DON!! −1 effect lets you play a Celestial Dragon with 6000 Power or less from your Trash.", "Use OP18-065 with OP18-083 and OP18-093 Sleeptids, OP18-064 Saint Killingham, or OP13-089 St. Topman Warcury, depending on whether you need a Blocker, board control, or defense."] }
];
const curveSecond = [
  { title: "2 DON!! — Saint Gunko (OP18-084)", cards: [gunkoSearch], paragraphs: ["Play your Searcher on your first turn. It finds a Holy Knight and sends the remaining cards to your Trash, preparing a quick play from your Trash on your next turn."] },
  { title: "4 DON!! — Saint Killingham + Sleeptids", cards: [gunkoSearch, killinghamBlack, sleeptids], connectors: ["+", "→"], paragraphs: ["Use your 4 DON!! with your Searcher's Activate: Main effect to play Saint Killingham (OP18-083) from your Trash.", "If Sleeptids is already in your Trash, Killingham plays it for free. You get two Characters, including a Blocker, and trigger your Leader's draw effect."] },
  { title: "6 DON!! — Saint Sommers (OP18-088)", cards: [sommers, callEvent, killinghamPurple], connectors: ["OR", "OR"], paragraphs: ["With at least 6 DON!! on your field, Sommers can K.O. an opposing Character with a base Cost of 4 or less, such as the Mr.3 that can prevent one of your 9-Cost Characters from attacking and draw two cards from the Ms. All Sunday deck.", "You can also use I'll Make the Call to play Saint Killingham from your Trash, or choose the purple Killingham to neutralize several opposing attackers."] },
  { title: "8 DON!! — Saint Shamrock + Cerberus", cards: [abyss, shamrock, cerberus], connectors: ["+", "→"], paragraphs: ["With Abyss Pentagram, Shamrock costs 7 DON!!, leaving 1 DON!! for Cerberus. Without the Stage, you can get that DON!! back with your Leader effect after playing Shamrock.", "First, use Shamrock's effect to play a Holy Knight from your Trash. Saint Killingham (OP18-064) can prevent two opposing Characters from attacking. Then play Cerberus to give Shamrock Rush and attack a rested Character right away."] },
  { title: "10 DON!! — Saint Gunko or Offensive Pressure", cards: [gunkoBig, shamrock, cerberus], connectors: ["OR", "+"], paragraphs: ["Play Saint Gunko (OP18-065) to get an 11000-Power Blocker and play a Celestial Dragon from your Trash with its DON!! −1 effect. This is a particularly strong option when you need to withstand big opposing attacks.", "If your board is already developed, prioritize Saint Shamrock + Cerberus to finish the game. The Banish granted by Cerberus denies your opponent the cards from their Life, while Unblockable gets around their Blockers. Cerberus returns to your hand after its effect, so a single copy and 2 DON!! let you play it again and give Shamrock a second effect, such as Rush and Banish."] }
];

const techCards = [
  { card: zoro, title: "Roronoa Zoro (OP17-095) — Removal Protection", paragraphs: ["Zoro is especially important against decks that use a lot of Removal, particularly Spandam and his Triggers. He protects your Characters from opposing Removal by returning three cards from your Trash to the bottom of your deck, helping you avoid losing your Killingham and Sommers, in particular.", "Zoro is unsearchable and unrecoverable by your Searchers. You have to draw him naturally, including with your Leader's draw effect. Against Spandam, it may be better to delay attacking their Leader until Zoro can protect your board."] },
  { card: cerberus, title: "Cerberus (OP18-085) — Shamrock's Finisher", paragraphs: ["Cerberus lets you give Saint Shamrock Rush, Banish, or Unblockable, choosing with each activation.", "Use Rush to attack as soon as Shamrock enters play, Banish to prevent your opponent from adding their Life cards to their hand, or Unblockable to get around their Blockers.", "Cerberus returns to your hand after its effect. A single copy and 2 DON!! let you play it again, giving the same Shamrock a second effect such as Rush and Banish, which is very effective against the large Blockers in OP17 Kaido."] },
  { card: warcury, title: "St. Topman Warcury (OP13-089) — Defensive Value", paragraphs: ["Warcury is an additional target for Saint Gunko (OP18-065). He strengthens your defense when you need to withstand several important attacks.", "He can also draw one card when K.O.'d. Since he is a Blocker, this effect is especially useful. Against OP17 Kaido, he is an interesting alternative to Saint Killingham when you already have enough board control."] },
  { card: mars, title: "St. Marcus Mars (OP13-091) — Situational Removal", paragraphs: ["Mars gives Saint Gunko another option to play from your Trash. He can remove an opposing Character with a base Cost of 5 or less while also providing a difficult-to-remove Blocker.", "He is still situational: generally prioritize Saint Killingham to control attacks or Warcury when you need to strengthen your defense."] },
  { card: callEvent, title: "I'll Make the Call (OP18-096) — Emergency Recursion", paragraphs: ["This Event lets you play a Holy Knight with a Cost of 6 or less from your Trash for a total of 4 DON!!: 1 DON!! to play the Event and 3 DON!! to rest.", "It gives you an alternative to OP18-084 Saint Gunko for recovering Saint Killingham or Sommers, especially when you need to develop your board quickly.", "On defense, it gives your Leader or a Character +4000 Power if your Trash has at least 10 cards."] }
];

const matchups = [
  { title: "OP18 Spandam — Protect Your Board", leader: spandamLeader, paragraphs: ["Spandam is dangerous because his Triggers can remove your Characters from the board.", "Roronoa Zoro (OP17-095) is your priority. He protects your Characters from Removal effects, but your Searchers cannot find him. Use your Leader's draw effect to find him, and avoid attacking your opponent's Life too early without protection.", "Sleeptids (OP18-093) is also valuable: its 9 Cost protects it from Removal effects limited to a Cost of 8 or less."] },
  { title: "OP18 Ms. All Sunday — Control the Board", leader: sundayLeader, paragraphs: ["Ms. All Sunday can quickly fill her board and multiply attacks. Your priority is to reduce the number of opposing attackers before trying to deal damage.", "Starting with 6 DON!! on your field, Saint Sommers (OP18-088) can remove an opposing Character with a base Cost of 4 or less.", "When you have the necessary cards, play Saint Shamrock (OP18-119) to play Saint Killingham (OP18-064) from your Trash and prevent up to two opposing Characters from attacking. Then use Cerberus (OP18-085) to give Shamrock Rush and immediately attack a rested Character.", "This combination lets you neutralize several threats while developing your board."] },
  { title: "OP17 Kaido — Survive and Pressure with Banish", leader: kaidoLeader, paragraphs: ["Kaido can neutralize your Characters, restand your Blockers, and apply heavy pressure with his big attacks.", "Play Saint Killingham (OP18-083) + Sleeptids to maintain recurring defense. Do not hesitate to block with Sleeptids; you can replay it from your Trash.", "Saint Gunko (OP18-065) provides an 11000-Power Blocker that is particularly useful for withstanding big attacks.", "With Saint Shamrock + Cerberus, adapt your offense: use Banish to deal damage without giving your opponent new cards, Rush to attack right away or remove a rested Character, and Unblockable to get around Blockers.", "Your goal is to survive Kaido's most dangerous turns while preparing a decisive attack."] }
];

const tips = [
  { title: "Don't Waste Sommers' Effect", cards: [sommers], paragraphs: [
    "**Saint Sommers (OP18-088)** needs at least 6 DON!! on your field to activate its KO effect.",
    "Even if Abyss Pentagram reduces its cost to 5, playing Sommers with only 5 DON!! on your field won't trigger its KO effect. You can still play it earlier to give a Character 6000 Power."
  ]},
  { title: "Discard Cards Wisely", cards: [sleeptids, killinghamBlack], paragraphs: [
    "Your Leader's discard effect lets you put useful targets in your Trash, even when you don't need the extra DON!!.",
    "Prioritize discarding **Sleeptids** when you have a way to play it from your Trash with Black Killingham. Avoid throwing away Counter cards, especially against aggressive decks."
  ]},
  { title: "Know the Difference Between Your Searchers", cards: [zoro, gunkoSearch, eldersEvent], paragraphs: [
    "**Roronoa Zoro (OP17-095)** can't be added to your hand by your Holy Knights or Celestial Dragons Searchers.",
    "**Saint Gunko (OP18-084):** sends the cards you don't choose to your Trash.",
    "**The Five Elders Are at Your Service!!!:** sends the cards you do not choose to your Trash, so be careful not to lose Zoro this way.",
    "Keep this risk in mind before using your Searchers against decks with lots of removal effects."
  ]},
  { title: "Plan Your Turn Before Attacking", cards: [sommers, killinghamPurple, shamrock, cerberus], paragraphs: [
    "Decide whether you need to remove opposing Characters, protect your board, or deal damage before spending your DON!!.",
    "Sometimes it's best to attack first. In other situations, playing **Sommers** to remove a threat, **Purple Killingham** to prevent future attacks, or **Shamrock + Cerberus** to attack right away will be more effective.",
    "Don't follow a fixed attack order. Adapt your plays to your opponent's board and the resources available."
  ]}
];

const renderText = (text) => text.split(/(\*\*.*?\*\*)/g);
---

<MainLayout title={title} description={description}>
  <section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span class="hero-chip">Deck Guide</span><span class="hero-chip hero-chip-accent">OP18 Format</span></div><h1>{title}</h1><p class="hero-intro">{mulliganIntro[0]}</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Game Plan &amp; Curve</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div></div><div class="guide-icon"><img src={guideIcon} alt="Saint Gunko OP18 deck guide icon" loading="eager" /></div></div></section>
  <div class="container article-stack">
    <section id="decklist" class="glow-block"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim={simDeckCode}>Copy for Sim</button></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy"/><div class="deck-info"><b class="deck-count">{entry.count}x</b><span>{entry.name}<small class="deck-code">{entry.code}</small><small class="deck-role">{entry.role}</small></span></div></button>)}</div></section>
    <section id="mulligan" class="glow-block"><h2>Mulligan</h2>{mulliganIntro.map((text) => <p>{text}</p>)}<div class="content-list">{mulligan.map((item) => <article class={`content-item ${item.cards.length ? "has-cards" : "text-only"}`}><h3>{item.title}</h3>{item.cards.length > 0 && <div class="card-row">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy"/></button>)}</div>}<div class="paragraphs">{item.paragraphs.map((text) => <p>{renderText(text).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2,-2)}</strong> : part)}</p>)}</div></article>)}</div></section>
    <section id="curve" class="glow-block"><h2>Curve Guide</h2><p>OP18 Saint Gunko has different development options depending on whether you go first or second. Going first lets you prepare your Trash and play Saint Shamrock on your 7 DON!! turn, while going second lets you play Saint Killingham and Sleeptids as early as your 4 DON!! turn.</p>{[["Going First", curveFirst], ["Going Second", curveSecond]].map(([heading, curve]) => <div class="curve-block"><h3>{heading}</h3>{curve.map((item) => <article class="curve-item"><strong>{item.title}</strong><div class="curve-content"><div class={`card-set ${item.cards.length === 4 ? "four" : ""} ${item.cards.length === 3 ? "three" : ""} ${item.connectors?.length ? "connected" : ""} ${item.optionRows ? "option-rows" : ""}`}>{item.cards.map((entry, index) => <>{index > 0 && item.connectors?.[index - 1] && <span class={`connector ${item.optionRows && item.connectors[index - 1] === "OR" ? "option-break" : ""}`}>{item.connectors[index - 1]}</span>}<button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy"/></button></>)}</div><div class="curve-note">{item.paragraphs.map((text) => <p>{renderText(text).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2,-2)}</strong> : part)}</p>)}</div></div></article>)}</div>)}<p>Going First or Going Second? Going second offers the most explosive opening, with the option to play Saint Killingham from your Trash as early as 4 DON!! and quickly play Sleeptids. Going first favors more gradual preparation, especially with Abyss Pentagram and successive plays from your Trash. In either case, adapt your curve to the situation: play Sleeptids to defend, use Sommers against smaller threats, and prioritize Shamrock when you can start applying pressure.</p></section>
    <section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><div class="content-list">{techCards.map((item) => <article class="tech-card"><button class="mini-card tech-card-image" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={getCardThumbnail(item.card.img)} alt={`${item.card.code} ${item.card.name}`} loading="lazy"/></button><h3>{item.title}</h3><div class="paragraphs">{item.paragraphs.map((text) => <p>{renderText(text).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2,-2)}</strong> : part)}</p>)}</div></article>)}</div></section>
    <section id="matchups" class="glow-block"><h2>Matchups</h2><div class="content-list">{matchups.map((item) => <article class="content-item matchup-card"><div class="matchup-heading"><button class="mini-card matchup-leader-card" type="button" data-card-preview data-full={item.leader.img} data-name={`${item.leader.code} ${item.leader.name}`}><img src={getCardThumbnail(item.leader.img)} alt={`${item.leader.code} ${item.leader.name} Leader`} loading="lazy"/></button><h3>{item.title}</h3></div>{item.paragraphs.map((text) => <p>{text}</p>)}</article>)}</div></section>
    <section id="tips" class="glow-block"><h2>Tips</h2><div class="content-list">{tips.map((item) => <article class="content-item has-cards"><h3>{item.title}</h3><div class="card-row">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy"/></button>)}</div><div class="paragraphs">{item.paragraphs.map((text) => <p>{renderText(text).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</p>)}</div></article>)}</div></section>

  </div>
  <div class="card-modal" data-modal aria-hidden="true"><div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview"><button class="modal-close" type="button" data-close>Close</button><img src="" alt="" data-modal-image/></div></div>
</MainLayout>

<script>
  const modal = document.querySelector("[data-modal]"); const modalImage = document.querySelector("[data-modal-image]");
  const closeModal = () => { modal?.classList.remove("is-open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; };
  document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !modalImage) return; modalImage.src = button.dataset.full || ""; modalImage.alt = button.dataset.name || "Card preview"; modal.classList.add("is-open"); modal.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; }));
  document.querySelector("[data-close]")?.addEventListener("click", closeModal); modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
  document.querySelector("[data-copy-sim]")?.addEventListener("click", async (event) => { const button = event.currentTarget; try { await navigator.clipboard.writeText(button.dataset.copySim); const previous = button.textContent; button.textContent = "Copied"; window.setTimeout(() => { button.textContent = previous; }, 1800); } catch { button.textContent = "Copy failed"; } });
</script>

<style>
