---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail, getOptimizedAssetUrl } from "../../lib/assets";

const title = "Saint Gunko OP18 Deck Guide";
const description = "OP18 Saint Gunko deck guide with decklist, mulligan priorities, going-first and going-second curves, tech cards, and matchups.";
const heroIntro = "Saint Gunko fills the Trash, then revives Holy Knights to develop the board. Searchers and Abyss Pentagram set up those plays. Killingham and Sleeptids defend, while Shamrock and Cerberus add Rush, Banish, or Unblockable.";
const guideIcon = "/assets/guides/Gunko%20OP18.png";
const card = (code, name, file, count = null, role = "Character") => ({ code, name, img: `/Cards/${file}`, count, role });

const leader = card("OP18-060", "Saint Gunko", "OP18/OP18-060 Saint Gunko.jpg", 1, "Leader");
const gunkoSearch = card("OP18-084", "Saint Gunko", "OP18/OP18-084 Gunko.jpg", 4);
const cerberus = card("OP18-085", "Cerberus", "OP18/OP18-085 Cerberus.jpg", 3);
const sugar = card("EB05-034", "Sugar", "EB05/EB05-034 Sugar.jpg", 2);
const zoro = card("OP17-095", "Roronoa Zoro", "OP17/New OP17/OP17-095.jpg", 3);
const warcury = card("OP13-089", "St. Topman Warcury", "OP13/OP13-089.jpg", 1);
const killinghamPurple = card("OP18-064", "Saint Killingham", "OP18/OP18-064 Saint Killingham.jpg", 4);
const killinghamBlack = card("OP18-083", "Saint Killingham", "OP18/OP18-083 Saint Killingham.jpg", 4);
const mars = card("OP13-091", "St. Marcus Mars", "OP13/OP13-091.jpg", 1);
const sommers = card("OP18-088", "Saint Sommers", "OP18/OP18-088 Saint Sommers .jpg", 2);
const shamrock = card("OP18-119", "Saint Shamrock", "OP18/OP18-119 Saint Shamrock.jpg", 4);
const sleeptids = card("OP18-093", "Sleeptids", "OP18/OP18-093 Sleeptids.jpg", 5);
const gunkoBig = card("OP18-065", "Saint Gunko", "OP18/OP18-065 Saint Gunko.jpg", 3);
const mamaragan = card("OP15-078", "Mamaragan", "OP15/OP15-078.jpg", 3, "Event");
const eldersEvent = card("OP13-096", "The Five Elders Are at Your Service!!!", "OP13/OP13-096.jpg", 4, "Event");
const callEvent = card("OP18-096", "I'll Make the Call", "OP18/OP18-096 I'll Summon Them.jpg", 4, "Event");
const abyss = card("OP18-097", "Abyss Pentagram", "OP18/OP18-097 Abyss.jpg", 4, "Stage");
const lateEvent = card("OP18-095", "I'm Late, I'm Very Late!!", "OP18/OP18-095 I will Be Late!!! I Won't Make It!.jpg", null, "Event");
const groundDeath = card("OP14-096", "Ground Death", "OP14/OP14-096.jpg", null, "Event");
const lightningDragon = card("OP15-077", "Lightning Dragon", "OP15/OP15-077.jpg", null, "Event");
const luffyOp05 = card("OP05-119", "Monkey.D.Luffy", "OP05/OP05-119.png", null, "Character");
const yamatoEb05 = card("EB05-046", "Yamato", "EB05/EB05-046 Yamato.jpg", null, "Character");
const usohachi = card("ST18-001", "Usohachi", "ST18/ST18-001.png", null, "Character");
const slowSlowBeamSword = card("OP07-076", "Slow-Slow Beam Sword", "OP07/OP07-076.png", null, "Event");
const spandamLeader = card("OP18-079", "Spandam", "OP18/OP18-079 Spandam.jpg", null, "Leader");
const sundayLeader = card("OP18-041", "Ms. All Sunday", "OP18/OP18-041 Ms. All Sunday.jpg", null, "Leader");
const kaidoLeader = card("OP17-058", "Kaido", "OP17/New OP17/OP17-058.jpg", null, "Leader");
const rocksLeader = card("OP17-039", "Rocks D. Xebec", "OP17/New OP17/OP17-039.jpg", null, "Leader");
const saboLeader = card("OP13-004", "Sabo", "OP13/OP13-004.jpg", null, "Leader");
const redLawLeader = card("OP14-001", "Trafalgar Law", "OP14/OP14-001.jpg", null, "Leader");
const buggyLeader = card("OP09-042", "Buggy", "OP09/OP09-042.jpg", null, "Leader");
const robinLeader = card("EB05-010", "Nico Robin", "EB05/EB05-010 Nico Robin .jpg", null, "Leader");
const luffyOp18Leader = card("OP18-022", "Monkey D. Luffy", "OP18/OP18-022 Monkey.D.Luffy.jpg", null, "Leader");

const decklist = [leader, gunkoSearch, cerberus, sugar, zoro, warcury, killinghamPurple, killinghamBlack, sommers, shamrock, sleeptids, gunkoBig, mamaragan, eldersEvent, callEvent, abyss];
const simDeckCode = decklist.flatMap((entry) => { const lines = []; let remaining = entry.count; while (remaining > 4) { lines.push(`4x${entry.code}`); remaining -= 4; } if (remaining > 0) lines.push(`${remaining}x${entry.code}`); return lines; }).join("\n");

const mulliganIntro = [
  "Your opening hand with Saint Gunko (OP18-060) should prioritize cards that quickly prepare your Trash and let you play your first Holy Knights of God from it."
];
const mulligan = [
  { title: "OP18-084 Saint Gunko — Your Top Priority", cards: [gunkoSearch], paragraphs: [
    "Saint Gunko is the most important card to have in your opening hand. Its On Play effect lets you look at the top four cards of your deck, add a Holy Knights of God card to your hand, and send the rest to your Trash.",
    "It is also your main way to play Holy Knights of God Characters with a Cost of 6 or less from your Trash: rest 4 DON!! to activate its Activate: Main effect. Saint Gunko does not rest itself when you use this effect, so it does not become a target that can be attacked during the Battle Phase, and you can use the effect again on your next turn. The effect is also not Once Per Turn, so when you have enough DON!!, you can technically use it twice in one turn. There is often something better to do with 8 DON!!, but it remains an option."
  ]},
  { title: "OP18-097 Abyss Pentagram — An Excellent Opening Card", cards: [abyss], paragraphs: [
    "The Stage is your second priority. It reduces the Cost by 1 of Holy Knights of God and Five Elders Characters with a Cost of 2 or more played from your hand.",
    "This reduction makes your DON!! curve easier and lets you keep more resources to use Cerberus or attack opposing Characters.",
    "Its On Play effect also lets you draw a card and send the top two cards of your deck to your Trash. This is very useful for OP18-084 Saint Gunko's Activate: Main effect, since you may have more Holy Knights of God Characters to choose from in your Trash."
  ]},
  { title: "Cards to Set Up in Your Trash", cards: [sleeptids, killinghamBlack, killinghamPurple, sommers], paragraphs: [
    "OP18-093 Sleeptids is a Blocker that you want to send to your Trash quickly rather than keep to play normally.",
    "OP18-083 Saint Killingham is generally your best first target to play from your Trash. Its On Play effect can then play Sleeptids from your Trash, developing your board and triggering your Leader's draw effect.",
    "Other options depend more on the situation. OP18-064 Saint Killingham is useful when you need to stop opposing Characters from attacking. OP18-088 Saint Sommers becomes interesting when the opposing board has targets with a Cost of 4 or less and you have at least 6 DON!! on your field."
  ]},
  { title: "Which Hand Should You Keep?", cards: [gunkoSearch, abyss], paragraphs: [
    "Look first for the Saint Gunko Searcher, ideally alongside Abyss Pentagram.",
    "You do not need to assemble every piece right away. The main thing is to be able to fill your Trash and prepare a first play of black Saint Killingham, followed by Sleeptids.",
    "Priority: Saint Gunko Searcher → Abyss Pentagram → prepare black Saint Killingham and Sleeptids in your Trash."
  ]}
];

const curveFirst = [
  { title: "1 DON!! — Saint Gunko or Abyss Pentagram", cards: [gunkoSearch, abyss], connectors: ["+"], paragraphs: ["Play OP18-084 Saint Gunko to search for a Holy Knight of God and fill your Trash, or OP18-097 Abyss Pentagram to draw and prepare your curve."] },
  { title: "3 DON!! — Prepare Your Trash", cards: [gunkoSearch, eldersEvent, abyss], connectors: ["+", "+"], paragraphs: ["Keep searching for cards with Saint Gunko or The Five Elders Are at Your Service!!!, and play Abyss Pentagram if you did not play it on turn 1.", "The goal is to send OP18-083 Saint Killingham and OP18-093 Sleeptids to your Trash so you can play them from there on your next turn, either by using them as Counter or by using your Leader effect to trash a card from your hand."] },
  { title: "5 DON!! — Black Saint Killingham + Sleeptids", cards: [killinghamBlack, sleeptids], connectors: ["+"], paragraphs: ["Use your Saint Gunko Searcher's effect, resting 4 DON!!, to play black Saint Killingham from your Trash. Its On Play effect then lets you play your Sleeptids Blocker from your Trash.", "Since you played a Character from your Trash, your Leader effect lets you draw two cards, then trash one.", "If Saint Gunko Searcher is not on your board yet and you have it in your hand, you can play it for 1 DON!! and immediately use its effect with the 4 DON!! you have left.", "Two interactions can get you out of a difficult hand:", "If Sleeptids is not in your Trash, resolve your Leader effect first after playing black Saint Killingham. If you draw Sleeptids, you can send it to your Trash before resolving black Saint Killingham's On Play effect.", "If Saint Killingham is in your hand, use your Leader effect to send it to your Trash before playing it with the Searcher. You can still discard it even without a Character with 8000 Power on your board, but you will not add a DON!!."] },
  { title: "7 DON!! — Saint Shamrock + Cerberus", cards: [shamrock, cerberus], connectors: ["+"], paragraphs: ["With Abyss Pentagram, OP18-119 Saint Shamrock costs 7 DON!! instead of 8.", "Once Shamrock is on your board, use your Leader effect to send a card to your Trash and add 1 active DON!!. Shamrock's base 9000 Power meets the Leader effect's condition for ramping.", "Use that DON!! to play OP18-085 Cerberus, then return Cerberus to your hand to give Shamrock Rush. You can attack immediately with its 9000 Power.", "Also activate Shamrock's effect to play a Holy Knight of God with a Cost of 6 or less from your Trash without spending any additional DON!!.", "Your Leader's ramp takes you from 7 to 8 DON!! total, setting up your next turn."] },
  { title: "10 DON!! — Saint Gunko Options", cards: [gunkoBig, killinghamBlack, sleeptids, gunkoBig, killinghamPurple, gunkoBig, sommers, gunkoBig, warcury], cardGroups: [[gunkoBig, killinghamBlack, sleeptids], [gunkoBig, killinghamPurple], [gunkoBig, sommers], [gunkoBig, warcury]], paragraphs: ["If you ramped on the previous turn, you reach 10 DON!! on this turn.", "Play OP18-065 Saint Gunko, an 11000-Power Blocker. Its On Play effect, with DON!! −1, lets you play a Celestial Dragons Character with 6000 Power or less from your Trash.", "Your options include OP18-083 Saint Killingham to play Sleeptids from your Trash for another Blocker; OP18-064 Saint Killingham to stop opposing Characters from attacking during their next turn; OP18-088 Saint Sommers to K.O. an opposing Character with a base Cost of 4 or less; or OP13-089 St. Topman Warcury to play another Blocker that lets you draw when you block with it."] }
];
const curveSecond = [
  { title: "2 DON!! — Set Up Your Engine", cards: [gunkoSearch, abyss], connectors: ["+"], paragraphs: ["Play Saint Gunko Searcher and Abyss Pentagram. Prepare black Saint Killingham and Sleeptids in your Trash for your next turn."] },
  { title: "4 DON!! — First Play from Your Trash", cards: [killinghamBlack, sleeptids], connectors: ["→"], paragraphs: ["If Saint Gunko is already on the field, rest your 4 DON!! to play black Saint Killingham, then Sleeptids from your Trash.", "Without the Searcher, OP18-096 I'll Make the Call can also play a Holy Knight of God with a Cost of 6 or less from your Trash for a total of 4 DON!!: 1 for the Event and 3 to rest.", "In either case, playing from your Trash triggers your Leader's draw effect."] },
  { title: "6 DON!! — Develop Your Board", cards: [killinghamBlack, killinghamPurple, sommers], connectors: ["OR", "OR"], paragraphs: ["Keep using Saint Gunko or I'll Make the Call to play your Characters from your Trash.", "Prioritize black Saint Killingham to play a Blocker, purple Saint Killingham to stop opposing attacks, or Saint Sommers to K.O. a Character with a base Cost of 4 or less."] },
  { title: "8 DON!! — Saint Shamrock + Cerberus", cards: [shamrock, cerberus], connectors: ["→"], paragraphs: ["Play Saint Shamrock for 8 DON!!, or 7 with Abyss Pentagram.", "With the Stage, you keep 1 DON!! for Cerberus and can give Shamrock Rush immediately.", "Then use Shamrock's effect to play a Holy Knight of God from your Trash. You can also activate your Leader's ramp effect because Shamrock has 9000 base Power, but this is not necessary to play Cerberus if you already have the Stage.", "After ramping with your Leader, you can use Cerberus on Shamrock again to give it Banish or Unblockable in addition to Rush, depending on the situation."] },
  { title: "10 DON!! — Saint Gunko or Two Saint Killinghams", cards: [gunkoBig, killinghamPurple], connectors: ["OR"], cardSuffixes: [null, "X2"], paragraphs: ["The standard curve is to play Saint Gunko at 10 DON!! and use its effect to bring a Character back from your Trash.", "However, against aggressive decks such as Red Law, Ms. All Sunday, or Green/Yellow Robin, playing two purple Saint Killinghams instead of Saint Gunko may be better.", "This lets you stop more opposing Characters from attacking and better control their board."] },
  { title: "Alternative at 10 DON!! — Sugar + Saint Gunko", cards: [sugar, gunkoBig, killinghamBlack, sommers, warcury], connectors: ["+", "+", "OR", "OR"], paragraphs: ["If you want to get rid of a dangerous opposing Character, you can use the following sequence.", "With Abyss Pentagram and a Character with at least 8000 base Power on your field, you can combine EB05-034 Sugar and Saint Gunko in the same turn.", "With 10 active DON!!, play Sugar for 2 DON!!. You have 8 active DON!! and 2 rested DON!! remaining.", "Activate Sugar's On Play effect with DON!! −2, returning the 2 rested DON!! to your DON!! deck. You keep your 8 active DON!! and can give an opposing Character −4000 Power.", "Activate your Leader effect: send a card from your hand to your Trash to add 1 active DON!!. You now have 9 active DON!!.", "With Abyss Pentagram, play Saint Gunko for 9 DON!! instead of 10.", "Use its DON!! −1 effect to play Saint Killingham, Saint Sommers, or Warcury from your Trash.", "This sequence lets you reduce an opposing Character's Power before attacking it while playing Saint Gunko and another Character to your board.", "It requires you to keep the 8 active DON!! after Sugar's effect, have Abyss Pentagram in play, and be able to activate your Leader's ramp effect."] }
];

const techCards = [
  { card: cerberus, title: "3x OP18-085 Cerberus", paragraphs: ["Cerberus is a 2000 Counter that lets you give Rush, Banish, or Unblockable to Saint Shamrock.", "Rush lets you attack right away after playing Shamrock, Banish is especially useful against decks that recover Life and play around Trigger, such as OP18 Spandam, and Unblockable lets you get past opposing Blockers to finish a game.", "Cerberus returns to your hand after activation. You can therefore replay it to give Shamrock multiple effects, as long as you have active DON!! available.", "Three copies are a good balance: the card should be accessible without taking up too much space in the deck."] },
  { card: sleeptids, title: "5x OP18-093 Sleeptids", paragraphs: ["Sleeptids is a Blocker with a 2000 Counter, mainly intended to be played from your Trash with OP18-083 Saint Killingham.", "Its 9 DON!! Cost makes playing it from your hand unattractive. You want to send it to your Trash quickly to use black Saint Killingham's effect.", "You can include more than four copies of Sleeptids. Five is intentional: four copies do not put it in your Trash often enough, while six take up too much space."] },
  { card: sommers, title: "2x OP18-088 Saint Sommers", paragraphs: ["Saint Sommers is a situational target to play from your Trash. With at least 6 DON!! on your field, its On Play effect can K.O. an opposing Character with a base Cost of 4 or less.", "It is especially useful against Elbaf decks to remove Ripley or Jaguar D. Saul.", "Its 2000 Counter makes it useful even when its effect has no good target. It can also return from your Trash after being K.O.'d, but this requires you to send two cards from your hand to your Trash, which is a significant cost."] },
  { card: warcury, title: "1x OP13-089 St. Topman Warcury", paragraphs: ["Warcury is an additional target for Saint Gunko's effect at 10 DON!!.", "With at least seven cards in your Trash, it gains Blocker and cannot be removed from the field by opposing effects. Its On K.O. effect also lets you draw one card.", "It is especially useful when your board is starting to run out of space. Unlike black Saint Killingham, who will play Sleeptids, Warcury only takes up one space.", "Note: Warcury is not a Holy Knights of God Character. Saint Gunko Searcher and Saint Shamrock cannot play it from your Trash."] },
  { card: zoro, title: "3x OP17-095 Roronoa Zoro", paragraphs: ["Zoro protects your Characters from opposing effects that remove them from the field without K.O.'ing them.", "When one of your Characters would leave the field because of an opposing effect, you can place three cards from your Trash under your deck to prevent it from leaving.", "This anti-removal effect is especially useful against Spandam, Buggy, Ms. All Sunday, and Rocks. Your On K.O. effects do not work against this kind of removal, so Zoro lets you keep your board against answers to which the deck is otherwise vulnerable.", "Its 2000 Counter also adds to its value. If you face few decks with these effects, you can replace its three slots with other utility cards.", "One point to note: your Searchers cannot find Zoro, and you cannot play it from your Trash."] },
  { card: sugar, title: "2x EB05-034 Sugar", paragraphs: ["Sugar is a more personal choice in this decklist.", "With at least 7 DON!! on your field, its On Play effect can give an opposing Character −4000 Power for the turn, with DON!! −2.", "This reduction can help your purple Saint Killingham stop attacks from Characters it normally could not prevent from attacking.", "Sugar also has a 2000 Counter and can be combined with Saint Gunko at 10 DON!! thanks to Abyss Pentagram and your Leader's ramp, as explained in the Curve Guide.", "If you do not need this Power reduction, Sugar is one of the cards you can cut."] },
  { card: mamaragan, title: "3x OP15-078 Mamaragan", paragraphs: ["Mamaragan is a 0 DON!! Event that lets you draw one card and rest an opposing Character with 5000 Power or less, with DON!! −2.", "It is especially useful for resting a small Blocker or a Character such as Ripley so you can attack it with your Characters.", "As a Counter, it gives +1000 Power and also lets you draw one card when you have 6 DON!! or less on your field.", "Its value depends on the opposing board. If the decks you face have few useful targets to rest, you can reduce the number of copies."] },
  { card: callEvent, title: "4x OP18-096 I'll Make the Call", paragraphs: ["I'll Make the Call lets you play a Holy Knights of God Character with a Cost of 6 or less from your Trash for a total of 4 DON!!: 1 to play the Event and 3 to rest.", "It serves as an alternative to Saint Gunko Searcher when you do not have it in your hand.", "Its Counter effect is useful later in the game: with at least 10 cards in your Trash, a very easy condition to meet, it gives your Leader or a Character +4000 Power during the battle."] },
  { card: eldersEvent, title: "4x OP13-096 The Five Elders Are at Your Service!!!", paragraphs: ["This Event looks at the top three cards of your deck, adds a Celestial Dragons card to your hand, and sends the rest to your Trash.", "I'm Late, I'm Very Late!! (OP18-095) looks at more cards, while The Five Elders Are at Your Service!!! is preferred for its ability to fill your Trash.", "Together with your four Saint Gunko Searchers, it gives you eight search cards in your deck."] },
  { card: abyss, title: "4x OP18-097 Abyss Pentagram", paragraphs: ["Abyss Pentagram reduces by 1 the Cost of Holy Knights of God and Five Elders Characters with a Cost of 2 or more when you play them from your hand.", "This reduction does not apply to Characters played from your Trash.", "The Stage helps you play Saint Killingham for 4 DON!!, Saint Sommers for 5, Saint Shamrock for 7, and Saint Gunko for 9.", "Four copies help you find it regularly in the early game. Extra copies can then be sent to your Trash with your Leader's effect."] },
  { card: lateEvent, title: "I'm Late! I'm Very Late!", paragraphs: ["An alternative to The Five Elders Are at Your Service!!! that looks at the top five cards of your deck to find a Holy Knights of God Character or Sleeptids.", "It lets you search deeper, but does not send the remaining cards to your Trash.", "The choice depends on your priority: improve your search or fill your Trash more."] },
  { card: mars, title: "Saint Mars", paragraphs: ["An alternative to Warcury that is also interesting to play with Saint Gunko at 10 DON!!.", "Saint Mars is a Blocker with protection from opposing effects. Its On Play effect lets you send a card from your hand to your Trash to K.O. an opposing Character with a base Cost of 5 or less.", "It can be especially useful against Elbaf decks."] },
  { card: lightningDragon, title: "Lightning Dragon", paragraphs: ["A 0 DON!! Event that lets you draw one card and prevent a rested opposing Character with 6000 Power from becoming Active again, with DON!! −1.", "It is especially useful in the mirror matchup to keep an opposing Saint Killingham rested.", "Its value is more limited against decks such as Rocks or Buggy, which have fewer suitable targets."] },
  { card: slowSlowBeamSword, title: "Slow-Slow Beam Sword", paragraphs: ["A defensive Event that gives +2000 Power during a battle and lets you rest an opposing Character, with DON!! −1.", "It can defend an attack while also preventing another Character from attacking during the same turn.", "Consider it if you want to strengthen the deck's defensive options."] },
  { card: groundDeath, title: "Ground Death", paragraphs: ["Ground Death can provide a +4000 Counter when its Trash condition is met.", "Its Main effect can neutralize the effects of an opposing Character with a Cost of 5 or less during the turn.", "It can answer a Blocker or a troublesome effect, although Cerberus already offers a way to get past Blockers with Unblockable."] },
  { card: luffyOp05, title: "OP05-119 Monkey.D.Luffy", paragraphs: ["A more experimental late-game option.", "Its effect lets you take an extra turn with DON!! −10 and by returning your other Characters to the bottom of your deck.", "The idea is to use your board's attacks before playing Luffy, then use the extra turn to finish the game.", "This option remains very situational and is not part of the main game plan."] },
  { card: yamatoEb05, title: "EB05 Yamato", paragraphs: ["A defensive option that can give your Leader 7000 base Power when your Trash has at least 10 cards.", "Yamato can also become an 8000-Power Blocker if your opponent has a Character with at least 8000 base Power.", "It is less necessary in a deck that already has several Blockers thanks to Saint Gunko, Topman Warcury, and Sleeptids."] },
  { card: usohachi, title: "Usohachi", paragraphs: ["An additional 2000 Counter that can rest opposing Blockers.", "It can take one of the flexible slots if you want more answers to defensive boards."] },
  { card: null, title: "Flexible Slots", paragraphs: ["The most flexible slots in this decklist are Zoro, Sugar, and Mamaragan.", "These changes let you add other utility cards or 2000 Counters for your matchups while keeping the deck's main engine."], bullets: ["Zoro: reduce the count if removal effects are uncommon in the metagame.", "Sugar: cut it if the Power reduction is not useful enough.", "Mamaragan: reduce the count if you face few Characters worth resting."] }
];

const matchupGroups = [
  { title: "Favorable Matchups", items: [
    { title: "OP18 Spandam", leader: spandamLeader, rating: "Favorable", ratingTone: "favorable", paragraphs: ["Spandam is a favorable matchup, but his effects that return your Characters to the bottom of the deck require careful play.", "OP17-095 Roronoa Zoro is important for protecting your board from these effects, especially those from opposing Triggers.", "Prioritize OP18-064 Saint Killingham when you need to stop a Character such as Khalifa from attacking. Depending on the situation, this may be more useful than black Saint Killingham and its Sleeptids.", "Saint Shamrock with Banish can also maintain pressure against effects that recover Life."] },
    { title: "OP14 Red Law", leader: redLawLeader, rating: "Favorable", ratingTone: "favorable", paragraphs: ["Red Law is a fairly favorable matchup when your curve goes to plan.", "Purple Saint Killingham is especially effective against Bonney and Urouge. Its effect lets you stop them from attacking, reducing the pressure from the opposing board.", "You can regularly play purple Saint Killingham from your Trash to keep several attackers under control.", "Saint Shamrock with Rush also applies pressure while playing another Holy Knight of God.", "Against a board full of small Characters, playing several purple Saint Killinghams may be more effective than playing Saint Gunko at 10 DON!!."] },
    { title: "OP17 Kaido — Survive and Pressure with Banish", leader: kaidoLeader, rating: "Favorable", ratingTone: "favorable", paragraphs: ["Kaido can neutralize your Characters, restand your Blockers, and apply heavy pressure with his big attacks.", "Play Saint Killingham (OP18-083) + Sleeptids to maintain recurring defense. Do not hesitate to block with Sleeptids; you can replay it from your Trash.", "Saint Gunko (OP18-065) provides an 11000-Power Blocker that is particularly useful for withstanding big attacks.", "With Saint Shamrock + Cerberus, adapt your offense: use Banish to deal damage without giving your opponent new cards, Rush to attack right away or remove a rested Character, and Unblockable to get around Blockers.", "Your goal is to survive Kaido's most dangerous turns while preparing a decisive attack."] }
  ]},
  { title: "Even / Slightly Favorable Matchups", items: [
    { title: "OP17 Rocks", leader: rocksLeader, rating: "Slightly Favorable", ratingTone: "slightly-favorable", paragraphs: ["The matchup against Rocks is close, with a slight advantage for Saint Gunko.", "Roronoa Zoro is especially useful against effects that remove your Characters without K.O.'ing them, including Gloriosa's effects.", "This protection lets you keep your Characters on the field instead of losing them to effects that bypass their On K.O. abilities."] },
    { title: "OP13 Sabo", leader: saboLeader, rating: "Slightly Favorable", ratingTone: "slightly-favorable", paragraphs: ["The matchup against Sabo depends a lot on your curve and your ability to manage its board.", "Against Elbaf Characters, Mamaragan can rest Ripley so Saint Shamrock with Rush can attack and remove it, or so your other Characters can attack it.", "You can then use your other Characters' attacks to remove opposing Characters while they are rested.", "Saint Sommers is another possible answer to some targets with a Cost of 4 or less, but it is not essential if you can already clear the board through battle.", "Later in the game, purple Saint Killingham can prevent Characters such as Pirates Docking from attacking during the next opposing turn."] }
  ]},
  { title: "Unfavorable Matchups", items: [
    { title: "OP18 Miss All Sunday", leader: sundayLeader, rating: "Unfavorable", ratingTone: "unfavorable", paragraphs: ["Miss All Sunday is a difficult matchup because of her aggression.", "She can put Saint Gunko under pressure too quickly, before its plays from the Trash and Blockers can stabilize the game.", "In most cases, avoid K.O.'ing her board because of her Leader effect. Purple Saint Killingham is your best card against this deck because it prevents Characters from attacking."] },
    { title: "OP09 Buggy", leader: buggyLeader, rating: "Unfavorable", ratingTone: "unfavorable", paragraphs: ["Buggy is especially difficult for two reasons: its effects return your Characters to the bottom of the deck, and it can regularly play two Characters with 7000 Power.", "Saint Killingham's On K.O. effects do not activate when a Character is returned to the bottom of the deck.", "You absolutely need to go first.", "Roronoa Zoro can protect your Characters from this kind of removal, but Buggy's constant pressure remains difficult to contain."] },
    { title: "OP18 Green Luffy", leader: luffyOp18Leader, rating: "Unfavorable", ratingTone: "unfavorable", paragraphs: ["Green Luffy can focus its attacks directly on your Leader and apply heavy pressure.", "This matchup remains unfavorable despite Saint Gunko's defensive options."] },
    { title: "EB05 Green/Yellow Robin", leader: robinLeader, rating: "Unfavorable", ratingTone: "unfavorable", paragraphs: ["Green/Yellow Robin is another difficult matchup because of its aggression. Saint Gunko can struggle to survive long enough to regain control of the board.", "In this matchup, it may be better to play two OP18-064 Saint Killinghams instead of Saint Gunko at 10 DON!!. This lets you stop more opposing Characters from attacking and limit the damage you take on the next turn."] }
  ]}
];
const matchupReevaluation = [
  "The old Red/Green Luffy statistics should not be used to evaluate this matchup after the banlist.",
  "The data still includes games played with the 5 DON!! Bonney package.",
