---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Sabo OP13 Deck Guide OP17: Decklist, Mulligan & Curve";
const description = "Master Sabo OP13 in OP17 with the Elbaf Straw Hat decklist, mulligan priorities, curve guide, tech cards, matchup spread, and gameplay tips.";
const icon = "/assets/guides/Sabo%20OP13-004.png";
const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });
const expandSimLines = (count, code) => { const lines = []; let remaining = count; while (remaining > 4) { lines.push(`4x${code}`); remaining -= 4; } if (remaining) lines.push(`${remaining}x${code}`); return lines; };

const leader = card("OP13-004", "Sabo", "/Cards/OP13/OP13-004.jpg", 1, "Leader");
const nami01 = card("OP01-016", "Nami", "/Cards/OP01/OP01-016.png", 4);
const chopper = card("OP17-084", "Tony Tony Chopper", "/Cards/OP17/New OP17/OP17-084.jpg", 2);
const nami17 = card("OP17-086", "Nami", "/Cards/OP17/New OP17/OP17-086.jpg", 4);
const usopp = card("OP17-080", "Usopp", "/Cards/OP17/New OP17/OP17-080.jpg", 4);
const jinbe = card("OP17-083", "Jinbe", "/Cards/OP17/New OP17/OP17-083.jpg", 2);
const robin = card("OP17-087", "Nico Robin", "/Cards/OP17/New OP17/OP17-087.jpg", 4);
const zoro = card("OP17-095", "Roronoa Zoro", "/Cards/OP17/New OP17/OP17-095.jpg", 4);
const brook = card("ST01-011", "Brook", "/Cards/ST01/ST01-011.png", 4);
const franky = card("OP11-012", "Franky", "/Cards/OP11/OP11-012.jpg", 2);
const saul = card("OP17-089", "Jaguar D. Saul", "/Cards/OP17/New OP17/OP17-089.jpg", 4);
const docking = card("OP15-088", "Pirates Docking Six", "/Cards/OP15/OP15-088.jpg", 4);
const loki = card("OP17-119", "Loki", "/Cards/OP17/New OP17/OP17-119.jpg", 4);
const luffy = card("OP17-093", "Monkey D. Luffy", "/Cards/OP17/New OP17/OP17-093.jpg", 4);
const badManners = card("OP04-016", "Bad Manners Kick Course", "/Cards/OP04/OP04-016.png", 2, "Event");
const kongGun = card("OP17-098", "Gum-Gum Kong Gun", "/Cards/OP17/New OP17/OP17-098.jpg", 2, "Event");
const gerd = card("OP17-081", "Gerd", "/Cards/OP17/New OP17/OP17-081.jpg");
const imLuffy = card("OP17-096", "I'm Luffy! The Man Who Will Become the King of the Pirates!", "/Cards/OP17/New OP17/OP17-096.jpg", null, "Event");
const zoroEb04 = card("EB04-007", "Roronoa Zoro", "/Cards/EB04/EB04-007.jpg");
const sanji17 = card("OP17-082", "Sanji", "/Cards/OP17/New OP17/OP17-082.jpg");
const sanjiSt21 = card("ST21-003", "Sanji", "/Cards/ST21/ST21-003.jpg");
const brook17 = card("OP17-091", "Brook", "/Cards/OP17/New OP17/OP17-091.jpg");
const mihawk = card("OP14-020", "Dracule Mihawk OP14", "/assets/guides/dracule-mihawk-op14.png");
const robin09 = card("OP09-062", "Nico Robin OP09", "/assets/guides/Nico-Robin-op09.png");
const luffyAce = card("ST30-001", "Luffy and Ace ST30", "/assets/guides/Luffy-st30.png");
const enel = card("OP15-058", "Enel OP15", "/assets/guides/enel-op15.png");
const rocks = card("OP17-039", "Rocks D. Xebec OP17", "/assets/guides/Rocks.DXebec%20op17.png");
const kaido = card("OP17-058", "Kaido OP17", "/assets/guides/Kaido%20op17.png");
const luffy17 = card("OP17-079", "Monkey D. Luffy OP17", "/assets/guides/Monkey.D.Luffy%20op17.png");
const boa = card("OP14-041", "Boa Hancock OP14", "/assets/guides/boa-hancock-op14.png");
const ace = card("OP16-001", "Portgas D. Ace OP16", "/assets/guides/Ace-op16.png");
const newgate = card("OP17-005", "Edward.Newgate", "/Cards/OP17/New OP17/OP17-005.jpg");
const luffy13 = card("OP13-001", "Monkey D. Luffy OP13", "/assets/guides/monkey-d-luffy-op13.png");

const decklist = [leader, nami01, chopper, nami17, usopp, jinbe, robin, zoro, brook, franky, saul, docking, loki, luffy, badManners, kongGun];
const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");
const priorityKeeps = [
	{ title: "Usopp OP17-080", cards: [usopp], text: "Usopp is one of your best openers. For 2 DON!!, he looks at the top three cards, starts developing your board, and can find another Usopp. Once a 12-cost or higher Character is in play, he also becomes a 5000-Power attacker." },
	{ title: "Jaguar D. Saul OP17-089", cards: [saul], text: "Saul looks at the top three cards while being a 12-cost Giant himself. That turns on both Sabo's Leader effect and the +3000 Power bonus for your 2-cost Elbaf Straw Hats." },
	{ title: "Roronoa Zoro OP17-095", cards: [zoro], text: "Zoro is excellent after your searchers. He is a 2000 Counter and protects your wide board from removal by returning three cards from your trash to the bottom of your deck." },
];
const goodKeeps = [
	{ title: "Nami OP01-016 and Nami OP17-086", cards: [nami01, nami17], text: "OP01 Nami searches on the first turn, while OP17 Nami trashes an Elbaf card to draw two. The newer Nami is especially useful when a hand contains too many cards without Counter." },
	{ title: "Nico Robin OP17-087", cards: [robin], text: "Robin can be a priority in matchups where her -3000 Power effect immediately puts an opposing Character in range of your board." },
];
const firstCurve = [
	{ label: "1 DON!! — Nami", cards: [nami01, nami17], mode: "OR", text: "Start with either Nami. OP01-016 searches a card, while OP17-086 can trash an Elbaf card to draw two and clean up your hand." },
	{ label: "3 DON!! — Usopp", cards: [usopp], text: "Play Usopp to keep searching for your pieces. Use the remaining DON!! on the Leader when a 5000-Power attack matters." },
	{ label: "5 DON!! — Jaguar D. Saul or Pirates Docking Six", cards: [saul, docking], mode: "OR", text: "Saul searches again and establishes your 12-cost Giant, then your final DON!! can activate Sabo. Docking Six is the alternative when replaying a 2-cost from trash develops a stronger board, even though you give up the Leader activation." },
	{ label: "7 DON!! — Loki or Pirates Docking Six + Robin", cards: [loki, docking, robin], connectors: ["OR", "+"], text: "Loki costs 6 DON!!, can K.O. opposing Characters with a combined cost of 4 or less, and is another 12-cost-or-higher Character. Docking Six plus a 2-cost is the other line; Robin is especially strong when her -3000 Power lets your established board remove a Character." },
	{ label: "9 DON!! — Monkey D. Luffy + Nico Robin", cards: [luffy, robin], mode: "+", text: "Play Luffy, then bring back Robin from trash. With a 12-cost Giant in play, Luffy has Rush; Robin lowers a target by 3000 Power and Luffy can immediately attack it. You still have 1 DON!! for Sabo." },
];
const secondCurve = [
	{ label: "2 DON!! — Nami + Nami OP17 or Usopp", cards: [nami01, nami17, usopp], connectors: ["+", "OR"], text: "Use Nami OP01 followed by Nami OP17, or play Usopp, to shape your hand and establish the early board." },
	{ label: "4 DON!! — Jaguar D. Saul or two 2-costs", cards: [saul, usopp, zoro], connectors: ["OR", "+"], text: "Saul gives you a Giant and another search, but leaves no DON!! for Sabo, so the Leader remains at 4000 Power while you are at 4 Life or more. Alternatively, play two 2-costs such as Usopp plus Zoro to build wide and prepare protection." },
	{ label: "6 DON!! — Saul, Pirates Docking Six, or Loki", cards: [saul, docking, loki], connectors: ["OR", "OR"], text: "Saul plus 2 DON!! on your Leader establishes a Giant and a stronger Sabo. Docking Six plus 1 DON!! on Sabo and a 2-cost from trash is another line. Loki is best when removing an opposing 4-cost brings real value; otherwise, keeping DON!! for Sabo is often safer." },
	{ label: "8 DON!! — Monkey D. Luffy + Brook", cards: [luffy, brook], mode: "+", text: "With a 12-cost Giant already in play, Luffy gains Rush. Bring back Brook ST01-011 from trash, then use Brook to place two rested DON!! on Sabo. You activate the Leader despite spending all 8 DON!! and create a 9000-Power Rush attack." },
	{ label: "10 DON!! — Monkey D. Luffy + Nico Robin", cards: [luffy, robin], mode: "+", text: "This is the primary late-game sequence: Robin lowers a Character by 3000 Power, Luffy attacks immediately with Rush, and your earlier board keeps applying pressure." },
	{ label: "Alternative at 8 DON!! — Gum-Gum Kong Gun", cards: [kongGun], text: "When your board is already ahead and the opponent has two important Characters that cost 6 or less, spend 7 DON!! on Kong Gun and keep 1 DON!! for Sabo. With little or no board, committing nearly all of your DON!! to removal is far less rewarding." },
];
const techCards = [
	{ card: franky, title: "Franky OP11-012", text: "Franky is primarily a choice against Event-heavy decks such as Mihawk, Purple Enel, and Rocks. When the opponent uses an Event, he gives your whole board +2000 Power, sharply increasing the pressure from your next attacks. He is flexible rather than essential." },
	{ card: chopper, title: "Tony Tony Chopper OP17-084", text: "Chopper becomes unblockable while you control a 12-cost-or-higher Character. He is particularly dangerous at 0 Life, and Luffy can replay him from the trash without requiring you to keep him in hand." },
	{ card: kongGun, title: "Gum-Gum Kong Gun OP17-098", text: "Kong Gun gives your Leader +3000 Power defensively. With a 12-cost-or-higher Character in play, it can also spend 6 additional DON!! to K.O. up to two Characters that cost 6 or less. Use removal mode chiefly when your board is already wider than the opponent's." },
	{ card: badManners, title: "Bad Manners Kick Course OP04-016", text: "This deck has many cards without Counter, so Bad Manners converts an awkward card into +3000 Counter. Its Trigger also gives an opposing Leader or Character -3000 Power for the turn, which can save a close defensive turn." },
];
const otherOptions = [
	{ card: gerd, title: "Gerd OP17-081", text: "Gerd can trash a card from your hand to return a Character that costs 8 or less from your trash, including Monkey D. Luffy for the late game. She also has 2000 Counter. Because Sabo is not an Elbaf Leader, she does not gain the 12-cost part of her effect." },
	{ card: imLuffy, title: "I'm Luffy! The Man Who Will Become the King of the Pirates! OP17-096", text: "This Event gives +4000 Counter for 1 DON!! while you control a 12-cost Character. Its Trigger recovers an Elbaf card from trash, but its condition makes it less reliable than the current defensive options." },
	{ card: zoroEb04, title: "Roronoa Zoro EB04-007", text: "A mirror-tech option for Sabo Elbaf and Elbaf Luffy. He gives your Leader +2000 Power through the end of the next opposing turn, and gains Rush when an opposing Character has 8000 Power or more." },
	{ card: sanji17, title: "Sanji OP17-082", text: "Sanji can replace some 2-costs to draw two, then trash two. With a 12-cost Character in play, he becomes a 5000-Power attacker; Sabo's Leader effect raises that to 6000 Power for only 2 cost." },
	{ card: sanjiSt21, title: "Sanji ST21-003", text: "Sanji is an alternate unblockable threat if you prefer a different condition from Chopper. Nightmare Luffy is another defensive idea, but reaching 20 cards in your trash is difficult for this deck." },
	{ card: brook17, title: "Brook OP17-091", text: "Brook can make the opponent trash a card, but he fits this aggressive version less well. Your goal is to empty the opposing hand through repeated attacks, not a slow resource battle." },
];
const matchupGroups = [
	{ label: "Favorable", icon: "&uarr;", tone: "up", cards: [luffyAce, luffy17] },
	{ label: "Slightly Favorable", icon: "&nearr;", tone: "slightly-up", cards: [robin09] },
	{ label: "Even", icon: "~", tone: "even", cards: [mihawk] },
	{ label: "Slightly Unfavorable", icon: "&searr;", tone: "slightly-down", cards: [boa, luffy13] },
	{ label: "Unfavorable", icon: "&darr;", tone: "down", cards: [enel, rocks, kaido, ace] },
];
const tips = [
	{ cards: [saul, loki], text: "Keep a 12-cost Character on the board. Your 2-cost Elbaf Straw Hats gain their full value once a 12-cost-or-higher Character is in play, and Saul enables Sabo's Leader effect early. Avoid losing your last Saul or Loki if you have no other way to reactivate the effect." },
	{ cards: [zoro], text: "Protect your board with Zoro. Once you begin playing multiple small Characters, Zoro OP17-095 can protect that board from removal. The longer you stay wide, the more valuable Sabo's global +1000 Power becomes." },
	{ cards: [robin, luffy], text: "Robin is one of your best tools. Use her -3000 Power to put an opposing Character in range of your attackers rather than always attacking the Leader. She is even stronger when Luffy replays her from trash before attacking with Rush." },
	{ cards: [luffy, brook], text: "Use Brook with Luffy. When all 8 DON!! go into Luffy, bring back Brook ST01-011 from trash. Brook places two rested DON!! on Sabo, letting you activate the Leader effect while Luffy is in play." },
	{ cards: [loki, newgate], text: "Do not play Loki just because you can. Loki uses 6 DON!! and can prevent you from strengthening Sabo, so prioritize him when removal hits a key target. Against Ace, Loki's +3000 Power during the opposing turn can also enable Edward Newgate OP17-005's cost reduction." },
	{ cards: [kongGun], text: "Gum-Gum Kong Gun is strongest when you are already ahead on board. Removing two opposing Characters while keeping several attackers forces the opponent to rebuild. With little or no board, this investment is much harder to justify." },
	{ cards: [jinbe], text: "Jinbe can be more than a Blocker. With a 12-cost Character in play, he is also a 6000-Power attacker, so do not automatically leave him active every turn." },
	{ cards: [leader], text: "Remember Sabo's low-Life advantage. At 4 Life or more, Sabo begins at 4000 Power; at 3 Life or less, the penalty disappears. With 1 DON!! attached and an 8-cost-or-higher Character in play, the Leader gains another +1000 Power." },
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span>Deck Guide</span><span>OP17 Format</span></div><h1>Sabo OP13 Deck Guide</h1><p>Build a wide Elbaf Straw Hat board, keep a 12-cost Giant in play, and turn every small Character into immediate pressure with Sabo's Leader effect.</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Curve Guide</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div></div><div class="guide-icon"><img src={icon} alt="Sabo OP13 deck guide icon" loading="eager" /></div></div></section>
	<section id="decklist" class="list-section"><div class="container article-stack">
		<section class="glow-block"><div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>Copy for Sim</button></div></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><span class="deck-count">{entry.count}x</span><div><div class="deck-name">{entry.name}</div><div class="deck-code">{entry.code}</div></div></div><span class="deck-role">{entry.role}</span></button>)}</div></section>
		<section class="glow-block"><h2>Mulligan</h2><p>Your priority is an early game that develops the board while finding a Giant. Usopp and Jaguar D. Saul are your most important keeps, followed by Roronoa Zoro to protect your smaller Characters.</p><div class="article-list"><section class="mulligan-group"><h3 class="mulligan-subtitle">Priority Keeps</h3>{priorityKeeps.map((item) => <article><h4>{item.title}</h4><div class="item-row"><div class="card-set">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>{item.text}</p></div></article>)}</section><section class="mulligan-group"><h3 class="mulligan-subtitle">Good Keeps</h3>{goodKeeps.map((item) => <article><h4>{item.title}</h4><div class="item-row"><div class="card-set">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>{item.text}</p></div></article>)}</section><section class="mulligan-group"><h3 class="mulligan-subtitle">Don't Overprioritize Your Late Game</h3><div class="item-row"><div class="card-set three">{[docking, loki, luffy].map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>Prioritize Usopp plus Jaguar D. Saul before Pirates Docking Six, Loki, and Monkey D. Luffy. Once a Giant is in play, your 2-cost Characters gain +3000 Power, while attaching 1 DON!! to Sabo gives your Leader and every Character +1000 Power.</p></div></section></div></section>
		<section id="curve" class="glow-block"><h2>Curve Guide</h2><p>Sabo wants to play several small Characters, establish a 12-cost Giant, then finish with Monkey D. Luffy. Going second is usually smoother, although some turns force you to choose between development and keeping 1 DON!! on Sabo.</p>{[["Going First", firstCurve], ["Going Second", secondCurve]].map(([heading, curve]) => <div class="curve-block"><h3>{heading}</h3>{curve.map((item) => <article class="curve-item"><strong>{item.label}</strong><div class="curve-content"><div class={`card-set ${item.cards.length === 3 ? "three" : ""}`}>{item.cards.map((entry, index) => <><button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>{item.cards.length > 1 && index < item.cards.length - 1 && <span class="connector">{item.connectors?.[index] ?? item.mode ?? "+"}</span>}</>)}</div><p class="curve-note">{item.text}</p></div></article>)}</div>)}</section>
		<section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><p>These cards do more than fill out the curve. Some improve specific matchups, while others reward you for keeping a 12-cost Character on the board.</p><div class="tech-list">{techCards.map((item) => <article class="item-row"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={item.card.img} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div><h3 class="other-options-heading">Other Options</h3><div class="tech-list">{otherOptions.map((item) => <article class="item-row"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={item.card.img} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>
		<section id="matchups" class="glow-block"><h2>Matchups</h2><p>See Sabo&apos;s win rates when going first or second in <a class="matchup-stats-link" href="/meta-analysis/Sabo-op13-stats/"><strong>OP13 Sabo Stats in OP17 Format.</strong></a></p><div class="matchup-grid">{matchupGroups.map((group) => <article class="matchup-card"><div class={`badge ${group.tone}`}><span set:html={group.icon}></span>{group.label}</div><div class="matchup-list">{group.cards.map((entry) => <button type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div></article>)}</div></section>
		<section class="glow-block"><h2>Tips</h2><p>Sabo rewards a wide board, careful Giant management, and knowing when to leave DON!! for the Leader effect.</p><div class="tips-list">{tips.map((item) => <article class="item-row"><div class={`card-set ${item.cards.length === 3 ? "three" : ""}`}>{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>{item.text}</p></article>)}</div></section>
	</div></section>
	<div class="card-modal" data-modal aria-hidden="true"><div><button type="button" data-close>Close</button><img src="" alt="" data-modal-image /></div></div>
</MainLayout>

<script>
	const modal = document.querySelector("[data-modal]"); const modalImage = document.querySelector("[data-modal-image]"); const close = () => modal?.setAttribute("aria-hidden", "true");
	document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !modalImage) return; modalImage.src = button.dataset.full ?? ""; modalImage.alt = button.dataset.name ?? ""; modal.setAttribute("aria-hidden", "false"); })); document.querySelector("[data-close]")?.addEventListener("click", close); modal?.addEventListener("click", (event) => { if (event.target === modal) close(); }); document.querySelectorAll("[data-copy-sim]").forEach((button) => button.addEventListener("click", async () => { const value = button.getAttribute("data-sim-deck") ?? ""; if (!value) return; const previous = button.textContent; try { await navigator.clipboard.writeText(value); button.textContent = "Copied!"; } catch { button.textContent = "Copy failed"; } setTimeout(() => { button.textContent = previous ?? "Copy for Sim"; }, 1400); }));
</script>

<style>
	.guide-hero{padding-top:3rem}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:2.5rem;align-items:center}.hero-tags,.hero-actions,.card-set,.matchup-list{display:flex;flex-wrap:wrap;gap:.65rem;align-items:center}.hero-tags span,.badge{border-radius:999px;padding:.35rem .7rem;font-weight:800}.hero-tags span{border:1px solid rgba(255,107,53,.45);font-size:.8rem}.guide-icon img{width:100%;border-radius:18px;box-shadow:0 24px 52px rgba(0,0,0,.35)}.article-stack,.article-list,.tech-list,.tips-list{display:grid;gap:1rem}.glow-block{padding:1.25rem;border:1px solid rgba(255,107,53,.35);border-radius:24px;background:rgba(8,12,24,.82);box-shadow:0 0 28px rgba(255,107,53,.07)}.glow-block h2,.glow-block h3,.glow-block h4,.glow-block p{margin-top:0}.decklist-title-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1rem}.copy-sim-button{width:auto}.deck-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.85rem;margin-top:1rem}.deck-card{display:grid;gap:.55rem;padding:.7rem;border:1px solid rgba(255,107,53,.22);border-radius:16px;background:rgba(0,0,0,.22);color:inherit;text-align:left;cursor:pointer}.deck-card img{width:100%;max-width:110px;margin:auto;border-radius:12px}.deck-card b{display:block;color:#ff8a42}.deck-card strong,.deck-card small{display:block}.deck-card small{color:var(--text-300);font-size:.75rem}.article-list article,.curve-item{padding-top:1rem;border-top:1px solid rgba(255,107,53,.25)}.item-row{display:grid;grid-template-columns:minmax(150px,300px) minmax(0,1fr);gap:1rem;align-items:center}.mini-card{border:0;padding:0;background:transparent;cursor:pointer}.mini-card img{display:block;width:98px;border-radius:10px}.curve-block{margin-top:1.5rem}.curve-item strong{display:block;margin-bottom:.65rem;color:#ff6b35}.connector{color:#ff6b35;font-weight:900}.curve-item p,.item-row p{line-height:1.6}.tech-list .item-row,.tips-list .item-row{padding:.9rem;border:1px solid rgba(255,107,53,.2);border