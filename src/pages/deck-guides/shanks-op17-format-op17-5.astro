---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Shanks OP17 Deck Guide OP17.5: Decklist, Mulligan & Curve";
const description = "Shanks OP17.5 deck guide with decklist, mulligan priorities, curve guide, tech cards, matchups, and tips.";
const icon = "/assets/guides/Shanks%20op17.png";
const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });
const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;
	while (remaining > 4) { lines.push(`4x${code}`); remaining -= 4; }
	if (remaining > 0) lines.push(`${remaining}x${code}`);
	return lines;
};

const leader = card("OP17-020", "Shanks", "/Cards/OP17/New OP17/OP17-020.jpg", 1, "Leader");
const perona = card("OP12-034", "Perona", "/Cards/OP12/OP12-034.jpg", 4);
const croneOli = card("OP17-021", "Crone Oli", "/Cards/OP17/New OP17/OP17-021.jpg", 4);
const limeJuice = card("OP17-032", "Limejuice", "/Cards/OP17/New OP17/OP17-032.jpg", 4);
const hongo = card("OP17-029", "Hongo", "/Cards/OP17/New OP17/OP17-029.jpg", 4);
const luckyRoux = card("OP17-033", "Lucky.Roux", "/Cards/OP17/New OP17/OP17-033.jpg", 4);
const yasopp = card("OP17-031", "Yasopp", "/Cards/OP17/New OP17/OP17-031.jpg", 4);
const kouzukiOden = card("ST32-002", "Kouzuki Oden", "/Cards/ST32/ST32-002.jpg", 4);
const trafalgarLaw = card("OP13-031", "Trafalgar Law", "/Cards/OP13/OP13-031.jpg", 4);
const bennBeckman = card("OP17-027", "Benn.Beckman", "/Cards/OP17/New OP17/OP17-027.jpg", 4);
const shanksSt16 = card("ST16-004", "Shanks", "/Cards/ST16/ST16-004.png", 2);
const shanksOp17 = card("OP17-022", "Shanks", "/Cards/OP17/New OP17/OP17-022.jpg", 4);
const uglyFuture = card("OP17-038", "I Think He's Seen an Ugly Future...", "/Cards/OP17/New OP17/OP17-038.jpg", 2, "Event");
const withdrawNow = card("OP17-036", "Withdraw Now and Allow Me to Save Face", "/Cards/OP17/New OP17/OP17-036.jpg", 2, "Event");
const newEra = card("OP17-037", "Are You That Afraid of the New Era?!!", "/Cards/OP17/New OP17/OP17-037.jpg", 4, "Event");

const decklist = [leader, perona, croneOli, limeJuice, hongo, luckyRoux, yasopp, kouzukiOden, trafalgarLaw, bennBeckman, shanksSt16, shanksOp17, uglyFuture, withdrawNow, newEra];
const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const saboOp13 = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg");
const rocksOp17 = card("OP17-039", "Rocks D. Xebec OP17", "/Cards/OP17/New OP17/OP17-039.jpg");
const kaidoOp17 = card("OP17-058", "Kaido OP17", "/Cards/OP17/New OP17/OP17-058.jpg");
const robinOp09 = card("OP09-062", "Nico Robin OP09", "/Cards/OP09/OP09-062.jpg");
const luffyOp17 = card("OP17-079", "Monkey D. Luffy OP17", "/Cards/OP17/New OP17/OP17-079.jpg");
const luffyAceSt30 = card("ST30-001", "Luffy & Ace ST30", "/Cards/ST30/ST30-001.jpg");
const enelOp15 = card("OP15-058", "Enel OP15", "/Cards/OP15/OP15-058.jpg");
const puddingOp08 = card("OP08-058", "Charlotte Pudding OP08", "/Cards/OP08/OP08-058.png");
const enelOp05 = card("OP05-098", "Enel OP05", "/Cards/OP05/OP05-098.png");
const matchupIcons = {
	"OP17-058": "/assets/guides/Kaido op17.png", "OP09-062": "/assets/guides/Nico-Robin-op09.png", "OP17-079": "/assets/guides/Monkey.D.Luffy op17.png", "OP15-058": "/assets/guides/enel-op15.png", "OP13-004": "/assets/guides/Sabo OP13-004.png", "OP17-039": "/assets/guides/Rocks.DXebec op17.png", "ST30-001": "/assets/guides/Luffy-st30.png", "OP08-058": "/assets/guides/Pudding op08.png", "OP05-098": "/assets/guides/Enel OP05-098.png",
};
const matchupGroups = [
	{ label: "Favorable", tone: "up", icon: "&uarr;", cards: [luffyOp17, puddingOp08] },
	{ label: "Slightly Favorable", tone: "slightly-up", icon: "&nearr;", cards: [robinOp09, kaidoOp17] },
	{ label: "Even", tone: "mid", icon: "~", cards: [enelOp15] },
	{ label: "Slightly Unfavorable", tone: "slightly-down", icon: "&swarr;", cards: [enelOp05] },
	{ label: "Unfavorable", tone: "down", icon: "&darr;", cards: [rocksOp17, saboOp13, luffyAceSt30] },
];

const priorityKeeps = [
{ title: "Perona OP12-034 and Limejuice OP17-032", cards: [perona, limeJuice], text: "These are your main cards to have in your opening hand. They let you immediately start searching for the pieces you will need for the rest of the game." },
	{ title: "Lucky.Roux OP17-033", cards: [luckyRoux], text: "Lucky.Roux is also a good card to keep. In addition to being a Searcher, it can later be used defensively through its effect during an opposing attack." },
	{ title: "Yasopp OP17-031", cards: [yasopp], text: "Yasopp is another excellent card to have in your opening hand, especially for starting to control the opposing board from the midgame onward." },
];

const curveGroups = [
	{ heading: "Going First", slots: [
{ label: "1 DON!! — Searchers", cards: [perona, limeJuice], connectors: ["OR"], text: "Play Perona OP12-034 or Limejuice OP17-032 to start searching for the cards needed for your curve." },
{ label: "3 DON!!", cards: [leader], text: "You do not have a mandatory play at 3 DON!!. You can play other Searchers and/or use your DON!! on your Leader to attack. If you want to starve your opponent, you can also choose not to attack at all so you do not give them additional cards from their Life. This is especially useful against Sabo OP13." },
{ label: "5 DON!! — Control", cards: [kouzukiOden, yasopp, luckyRoux], connectors: ["OR", "OR"], text: "This is your first real control turn. You can play Kouzuki Oden ST32-002 to prevent an opposing Character with a base cost of 6 or less from becoming rested, which notably stops it from attacking or blocking. Yasopp OP17-031 is the other main option: its On Play effect rests an opposing Character with a cost of 8 or less, allowing you to attack it immediately. If your opponent has not played an interesting target, Lucky.Roux OP17-033 is also an option to keep searching while preparing your defense." },
{ label: "7 DON!! — Benn.Beckman", cards: [bennBeckman], text: "Play Benn.Beckman OP17-027. In addition to drawing 1 card, he can rest up to two opposing Characters with no cost restriction, then immediately attack a rested Character. Your goal remains to keep controlling the board rather than rush the opposing Life." },
{ label: "9 DON!! — Shanks", cards: [shanksSt16], text: "Shanks ST16-004 becomes your main play. Its On Play effect can K.O. a rested opposing Character, which directly fits your control strategy." },
{ label: "10 DON!! — Shanks", cards: [shanksOp17], text: "Play Shanks OP17-022 for your late game. It rests the entire opposing board with no cost restriction, and it has Rush and 12000 Power. Its On Play effect also sets two of your DON!! as active. You can use those two DON!! to keep your Leader effect and a defensive option available, or to strengthen an attack." },
	] },
	{ heading: "Going Second", slots: [
{ label: "2 DON!! — Searchers", cards: [perona, limeJuice], connectors: ["OR"], text: "Start with Perona OP12-034 or Limejuice OP17-032 to search for your next cards." },
{ label: "4 DON!! — Setup", cards: [hongo, luckyRoux], connectors: ["OR"], text: "You mainly have two options. Hongo OP17-029 is for when you want to start controlling small opposing Characters. It can rest up to two Characters with a cost of 2 or less, and it is a Blocker. Lucky.Roux OP17-033 is the more general option to keep searching while preparing your defense with its effect during an opposing attack. Hongo is especially preferred against Sabo OP13 and Luffy OP17, where its ability to rest small Characters can be particularly useful." },
{ label: "6 DON!! — Trafalgar Law", cards: [trafalgarLaw, limeJuice, kouzukiOden, yasopp], connectors: ["→", "→", "OR"], text: "Play Trafalgar Law OP13-031. You can return the Limejuice played on your first turn to your hand, then play Kouzuki Oden or Yasopp rested through Law. This sequence lets you recover your 2000 Counter Limejuice to your hand, or replay it later for another search if needed." },
{ label: "8 DON!! — Benn.Beckman", cards: [bennBeckman], text: "Play Benn.Beckman OP17-027 to keep controlling the opposing board." },
{ label: "10 DON!! — Shanks", cards: [shanksOp17], text: "Move into Shanks OP17-022. Once you reach 10 DON!!, the curve is to keep playing your 10-cost Shanks to establish your late game. The general principle remains the same for both curves: prioritize controlling the opposing board. You do not need to attack Life every turn. The main exceptions are Rocks OP17 and Luffy & Ace ST30, against whom you should focus more on racing your opponent." },
	] },
];

const techCards = [
{ card: croneOli, title: "Crone Oli OP17-021", text: "Crone Oli is your main protection against removal effects. She protects your Red-Haired Pirates Characters by resting one of your cards: your Leader, a DON!!, or Crone Oli herself. She also has 2000 Counter, which keeps her useful in hand when you do not need her protection. However, she cannot protect Kouzuki Oden ST32-002 or Trafalgar Law OP13-031 because they do not have the Red-Haired Pirates type." },
{ card: luckyRoux, title: "Lucky.Roux OP17-033", text: "Lucky.Roux combines searching and defense. When an opponent attacks, you can trash him to rest an opposing Leader or Character. This can neutralize a large attack before it happens. If your opponent has two large Characters, you can wait for the first one to attack and rest the second. The Character that becomes rested is also a target you can then freeze with your Leader effect or K.O. with Shanks ST16-004." },
{ card: uglyFuture, title: "I Think He's Seen an Ugly Future... OP17-038", text: "This card turns cards without Counter into defense: by discarding another card, you gain +3000 Counter for 0 DON!!. It can also be used offensively by resting 4 of your cards, including DON!!, your Leader, or Characters, to rest an opposing Character. This gives it a second use when you do not need its Counter." },
	{ card: withdrawNow, title: "Withdraw Now and Allow Me to Save Face OP17-036", text: "This card has two uses. Offensively, it can K.O. up to two rested Characters with a cost of 6, while first letting you rest a Character to create an additional target if necessary. Defensively, it can provide +4000 Counter, but only to your Leader or your Characters named Shanks." },
{ card: newEra, title: "Are You That Afraid of the New Era?!! OP17-037", text: "This card complements your Searchers while also serving as a defensive tool. Its defensive use provides +3000 Counter, but it requires you to rest another card in addition to paying its cost. You can rest a DON!! or use a Perona, Limejuice, or Crone Oli already on the board to pay this requirement." },
	{ card: shanksSt16, title: "Shanks ST16-004", text: "This version of Shanks is your direct late-game removal: for 9 DON!!, its On Play effect can K.O. a rested Character. It works especially well with the deck's many ways to rest opposing Characters before removing them. Only 2 copies are played because Shanks OP17-022 remains your main threat at 10 DON!!." },
];

const tips = [
{ title: "Focus on Opposing Characters", cards: [yasopp, bennBeckman, shanksOp17], text: "Do not automatically look to attack Life. Shanks is first and foremost a control deck. In matchups where you can limit opposing resources, focus on Characters and force your opponent to use the cards already in their hand. Against Sabo, this approach lets you switch to offense once their board is under control." },
{ title: "Use Your Leader to Neutralize Important Attacks", cards: [leader], text: "Use your Leader to neutralize important attacks. You can rest 1 DON!! or trash a card from your hand to prevent a rested Character from becoming Active during the opponent's next Refresh. A card without Counter can therefore be used to stop a large attack on the following turn." },
{ title: "Prepare Your Targets", cards: [luckyRoux, yasopp, hongo, bennBeckman, shanksOp17, shanksSt16], text: "Prepare your targets before removing them. Lucky.Roux, Yasopp, Hongo, Benn.Beckman, and Shanks OP17 can rest opposing Characters. You can then keep them rested with your Leader, attack them, or use Shanks ST16-004 to K.O. them." },
{ title: "Use Trafalgar Law to Reclaim Useful Cards", cards: [trafalgarLaw, limeJuice, kouzukiOden, yasopp], text: "Use Trafalgar Law to recover your useful cards. You can return Limejuice OP17-032 to your hand before playing Oden or Yasopp. This gives you back a 2000 Counter and lets you replay Limejuice later for another search." },
{ title: "Use the Two Active DON!! from Shanks OP17-022", cards: [shanksOp17], text: "Make use of the 2 DON!! set as active by Shanks OP17-022. You can keep one for your Leader effect and the other for defense, or use them offensively. You can also attach both to Shanks to attack for 14000 Power." },
{ title: "Change Your Plan Against Rocks and Luffy & Ace", cards: [rocksOp17, luffyAceSt30], text: "Adapt your approach against Rocks and Luffy & Ace. Against these two Leaders, the classic control plan is less suitable: you should focus more on racing your opponent than simply controlling their board." },
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span>Deck Guide</span><span>OP17.5 Format</span></div><h1>Shanks OP17 Deck Guide</h1><p>Use searchers to build your control curve, then keep the opposing board under control with Shanks.</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Curve Guide</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div></div><div class="guide-icon"><img src={icon} alt="Shanks OP17 deck guide icon" loading="eager" /></div></div></section>

	<section id="decklist" class="list-section"><div class="container article-stack">
		<section class="glow-block"><div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>Copy for Sim</button></div></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><span class="deck-count">{entry.count}x</span><div><div class="deck-name">{entry.name}</div><div class="deck-code">{entry.code}</div></div></div><span class="deck-role">{entry.role}</span></button>)}</div></section>

		<section class="glow-block"><h2>Mulligan</h2><p>Your priority in your opening hand is to find your Searchers so you can quickly start building your hand and preparing your curve.</p><div class="mulligan-list"><section class="mulligan-group"><h3>Cards to Keep</h3>{priorityKeeps.map((item) => <article class="content-item"><h4>{item.title}</h4><div class="item-row"><div class="card-set">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>{item.text}</p></div></article>)}</section><section class="mulligan-group"><h3>Prepare Your Curve</h3><div class="item-row"><div class="card-set">{[perona, limeJuice, yasopp, bennBeckman, shanksOp17].map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>A good hand should not contain only Searchers. If your early game is already secured, you can also keep the cards that will let you naturally chain your next turns.</p><p>Benn.Beckman OP17-027 is especially interesting after your Yasopp turn, while Shanks OP17-022 is your main target for reaching the late game.</p><p>The sequence you are looking for can gradually look like this: Searcher → Yasopp → Benn.Beckman → Shanks OP17-022.</p><p>You do not need to have this entire curve in your opening hand. Your Searchers are there to gradually find the missing cards.</p></div></section><section class="mulligan-group"><h3>Adapt Your Hand to Going First or Second</h3><p>Going first, a hand with Perona or Limejuice is especially valuable because you can immediately start searching for your next cards.</p><p>Going second, those same Searchers remain priorities on your first 2 DON!! turn. You can then move into Lucky.Roux or Hongo at 4 DON!! before reaching your true midgame.</p><p>The goal remains simple: secure your early game with your Searchers, then gradually build your control curve rather than look for one specific multi-card combination during the Mulligan.</p></section></div></section>

		<section id="curve" class="glow-block"><h2>Curve Guide</h2>{curveGroups.map((group) => <div class="curve-block"><h3>{group.heading}</h3><div class="curve-rows">{group.slots.map((slot) => <article class="curve-row"><div><div class="curve-label">{slot.label}</div>{slot.cards.length > 0 && <div class:list={["curve-cards", { "curve-cards-inline": slot.cards.length <= 3 }]}>{slot.cards.map((entry, index) => <><button class="mini-card curve-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>{index < slot.cards.length - 1 && <span class="curve-join">{slot.connectors?.[index] ?? "+"}</span>}</>)}</div>}</div><p class="curve-note">{slot.text}</p></article>)}</div></div>)}</section>

		<section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><div class="tech-list">{techCards.map((item) => <article class="tech-card"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={getCardThumbnail(item.card.img)} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>

		<section id="matchups" class="glow-block feature-block"><div class="section-header feature-header"><div><h2>Matchups Format 17.5</h2><p>Quick OP17.5 matchup spread for Shanks.</p></div></div><div class="matchup-grid">{matchupGroups.map((group) => <div class="matchup-card"><div class={`matchup-badge badge-${group.tone}`}><span class="badge-icon" set:html={group.icon}></span><span>{group.label}</span></div><div class="matchup-list">{group.cards.map((entry) => <button class="matchup-entry" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img class="matchup-leader-icon" src={getCardThumbnail(matchupIcons[entry.code] ?? entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /><span>{entry.name}</span></button>)}</div></div>)}</div></section>

<section class="glow-block"><h2>Tips</h2><div class="tips-list">{tips.map((item) => <article class="tip-card"><div class="card-set tip-cards">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>
	</div></section>
	<div class="card-modal" data-modal aria-hidden="true"><div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview"><button class="modal-close" type="button" data-close>Close</button><img src="" alt="" data-modal-image /></div></div>
</MainLayout>

<script>
	const modal = document.querySelector("[data-modal]"); const modalImage = document.querySelector("[data-modal-image]"); const closeModal = () => { modal?.classList.remove("is-open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; }; document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !modalImage) return; modalImage.src = button.dataset.full || ""; modalImage.alt = button.dataset.name || "Card preview"; modal.classList.add("is-open"); modal.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; })); document.querySelector("[data-close]")?.addEventListener("click", closeModal); modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); }); document.querySelectorAll("[data-copy-sim]").forEach((button) => button.addEventListener("click", async () => { const simDeck = button.dataset.simDeck; if (!simDeck) return; const previous = button.textContent?.trim() || "Copy for Sim"; try { if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(simDeck); } else { const textarea = document.createElement("textarea"); textarea.value = simDeck; textarea.setAttribute("readonly", ""); textarea.style.position = "fixed"; textarea.style.opacity = "0"; document.body.appendChild(textarea); textarea.select(); document.execCommand("copy"); textarea.remove(); } button.textContent = "Copied"; } catch { button.textContent = "Copy failed"; } window.setTimeout(() => { button.textContent = previous; }, 1800); }));
</script>

<style>
	.article-stack > section.glow-block:nth-of-type(2) .mulligan-group:nth-child(2) .item-row { display: block; }
	.article-stack > section.glow-block:nth-of-type(2) .mulligan-group:nth-child(2) .item-row > .card-set { margin-bottom: 1rem; }
	#curve > p:first-of-type { display: none; }
	#curve, #matchups { scroll-margin-top: 190px; }
	@media (max-width: 760px) {
		#curve .curve-cards-inline { flex-wrap: nowrap; gap: .35rem; }
		#curve .curve-cards-inline .curve-card img { width: 86px; }
	}
	.guide-hero{padding-top:3rem}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:2.5rem;align-items:center}.hero-tags,.hero-actions,.card-set{display:flex;flex-wrap:wrap;gap:.65rem;align-items:center}.hero-tags span{border:1px solid rgba(255,107,53,.45);border-radius:999px;padding:.35rem .7rem;font-size:.8rem;font-weight:800}.guide-icon img{width:100%;border-radius:18px;box-shadow:0 24px 52px rgba(0,0,0,.35)}.article-stack,.mulligan-list,.curve-rows,.tech-list,.tips-list{display:grid;gap:1rem}.glow-block{padding:1.25rem;border:1px solid rgba(255,107,53,.35);border-radius:24px;background:rgba(8,12,24,.82);box-shadow:0 0 28px rgba(255,107,53,.07)}.glow-block h2,.glow-block h3,.glow-block h4,.glow-block p{margin-top:0}.decklist-title-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1rem}.copy-sim-button{width:auto}.deck-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.85rem;margin-top:1rem}.deck-card{display:grid;gap:.55rem;padding:.7rem;border:1px solid rgba(255,107,53,.22);border-radius:16px;background:rgba(0,0,0,.22);color:inherit;text-align:left;cursor:pointer}.deck-card img{width:100%;max-width:110px;margin:auto;border-radius:12px}.deck-info{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.5rem;align-items:center}.deck-count{color:#ff8a42;font-weight:900}.deck-name{font-weight:700}.deck-code,.deck-role{display:block;color:var(--text-300);font-size:.75rem}.deck-role{text-transform:uppercase;letter-spacing:.05em}.mulligan-group{padding:1rem;border:1px solid rgba(255,107,53,.24);border-radius:18px;background:rgba(0,0,0,.16)}.mulligan-group h3{color:#ff8a42}.content-item+.content-item{margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(255,107,53,.25)}.item-row,.curve-row,.tech-card{display:grid;grid-template-columns:minmax(180px,330px) minmax(0,1fr);gap:1rem;align-items:center}.mini-card{border:0;padding:0;background:transparent;cursor:pointer}.mini-card img{display:block;width:98