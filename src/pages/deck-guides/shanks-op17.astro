---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Shanks OP17 Deck Guide";
const description =
	"Deck guide for Shanks OP17 for One Piece Card Game with leader ability, updated decklist, curve guide, big bodies, deck in a nutshell, strengths, weaknesses, and a conclusion for the OP17 format.";
const icon = "/assets/guides/Shanks%20op17.png";

const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;

	while (remaining > 4) {
		lines.push(`4x${code}`);
		remaining -= 4;
	}

	if (remaining > 0) {
		lines.push(`${remaining}x${code}`);
	}

	return lines;
};

const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const leader = card("OP17-020", "Shanks", "/Cards/OP17/New OP17/OP17-020.jpg", 1, "Leader");

const croneOli = card("OP17-021", "Crone Oli", "/Cards/OP17/New OP17/OP17-021.jpg", 4, "Character");
const fugar = card("OP17-026", "Fugar", "/Cards/OP17/New OP17/OP17-026.jpg", 2, "Character");
const limeJuice = card("OP17-032", "Lime Juice", "/Cards/OP17/New OP17/OP17-032.jpg", 4, "Character");
const hongo = card("OP17-029", "Hongo", "/Cards/OP17/New OP17/OP17-029.jpg", 4, "Character");
const luckyRoux = card("OP17-033", "Lucky.Roux", "/Cards/OP17/New OP17/OP17-033.jpg", 4, "Character");
const yasopp = card("OP17-031", "Yasopp", "/Cards/OP17/New OP17/OP17-031.jpg", 4, "Character");
const rockstar = card("OP17-034", "Rockstar", "/Cards/OP17/New OP17/OP17-034.jpg", 3, "Character");
const kouzukiOden = card("ST32-002", "Kouzuki Oden", "/Cards/ST32/ST32-002.jpg", 3, "Character");
const trafalgarLaw = card("OP13-031", "Trafalgar Law", "/Cards/OP13/OP13-031.jpg", 3, "Character");
const bennBeckman = card("OP17-027", "Benn.Beckman", "/Cards/OP17/New OP17/OP17-027.jpg", 4, "Character");
const shanksSt16 = card("ST16-004", "Shanks", "/Cards/ST16/ST16-004.png", 4, "Character");
const shanksOp17 = card("OP17-022", "Shanks", "/Cards/OP17/New OP17/OP17-022.jpg", 4, "Character");
const uglyFuture = card("OP17-038", "I Think He's Seen An Ugly Future", "/Cards/OP17/New OP17/OP17-038.jpg", 3, "Event");
const newEra = card("OP17-037", "Are You That Afraid of the New Era?!!", "/Cards/OP17/New OP17/OP17-037.jpg", 4, "Event");

const decklist = [
	leader,
	croneOli,
	fugar,
	limeJuice,
	hongo,
	luckyRoux,
	yasopp,
	rockstar,
	kouzukiOden,
	trafalgarLaw,
	bennBeckman,
	shanksSt16,
	shanksOp17,
	uglyFuture,
	newEra,
];

const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const nutshellStrength = [
	"Oppressive board control: Starves the opponent of resources.",
	"Massive consistency: Runs 8-12 searchers (Lucky Roux, Limejuice, Perona).",
	"Punishes Aggro: Easily picks off low-cost rested threats.",
];

const nutshellWeakness = [
	"Resource intensive: Leader ability requires trashing a card or resting a DON!!.",
	"Awkward early game: The 3-DON!! turn is weak when going first.",
	"Struggles against Big Bodies: Weak to decks dropping 10+ cost un-restable threats.",
];

const coreEngine = [
	"Leader Shanks: The control anchor. Trashes a card or rests a DON!! to freeze characters.",
	"7c Benn Beckman: The MVP. A 9k Rush body that rests two characters and draws a card.",
	"10c & 9c Shanks: The sweepers. 10c rests the entire board; 9c provides heavy spot removal.",
];

const bestCurve = [
	{
		label: "2 DON!!",
		cards: [{ card: newEra }, { card: limeJuice }],
	},
	{
		label: "4 DON!!",
		cards: [{ card: luckyRoux }],
	},
	{
		label: "6 DON!!",
		cards: [{ card: yasopp }],
	},
	{
		label: "8 DON!!",
		cards: [{ card: bennBeckman }],
	},
	{
		label: "10 DON!!",
		cards: [{ card: shanksOp17 }],
	},
];

const oddCurve = [
	{
		label: "1 DON!!",
		cards: [{ card: limeJuice }],
	},
	{
		label: "3 DON!!",
		cards: [{ card: limeJuice }, { card: leader, rested: true }],
	},
	{
		label: "5 DON!!",
		cards: [{ card: yasopp }],
	},
	{
		label: "7 DON!!",
		cards: [{ card: bennBeckman }],
	},
];

const bigBodies = [
	{
		card: shanksOp17,
		copy: "Drops for 10 DON!! to instantly rest your opponent's entire board, attacks with Rush, and refunds 2 active DON!!. He completely resets the game in your favor while setting up your Leader freeze.",
	},
	{
		card: shanksSt16,
		copy: "The perfect alternative when you don't need a full board wipe. He easily pops a single massive rested threat. Fully searchable and vital for tight late-game scenarios where 10 DON!! is too slow.",
	},
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags">
					<span class="hero-chip">Deck Guide</span>
					<span class="hero-chip hero-chip-accent">OP17 Format</span>
				</div>
				<h1>Shanks OP17 Deck Guide</h1>
				<p class="hero-intro">
					A quick OP17 mini guide focused on Shanks' control plan, updated decklist, curve guide, big bodies,
					and the core tools that let the deck freeze the board and convert tempo into clean wins.
				</p>
			</div>
			<div class="guide-icon">
				<img src={icon} alt="Shanks OP17 deck guide icon" loading="eager" />
			</div>
		</div>
	</section>

	<section id="decklist" class="list-section">
		<div class="container article-stack">
			<div class="leader-panel glow-block">
				<div class="leader-grid">
					<div class="leader-tag-wrap">
						<div class="section-tag">LEADER</div>
					</div>
					<div class="ability-tag-wrap">
						<div class="section-tag section-tag-light">Ability</div>
					</div>
					<div class="leader-card-wrap">
						<button
							class="detail-card"
							type="button"
							data-card-preview
							data-full={leader.img}
							data-name={`${leader.code} ${leader.name}`}
							data-code={leader.code}
						>
							<img src={leader.img} alt={`${leader.code} ${leader.name}`} loading="lazy" />
						</button>
					</div>
					<div class="leader-details">
						<div class="info-box">
							<p class="ability-meta">Type &amp; Attribute: The Four Emperors/Red-Haired Pirates - Slash</p>
							<p class="ability-copy">
								<span class="leader-keyword-group">
									<img class="leader-keyword-badge" src="/assets/keywords/activate-main.png" alt="Activate: Main" />
									<img class="leader-keyword-badge" src="/assets/keywords/once-per-turn.png" alt="Once Per Turn" />
								</span><br />
								You may trash 1 card from your hand or rest 1 of your DON!! cards:<br />
								Up to 1 of your opponent's rested Characters will not become active<br />
								during your opponent's next Refresh Phase.
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="glow-block">
				<div class="section-header decklist-header">
					<div class="decklist-title-row">
						<h2>Decklist</h2>
						<button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>
							Copy for Sim
						</button>
					</div>
					<div>
						<p>Updated OP17 Shanks list built around searchers, freeze effects, and heavy finishers.</p>
					</div>
				</div>
				<div class="deck-grid">
					{
						decklist.map((entry) => (
							<button
								class="deck-card"
								type="button"
								data-card-preview
								data-full={entry.img}
								data-name={`${entry.code} ${entry.name}`}
								data-code={entry.code}
							>
								<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
								<div class="deck-info">
									<span class="deck-count">{entry.count}x</span>
									<div>
										<div class="deck-name">{entry.name}</div>
										<div class="deck-code">{entry.code}</div>
									</div>
								</div>
								<span class="deck-role">{entry.role}</span>
							</button>
						))
					}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Curve Guide</h2>
					</div>
				</div>

				<div class="curve-guide-block">
					<h3>Your Best Curve</h3>
					<p>Going 2nd is your best start! It leaves you 1 DON!! open for leader effect or events.</p>
					<div class="curve-rows">
						{bestCurve.map((slot) => (
							<div class="curve-row">
								<div class="curve-label">{slot.label}</div>
								<div class="curve-cards">
									{slot.cards.map((entry, index) => (
										<>
											{index > 0 && <span class="curve-join">+</span>}
											<button
												class={`mini-card curve-card ${entry.rested ? "is-rested" : ""}`}
												type="button"
												data-card-preview
												data-full={entry.card.img}
												data-name={`${entry.card.code} ${entry.card.name}`}
												data-code={entry.card.code}
											>
												<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
											</button>
										</>
									))}
								</div>
							</div>
						))}
					</div>
				</div>

				<div class="curve-guide-block">
					<h3>Odd Curve</h3>
					<div class="curve-rows">
						{oddCurve.map((slot) => (
							<div class="curve-row">
								<div class="curve-label">{slot.label}</div>
								<div class="curve-cards">
									{slot.cards.map((entry, index) => (
										<>
											{index > 0 && <span class="curve-join">+</span>}
											<button
												class={`mini-card curve-card ${entry.rested ? "is-rested" : ""}`}
												type="button"
												data-card-preview
												data-full={entry.card.img}
												data-name={`${entry.card.code} ${entry.card.name}`}
												data-code={entry.card.code}
											>
												<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
											</button>
										</>
									))}
								</div>
							</div>
						))}
					</div>
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Big Bodies</h2>
					</div>
				</div>
				<div class="boss-grid">
					{bigBodies.map((entry) => (
						<article class="boss-card">
							<button
								class="mini-card boss-card-media"
								type="button"
								data-card-preview
								data-full={entry.card.img}
								data-name={`${entry.card.code} ${entry.card.name}`}
								data-code={entry.card.code}
							>
								<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
							</button>
							<p class="curve-note">{entry.copy}</p>
						</article>
					))}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Deck In A Nutshell</h2>
						<p>
							Rest your opponent's Characters with your Mid-Game drops, attack into them to clean the board,
							and then use your Leader ability to completely freeze anything left standing so it won't wake up
							next turn!
						</p>
					</div>
				</div>
				<div class="nutshell-grid">
					<div class="info-panel">
						<div class="section-tag section-tag-light">Strength</div>
						<ul class="summary-list">
							{nutshellStrength.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div class="info-panel">
						<div class="section-tag section-tag-light">Weakness</div>
						<ul class="summary-list">
							{nutshellWeakness.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>
				<div class="core-panel">
					<div class="section-tag section-tag-light">The Core Engine</div>
					<ul class="summary-list">
						{coreEngine.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>

			<div class="summary-grid">
				<div class="glow-block conclusions-card">
					<div class="section-tag section-tag-light">Conclusion</div>
					<p class="ability-copy">
						Shanks OP17 is a proactive control deck that uses searchers, midgame freeze tools, and oversized
						finisher turns to choke the opponent out of clean lines.
					</p>
				</div>
			</div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true">
		<div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview">
			<button class="modal-close" type="button" data-close>Close</button>
			<img src="" alt="" data-modal-image />
		</div>
	</div>
</MainLayout>
<script>
	const previewButtons = document.querySelectorAll("[data-card-preview]");
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const modalEffect = document.querySelector("[data-modal-effect]");
	const closeButton = document.querySelector("[data-close]");
	const copyButtons = document.querySelectorAll("[data-copy-sim]");
	const keywordBadge = (icon, alt) => ({ type: "keyword", icon, alt });
	const decklistEffectTextByCode = {
		"OP17-020": [
			[keywordBadge("activate-main", "Activate: Main"), " ", keywordBadge("once-per-turn", "Once Per Turn"), " You may trash 1 card from your hand or rest 1 of your DON!! cards: Up to 1 of your opponent's rested Characters will not become active during your opponent's next Refresh Phase."],
		],
		"OP17-021": [
			['If your Character with a type including "Red-Haired Pirates" would be removed from the field by your opponent\'s effect, you may rest 1 of your cards instead.'],
		],
		"OP17-022": [
			[keywordBadge("rush", "Rush")],
			[keywordBadge("on-play", "On Play"), " Set up to 2 of your DON!! cards as active. Then, rest all of your opponent's Characters."],
		],
		"OP17-027": [
			[keywordBadge("rush", "Rush"), ": Character"],
			["(This card can attack Characters on the turn it is played.)"],
			[keywordBadge("on-play", "On Play"), " If your Leader has the {Red-Haired Pirates} type, draw 1 card and rest up to 2 of your opponent's Characters."],
		],
		"OP17-029": [
			[keywordBadge("on-play", "On Play"), " Rest up to 1 of your opponent's Characters with a cost of 4 or less."],
		],
		"OP17-031": [
			[keywordBadge("on-play", "On Play"), " Draw 1 card and rest up to 1 of your opponent's Characters with a cost of 8 or less."],
			[keywordBadge("end-of-your-turn", "End of Your Turn"), " Set up to 1 of your {Red-Haired Pirates} type Characters as active."],
		],
		"OP17-032": [
			[keywordBadge("on-play", "On Play"), ' Look at 3 cards from the top of your deck; reveal up to 1 card with a type including "Red-Haired Pirates" and add it to your hand. Then, place the rest at the bottom of your deck in any order.'],
		],
		"OP17-033": [
			[keywordBadge("on-play", "On Play"), ' Look at 3 cards from the top of your deck; reveal up to 1 card with a type including "Red-Haired Pirates" and add it to your hand. Then, place the rest at the bottom of your deck in any order.'],
			[keywordBadge("on-your-opponents-attack", "On Your Opponent's Attack"), " You may trash this Character: Rest up to 1 of your opponent's Leader or Characters."],
		],
		"OP17-034": [
			[keywordBadge("on-play", "On Play"), " If your Leader has the {Red-Haired Pirates} type, this Character gains +1000 power until the end of your opponent's next turn."],
		],
		"OP17-036": [
			[keywordBadge("main", "Main"), " You may rest 6 of your DON!! cards: Rest up to 1 of your opponent's Characters. Then, K.O. up to 2 of your opponent's rested Characters with a cost of 6 or less."],
			[keywordBadge("counter", "Counter"), " Up to 1 of your [Shanks] gains +4000 power during this battle."],
		],
		"OP17-037": [
			[keywordBadge("main", "Main"), " Up to 1 of your opponent's rested Characters gains -3000 power during this turn."],
			[keywordBadge("counter", "Counter"), " If your Leader has the {Red-Haired Pirates} type, up to 1 of your Leader or Character cards gains +3000 power during this battle."],
		],
		"OP17-038": [
			[keywordBadge("main", "Main"), " You may rest 4 of your cards: Rest up to 1 of your opponent's Characters."],
			[keywordBadge("counter", "Counter"), " You may trash 1 card from your hand: Up to 1 of your Leader or Character cards gains +3000 power during this battle."],
		],
	};

	const openModal = (button) => {
		if (!modal || !modalImage) return;
		const full = button.getAttribute("data-full");
		const name = button.getAttribute("data-name") || "Card preview";
		const code = button.getAttribute("data-code");
		const effectLines = code?.startsWith("OP17") ? decklistEffectTextByCode[code] : null;
		modalImage.setAttribute("src", full);
		modalImage.setAttribute("alt", name);
		if (modalEffect) {
			modalEffect.innerHTML = "";
			if (effectLines?.length) {
				effectLines.forEach((line) => {
					const paragraph = document.createElement("p");
					const normalizedLine = Array.isArray(line) ? line : [line];
					normalizedLine.forEach((part) => {
						if (typeof part === "string") {
							paragraph.appendChild(document.createTextNode(part));
							return;
						}
						if (part?.type === "keyword") {
							const image = document.createElement("img");
							image.className = "modal-keyword-badge";
							image.src = `/assets/keywords/${part.icon}.png`;
							image.alt = part.alt;
							paragraph.appendChild(image);
						}
					});
					modalEffect.appendChild(paragraph);
				});
				modalEffect.hidden = false;
			} else {
				modalEffect.hidden = true;
			}
		}
		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
		document.body.style.overflow = "hidden";
	};

	const closeModal = () => {
		if (!modal || !modalImage) return;
		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
		modalImage.setAttribute("src", "");
		modalImage.setAttribute("alt", "");
		if (modalEffect) {
			modalEffect.innerHTML = "";
			modalEffect.hidden = true;
		}
		document.body.style.overflow = "";
	};

	previewButtons.forEach((button) => {
		button.addEventListener("click", () => openModal(button));
	});

	closeButton?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (event) => {
		if (event.target === modal) closeModal();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && modal?.classList.contains("is-open")) {
			closeModal();
		}
	});

	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const simDeck = button.getAttribute("data-sim-deck");
			if (!simDeck) return;
			const previous = button.textContent?.trim();

			try {
				await navigator.clipboard.writeText(simDeck);
				button.textContent = "Copied";
				window.setTimeout(() => {
					button.textContent = previous ?? "Copy for Sim";
				}, 1800);
			} catch {
				button.textContent = "Copy failed";
				window.setTimeout(() => {
					button.textContent = previous ?? "Copy for Sim";
				}, 1800);
			}
		});
	});
</script>
<style>
	:root {
		--first-look-accent: #7bd53a;
		--first-look-accent-soft: rgba(123, 213, 58, 0.2);
		--first-look-border: rgba(123, 213, 58, 0.28);
	}

	.guide-hero {
		padding-top: 3.2rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(260px, 415px);
		gap: 2rem;
		align-items: center;
	}

	.hero-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-bottom: 1rem;
	}

	.hero-chip,
	.publish-banner {
		display: inline-flex;
		align-items: center;
		padding: 0.7rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--first-look-border);
		background: rgba(12, 17, 30, 0.85);
		color: #f3f7ff;
	}

	.hero-chip {
		font-size: 0.95rem;
		font-weight: 600;
	}

	.hero-chip-accent {
		color: var(--accent);
	}

	.hero-intro {
		max-width: 56ch;
	}

	.publish-banner {
		margin-top: 1.25rem;
		font-weight: 600;
	}

	.guide-icon {
		display: flex;
		justify-content: center;
	}

	.guide-icon img {
		width: min(415px, 100%);
		border-radius: 18px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
	}

	.article-stack,
	.summary-grid,
	.leader-details {
		display: grid;
		gap: 1.4rem;
	}

	.summary-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.conclusions-card {
		grid-column: 1 / -1;
	}

	.glow-block {
		background: rgba(12, 17, 30, 0.9);
		border: 1px solid var(--first-look-border);
		border-radius: 26px;
		padding: 1.25rem;
		box-shadow:
			0 0 0 1px rgba(123, 213, 58, 0.18),
			0 0 22px rgba(123, 213, 58, 0.1),
			0 0 52px rgba(123, 213, 58, 0.06);
	}

	.leader-grid {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		grid-template-areas:
			"leaderTag abilityTag"
			"card ability";
		gap: 1.5rem;
		align-items: start;
	}

	.leader-tag-wrap {
		grid-area: leaderTag;
	}

	.ability-tag-wrap {
		grid-area: abilityTag;
	}

	.leader-card-wrap {
		grid-area: card;
	}

	.leader-details {
		grid-area: ability;
	}

	.section-tag {
		display: inline-flex;
		padding: 0.45rem 0.9rem;
		background: var(--first-look-accent-soft);
		color: #f1f8e8;
		margin-bottom: 1rem;
		border-radius: 999px;
		font-weight: 600;
	}

	.section-tag-light {
