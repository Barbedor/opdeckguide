---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Sabo OP13 Deck Guide";
const description =
	"Sabo OP13 deck guide for One Piece Card Game with decklist, mulligan priorities, curve guides, tech cards, matchup notes, and gameplay tips for the OP16 format.";

const icon = "/assets/guides/Sabo%20OP13-004.png";

const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;

	while (remaining > 4) {
		lines.push(`4x${code}`);
		remaining -= 4;
	}

	if (remaining > 0) {
		lines.push(`${remaining}x${code}`);
	}

	return lines;
};

const card = (code, name, img) => ({ code, name, img });

const saboLeader = card("OP13-004", "Sabo", "/Cards/OP13/OP13-004.jpg");
const bonney = card("EB04-002", "Jewelry Bonney", "/Cards/EB04/EB04-002.jpg");
const nami = card("OP01-016", "Nami", "/Cards/OP01/OP01-016.png");
const zoroBlocker = card("OP15-094", "Roronoa Zoro", "/Cards/OP15/OP15-094.jpg");
const brook = card("ST01-011", "Brook", "/Cards/ST01/ST01-011.png");
const sanjiRush = card("ST21-003", "Sanji", "/Cards/ST21/ST21-003.jpg");
const luffyCost5 = card("OP12-015", "Monkey.D.Luffy", "/Cards/OP12/OP12-015.jpg");
const piratesDockingSix = card("OP15-088", "Pirates Docking Six", "/Cards/OP15/OP15-088.jpg");
const luffySt21 = card("ST21-014", "Monkey.D.Luffy", "/Cards/ST21/ST21-014.jpg");
const sanjiSt31 = card("ST31-001", "Sanji", "/Cards/ST31/ST31-001.jpg");
const luffySt31 = card("ST31-004", "Monkey.D.Luffy", "/Cards/ST31/ST31-004.jpg");
const badManners = card("OP04-016", "Bad Manners Kick Course", "/Cards/OP04/OP04-016.png");
const supremeKingHaki = card("OP12-018", "Color of the Supreme King Haki", "/Cards/OP12/OP12-018.jpg");
const counterattack = card("OP14-018", "Time for the Counterattack", "/Cards/OP14/OP14-018.jpg");
const groundDeath = card("OP14-096", "Ground Death", "/Cards/OP14/OP14-096.jpg");
const molePistol = card("ST21-017", "Gum-Gum Mole Pistol", "/Cards/ST21/ST21-017.jpg");
const thousandSunny = card("ST31-005", "Thousand Sunny", "/Cards/ST31/ST31-005.jpg");
const donCard = card("DON!!", "DON!!", "/Cards/Don/Don.png");

const chopper = card("OP10-011", "Chopper", "/Cards/OP10/OP10-011.jpg");
const zoroEb04 = card("EB04-007", "Roronoa Zoro", "/Cards/EB04/EB04-007.jpg");
const garp = card("OP13-016", "Monkey.D.Garp", "/Cards/OP13/OP13-016.jpg");
const iHaveMyCrew = card("ST14-016", "I Have My Crew!!", "/Cards/ST14/ST14-016.png");

const mihawk14 = card("OP14-020", "Dracule Mihawk OP14", "/Cards/OP14/OP14-020.jpg");
const gbLuffy = card("OP16-022", "Green/Blue Luffy OP16", "/Cards/OP16/OP16-022.jpg");
const katakuri11 = card("OP11-062", "Charlotte Katakuri OP11", "/Cards/OP11/OP11-062.jpg");
const st21Luffy = card("ST21-001", "Monkey.D.Luffy ST21", "/Cards/ST21/ST21-001.jpg");
const yamato16 = card("OP16-079", "Yamato OP16", "/Cards/OP16/OP16-079.jpg");
const teach16 = card("OP16-080", "Marshall.D.Teach OP16", "/Cards/OP16/OP16-080.jpg");
const kuzan12 = card("OP12-040", "Kuzan OP12", "/Cards/OP12/OP12-040.jpg");
const nami11 = card("OP11-041", "Nami OP11", "/Cards/OP11/OP11-041.jpg");
const kid10 = card("OP10-099", "Kid OP10", "/Cards/OP10/OP10-099.jpg");
const rosinante12 = card("OP12-061", "Donquixote Rosinante OP12", "/Cards/OP12/OP12-061.jpg");
const rgLuffy13 = card("OP13-001", "Red/Green Luffy OP13", "/Cards/OP13/OP13-001.jpg");
const enel15 = card("OP15-058", "Purple Enel OP15", "/Cards/OP15/OP15-058.jpg");
const ace15 = card("OP16-001", "Portgas.D.Ace OP16", "/Cards/OP16/OP16-001.jpg");
const boa14 = card("OP14-041", "Boa Hancock OP14", "/Cards/OP14/OP14-041.jpg");

const decklist = [
	{ ...saboLeader, count: 1, role: "Leader" },
	{ ...bonney, count: 4, role: "Character" },
	{ ...nami, count: 4, role: "Character" },
	{ ...zoroBlocker, count: 1, role: "Character" },
	{ ...brook, count: 4, role: "Character" },
	{ ...sanjiRush, count: 4, role: "Character" },
	{ ...luffyCost5, count: 4, role: "Character" },
	{ ...piratesDockingSix, count: 4, role: "Character" },
	{ ...luffySt21, count: 2, role: "Character" },
	{ ...sanjiSt31, count: 4, role: "Character" },
	{ ...luffySt31, count: 3, role: "Character" },
	{ ...badManners, count: 4, role: "Event" },
	{ ...supremeKingHaki, count: 2, role: "Event" },
	{ ...counterattack, count: 2, role: "Event" },
	{ ...groundDeath, count: 2, role: "Event" },
	{ ...molePistol, count: 2, role: "Event" },
	{ ...thousandSunny, count: 4, role: "Stage" },
];

const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const mulliganKeeps = [
	{
		copy:
			"Your cleanest searcher for the opening engine. Nami helps you find the exact pieces you need to get Sanji plus Pirates Docking Six online as fast as possible.",
		cards: [nami],
	},
	{
		copy:
			"Another premium searcher. Bonney improves your hand consistency and makes it much easier to line up Sanji and Pirates Docking Six on schedule.",
		cards: [bonney],
	},
	{
		copy:
			"Your third search engine is also one of your most useful setup cards. Thousand Sunny keeps digging while giving 1 rested DON!! to one of your Luffy cards every turn.",
		cards: [thousandSunny],
	},
];

const curveFirst = [
	{
		label: "1 DON!!",
		notes:
			"Start with Nami, Jewelry Bonney, or Thousand Sunny. The whole point is to set up ST31-001 Sanji plus OP15-088 Pirates Docking Six as quickly as possible.",
		cards: [nami, bonney, thousandSunny],
	},
	{
		label: "3 DON!!",
		notes:
			"Keep using your searchers to clean up your hand. Your priority is still getting to the next turn with the main combo available.",
		cards: [nami, bonney, thousandSunny],
	},
	{
		label: "5 DON!!",
		notes:
			"This is the first key turn: play ST31-001 Sanji, then OP15-088 Pirates Docking Six plus a cost-2-or-lower Straw Hat Crew character from trash if you have one. Docking Six helps set that up by trashing three cards on play. If you want the Leader effect buff, Brook is excellent once it's in the trash. Blocker Zoro is a fine defensive pivot when the game calls for it, and Sanji into Rush Luffy is also live here.",
		cards: [sanjiSt31, piratesDockingSix, brook, luffySt21, zoroBlocker],
	},
	{
		label: "7 DON!!",
		notes:
			"The preferred line is to run another Pirates Docking Six sequence. By now, the board you built the turn before already lets you exploit Sabo's leader effect much more aggressively while you keep adding characters.",
		cards: [piratesDockingSix],
	},
	{
		label: "9+ DON!!",
		notes:
			"Once the first Pirates Docking Six turns are done, move into your cost-7 Luffys. That's the natural next step in the curve and the point where your pressure really starts stacking.",
		cards: [luffySt31],
	},
];

const curveSecond = [
	{
		label: "2 DON!!",
		notes:
			"Use your searchers to find Sanji and Pirates Docking Six. You don't need to force a different line yet.",
		cards: [nami, bonney, thousandSunny],
	},
	{
		label: "4 DON!!",
		notes:
			"Keep searching for the missing pieces instead of drifting into side lines. You're still setting up the first ST31-001 Sanji into Pirates Docking Six turn.",
		cards: [nami, bonney, thousandSunny],
	},
	{
		label: "6 DON!!",
		notes:
			"Play Sanji, with the same alternate targets as going first : Rush Luffy if you want more pressure, or Pirates Docking Six into Zoro when you need a blocker. Brook is still a strong Pirates Docking Six-effect target to give Don to your leader if it’s already in the trash.",
		cards: [sanjiSt31, piratesDockingSix, brook, luffySt21, zoroBlocker],
	},
	{
		label: "8 DON!!",
		notes:
			"At 8 DON!!, you can start landing a cost-7 Luffy. If Thousand Sunny is already in play and you also have the cost-5 Luffy set up, you can give that cost-7 Luffy Rush and turn your development into immediate pressure.",
		cards: [luffySt31],
	},
	{
		label: "10 DON!!",
		notes:
			"After the first combo sequence, the plan is to keep playing your cost-7 Luffys. At this stage, you're mostly trying to cash in on the board you already built and keep extending with your bigger threats.",
		cards: [luffySt31],
	},
];

const optionsCards = [
	{
		...chopper,
		copy:
			"A defensive flex piece with Blocker, 6000 power during the opposing turn, and 2000 counter. The big selling point is flexibility: it shores up the board without becoming dead in hand, so it's worth considering if you want a more resilient list.",
	},
	{
		...zoroEb04,
		copy:
			"This one directly improves Sabo's defense while still adding offensive pressure. Since it's a Straw Hat Crew character, Nami, Bonney, and Thousand Sunny can all find it. It also gives the leader +2000 power by default, and when that stacks with Sabo's effect, your leader can reach 8000 power.",
	},
	{
		...garp,
		copy:
			"Garp adds another searcher to the deck, but it's less flexible than Bonney because it can only find characters that cost 3 or more. Since this list plays multiple cost-2 characters, Garp is more of an extra consistency layer than a clean replacement for your current search package.",
	},
	{
		...iHaveMyCrew,
		copy:
			"This is your cleanest answer to Electrical Luna. Sabo boards really don't want their cost-7-or-lower characters locked from restanding, and I Have My Crew!! can raise one of your characters by +3 cost while replacing itself. The downside is obvious: this deck doesn't have much DON!! to waste, so you have to be selective.",
	},
];

const matchups = [
	{
		label: "Slightly Favorable",
		tone: "up",
		icon: "^",
		leader: mihawk14,
		notes: [
			"The deck can develop multiple threats while still holding enough resources to answer the opponent's bigger bodies.",
			"Build Sanji into Pirates Docking Six quickly so you can take control of the board.",
			"Characters boosted by Sabo's leader effect make favorable trades much harder for Mihawk.",
			"Once your board is set, keep pressuring without overinvesting all your resources into one character.",
		],
	},
	{
		label: "Favorable",
		tone: "up",
		icon: "^",
		leader: gbLuffy,
		notes: [
			"Sabo can apply enough pressure before Green/Blue Luffy starts chaining its bigger restand turns.",
			"Try to assemble your combo as early as possible so you can take the board first.",
			"Use the leader effect to keep your board intact through opposing control attempts.",
			"Keep multiplying threats instead of loading all your power into one character.",
		],
	},
	{
		label: "Favorable",
		tone: "up",
		icon: "^",
		leader: katakuri11,
		notes: [
			"Play your normal game plan.",
			"Assemble Sanji into Pirates Docking Six quickly so you can keep the pace of the game in your hands.",
		],
	},
	{
		label: "Favorable",
		tone: "up",
		icon: "^",
		leader: st21Luffy,
