---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Monkey D. Luffy OP18 Deck Guide";
const description = "Monkey D. Luffy OP18 deck guide with decklist, mulligan priorities, going-first and going-second curves, tech cards, matchups, and gameplay tips.";
const guideIcon = "/assets/guides/Monkey.DLuffy%20OP18.png";
const card = (code, name, file, count = null, role = "Character") => ({ code, name, img: `/Cards/${file}`, count, role });

const leader = card("OP18-022", "Monkey.D.Luffy", "OP18/OP18-022 Monkey.D.Luffy.jpg", 1, "Leader");
const nami = card("EB02-017", "Nami", "EB02/EB02-017.jpg", 4);
const gonbe = card("OP18-025", "Gonbe", "OP18/OP18-025 Gonbe.jpg", 4);
const kokoro = card("OP18-024", "Kokoro", "OP18/OP18-024 Kokoro.jpg", 4);
const sanji = card("OP18-026", "Sanji", "OP18/OP18-026 Sanji.jpg", 4);
const chimney = card("OP18-028", "Chimney", "OP18/OP18-028 Chimney.jpg", 4);
const luffyCharacter = card("OP18-036", "Monkey.D.Luffy", "OP18/OP18-036-Monkey.D.Luffy.jpg", 4);
const robin = card("OP18-031", "Nico Robin", "OP18/OP18-031 Nico Robin.jpg", 4);
const zoroSogeking = card("OP18-027", "Zoro & Sogeking", "OP18/OP18-027 Zoro and Sogeking.jpg", 4);
const zoro = card("OP16-035", "Roronoa Zoro", "OP16/OP16-035.jpg", 2);
const luffyNine = card("OP18-118", "Monkey.D.Luffy", "OP18/OP18-118 Monkey D Luffy.jpg", 3);
const asura = card("OP12-037", "Demon Aura Nine Sword Style Asura Blades Drawn Dead Man's Game", "OP12/OP12-037.jpg", 2, "Event");
const twinJet = card("OP16-039", "Gum-Gum Twin Jet Pistol", "OP16/OP16-039.jpg", 3, "Event");
const shootDown = card("OP18-038", "Shoot Down That Flag", "OP18/OP18-038 Shoot Down That Flag.jpg", 4, "Event");
const giantAxe = card("OP18-039", "Gum-Gum Giant Axe", "OP18/OP18-039 Gum-Gum Giant Axe.jpg", 4, "Event");
const uglyFuture = card("OP17-038", "I Think He's Seen an Ugly Future...", "OP17/New OP17/OP17-038.jpg", null, "Event");
const zoroOp13 = card("OP13-037", "Roronoa Zoro", "OP13/OP13-037.jpg", null);
const chopperNine = card("OP18-029", "Tony Tony.Chopper", "OP18/OP18-029 Tony Tony.Chopper.jpg", null);
const namiOp14 = card("OP14-031", "Nami", "OP14/OP14-031.jpg", null);
const strongEvent = card("OP13-040", "I Know You're Strong... So I'll Go All Out from the Very Start!!!", "OP13/OP13-040.jpg", null, "Event");
const laboon = card("OP15-035", "Laboon", "OP15/OP15-035.jpg", null);
const asuraOp07 = card("OP07-036", "Demonic Aura Nine-Sword Style Asura Demon Nine Flash", "OP07/OP07-036.png", null, "Event");

const sundayLeader = card("OP18-041", "Ms. All Sunday", "OP18/OP18-041 Ms. All Sunday.jpg", null, "Leader");
const rocksLeader = card("OP17-039", "Rocks D. Xebec", "OP17/New OP17/OP17-039.jpg", null, "Leader");
const spandamLeader = card("OP18-079", "Spandam", "OP18/OP18-079 Spandam.jpg", null, "Leader");
const kaidoLeader = card("OP17-058", "Kaido", "OP17/New OP17/OP17-058.jpg", null, "Leader");
const purpleEnelLeader = card("OP15-058", "Purple Enel", "OP15/OP15-058.jpg", null, "Leader");
const redLawLeader = card("OP14-001", "Red Trafalgar Law", "OP14/OP14-001.jpg", null, "Leader");
const yellowEnelLeader = card("OP05-098", "Yellow Enel", "OP05/OP05-098.png", null, "Leader");
const frankyLeader = card("OP18-034", "Franky OP18", "OP18/OP18-034 Franky.jpg", null, "Leader");
const luffySt10Leader = card("ST10-001", "Monkey D. Luffy ST10", "ST10/ST10-001.png", null, "Leader");
const luffyAceLeader = card("ST30-001", "Luffy & Ace ST30", "ST30/ST30-001.jpg", null, "Leader");

const decklist = [leader, nami, gonbe, kokoro, sanji, chimney, luffyCharacter, robin, zoroSogeking, zoro, luffyNine, asura, twinJet, shootDown, giantAxe];
const simDeckCode = decklist.flatMap((entry) => {
  const lines = []; let remaining = entry.count;
  while (remaining > 4) { lines.push(`4x${entry.code}`); remaining -= 4; }
  if (remaining > 0) lines.push(`${remaining}x${entry.code}`);
  return lines;
}).join("\n");

const mulliganIntro = [
  "Green Luffy's opening hand mainly depends on having OP18-031 Nico Robin, which lets you fully use your Leader's effect, followed by OP18-027 Zoro & Sogeking to strengthen your defense while maintaining offensive pressure."
];
const mulligan = [
  { title: "OP18-031 Nico Robin", cards: [robin], paragraphs: [
    "The most important card to have in your opening hand.",
    "At the end of your turn, Robin lets you set a Water Seven card and a DON!! Active. This lets you attack twice with your Leader, then set it Active to get around the restriction on its effect during your next Refresh Phase.",
    "She is your best 4 DON!! turn play when going second or 5 DON!! turn play when going first."
  ]},
  { title: "EB02-017 Nami and OP18-038 Shoot Down That Flag", cards: [nami, shootDown], titleAboveCards: true, paragraphs: [
    "The deck's two Searchers can find Straw Hat Crew cards among the top five cards of your deck.",
    "They are especially important for finding Nico Robin, Zoro & Sogeking, and 2-cost Monkey.D.Luffy.",
    "However, the deck has no Water Seven Searcher, which makes some pieces difficult to find, especially Gonbe and Chimney."
  ]},
  { title: "OP18-027 Zoro & Sogeking", cards: [zoroSogeking], paragraphs: [
    "The best card to pair with Nico Robin in the midgame.",
    "Its On Play effect sets 2 DON!! Active and prevents an opposing Character with a Cost of 6 or less from becoming Rested until the end of your opponent's next turn.",
    "During your opponent's turn, if your Leader is Active with at least 3 DON!! attached, its base Power becomes 7000.",
    "Combined with Nico Robin, Zoro & Sogeking lets you maintain offensive pressure with both of your Leader's attacks while greatly strengthening your defense."
  ]},
  { title: "OP18-025 Gonbe and OP18-028 Chimney", cards: [gonbe, chimney], titleAboveCards: true, paragraphs: [
    "These two Characters are an important late-game combination because they let you make a third attack with your Leader.",
    "No Searcher in the deck can find them, so an opening hand with Gonbe, Chimney, and a Searcher is worth keeping.",
    "This combination is still secondary to Nico Robin and is not required to win every game. Two powerful attacks with your Leader may be enough."
  ]}
];
const mulliganGuidelines = [
  "Prioritize a hand with Nico Robin or Searchers that can find her.",
  "A hand with Robin and Zoro & Sogeking is especially good because it gives you access to your best midgame curve.",
  "A hand with Gonbe, Chimney, and a Searcher is also worth keeping because these two Characters cannot be searched directly.",
  "Once you have your midgame pieces, look for OP18-118 Monkey.D.Luffy to prepare your 9- and 10-DON!! turns."
];

const curveFirst = [
  { title: "1 DON!! — Find Your Pieces", cards: [nami, shootDown], connectors: ["OR"], paragraphs: [
    "Play one of your two Searchers: EB02-017 Nami or OP18-038 Shoot Down That Flag.",
    "Your priority is to find Nico Robin, then Zoro & Sogeking to prepare for your midgame."
  ]},
  { title: "3 DON!! — Continue Searching", cards: [nami, shootDown], connectors: ["+"], paragraphs: [
    "The deck has no major play at this point.",
    "You can use your Searchers to complete your hand or attack with your Leader."
  ]},
  { title: "5 DON!! — Play Nico Robin", cards: [robin], paragraphs: [
    "OP18-031 Nico Robin is your priority play.",
    "Her End of Your Turn effect sets a Water Seven card and a DON!! Active. This lets you make two attacks with your Leader on your next turns, then set it Active to get around the restriction on its effect.",
    "You can also use the Active DON!! during your opponent's turn for Counter Events.",
    "Robin gives your board additional protection: during your opponent's turn, when one of your Characters would be removed from the board by an opposing effect, you can rest Robin instead. However, this exposes her to opposing attacks."
  ]},
  { title: "7 DON!! — Zoro & Sogeking or Roronoa Zoro", cards: [zoroSogeking, zoro], connectors: ["OR"], paragraphs: [
    "You have two main options:",
    "OP18-027 Zoro & Sogeking: its On Play effect sets 2 DON!! Active and prevents an opposing Character with a Cost of 6 or less from becoming Rested until the end of your opponent's next turn. You can attach the 4 DON!! available to your Leader to make two attacks at 9000 Power.",
    "OP16-035 Roronoa Zoro is a 9000-Power Character whose On Play effect lets you set an opposing card Rested and attach 3 rested DON!! to your Leader by discarding a card from your hand. You can then make two attacks at 8000 Power while adding a large Character to your board.",
    "In either case, Nico Robin lets you set your Leader Active at the end of the turn.",
    "If you played Zoro & Sogeking, your Leader has 7000 base Power during your opponent's turn, provided it is Active with at least 3 DON!! attached.",
    "If Nico Robin is no longer on your board, make sure you have another way to set your Leader Active before making your second attack."
  ]},
  { title: "9 DON!! — Play Monkey.D.Luffy", cards: [luffyNine], paragraphs: [
    "OP18-118 Monkey.D.Luffy is your main late-game play.",
    "Its On Play effect sets 3 DON!! Active and prevents an opposing Character, regardless of Cost, from becoming Rested until the end of your opponent's next turn.",
    "You can therefore play a 10000-Power Character while making two 8000-Power attacks with your Leader.",
    "Its End of Your Turn effect can also set a Water Seven card Active. If Nico Robin is no longer on your board, Luffy can set your Leader Active instead."
  ]},
  { title: "10 DON!! — Maintain Pressure or Set Up Lethal", cards: [luffyNine, gonbe, chimney, twinJet], paragraphs: [
    "Keep playing OP18-118 Monkey.D.Luffy to develop your board, limit opposing attacks, and maintain pressure with your Leader.",
    "If your opponent is low enough on Life, you can also use your DON!! for late-game combinations with Gonbe, Chimney, and Gum-Gum Twin Jet Pistol."
  ]}
];

const curveSecond = [
  { title: "2 DON!! — Find Your Pieces", cards: [nami, shootDown], connectors: ["+"], paragraphs: [
    "Use EB02-017 Nami or OP18-038 Shoot Down That Flag to search for Nico Robin and Zoro & Sogeking.",
    "Your priority is to have Robin for your next turn."
  ]},
  { title: "4 DON!! — Play Nico Robin", cards: [robin], paragraphs: [
    "Play OP18-031 Nico Robin to prepare for your 6 DON!! turn.",
    "The Active DON!! at the end of your turn lets you use, among other things:",
    "OP18-039 Gum-Gum Giant Axe.",
    "OP12-037 Demon Aura Nine Sword Style Asura Blades Drawn Dead Man's Game."
  ]},
  { title: "6 DON!! — Play Zoro & Sogeking", cards: [zoroSogeking], paragraphs: [
    "With Nico Robin on your board, this is your best midgame sequence:",
  ], bullets: [
    "Play OP18-027 Zoro & Sogeking for 5 DON!!.",
    "Set 2 DON!! Active with its On Play effect.",
    "Prevent an opposing Character with a Cost of 6 or less from becoming Rested.",
    "Attach your 3 available DON!! to your Leader.",
    "Make two attacks at 8000 Power with your Leader.",
  ], after: [
    "At the end of the turn, Nico Robin sets your Leader and 1 DON!! Active.",
    "During your opponent's turn, you then have an Active Leader with 7000 base Power, a DON!! available for Counter Events, an opposing Character that cannot become Rested, and Nico Robin's protection against Removal effects.",
    "This sequence perfectly illustrates the deck's game plan: apply strong offensive pressure while strengthening your defense."
  ]},
  { title: "8 DON!! — Adapt Your Play", cards: [zoro, zoroSogeking], connectors: ["OR"], paragraphs: [
    "The deck has no particularly attractive Water Seven Character to play at 8 DON!!, so you can choose between:",
    "OP16-035 Roronoa Zoro: play a 9000-Power Character, set an opposing card Rested, and fuel your Leader's attacks.",
    "OP18-027 Zoro & Sogeking: continue limiting opposing attacks and reinforce your Leader's base Power in case one of your Zoro & Sogeking is removed from the board. In general, it is better not to attack with it during the midgame to increase the chance it stays on your board.",
    "Roronoa Zoro can also set an opposing Character Rested regardless of its Cost, letting you remove it with your attacks and reduce pressure on your Life."
  ]},
  { title: "10 DON!! — Play Monkey.D.Luffy", cards: [luffyNine], paragraphs: [
    "Play OP18-118 Monkey.D.Luffy to develop your board and prevent an opposing Character from becoming Rested."
  ], bullets: [
    "Use its On Play effect to set 3 DON!! Active.",
    "Use those DON!! and your remaining DON!! to make two attacks at 9000 Power with your Leader."
  ], after: [
    "If Nico Robin is still on your board, you have two effects that can set Water Seven cards Active at the end of your turn.",
    "You can set your Leader Active and also set a Water Seven Character that attacked, such as Nico Robin or Zoro & Sogeking.",
    "On later turns, keep playing your Monkey.D.Luffy or prepare lethal with the combinations below."
  ]}
];

const techCards = [
  { cards: [giantAxe], title: "OP18-039 Gum-Gum Giant Axe — Flexible Defense", paragraphs: [
    "This 1-cost Event gives one of your Monkey.D.Luffy Characters +2000 Power during a battle. If your Leader is Active, you also draw a card.",
    "It has good synergy with Nico Robin, who can set your Leader and 1 DON!! Active at the end of your turn. You can defend your Leader and replace the Event you used with a new card.",
    "Its main drawback is its restriction: it cannot defend your Characters that are not named Monkey.D.Luffy, especially Nico Robin and Zoro & Sogeking.",
    "This limitation is especially problematic when your opponent tries to remove Nico Robin after you have used her anti-Removal effect.",
    "Despite its popularity in Green Luffy decklists, Gum-Gum Giant Axe is still a debatable inclusion. You can reduce the number of copies or remove it entirely in favor of other defensive options."
  ]},
  { cards: [luffyCharacter], title: "OP18-036 Monkey.D.Luffy — Backup Leader Re-stand", paragraphs: [
    "This 2-cost Character is mainly a source of +2000 Counter.",
    "At the end of your turn, you may trash this Character to draw 1 card and set your Leader Active.",
    "It is a backup solution when you do not have Nico Robin to set your Leader Active after its second attack.",
    "Unlike Gonbe and Chimney, it can be found with your Searchers because it is a Straw Hat Crew card."
  ]},
  { cards: [kokoro], title: "OP18-024 Kokoro — Blocker and Leader Re-stand", paragraphs: [
    "Kokoro is a 2-cost Blocker that can also set your Leader Active at the end of your turn by placing herself in your Trash.",
    "It is generally better to keep her on your board to block an opposing attack rather than sacrifice her to set your Leader Active.",
    "Her effect is still a backup solution when your other re-stand options are unavailable."
  ]},
  { cards: [gonbe, chimney], title: "OP18-025 Gonbe + OP18-028 Chimney — Third Leader Attack", paragraphs: [
    "This combination is one of the less reliable deck-building choices in the decklist.",
    "It gives your Leader a third attack, but requires you to assemble two different Characters.",
    "The main issue is consistency: Gonbe and Chimney have the Water Seven type but not Straw Hat Crew, so the deck's Searchers cannot find them.",
    "They are also vulnerable to Removal, which can make the combination unusable before the decisive turn.",
    "There are still two advantages:"
  ], bullets: [
    "You can play both Characters ahead of time against decks with little Removal.",
    "Gonbe is useful on its own because it can attack and become Rested, allowing you to set your Leader Active at the end of your turn."
  ], after: ["Gonbe and Chimney should therefore be treated as an additional offensive option, not as the deck's main game plan."]},
  { cards: [twinJet], title: "OP16-039 Gum-Gum Twin Jet Pistol — Double Attack", paragraphs: [
    "This 1-cost Event gives one of your Monkey.D.Luffy Characters Double Attack for the turn.",
    "It is mainly used on your Leader to take advantage of its multiple attacks.",
    "Combined with Gonbe and Chimney, it lets your Leader make three attacks at 11000 Power with Double Attack at 10 DON!! if you need to play both Characters that turn.",
    "This card is a major threat to an opponent who still has a lot of Life.",
    "Its Trigger can also set the opposing Leader Rested, potentially preventing an attack if they have not attacked yet that turn."
  ]},
  { cards: [asura], title: "OP12-037 Demon Aura Nine Sword Style Asura Blades Drawn Dead Man's Game — Flexible Counter", paragraphs: [
    "This Event has both offensive and defensive uses:",
    "Counter: for 1 DON!!, give your Leader +3000 Power during a battle.",
    "Main: for 4 DON!!, rest up to two opposing DON!! or Characters.",
    "Its Main effect is especially useful for preparing lethal by neutralizing Blockers or Active DON!! kept for Counter Events.",
    "Do not use it too early. If your opponent still has enough resources to survive your attacks, it may be better to develop your board, particularly with OP18-118 Monkey.D.Luffy, and save this Event for a later turn."
  ]},
  { cards: [sanji], title: "OP18-026 Sanji — Removal Protection", paragraphs: [
    "Sanji provides additional protection from opposing Removal effects by placing himself in your Trash with his effect.",
    "He is especially important for protecting Nico Robin, who supports much of the game plan.",
    "Even when his protection effect is not needed, Sanji remains useful in hand as a +2000 Counter. Your Searchers can also find him because he is a Straw Hat Crew card."
  ]},
  { cards: [zoro], title: "OP16-035 Roronoa Zoro — Mid-Cost Flexibility", paragraphs: [
    "This 7-cost, 9000-Power Character helps fill out the deck's 7- and 8-DON!! turns, which otherwise have few natural options.",
    "Its On Play effect rests an opposing card and attaches 3 rested DON!! to your Leader by discarding a card from your hand.",
    "You can play a 9000-Power Character, neutralize a Blocker before lethal, make an opposing Character attackable, or rest an opposing DON!! while fueling your Leader's multiple attacks.",
    "At 10 DON!!, play Zoro, attach 3 rested DON!! with its effect, then attach your 3 remaining Active DON!! to your Leader. If your Leader can attack and has not used its re-stand effect, it can make two attacks at 11000 Power.",
    "Zoro is a flexible option rather than an essential deck piece. You can also choose not to play it and prioritize Zoro & Sogeking on your 7- and 8-DON!! turns."
  ]},
  { cards: [nami, shootDown], title: "EB02-017 Nami + OP18-038 Shoot Down That Flag — Searchers", paragraphs: [
    "These Searchers are essential for making the deck more consistent.",
    "Their priority is generally to find OP18-031 Nico Robin, since the Leader relies heavily on re-stand effects to maintain constant pressure.",
    "Once you have Robin, they can find other cards that meet their respective conditions and help prepare your next turns.",
    "They are particularly important because the deck has little natural card draw. However, they do not solve the problem completely: they can find eligible pieces, but not Gonbe or Chimney."
  ]},
  { cards: [sanji, zoro], title: "Deck-Building Trade-Off — Consistency and Card Draw", paragraphs: [
    "The main trade-off in this decklist is consistency. Re-stand cards are necessary to make full use of the Leader, but they take up many slots in a deck that already lacks card draw.",
    "More flexible choices, such as Sanji and Roronoa Zoro, should therefore be evaluated according to how useful they are across different situations."
  ]},
  { cards: [uglyFuture], optionalStart: true, title: "OP17-038 I Think He's Seen an Ugly Future...", paragraphs: [
    "This Event lets you discard a card from your hand to give your Leader +3000 Counter.",
    "It can make use of cards in your hand without Counter, such as Zoro & Sogeking or 9-cost Monkey.D.Luffy.",
