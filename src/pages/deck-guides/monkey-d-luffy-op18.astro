---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Monkey D. Luffy OP18 Deck Guide";
const description = "Monkey D. Luffy OP18 deck guide with decklist, mulligan priorities, going-first and going-second curves, tech cards, matchups, and gameplay tips.";
const guideIcon = "/assets/guides/Monkey.DLuffy%20OP18.png";
const card = (code, name, file, count = null, role = "Character") => ({ code, name, img: `/Cards/${file}`, count, role });

const leader = card("OP18-022", "Monkey.D.Luffy", "OP18/OP18-022 Monkey.D.Luffy.jpg", 1, "Leader");
const nami = card("EB02-017", "Nami", "EB02/EB02-017.jpg", 4);
const gonbe = card("OP18-025", "Gonbe", "OP18/OP18-025 Gonbe.jpg", 4);
const kokoro = card("OP18-024", "Kokoro", "OP18/OP18-024 Kokoro.jpg", 4);
const sanji = card("OP18-026", "Sanji", "OP18/OP18-026 Sanji.jpg", 4);
const chimney = card("OP18-028", "Chimney", "OP18/OP18-028 Chimney.jpg", 4);
const luffyCharacter = card("OP18-036", "Monkey.D.Luffy", "OP18/OP18-036-Monkey.D.Luffy.jpg", 4);
const robin = card("OP18-031", "Nico Robin", "OP18/OP18-031 Nico Robin.jpg", 4);
const zoroSogeking = card("OP18-027", "Zoro & Sogeking", "OP18/OP18-027 Zoro and Sogeking.jpg", 4);
const zoro = card("OP16-035", "Roronoa Zoro", "OP16/OP16-035.jpg", 3);
const luffyNine = card("OP18-118", "Monkey.D.Luffy", "OP18/OP18-118 Monkey D Luffy.jpg", 3);
const asura = card("OP12-037", "Demon Aura Nine Sword Style Asura Blades Drawn Dead Man's Game", "OP12/OP12-037.jpg", 4, "Event");
const twinJet = card("OP16-039", "Gum-Gum Twin Jet Pistol", "OP16/OP16-039.jpg", 4, "Event");
const shootDown = card("OP18-038", "Shoot Down That Flag", "OP18/OP18-038 Shoot Down That Flag.jpg", 4, "Event");

const sundayLeader = card("OP18-041", "Ms. All Sunday", "OP18/OP18-041 Ms. All Sunday.jpg", null, "Leader");
const rocksLeader = card("OP17-039", "Rocks D. Xebec", "OP17/New OP17/OP17-039.jpg", null, "Leader");
const spandamLeader = card("OP18-079", "Spandam", "OP18/OP18-079 Spandam.jpg", null, "Leader");
const kaidoLeader = card("OP17-058", "Kaido", "OP17/New OP17/OP17-058.jpg", null, "Leader");

const decklist = [leader, nami, gonbe, kokoro, sanji, chimney, luffyCharacter, robin, zoroSogeking, zoro, luffyNine, asura, twinJet, shootDown];
const simDeckCode = decklist.flatMap((entry) => {
  const lines = []; let remaining = entry.count;
  while (remaining > 4) { lines.push(`4x${entry.code}`); remaining -= 4; }
  if (remaining > 0) lines.push(`${remaining}x${entry.code}`);
  return lines;
}).join("\n");

const mulliganIntro = [
  "Your opening hand should have the cards you need to use your Leader's multiple attacks without suffering its main drawback: it cannot become Active during your next Refresh Phase.",
  "Your priority is to find OP18-031 Nico Robin while keeping a hand that can develop your board and prepare your first offensive turns."
];
const mulligan = [
  { title: "OP18-031 Nico Robin — Absolute Priority", cards: [robin], paragraphs: [
    "Nico Robin is the most important card to look for in your opening hand. Her End of Your Turn effect can set up to 1 {Water Seven} type Character and up to 1 DON!! as Active.",
    "This interaction is essential with your Leader. With 3 DON!! attached, Monkey.D.Luffy can become Active after his first attack and attack a second time, but he will not become Active during your next Refresh Phase. Nico Robin lets you get around this restriction by setting your Leader Active at the end of your turn.",
    "Once Robin is in play, you can use your Leader's two attacks much more consistently.",
    "Robin also has a useful protection effect: during your opponent's turn, if one of your Characters would leave the field because of an opposing effect, you can rest Robin instead. This helps you protect important pieces, although using this anti-Removal effect may cost you her end-of-turn restand because your opponent can attack into and rest her."
  ]},
  { title: "The Searchers — EB02-017 Nami and OP18-038 Shoot Down That Flag", cards: [nami, shootDown], connectors: ["OR"], titleAboveCards: true, textBesideCards: true, paragraphs: [
    "If you do not have Nico Robin in your hand, Nami and Shoot Down That Flag are your best options for finding her."
  ]},
  { title: "OP18-027 Zoro & Sogeking", cards: [zoroSogeking], paragraphs: [
    "This is an excellent card to have in your hand for your 6 DON!! turn. Its On Play effect sets up to 2 DON!! as Active, leaving you with enough resources to attach 3 DON!! to your Leader and use its two attacks.",
    "This combination lets you develop your board while maintaining significant offensive pressure."
  ]},
  { title: "OP18-024 Kokoro", cards: [kokoro], paragraphs: [
    "Kokoro is an interesting alternative when Nico Robin is unavailable. Her End of Your Turn effect lets you trash her to set your Leader Active, so it does not stay rested after using its ability.",
    "Unlike Robin, this is a one-time solution and costs you a Blocker, but it lets you continue using Monkey.D.Luffy's multiple attacks while you look for your main piece."
  ]}
];

const curveFirst = [
  { title: "1 DON!! — Search for Nico Robin", cards: [nami, shootDown], connectors: ["OR"], paragraphs: [
    "Play EB02-017 Nami or OP18-038 Shoot Down That Flag to search for Nico Robin.",
    "If you already have Robin in your hand, prioritize Zoro & Sogeking to prepare for the midgame. OP18-025 Gonbe is also a possible opening if you have Chimney and your opponent has little Removal."
  ]},
  { title: "3 DON!! — Develop Your Support Cards", cards: [kokoro, gonbe, chimney], connectors: ["OR", "+"], paragraphs: [
    "OP18-024 Kokoro is a good option when Robin is unavailable. Her effect lets you put her in the Trash to set your Leader Active at the end of your turn. Otherwise, having a Blocker in play is always useful.",
    "You can also play OP18-025 Gonbe and OP18-028 Chimney to prepare a third Leader attack later in the game.",
    "This combination is situational: it requires both Characters and works best when your opponent cannot easily remove them."
  ]},
  { title: "5 DON!! — Play Robin or Zoro & Sogeking", cards: [robin, zoroSogeking], connectors: ["OR"], paragraphs: [
    "OP18-031 Nico Robin is your priority. She can set your Leader and 1 DON!! Active at the end of your turn, supporting both your offense and defense on later turns.",
    "If you do not have Robin, OP18-027 Zoro & Sogeking is an alternative.",
    "Its On Play effect sets 2 DON!! as Active and can prevent an opposing Character with a Cost of 6 or less from becoming Rested. This can stop a Character from attacking or a Blocker from blocking your next attack.",
    "At this point, the 2 DON!! you get back are not enough to activate your Leader's ability immediately, which requires 3 DON!! attached. This is mainly a development turn."
  ]},
  { title: "7 DON!! — Roronoa Zoro or Zoro & Sogeking", cards: [zoro, zoroSogeking], connectors: ["OR"], paragraphs: [
    "OP16-035 Roronoa Zoro is an interesting option at this point in the curve.",
    "For 7 DON!!, you play a 9000-Power Character and can rest an opposing card. By discarding a card from your hand, you attach 3 rested DON!! to your Leader, allowing it to attack twice at 8000 Power.",
    "Zoro can rest a Blocker, a Character you want to attack, or an opposing DON!!.",
    "This card is a supplementary option rather than an absolute priority. Its discard cost can be painful in a deck that lacks card draw.",
    "OP18-027 Zoro & Sogeking is an alternative if you want to develop your board while keeping more resources. Its On Play effect can also prepare your Leader's multiple attacks."
  ]},
  { title: "9 DON!! — OP18-118 Monkey.D.Luffy", cards: [luffyNine, twinJet], connectors: ["OR"], paragraphs: [
    "OP18-118 Monkey.D.Luffy becomes your main development option.",
    "Its On Play effect attaches 3 rested DON!! to your Leader and can prevent an opposing Character from becoming Rested until the end of your opponent's next turn.",
    "Most importantly, it can set your Leader Active at the end of your turn, making it an excellent solution if Nico Robin has been removed or you have not found her.",
    "Its restand effect can also target another Character.",
    "If your board is already established, OP16-039 Gum-Gum Twin Jet Pistol is an offensive alternative: for 1 DON!!, it gives your Leader Double Attack, and you can use the remaining 8 DON!! to make two 13000-Power attacks with Double Attack.",
    "Prioritize Luffy to maintain pressure over multiple turns, and use Double Attack when you have a real opportunity to threaten your opponent's Life."
  ]}
];

const curveSecond = [
