  ]},
  { title: "OP17 Rocks D. Xebec", leader: rocksLeader, rating: "Unfavorable", ratingTone: "unfavorable", intro: [
    "Against Rocks, the game is about managing large opposing Characters and defensive resources.",
    "Use your Leader's multiple attacks to reduce your opponent's hand while preventing their most dangerous Characters from attacking freely."
  ], gamePlan: [
