---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Trafalgar Law OP14 EB05 Deck Guide";
const description = "Trafalgar Law OP14 deck guide for the EB05 format, with decklist, mulligan priorities, game plan, tech cards, matchups, and tips.";
const icon = "/assets/guides/trafalgar-law-op14.png";
const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const leader = card("OP14-001", "Trafalgar Law", "/Cards/OP14/OP14-001.jpg", 1, "Leader");
const killer = card("OP14-005", "Killer", "/Cards/OP14/OP14-005.jpg", 4);
const hawkins = card("OP14-010", "Basil Hawkins", "/Cards/OP14/OP14-010.jpg", 4);
const luffy = card("OP14-013", "Monkey.D.Luffy", "/Cards/OP14/OP14-013.jpg", 4);
const stussy = card("EB05-006", "Miss Buckingham Stussy", "/Cards/EB05/EB05-006 Miss Buckingham Stussy.jpg", 3);
const cavendish = card("OP14-004", "Cavendish", "/Cards/OP14/OP14-004.jpg", 4);
const bartolomeo = card("OP14-011", "Bartolomeo", "/Cards/OP14/OP14-011.jpg", 3);
const lawEb04 = card("EB04-005", "Trafalgar Law", "/Cards/EB04/EB04-005.jpg", 4);
const urouge = card("OP14-002", "Urouge", "/Cards/OP14/OP14-002.jpg", 4);
const rakuyo = card("OP17-016", "Rakuyo", "/Cards/OP17/New OP17/OP17-016.jpg", 2);
const kid = card("OP14-014", 'Eustass "Captain" Kid', "/Cards/OP14/OP14-014.jpg", 4);
const luckyRoux = card("PRB02-003", "Lucky.Roux", "/Cards/PRB02/PRB02-003.jpg", 4);
const bonney = card("EB05-001", "Jewelry Bonney", "/Cards/EB05/EB05-001 Jewelry Bonney.jpg", 4);
const drake = card("OP14-016", "X.Drake", "/Cards/OP14/OP14-016.jpg", 3);
const bonneyOp14 = card("OP14-007", "ewelry Bonney", "/Cards/OP14/OP14-007.jpg", 2);
const zoro = card("OP14-015", "Roronoa Zoro", "/Cards/OP14/OP14-015.jpg", 4);
const rushLaw = card("OP14-009", "Trafalgar Law", "/Cards/OP14/OP14-009.jpg", 3);
const newgate = card("OP17-005", "Edward.Newgate", "/Cards/OP17/New OP17/OP17-005.jpg", 2);
const eventSearcher = card("OP14-019", "I Have a Plan to Take Down One of the Four Emperors!", "/Cards/OP14/OP14-019.jpg", 4, "Event");
const buggyLeader = card("OP09-042", "Buggy OP09", "/Cards/OP09/OP09-042.jpg", null, "Leader");
const saboLeader = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg", null, "Leader");
const luffySt10Leader = card("ST10-002", "Monkey.D.Luffy ST10", "/Cards/ST10/ST10-002.png", null, "Leader");
const rogerLeader = card("OP13-003", "Gol D Roger OP13", "/Cards/OP13/OP13-003.jpg", null, "Leader");
const aceLeader = card("OP13-002", "Portgas.D.Ace OP13", "/Cards/OP13/OP13-002.jpg", null, "Leader");
const robinEb05Leader = card("EB05-010", "Nico Robin EB05", "/Cards/EB05/EB05-010 Nico Robin .jpg", null, "Leader");
const luffyGbLeader = card("OP16-022", "Green/Blue Luffy OP16", "/Cards/OP16/OP16-022.jpg", null, "Leader");
const rocksLeader = card("OP17-039", "Rocks D. Xebec OP17", "/Cards/OP17/New OP17/OP17-039.jpg", null, "Leader");

const decklist = [leader, killer, luffy, stussy, cavendish, bartolomeo, urouge, rakuyo, kid, luckyRoux, bonney, drake, bonneyOp14, rushLaw, newgate, eventSearcher];
const simDeckCode = decklist.flatMap((entry) => entry.count ? [`${entry.count}x${entry.code}`] : []).join("\n");

const mulliganSections = [
  { title: "Jewelry Bonney - Your Priority", cards: [bonney], text: "Jewelry Bonney EB05-001 is one of the cards you absolutely want to find.\n\nShe lets you develop your board while generating cards and provides a Power reduction that is especially important against Leaders with 6000 Power or more. This reduction also remains active during your opponent's turn, giving her both offensive and defensive value.\n\nPlaying multiple Bonneys in succession also generates a huge amount of resources and lets you maintain a very large hand throughout the game." },
  { title: "Increase Your Chances of Finding Bonney", cards: [eventSearcher, luffy], text: "I Have a Plan to Take Down One of the Four Emperors! OP14-019 is especially important early in the game because it increases your chances of finding Jewelry Bonney EB05-001.\n\nMonkey.D.Luffy OP14-013 also lets you prepare your development by searching for the other pieces you need.\n\nYour goal is therefore to have Bonney directly in your hand or enough Searchers to find her quickly." },
  { title: `Eustass "Captain" Kid - Prepare Your Board`, cards: [kid], text: `Eustass "Captain" Kid OP14-014 is also a very valuable card to have to prepare your development.\n\nIn addition to being a Blocker, his effect lets you play your small Characters and quickly fill your board. The more Characters capable of attacking you establish, the more effectively you can use your Leader's Power exchange.` },
  { title: "Do Not Overload Your Hand With Top End", cards: [[rushLaw, newgate], null], cardsAbove: true, text: "Trafalgar Law OP14-009 and Edward.Newgate OP17-005 can become very important later in the game, but they are not your main priorities in your opening hand.\n\nAbove all, your early game should let you find Bonney, prepare your board, and have the small Characters you need to start applying pressure." },
];

const gamePlan = [
  { title: "Early Game - Search & Setup", cards: [[luffy, eventSearcher, bonney]], cardsAbove: true, text: "Use Monkey.D.Luffy OP14-013 and I Have a Plan to Take Down One of the Four Emperors! OP14-019 to prepare your hand and prioritize finding Jewelry Bonney EB05-001.\n\nBonney is important enough to justify playing multiple ways to find her. Your goal is then to keep generating cards with your Bonneys, Lucky.Roux, or Urouge so you always have Characters to develop and Counter to defend." },
  { title: `Eustass "Captain" Kid - Fill Your Board`, cards: [kid, [killer, bartolomeo, urouge, luckyRoux, stussy]], text: `Eustass "Captain" Kid OP14-014 lets you develop your small Characters without having to invest all your resources in their cost.\n\nYou have several worthwhile targets, including Killer OP14-005, Bartolomeo OP14-011, Urouge OP14-002, Lucky.Roux PRB02-003, or Miss Buckingham Stussy EB05-006, depending on the situation.\n\nThese small Characters gain tremendous value with your Leader: even with low Power, they can receive the Power of a stronger attacker and then represent another big attack.` },
  { title: "Killer - Prepare Your Next Attacks", cards: [killer], text: "Killer OP14-005 gives you a small Character to transfer Power to while also giving you access to an additional DON!!.\n\nThis lets you develop your board while preparing more Power for your next attacks. You do not need every small Character to have high Power individually: Law's effect lets you redistribute the Power of your best attackers." },
  { title: "Jewelry Bonney - Your Main Engine", cards: [bonney, luckyRoux], text: "Jewelry Bonney EB05-001 should be used as often as possible to keep adding to your board and hand.\n\nShe can play Lucky.Roux, giving you access to a Blocker while generating even more cards. By playing multiple Bonneys in succession, your hand can quickly grow to 9 or 10 cards.\n\nHer -1000 Power reduction is also essential. Against a Leader with 6000 Power or more, you can reduce its Power so that your many attacks become much harder to defend.\n\nAbove all, this reduction lasts through your opponent's turn. Multiple Bonneys can therefore gradually lower a Leader's Power when it has 7000 Power or more, improving your offense while greatly reducing its ability to pressure you on its next turn." },
  { title: "Mid Game - Multiply Big Attacks With Your Leader", cards: [leader], text: "Once your board is established, the order of your attacks becomes essential.\n\nFirst attack with the Character whose Power you want to use. Then use Trafalgar Law's effect to exchange its Power with that of a weaker Character that has not attacked yet.\n\nThis lets you make several big attacks in succession with a board that was initially made up of small Characters.\n\nAlso look to create attack values that are difficult to defend. Attacks at 5000 and 7000 Power can force your opponent to use their Counters less efficiently." },
  { title: "Rakuyo - Handle Important Small Characters", cards: [rakuyo], text: "Rakuyo OP17-016 is especially useful against decks that rely on small utility Characters.\n\nHe can be particularly valuable against decks such as Red/Purple Luffy, Purple Enel, or Green/Blue Luffy, where several important cards have low Power.\n\nRemoving these Characters lets you disrupt your opponent's game plan while maintaining your own pressure." },
  { title: "Jewelry Bonney OP14-007 and Lucky.Roux - Maintain Your Resources", cards: [bonneyOp14, [bonneyOp14, drake, rushLaw, newgate], luckyRoux], text: "Jewelry Bonney OP14-007 provides a 2000 Counter, but her Power is also high enough for her to be used as a card to trash for Lucky.Roux's effect.\n\nAvailable targets for Lucky.Roux include Bonney OP14-007, X.Drake, Trafalgar Law OP14-009, and Edward.Newgate.\n\nThis lets you use Lucky.Roux more consistently to replenish your hand while playing a Blocker." },
  { title: "Trafalgar Law OP14-009 - Add a Big Attack Immediately", cards: [rushLaw], text: "Trafalgar Law OP14-009 gives you access to an immediate big attack thanks to Rush.\n\nHe also works especially well with your Leader's effect: after his attack, you can transfer his Power to one of your small Characters that is still available, turning it into another threat." },
  { title: "Edward.Newgate - An Offensive and Defensive Threat", cards: [newgate, null, null, stussy], text: "Edward.Newgate OP17-005 becomes especially valuable when an opposing Character with enough Power lets you play him for only 6 DON!!.\n\nFor that cost, you get a Character with 12000 Power while also raising your Leader to 8000 Power. This increase improves your pressure while making your Leader much harder to attack during the following turn.\n\nThis situation is especially valuable against threats such as Loki, the 10-cost Buggy, or other big opposing Characters.\n\nMiss Buckingham Stussy EB05-006 can also create a specific interaction with Newgate: by giving an opposing Character with 7000 Power an additional 3000 Power, it can reach the threshold needed to let you play Newgate for 6 DON!!." },
  { title: "Your General Plan", cards: [], text: "Your goal is therefore to gradually build a board capable of turning every small Character into a potential attacker, while keeping enough cards in hand to continue developing and defending:\n\nSearchers → Kid / board development → Bonney → resource generation and Power reduction → big attacks → Power exchange with Law → more big attacks → Law or Newgate to maintain pressure.\n\nThe fuller your board remains, the harder your Leader's effect becomes to handle: every small Character still available can receive a high Power value and become the next attack." },
];

const techCards = [
  { card: bonney, title: "Jewelry Bonney EB05-001", text: "**Jewelry Bonney** is the centerpiece of the decklist and one of your main sources of resources.\n\nShe lets you **develop your board while generating cards**, helping you keep enough Characters in play and Counter in hand. By playing multiple Bonneys in succession, you can quickly build a very large hand.\n\nHer **-1000 Power** reduction is just as important. It can target Leaders with **6000 Power or more**, allowing your many attackers to reach much more effective attack values.\n\nThis reduction remains active during your opponent's turn. With multiple Bonneys, you can therefore stack the reductions and greatly lower the Power of the same target for both your turn and your opponent's." },
  { card: killer, title: "Killer OP14-005", text: "**Killer** is especially well suited to how Law works because he gives you a small Character to use with the Leader's Power exchange while also giving you **one additional rested DON!! to attach to one of your Characters or your Leader each turn.**\n\nYou can transfer the Power of a Character that has already attacked to Killer, then use the additional DON!! to increase the pressure of your attacks even further." },
  { card: stussy, title: "Miss Buckingham Stussy EB05-006", text: `**Miss Buckingham Stussy** provides a **2000 Counter** and can also be played with **Eustass "Captain" Kid** or **Jewelry Bonney**.\n\nShe lets you take a Life, which can be especially useful when your opponent is trying to **deliberately limit your resources by refusing to attack your Leader**.\n\nYou can then choose between different uses of her Power modification. The **-4000 Power** can make a rested Character much easier to remove immediately, while the **+3000 Power** can strengthen a Character to prepare an attack.\n\nThere is also a more situational interaction with **Edward.Newgate**: increasing the Power of an opposing Character with 7000 Power by 3000 can allow it to reach the threshold needed to play Newgate for **6 DON!!**.` },
  { card: rakuyo, title: "Rakuyo OP17-016", text: "**Rakuyo** is especially valuable against decks that use many small utility Characters.\n\nHe can remove important cards in matchups such as **Red/Purple Luffy, Purple Enel, or Green/Blue Luffy**, where several useful Characters have low Power.\n\nThis lets you directly disrupt your opponent's engine without having to commit several attacks to those small targets." },
  { card: luckyRoux, title: "Lucky.Roux PRB02-003", text: `**Lucky.Roux** provides a **2000 Counter**, a Blocker, and an additional source of card draw.\n\nHe can be played with **Eustass "Captain" Kid** or **Jewelry Bonney EB05-001**, letting you develop your board while continuing to generate cards.\n\nTo benefit from his draw consistently, you have **Jewelry Bonney OP14-007, X.Drake OP14-016, Trafalgar Law OP14-009, and Edward.Newgate OP17-005** among the cards that can meet his discard requirement.` },
  { card: bonneyOp14, title: "Jewelry Bonney OP14-007", text: "**Jewelry Bonney OP14-007** provides a **2000 Counter** while improving **Lucky.Roux's** consistency.\n\nHer Power makes her a suitable card to discard for Lucky.Roux. She can therefore protect your Leader while she remains in your hand or serve as a resource to keep drawing when you need to replenish your hand." },
  { card: drake, title: "X.Drake OP14-016", text: "**X.Drake** provides **protection against removal** while giving you access to a Power reduction with his When Attacking effect.\n\nThis reduction can be combined with Bonney's to make a big target much more accessible. For example, you can stack several reductions before focusing your attacks on an opposing Character.\n\nX.Drake is also a suitable card for **Lucky.Roux's** draw effect." },
  { card: rushLaw, title: "Trafalgar Law OP14-009", text: "**Trafalgar Law** gives you access to an immediate big attack thanks to Rush.\n\nHis Power can then be transferred with your Leader effect to a small Character that has not attacked yet, allowing his arrival to turn into several dangerous attacks during the same turn.\n\nLaw can also provide a defensive option during your opponent's turn." },
  { card: newgate, title: "Edward.Newgate OP17-005", text: "**Edward.Newgate** combines a huge offensive threat with a substantial defensive benefit.\n\nAgainst an opposing Character with enough Power, you can play him for only **6 DON!!**. You then get a Character with **12000 Power** while raising your Leader to **8000 Power**.\n\nHe is especially valuable against big threats such as **Loki** or the **10-cost Buggy**: their presence lets you play Newgate at a reduced cost, while your Leader's 8000 Power makes opposing attacks much harder to get through.\n\nNewgate can also be very valuable against **Green/Yellow Nico Robin** and decks capable of making multiple attacks around 6000 Power." },
];

const matchups = [
  { title: "OP09 Buggy", leader: buggyLeader, intro: "Buggy can become difficult to handle once he starts establishing his big Characters, but **Edward.Newgate OP17-005** gives you an excellent answer to that transition into the late game.", points: [
    "Keep developing your board before Buggy starts playing his big threats in succession.",
    "When he plays his **10-cost Character**, you can take advantage of the situation to play **Edward.Newgate for 6 DON!!**, establish a 12000-Power body, and raise your Leader to 8000 Power.",
    "**Law's 8000 Power** is especially important for defending against the many 7000-Power attacks Buggy can generate.",
    "Use your established board to keep multiplying attacks through Power exchanges rather than slowing your pressure to try to compete solely with his big Characters.",
  ] },
  { title: "OP13 Sabo", leader: saboLeader, intro: "Sabo can quickly take control of the board if you give him enough time to establish his Characters.", points: [
    "Look to **play multiple Characters quickly** so you do not depend on a single big threat.",
    "**Jewelry Bonney EB05-001** is important for continuing to generate resources even when you need to commit cards to your board.",
    "Use your Power reductions to make opposing Characters easier to handle before committing your attacks to removing them.",
    "Your Leader effect remains essential: even after attacking with your strongest Character, you can transfer its Power to a small Character and keep up the pressure.",
  ] },
  { title: "ST10 Red/Purple Luffy", leader: luffySt10Leader, intro: "**Jewelry Bonney EB05-001** is especially important against Red/Purple Luffy because of his Leader's high Power.", points: [
    "One Bonney can reduce Luffy from **8000 to 7000 Power**, and multiple Bonneys can stack their reductions to bring him down even further.",
    "The reduction remains active during your opponent's turn. You therefore improve your own attacks while greatly reducing the pressure Luffy can apply on his next turn.",
    "Try to play multiple Bonneys in succession: in addition to the stacked reductions, they let you keep a large hand to defend against Luffy's explosive turns.",
    "Keep enough Counter and Blockers as you approach his late game. Red/Purple Luffy can generate a huge offensive turn with his **10-cost Luffy** and his extra turn.",
  ] },
  { title: "EB05 Green/Yellow Nico Robin", leader: robinEb05Leader, intro: "Against Nico Robin, your main goal is to **race** and take advantage of your ability to quickly generate multiple attacks.", points: [
    "Develop your board quickly and start applying pressure before Robin can establish her big threats.",
    "Use **Jewelry Bonney** to reduce the Power of her big Characters while continuing to develop your own board.",
    "Make multiple attacks at 5000 and 7000 Power, then use Law's effect to turn your small Characters into additional attackers.",
    "**Trafalgar Law OP14-009** gives you an additional Rush attack when you need to speed up to finish the game.",
    "**Edward.Newgate** can also help if the game goes long, but your priority remains to **race Robin before she can take control of the late game**.",
  ] },
  { title: "Green/Blue Luffy", leader: luffyGbLeader, intro: "Green/Blue Luffy has only **4 Life**, allowing you to adopt an especially aggressive game plan.", points: [
    "Look to **race Luffy** by quickly playing multiple attackers.",
    "**X.Drake** and your Power exchanges let you turn your board into a sequence of 7000-Power attacks.",
    "Use **Jewelry Bonney's** reduction before your attacks when you want to handle a Character such as Crocodile or a Blocker.",
    "Watch out for Triggers that can bounce your Characters or send them to the bottom of your deck. When you are concerned about an important Trigger, it may be better to make certain attacks **before developing your board further**.",
    "Keep enough Counter and Blockers when Luffy approaches a turn where he can try to finish the game.",
  ] },
  { title: "Rocks D. Xebec", leader: rocksLeader, intro: "Against Rocks, you need to maintain your pressure while avoiding letting his small utility Characters generate too much value.", points: [
    "Try to build your attacks around values such as **5000 and 7000 Power**, which make your opponent's Counters less comfortable to use.",
    "**Jewelry Bonney** and **X.Drake** can combine their Power reductions to make his Characters easier to remove.",
    "Watch out for **Miss Buckingham Stussy**: she can prevent your small Characters from contributing effectively to your pressure. When multiple small threats are established, use your reductions and attacks in the right order to try to remove several of them during the same turn.",
    "When Rocks develops a very big threat, **Edward.Newgate** can become your best way to regain the advantage: his 12000-Power body maintains your pressure while your Leader's 8000 Power makes your defense much stronger.",
  ] },
];

const tips = [
  { cards: [bonney], text: "**Use Jewelry Bonney before starting your attacks.** Her Power reduction can completely change the values you need to apply pressure, especially against Leaders with high Power. Multiple Bonneys can stack their reductions on the same target." },
  { cards: [bonney, luffySt10Leader], text: "**Remember that Bonney's reduction remains active during your opponent's turn.** Bringing a Leader from 8000 to 7000, 6000, or even less improves your attacks, but also makes your opponent's attacks much easier to defend on their next turn." },
  { cards: [leader], text: "**Attack before exchanging Power.** First attack with your strongest Character, then use Law's Leader effect to transfer its Power to a small Character that has not attacked yet. This is what lets your 2000-Power Characters become new 7000- or 8000-Power attackers." },
  { cards: [leader], text: "**Plan your attack sequence before using your DON!!.** Law can generate multiple big attacks from the same Power. Decide in advance which Character will attack first and which one will receive its Power afterward." },
  { cards: [killer], text: "**Make use of the additional DON!! provided by Killer.** Killer remains an ideal small body to receive Power from your Leader, while giving you more DON!! to strengthen your other attacks." },
  { cards: [rakuyo], text: "**Use Rakuyo to remove important small utility Characters.** Cards such as Lucky.Roux, Nami, and other low-Power Characters can generate a lot of value if you leave them on the board." },
  { cards: [bonneyOp14, drake, rushLaw, newgate], text: "**Choose carefully what you discard with Lucky.Roux.** Jewelry Bonney OP14-007, X.Drake, Trafalgar Law, and Edward.Newgate can let you activate his draw, but always check whether you will need the card later in the game." },
  { cards: [stussy], text: "**Miss Buckingham Stussy can help when your opponent refuses to give you cards from Life.** Taking a Life card yourself lets you gain an additional resource while making use of her Power modification options." },
  { cards: [bonney, drake], text: "**Stack your Power reductions before attacking a big Character.** Bonney and X.Drake can make a target much easier to remove when used together." },
  { cards: [newgate], text: "**Do not think of Edward.Newgate only as an offensive threat.** Raising your Leader to **8000 Power** can be just as important as the 12000-Power Character itself, especially against decks that make multiple 7000-Power attacks." },
  { cards: [newgate], text: "**Watch for opportunities to play Edward.Newgate for 6 DON!!.** When an opposing Character meets the necessary condition, you can establish your 12000-Power Character and strengthen your Leader without devoting all your resources for the turn to Newgate." },
];

const contentRows = (item) => {
  const paragraphs = item.text.split("\n\n");
  if (paragraphs.length === 1) return [{ cards: item.cards, text: paragraphs[0] }];
  return paragraphs.map((text, index) => ({ cards: Array.isArray(item.cards[index]) ? item.cards[index] : item.cards[index] ? [item.cards[index]] : [], text }));
};
---

<MainLayout title={title} description={description}>
  <section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span>Deck Guide</span><span>EB05 Format</span></div><h1>Trafalgar Law OP14 Deck Guide</h1><p class="hero-intro">Trafalgar Law OP14 quickly fills its board with small Characters, then uses its Leader effect to exchange their Power and turn them into real attackers.</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Game Plan &amp; Curve</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div></div><div class="guide-icon"><img src={icon} alt="Trafalgar Law OP14 deck guide icon" loading="eager" /></div></div></section>
  <section class="list-section"><div class="container article-stack">
    <section id="decklist" class="glow-block"><div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim={simDeckCode}>Copy for Sim</button></div></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><b class="deck-count">{entry.count}x</b><span>{entry.name}<small class="deck-code">{entry.code}</small><small class="deck-role">{entry.role}</small></span></div></button>)}</div></section>
    <section id="mulligan" class="glow-block"><h2>Mulligan</h2><p>Your priority is to <strong>quickly establish your game engine</strong>, with particular attention to <strong>Jewelry Bonney EB05-001</strong>. She is the centerpiece of your development, and the decklist plays several ways to find her as consistently as possible.</p><div class="content-list">{mulliganSections.map((item) => <article class:list={["content-item", item.cardsAbove && "cards-above"]}><h3>{item.title}</h3><div class="item-rows">{contentRows(item).map((row) => <div class="content-row">{row.cards.length ? <div class="card-row">{row.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div> : <div class="card-slot" aria-hidden="true"></div>}<div class="paragraphs"><p>{row.text}</p></div></div>)}</div></article>)}</div><article class="content-item"><h3>Ideal Mulligan</h3><p>Look primarily for a combination that includes <strong>Jewelry Bonney EB05-001</strong>, <strong>Monkey.D.Luffy OP14-013 / I Have a Plan to Take Down One of the Four Emperors! OP14-019</strong>, and <strong>Eustass "Captain" Kid OP14-014</strong> to prepare your development.</p><p>The goal is to have <strong>Bonney or a way to find her quickly</strong>, then enough Characters to start building the board Law will use for his Power exchanges.</p></article></section>
    <section id="curve" class="glow-block"><h2>Game Plan &amp; Curve</h2><p>Trafalgar Law OP14 looks to quickly fill its board with small Characters, then maintain constant pressure through its Leader effect, which lets you exchange the Power of two of your Characters.</p><p>The principle is to attack with a powerful Character, then transfer its Power to a small Character that has not attacked yet. A Character with only 2000 Power can thus become your next attacker at 7000 or 8000 Power.</p><p>Jewelry Bonney EB05-001 is at the center of this plan. She lets you keep developing your board, generate cards, and reduce your opponent's Power, while giving Law enough resources to maintain this pressure over several turns.</p><div class="content-list">{gamePlan.map((item) => <article class:list={["content-item", item.cardsAbove && "cards-above"]}><h3>{item.title}</h3><div class="item-rows">{contentRows(item).map((row) => <div class="content-row">{row.cards.length ? <div class="card-row">{row.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div> : <div class="card-slot" aria-hidden="true"></div>}<div class="paragraphs"><p>{row.text}</p></div></div>)}</div></article>)}</div></section>
    <section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><div class="content-list">{techCards.map((item) => <article class:list={["tech-card", !item.card && "text-only-card"]}><div class="tech-card-heading">{item.card && <button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={getCardThumbnail(item.card.img)} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button>}<h3>{item.title}</h3></div><div class="paragraphs">{item.text.split("\n\n").map((paragraph) => <p>{paragraph.split(/(\*\*.*?\*\*)/g).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</p>)}</div></article>)}</div></section>
    <section id="matchups" class="glow-block"><h2>Matchups</h2><div class="matchup-grid">{matchups.map((item) => <article class="matchup-card"><div class="matchup-heading">{[item.leader].map((entry) => <button class="mini-card matchup-leader-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}<h3>{item.title}</h3></div><p>{item.intro.split(/(\*\*.*?\*\*)/g).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</p><ul>{item.points.map((point) => <li>{point.split(/(\*\*.*?\*\*)/g).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</li>)}</ul></article>)}</div></section>
    <section id="tips" class="glow-block"><h2>Tips</h2><div class="tips-list">{tips.map((item) => <article class="tip-card"><div class="card-row cards-per-row" style={`grid-template-columns:repeat(${item.cards.length},minmax(0,1fr))`}>{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>{item.text.split(/(\*\*.*?\*\*)/g).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</p></article>)}</div></section>
  </div></section>
  <div class="card-modal" data-modal aria-hidden="true"><div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview"><button class="modal-close" type="button" data-close>Close</button><img src="" alt="" data-modal-image /></div></div>
</MainLayout>

<script>
  const modal = document.querySelector("[data-modal]"); const modalImage = document.querySelector("[data-modal-image]");
  const closeModal = () => { modal?.classList.remove("is-open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; };
  document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !modalImage) return; modalImage.src = button.dataset.full || ""; modalImage.alt = button.dataset.name || "Card preview"; modal.classList.add("is-open"); modal.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; }));
  document.querySelector("[data-close]")?.addEventListener("click", closeModal); modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
  document.querySelectorAll("[data-copy-sim]").forEach((button) => button.addEventListener("click", async () => { const deck = button.dataset.copySim; if (!deck) return; const previous = button.textContent; try { await navigator.clipboard.writeText(deck); button.textContent = "Copied"; } catch { button.textContent = "Copy failed"; } window.setTimeout(() => { button.textContent = previous; }, 1800); }));
</script>

