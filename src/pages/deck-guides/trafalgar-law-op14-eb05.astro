---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Trafalgar Law OP14 EB05 Deck Guide";
const description = "Trafalgar Law OP14 deck guide for the EB05 format, with decklist, mulligan priorities, game plan, tech cards, matchups, and tips.";
const icon = "/assets/guides/trafalgar-law-op14.png";
const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const leader = card("OP14-001", "Trafalgar Law", "/Cards/OP14/OP14-001.jpg", 1, "Leader");
const hawkins = card("OP14-010", "Basil Hawkins", "/Cards/OP14/OP14-010.jpg", 4);
const luffy = card("OP14-013", "Monkey.D.Luffy", "/Cards/OP14/OP14-013.jpg", 4);
const cavendish = card("OP14-004", "Cavendish", "/Cards/OP14/OP14-004.jpg", 4);
const bartolomeo = card("OP14-011", "Bartolomeo", "/Cards/OP14/OP14-011.jpg", 4);
const lawEb04 = card("EB04-005", "Trafalgar Law", "/Cards/EB04/EB04-005.jpg", 4);
const urouge = card("OP14-002", "Urouge", "/Cards/OP14/OP14-002.jpg", 4);
const kid = card("OP14-014", "Eustass \"Captain\" Kid", "/Cards/OP14/OP14-014.jpg", 4);
const luckyRoux = card("PRB02-003", "Lucky.Roux", "/Cards/PRB02/PRB02-003.jpg", 4);
const bonney = card("EB05-001", "Jewelry Bonney", "/Cards/EB05/EB05-001 Jewelry Bonney.jpg", 4);
const drake = card("OP14-016", "X.Drake", "/Cards/OP14/OP14-016.jpg", 2);
const zoro = card("OP14-015", "Roronoa Zoro", "/Cards/OP14/OP14-015.jpg", 4);
const rushLaw = card("OP14-009", "Trafalgar Law", "/Cards/OP14/OP14-009.jpg", 2);
const newgate = card("OP17-005", "Edward.Newgate", "/Cards/OP17/New OP17/OP17-005.jpg", 2);
const eventSearcher = card("OP14-019", "I Have a Plan to Take Down One of the Four Emperors!", "/Cards/OP14/OP14-019.jpg", 4, "Event");
const buggyLeader = card("OP09-042", "Buggy OP09", "/Cards/OP09/OP09-042.jpg", null, "Leader");
const saboLeader = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg", null, "Leader");
const luffySt10Leader = card("ST10-002", "Monkey.D.Luffy ST10", "/Cards/ST10/ST10-002.png", null, "Leader");
const rogerLeader = card("OP13-003", "Gol D Roger OP13", "/Cards/OP13/OP13-003.jpg", null, "Leader");
const aceLeader = card("OP13-002", "Portgas.D.Ace OP13", "/Cards/OP13/OP13-002.jpg", null, "Leader");
const robinEb05Leader = card("EB05-010", "Nico Robin EB05", "/Cards/EB05/EB05-010 Nico Robin .jpg", null, "Leader");

const decklist = [leader, hawkins, luffy, cavendish, bartolomeo, lawEb04, urouge, kid, luckyRoux, bonney, drake, zoro, rushLaw, newgate, eventSearcher];
const simDeckCode = decklist.flatMap((entry) => entry.count ? [`${entry.count}x${entry.code}`] : []).join("\n");

const mulliganSections = [
  { title: "Cards to Prioritize", cards: [luffy, eventSearcher, bonney], text: "Monkey.D.Luffy OP14-013 is an excellent start thanks to its search effect. It helps prepare your next turns and can help you find the cards you need for development.\n\nI Have a Plan to Take Down One of the Four Emperors! OP14-019 is also important early. The decklist plays it in particular to improve the consistency with which you find Jewelry Bonney.\n\nFinally, Jewelry Bonney EB05-001 is clearly one of the cards you want to have available. It allows Law OP14 to become much more viable again." },
  { title: "Prepare Your Board Development With Eustass \"Captain\" Kid", cards: [kid, hawkins], cardsAbove: true, text: "When you go second, Eustass \"Captain\" Kid OP14-014 is especially valuable to have alongside your early-game cards." },
  { title: "Do Not Overload Your Hand With Top End", cards: [zoro, rushLaw, newgate], text: "Roronoa Zoro OP14-015 is your preferred top-end option in this decklist, especially because its 7 DON!! cost leaves you more resources to make other large attacks during the same turn.\n\nTrafalgar Law OP14-009 is included at only 2 copies for situations where you need even more Rush.\n\nEdward.Newgate OP17-005 is mainly included to answer Elbaf decks, especially Loki. It is therefore not a card you need to build your opening hand around every time." },
];

const gamePlan = [
  { title: "Early Game - Search & Setup", cards: [luffy, eventSearcher, kid], text: "Start by using Monkey.D.Luffy OP14-013 and I Have a Plan to Take Down One of the Four Emperors! OP14-019 to prepare your next turns.\n\nThe Event is played in particular to increase your chances of finding Jewelry Bonney, while Luffy lets you pick up the other pieces you need for development.\n\nWhen going second, look in particular for access to Eustass \"Captain\" Kid OP14-014 to begin establishing your board." },
  { title: "Eustass \"Captain\" Kid - Fill Your Board", cards: [kid, hawkins], text: "Eustass \"Captain\" Kid OP14-014 lets you begin developing several small Characters, including Basil Hawkins OP14-010.\n\nThese small Characters are essential to how Law works. Their low starting Power is not necessarily a problem because they can later receive the Power of a stronger Character through your Leader. The more Characters you have that can attack, the more opportunities you have to redistribute your Power and maintain pressure.\n\nDo not automatically play every card just to fill the board, however. With a limited number of 2000 Counters in the decklist, keeping some Characters in hand may be necessary to ensure your defense." },
  { title: "Jewelry Bonney - The Central Engine of This New Version", cards: [bonney, luckyRoux], text: "Jewelry Bonney EB05-001 greatly improves the deck's ability to develop its board while maintaining its resources.\n\nBonney can play Lucky.Roux PRB02-003, letting you get a Blocker while generating additional cards. You can even develop several Lucky.Roux when your hand allows it.\n\nBonney also provides Power reduction, which works especially well with Law's plan. Before you begin your important attacks, reduce the Power of an opposing Character you want to remove, or of the Leader when it is a valid target.\n\nWith several Bonneys, you can stack the reductions on the same target and make all your following attacks harder to defend." },
  { title: "Mid Game - Multiply Large Attacks With Your Leader", cards: [leader, hawkins, zoro], text: "Once several Characters are established, look to make the most of Trafalgar Law's Power exchange.\n\nYour attack sequence then becomes especially important. First attack with the Character whose Power you want to transfer. Once that attack is finished, exchange its Power with that of a weaker Character that has not attacked yet. You can then reuse a high Power value to create another attack.\n\nA small Character that initially represented only a minor threat can therefore become your next large attacker. This mechanic lets Law maintain strong pressure with a board made up largely of small Characters.\n\nJewelry Bonney completes this plan: while Law improves the quality of your own attacks through Power exchanges, Bonney can reduce opposing Power to make those attacks even more effective." },
  { title: "7 DON!!+ - Roronoa Zoro to Maintain Pressure", cards: [zoro, leader], text: "Roronoa Zoro OP14-015 is especially suited to the deck's plan. Its 7 DON!! cost leaves you resources available to continue your turn while immediately giving you a powerful attacker.\n\nZoro becomes even more valuable with the Leader effect. You can attack with its 8000 Power, then transfer that Power to one of your small Characters that has not attacked yet. Your opponent must then defend another large attack from a Character that was initially much less threatening." },
  { title: "Trafalgar Law OP14-009 - A Heavier Rush Option", cards: [rushLaw], text: "Trafalgar Law OP14-009 gives you another option when you need to add a large attack immediately.\n\nIt also provides a defensive option: during an opposing attack, its effect can make your Leader 10000 Power once by trashing two cards from your hand." },
  { title: "Edward.Newgate - An Answer to Large Threats", cards: [newgate], text: "Edward.Newgate OP17-005 is mainly included for Elbaf matchups and can answer Loki in particular.\n\nIt also makes your Leader 8000 Power and is itself a 12000-Power threat, giving it both strong defensive and offensive value. It is also especially valuable against Green/Yellow Nico Robin." },
  { title: "Your General Plan", cards: [null, null, null, zoro], text: "Your goal is therefore to gradually build a board that can turn every small Character into a potential threat:\n\nSearchers → Kid / board development → Bonney + Characters → opposing Power reduction → large attack → Power exchange with Law's effect → another large attack → Zoro or another top end to maintain pressure.\n\nThe deck's strength does not come only from its large Characters: it comes above all from your ability to reuse their Power with Trafalgar Law's effect to multiply dangerous attacks across your entire board." },
];

const techCards = [
  { card: bonney, title: "Jewelry Bonney EB05-001", text: "Jewelry Bonney is the main addition to this decklist and one of the deck's most important cards.\n\nIt gives Law several options: developing your board, drawing more cards, and above all reducing opposing Power. This reduction can be used on a Character you want to remove, but also on the opposing Leader if it has 6000 Power, to improve all your attacks during the turn.\n\nWith several Bonneys, you can stack the reductions. A sufficiently reduced Leader or Character then becomes much easier to attack with your many small and mid-sized attackers." },
  { card: luckyRoux, title: "Lucky.Roux PRB02-003", text: "Lucky.Roux provides a 2000 Counter that can also be played with Eustass \"Captain\" Kid or Jewelry Bonney.\n\nIt can serve as a Blocker while providing draw. You can use Bonney to play Lucky.Roux, benefit from Bonney's draw, then get an additional card through Lucky.Roux.\n\nBe careful with the cards you can discard for its effect: suitable targets include X.Drake and your top-end cards. Most of your other 2-cost Characters do not let you benefit from it in the same way." },
  { card: drake, title: "X.Drake OP14-016", text: "It provides protection against removal, while its Power reduction also remains useful. Two copies let you keep this option without making the decklist too heavy, since it already plays more cards without Counter with the arrival of Bonney." },
  { card: zoro, title: "Roronoa Zoro OP14-015", text: "Roronoa Zoro is the preferred top end.\n\nIts 7 DON!! cost lets you keep DON!! available after playing it and combine its attack with other offensives during the same turn. It therefore fits Law's plan well, which looks to multiply threats rather than invest all its resources into a single card." },
  { card: rushLaw, title: "Trafalgar Law OP14-009", text: "It can be useful when you need to make a large attack immediately. Its effect during an opposing attack also gives you a defensive option that lets your Leader reach 10000 Power once." },
  { card: newgate, title: "Edward.Newgate OP17-005", text: "Edward.Newgate is mainly a choice for Elbaf decks.\n\nAgainst Loki, you can use Newgate as an immediate answer. It also makes your Leader 8000 Power while being a 12000-Power threat itself.\n\nIt is also especially valuable against Green/Yellow Nico Robin. Its usefulness is more limited against certain other decks, however, which explains why it is included at only 2 copies." },
  { card: null, title: "A Tight Counter Ratio", text: "Adding 4 Bonneys forces this version to make some concessions. The list is down to only 8 cards with 2000 Counter.\n\nThis ratio is not definitively optimal. Avoid wasting Counter cards when their presence on the board does not provide enough value: some small Characters can be more useful kept in hand to defend your Leader." },
];

const matchups = [
  { title: "OP09 Buggy", leader: buggyLeader, points: ["Buggy can be difficult for Law because of its bottom-deck effects, which can remove your Characters without simply attacking them. Alvida and the other control tools can disrupt your board and force you to rebuild regularly.", "Try to keep enough Characters on the board to continue multiplying attacks even after removal.", "Roronoa Zoro is especially valuable for immediately applying pressure again with its large attack.", "Pay attention to opposing Blockers when setting up lethal: calculate all your attacks before starting your sequence so you do not invest more resources than necessary.", "Do not automatically develop every small Character. If their presence does not provide anything immediately, keeping their Counter in hand may be more important."] },
  { title: "OP13 Sabo", leader: saboLeader, points: ["Sabo can quickly build a board of several dangerous attackers, especially with Loki, Usopp, and Pirate Docking Six. You must avoid letting that board develop without an answer.", "Use Jewelry Bonney to gradually reduce the Power of an important Character before focusing your attacks on it.", "With several Bonneys, the reductions can stack and turn a large threat into a much more accessible target for your small attackers.", "Lucky.Roux is valuable defensively through its role as a Blocker when Sabo begins multiplying attacks.", "Do not forget to activate the Power reductions from your available Bonneys: a few thousand less Power can directly change the amount of Counter needed to survive the opposing turn.", "Edward.Newgate can also be very important if Sabo plays Loki, since it gives you a direct answer to that threat."] },
  { title: "ST10 Red/Purple Luffy", leader: luffySt10Leader, points: ["Jewelry Bonney's Power reduction is especially valuable against a Leader with high base Power.", "Use Bonney on the Leader before beginning your attacks to improve your entire offensive sequence.", "Several Bonneys can stack their reductions. An 8000-Power Leader can gradually be brought down to a much easier value to attack.", "Once its Power is reduced, distribute your DON!! correctly between your attacks rather than unnecessarily creating ineffective intermediate values.", "Keep enough Counter in hand: Red/Purple Luffy can generate turns with several very large attacks and threaten lethal quickly.", "Edward.Newgate can be decisive defensively in this situation. Making your Leader 8000 Power greatly increases the cost of the attacks needed to finish you and can let you survive a very aggressive turn."] },
  { title: "EB05 Green/Yellow Nico Robin", leader: robinEb05Leader, points: ["Edward.Newgate is also especially effective against Green/Yellow Nico Robin.", "It gives you access to a large threat while making Law 8000 Power, which makes opposing attacks much more costly to push through."] },
];

const tips = [
  { cards: [bonney], text: "Use Jewelry Bonney before beginning your attacks. Its Power reduction improves every attack that follows. If you have several Bonneys, you can stack the reductions on the same target to make it much easier to attack." },
  { cards: [hawkins, luckyRoux, bartolomeo, lawEb04], text: "Do not automatically play every small Character. With only 8 cards with 2000 Counter, your defense can quickly become limited. If a Character does not provide enough value on the board, keeping it as Counter may be preferable." },
  { cards: [bonney, luckyRoux], text: "Use Bonney to play Lucky.Roux. This gives you a Blocker, lets you benefit from Bonney's draw, then draw an additional card with Lucky.Roux if you have a card in hand that is suitable to trash for its effect." },
  { cards: [luckyRoux, bonney, drake, zoro], text: "Choose the cards used with Lucky.Roux correctly. Suitable cards include Jewelry Bonney, X.Drake, and your top-end cards. Most of your other 2-cost Characters do not allow you to benefit from its draw effect." },
  { cards: [bonney], text: "Reduce Power before trying to remove a large threat. With one or more Bonneys, you can gradually bring a powerful Character down to a value your many attackers can reach instead of investing a huge amount of DON!! into one attack." },
  { cards: [zoro], text: "Calculate your lethal before committing your DON!!. With Zoro and several Characters already established, you can have enough attacks to finish the game without overinvesting in the first ones. Distribute your DON!! based on the Counter thresholds you want to force." },
  { cards: [newgate], text: "Keep Edward.Newgate for matchups where it truly provides an answer. It is especially valuable against Loki and EB05 Green/Yellow Nico Robin. Making your Leader 8000 Power can also be decisive when you need to survive a very aggressive turn." },
  { cards: [bonney, luffySt10Leader, rogerLeader, aceLeader], text: "Do not forget that Bonney can also target the Leader. Against a Leader whose Power has been increased, reducing its Power before your attacks can be enough to make all your attackers effective again." },
];

const contentRows = (item) => {
  const paragraphs = item.text.split("\n\n");
  if (paragraphs.length === 1) return [{ cards: item.cards, text: paragraphs[0] }];
  return paragraphs.map((text, index) => ({ cards: item.cards[index] ? [item.cards[index]] : [], text }));
};
---

<MainLayout title={title} description={description}>
  <section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span>Deck Guide</span><span>EB05 Format</span></div><h1>Trafalgar Law OP14 Deck Guide</h1><p class="hero-intro">Trafalgar Law OP14 quickly fills its board with small Characters, then uses its Leader effect to exchange their Power and turn them into real attackers.</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Game Plan &amp; Curve</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div></div><div class="guide-icon"><img src={icon} alt="Trafalgar Law OP14 deck guide icon" loading="eager" /></div></div></section>
  <section class="list-section"><div class="container article-stack">
    <section id="decklist" class="glow-block"><div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim={simDeckCode}>Copy for Sim</button></div></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><b class="deck-count">{entry.count}x</b><span>{entry.name}<small class="deck-code">{entry.code}</small><small class="deck-role">{entry.role}</small></span></div></button>)}</div></section>
    <section id="mulligan" class="glow-block"><h2>Mulligan</h2><p>Your priority is to find the cards that let you establish your game engine quickly, with particular attention to Jewelry Bonney EB05-001.</p><div class="content-list">{mulliganSections.map((item) => <article class:list={["content-item", item.cardsAbove && "cards-above"]}><h3>{item.title}</h3><div class="item-rows">{contentRows(item).map((row) => <div class="content-row">{row.cards.length ? <div class="card-row">{row.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div> : <div class="card-slot" aria-hidden="true"></div>}<div class="paragraphs"><p>{row.text}</p></div></div>)}</div></article>)}</div><article class="content-item"><h3>Ideal Mulligan</h3><p>Look mainly for a combination that includes Monkey.D.Luffy, the Event Searcher, Jewelry Bonney, and, especially when going second, Eustass \"Captain\" Kid.</p><p>The goal is to have enough searching to find Bonney, then the cards needed to develop your board around it, rather than starting with several top-end cards in hand.</p></article></section>
    <section id="curve" class="glow-block"><h2>Game Plan &amp; Curve</h2><p>Trafalgar Law OP14 looks to quickly fill its board with small Characters, then maintain constant pressure through its Leader effect, which lets you exchange the Power of two of your Characters. This mechanic can turn normally unthreatening Characters into real attackers.</p><p>The principle is simple: first attack with your Character that has the highest Power, then exchange its Power with that of a small Character that has not attacked yet. For example, after attacking with Roronoa Zoro at 8000 Power, you can exchange its Power with that of a 2000-Power Character. That Character then becomes 8000 Power and can launch another large attack.</p><p>This is what makes board development so important: every additional small Character can potentially become a large attack. Jewelry Bonney EB05-001 further strengthens this plan by providing development, draw, and opposing Power reduction.</p><div class="content-list">{gamePlan.map((item) => <article class="content-item"><h3>{item.title}</h3><div class="item-rows">{contentRows(item).map((row) => <div class="content-row">{row.cards.length ? <div class="card-row">{row.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div> : <div class="card-slot" aria-hidden="true"></div>}<div class="paragraphs"><p>{row.text}</p></div></div>)}</div></article>)}</div></section>
    <section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><div class="content-list">{techCards.map((item) => <article class:list={["tech-card", !item.card && "text-only-card"]}><div class="tech-card-heading">{item.card && <button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={getCardThumbnail(item.card.img)} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button>}<h3>{item.title}</h3></div><div class="paragraphs">{item.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}</div></article>)}</div></section>
    <section id="matchups" class="glow-block"><h2>Matchups</h2><div class="matchup-grid">{matchups.map((item) => <article class="matchup-card"><div class="matchup-heading">{[item.leader].map((entry) => <button class="mini-card matchup-leader-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}<h3>{item.title}</h3></div><ul>{item.points.map((point) => <li>{point}</li>)}</ul></article>)}</div></section>
    <section id="tips" class="glow-block"><h2>Tips</h2><div class="tips-list">{tips.map((item) => <article class="tip-card"><div class="card-row cards-per-row" style={`grid-template-columns:repeat(${item.cards.length},minmax(0,1fr))`}>{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>{item.text}</p></article>)}</div></section>
  </div></section>
  <div class="card-modal" data-modal aria-hidden="true"><div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview"><button class="modal-close" type="button" data-close>Close</button><img src="" alt="" data-modal-image /></div></div>
</MainLayout>

<script>
  const modal = document.querySelector("[data-modal]"); const modalImage = document.querySelector("[data-modal-image]");
  const closeModal = () => { modal?.classList.remove("is-open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; };
  document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !modalImage) return; modalImage.src = button.dataset.full || ""; modalImage.alt = button.dataset.name || "Card preview"; modal.classList.add("is-open"); modal.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; }));
  document.querySelector("[data-close]")?.addEventListener("click", closeModal); modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
  document.querySelectorAll("[data-copy-sim]").forEach((button) => button.addEventListener("click", async () => { const deck = button.dataset.copySim; if (!deck) return; const previous = button.textContent; try { await navigator.clipboard.writeText(deck); button.textContent = "Copied"; } catch { button.textContent = "Copy failed"; } window.setTimeout(() => { button.textContent = previous; }, 1800); }));
</script>

<style>
  .guide-hero{padding:3rem 0 2rem}.hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(220px,.9fr);gap:3rem;align-items:center}.hero-copy h1{margin:0;font-size:clamp(2.1rem,5vw,3.3rem);line-height:1.05}.hero-tags,.hero-actions,.card-row{display:flex;flex-wrap:wrap;gap:.65rem;align-items:flex-start}.hero-tags{margin-bottom:1rem}.hero-tags span{padding:.4rem .8rem;border:1px solid rgba(255,138,42,.3);border-radius:999px;color:#ffb47c;font-size:.8rem;font-weight:800}.guide-icon img{display:block;width:min(320px,100%);margin-left:auto;border-radius:18px;border:1px solid rgba(255,255,255,.08)}.article-stack,.content-list,.tips-list,.matchup-grid{display:grid;gap:1rem}.glow-block{padding:1.25rem;border:2px solid rgba(255,107,53,.48);border-radius:18px;background:rgba(8,12,24,.82)}.glow-block h2,.glow-block h3,.glow-block p{margin-top:0}.decklist-title-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1rem}.deck-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.85rem}.deck-card{display:grid;gap:.55rem;padding:.7rem;border:1px solid rgba(255,107,53,.26);border-radius:12px;background:rgba(0,0,0,.22);color:inherit;text-align:left}.deck-card img{width:100%;max-width:110px;margin:auto;border-radius:10px}.deck-info{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.5rem}.deck-info b{color:#ff8a42}.deck-info span,.deck-info small{display:block}.deck-info small{color:var(--text-300);font-size:.75rem}.content-item,.tech-card,.tip-card,.matchup-card{padding:1rem;border:1px solid rgba(255,107,53,.3);border-radius:14px;background:rgba(0,0,0,.2)}.content-item h3,.tech-card h3,.matchup-card h3{margin-bottom:.7rem}.mini-card{border:0;padding:0;background:transparent;cursor:pointer}.mini-card img{display:block;width:98px;border-radius:10px}.paragraphs p,.tip-card p{line-height:1.6}.tech-card{display:grid;grid-template-columns:98px minmax(0,1fr);gap:1rem;align-items:start}.matchup-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.matchup-card ul{display:grid;gap:.65rem;margin:0;padding-left:1.25rem;line-height:1.6}.cards-per-row{display:grid;width:100%}.cards-per-row .mini-card{min-width:0}.cards-per-row img{width:100%;max-width:98px}.card-modal{position:fixed;inset:0;z-index:40;display:grid;place-items:center;padding:1rem;background:rgba(0,0,0,.78)}.card-modal[aria-hidden="true"]{display:none}.card-modal-inner{position:relative;max-width:min(440px,92vw)}.card-modal img{display:block;width:100%;max-height:84vh;object-fit:contain}.modal-close{position:absolute;right:0;top:-2.5rem;border:0;border-radius:999px;padding:.5rem .9rem;background:#ff6b35;color:#fff}
