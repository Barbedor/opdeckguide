---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Luffy & Ace ST30 Deck Guide OP17: Decklist, Mulligan & Combo";
const description = "Luffy & Ace ST30 OP17 deck guide with decklist, mulligan priorities, 4 DON!! combo lines, curve guide, tech cards, matchups, and tips.";
const icon = "/assets/guides/Luffy-st30.png";
const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const leader = card("ST30-001", "Luffy and Ace", "/Cards/ST30/ST30-001.jpg", 1, "Leader");
const bonney = card("EB04-002", "Jewelry Bonney", "/Cards/EB04/EB04-002.jpg", 4);
const nami01 = card("OP01-016", "Nami", "/Cards/OP01/OP01-016.png", 4);
const luffy12 = card("OP12-015", "Monkey.D.Luffy", "/Cards/OP12/OP12-015.jpg", 4);
const luffy21 = card("ST21-014", "Monkey.D.Luffy", "/Cards/ST21/ST21-014.jpg", 4);
const sanji = card("ST31-001", "Sanji", "/Cards/ST31/ST31-001.jpg", 4);
const namiEb02 = card("EB02-017", "Nami", "/Cards/EB02/EB02-017.jpg", 4);
const luffySt30 = card("ST30-012", "Monkey.D.Luffy", "/Cards/ST30/ST30-012.jpg", 4);
const badManners = card("OP04-016", "Bad Manners Kick Course", "/Cards/OP04/OP04-016.png", 4, "Event");
const gra = card("OP17-017", "Gra ha ha ha ha", "/Cards/OP17/New OP17/OP17-017.jpg", 4, "Event");
const samourai = card("OP01-055", "You Can Be My Samourai!!", "/Cards/OP01/OP01-055.png", 2, "Event");
const demonAura = card("OP12-037", "Demon Aura Nine Sword Style Asura Blades Drawn Dead Man’s Game", "/Cards/OP12/OP12-037.jpg", 4, "Event");
const allOut = card("OP13-040", "I Know You're Strong... So I'll Go All Out from the Very Start!", "/Cards/OP13/OP13-040.jpg", 4, "Event");
const sunny = card("ST31-005", "Thousand Sunny", "/Cards/ST31/ST31-005.jpg", 4, "Stage");

const saboOp13 = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg");
const rocksOp17 = card("OP17-039", "Rocks D. Xebec OP17", "/Cards/OP17/New OP17/OP17-039.jpg");
const mihawkOp14 = card("OP14-020", "Dracule Mihawk OP14", "/Cards/OP14/OP14-020.jpg");
const kaidoOp17 = card("OP17-058", "Kaido OP17", "/Cards/OP17/New OP17/OP17-058.jpg");
const aceLeaderOp16 = card("OP16-001", "Portgas D. Ace OP16", "/Cards/OP16/OP16-001.jpg");
const linlinOp17 = card("OP17-099", "Charlotte Linlin OP17", "/Cards/OP17/New OP17/OP17-099.jpg");
const luffyOp17 = card("OP17-079", "Monkey D. Luffy OP17", "/Cards/OP17/New OP17/OP17-079.jpg");
const shanksOp17 = card("OP17-020", "Shanks OP17", "/Cards/OP17/New OP17/OP17-020.jpg");
const enelOp15 = card("OP15-058", "Enel OP15", "/Cards/OP15/OP15-058.jpg");
const boaOp14 = card("OP14-041", "Boa Hancock OP14", "/Cards/OP14/OP14-041.jpg");
const nicoRobinOp09 = card("OP09-062", "Nico Robin OP09", "/Cards/OP09/OP09-062.jpg");

const matchupIcons = { "OP13-004": "/assets/guides/Sabo OP13-004.png", "OP17-039": "/assets/guides/Rocks.DXebec op17.png", "OP14-020": "/assets/guides/dracule-mihawk-op14.png", "OP17-058": "/assets/guides/Kaido op17.png", "OP16-001": "/assets/guides/Ace-op16.png", "OP17-099": "/assets/guides/Charlotte Linlin op17.png", "OP17-079": "/assets/guides/Monkey.D.Luffy op17.png", "OP17-020": "/assets/guides/Shanks op17.png", "OP15-058": "/assets/guides/enel-op15.png", "OP14-041": "/assets/guides/boa-hancock-op14.png", "OP09-062": "/assets/guides/Nico-Robin-op09.png" };
const decklist = [leader, bonney, nami01, luffy12, luffy21, sanji, namiEb02, luffySt30, badManners, gra, samourai, demonAura, allOut, sunny];
const simDeckCode = decklist.map((entry) => `${entry.count}x${entry.code}`).join("\n");
const matchupGroups = [
	{ label: "Favorable", icon: "&uarr;", tone: "up", cards: [kaidoOp17, aceLeaderOp16, linlinOp17, luffyOp17, shanksOp17, nicoRobinOp09] },
	{ label: "Slightly Unfavorable", icon: "&darr;", tone: "slightly-down", cards: [mihawkOp14, enelOp15] },
	{ label: "Unfavorable", icon: "&darr;", tone: "down", cards: [saboOp13, rocksOp17, boaOp14] },
];

const priorityKeeps = [
	{ title: "Monkey.D.Luffy OP12-015", cards: [luffy12], text: "Monkey.D.Luffy OP12-015 is the central piece you want in hand. It starts your 4 DON!! combo by revealing two Events from your hand to play Sanji ST31-001." },
	{ title: "Sanji ST31-001", cards: [sanji], text: "Sanji ST31-001 is also an important piece when you already have Luffy OP12-015 or enough searchers to find the missing pieces." },
	{ title: "Part of the Combo + a Searcher", cards: [luffy12, bonney], text: "A hand containing part of the combo alongside a searcher can be kept." },
];
const searcherCards = [bonney, nami01, namiEb02, sunny];
const goSecond = [
	{ label: "2 DON!! — Searchers", cards: [bonney, nami01, namiEb02, sunny], connectors: ["OR", "OR", "OR"], text: "Use your first turns to play Jewelry Bonney, Nami, or Thousand Sunny and find the missing pieces. Your priority is to assemble Monkey.D.Luffy OP12-015 + Sanji ST31-001 + a Luffy for Sanji to play, while keeping the Events needed to activate Luffy OP12-015. If you already have some pieces, use your searches to complete the combo instead of needlessly finding more copies of the same cards." },
	{ label: "4 DON!! — Classic Combo", cards: [luffy12, sanji, luffy21, luffySt30], connectors: ["→", "→", "OR"], text: "This is your key turn. Play Monkey.D.Luffy OP12-015, then reveal two Events from your hand to play Sanji ST31-001. Sanji draws a card, then can play a Straw Hat with a cost of 5 or less. The classic combo then plays one of your other Monkey.D.Luffy cards. With the right sequence, Luffy OP12-015 gives Sanji a rested DON!!; if you play and attack with Luffy ST21-014, it can give Sanji another rested DON!!, allowing Sanji to gain Rush. For only 4 DON!!, this line produces multiple attacks: 6000 with the Leader, 6000 with Luffy, and 5000 with Sanji. This ability to put several attackers into play for only 4 DON!! makes the deck especially explosive." },
	{ label: "The Full Combo", cards: [luffy12, sanji, luffy12, sanji, luffy21, luffySt30], connectors: ["→", "→", "→", "→", "OR"], text: "When your hand contains every required piece, you can go much further. Start with Monkey.D.Luffy OP12-015, reveal two Events, and play Sanji. Sanji then plays another Luffy OP12-015, which starts another Sanji and then Luffy ST21-014 or Luffy ST30-012. The complete sequence can put up to five Characters on your board. Depending on the Luffy cards available, you can end the chain with your Rush Luffy or the other Luffy that can gain Rush and rest an opposing Blocker with its When Attacking effect. This full combo is much rarer on your first 4 DON!! turn and usually happens a turn later. The classic three-card combo is the line you will find most consistently." },
];
const goFirst = [
	{ label: "1 DON!! — Searcher", cards: [bonney, nami01, namiEb02, sunny], connectors: ["OR", "OR", "OR"], text: "Play Jewelry Bonney, Nami, or Thousand Sunny to find the missing pieces." },
	{ label: "3 DON!! — Searchers", cards: [bonney, namiEb02, sunny], connectors: ["+", "+"], text: "Keep searching for your combo pieces, just as you did on the first turn. Playing Thousand Sunny is important because, in addition to finding a card, it lets you give one rested DON!! to one of your Luffy cards, excluding your Leader, every turn." },
	{ label: "5 DON!! — Combo", cards: [luffy12, sanji, luffy21], connectors: ["→", "→"], text: "Play your combo if you can. Compared with going second, you have had one additional turn to potentially find every piece of your full combo and put five Characters into play that turn." },
];
const techCards = [
	{ card: samourai, title: "You Can Be My Samourai!! OP01-055", text: "You Can Be My Samourai!! is played as a two-of to get value from your small searchers once they are no longer useful. After using Jewelry Bonney or Nami to find your combo pieces, you can rest them with this Event to draw two cards. This keeps you digging through the deck while giving Characters that have already done their job a second use. Some versions play even more searchers instead of You Can Be My Samourai!!, but this list prefers the Event to turn searchers that are no longer useful into card draw." },
	{ card: gra, title: "Gra ha ha ha ha OP17-017", text: "Its role in the deck is mainly to provide enough defense for a deck that cannot rely on many 2000 Counters. Giving your Leader +2000 Counter during a battle while reducing an opposing Leader or Character by 2000 Power for the entire turn is especially strong for limiting opposing pressure. For only 1 DON!!, this effect can potentially let you counter two attacks." },
	{ card: demonAura, title: "Demon Aura Nine Sword Style Asura Blades Drawn Dead Man’s Game OP12-037", text: "Like the other Events, it helps the deck keep enough Counter despite a decklist built mainly around searchers and combo pieces. During your turn, you can also use its Main effect for a total of 4 DON!! to rest up to two opposing cards, Characters and/or DON!!. This can make it a real finisher by resting opposing Blockers and/or the DON!! your opponent could use for defensive Events. Its 4 DON!! cost is also largely offset by Monkey.D.Luffy ST21-014 and Thousand Sunny ST31-005, which can recover rested DON!! by attaching them to your Characters for larger attacks." },
	{ card: allOut, title: "I Know You're Strong... So I'll Go All Out from the Very Start! OP13-040", text: "In addition to defending your Leader, this card can, for 3 DON!!, freeze up to two opposing Characters with a cost of 7 or less. It can prepare a big turn by reducing opposing pressure and temporarily preventing certain Characters from attacking again." },
	{ card: badManners, title: "Bad Manners Kick Course OP04-016", text: "Along with Gra ha ha ha ha OP17-017, this is the only Event in the decklist that can protect your board; the others only defend your Leader. This is not a major issue because your Luffy cards will be at 9000 Power during the opposing turn. This card gives +3000 Power by discarding a card from your hand, ideally a brick you no longer need or an Event you cannot play because you did not keep active DON!! for defense. Its -3000 Power Trigger can also be very useful. Although it is rare and outside your control, it can sometimes save you when your opponent tries to finish the game on their turn." },
	{ card: sunny, title: "Thousand Sunny ST31-005", text: "Thousand Sunny is one of the many searchers used to increase the deck's consistency. Once your board is developed, the Stage can also give a rested DON!! to a Luffy other than your Leader, helping set up your different attacks after the combo. It therefore fills two important roles: finding the pieces needed for your combo, then contributing to your pressure once your Characters are in play." },
];
const tips = [
	{ title: "Find Monkey.D.Luffy OP12-015 as Quickly as Possible", cards: [luffy12], text: "Monkey.D.Luffy OP12-015 is the central piece of your combo. Use your many searchers to find it quickly, then find the other pieces you need around it. Without this Luffy, the deck quickly becomes much less explosive. This is one of its main weaknesses: when your searches do not find the right pieces, the game becomes much harder." },
	{ title: "Don't Waste Your Searchers", cards: [bonney, nami01, samourai], text: "Once you have found your main pieces, your small searchers are no longer very useful. You Can Be My Samourai!! lets you rest them to draw and keep moving through your deck. This turns Characters that have become less useful into new cards instead of simply leaving them on the board." },
	{ title: "Protect Your Board", cards: [luffy12, luffy21, luffySt30], text: "Your deck becomes especially dangerous when the Luffy cards played through your combo survive until the next turn. Thanks to your Leader, your Luffy cards gain +3000 Power during the opposing turn, making them very difficult to remove through attacks. Your defensive Events can then be used when the opponent still tries to deal with your board." },
	{ title: "Use Rest Effects to Open the Way", cards: [demonAura, allOut, luffySt30], text: "Effects that rest opposing cards can become especially important when it is time to finish the game. Resting a Blocker opens the way for your many attacks. Once your board is established, preventing the opponent from using their defenses properly can be enough to turn your turn into lethal." },
	{ title: "Pressure the Opponent's Hand with 7K Attacks", cards: [luffy12, luffy21, luffySt30], text: "Once several attackers are in play, 7000-Power attacks are especially useful for forcing the opponent to use Counters. Several consecutive 7000-Power attacks gradually empty the opposing hand before the final push. You do not always need to look for lethal immediately: your board can first exhaust defensive resources." },
	{ title: "Keep DON!! Available for Defense", cards: [gra, demonAura, allOut], text: "The decklist plays no 2000 Counters and no Blockers, so it depends heavily on its Events for defense. Avoid automatically spending all of your DON!! if keeping a resource lets you protect an important board piece or survive the next turn." },
	{ title: "Take Advantage of Rested DON!!", cards: [luffy21, sunny], text: "The effects of Monkey.D.Luffy ST21-014 and Thousand Sunny ST31-005 let you get value from rested DON!!. This makes your sequences more efficient and helps absorb the cost of Events used during your turn before continuing your offense." },
	{ title: "Adapt Going First or Second to the Matchup", cards: [kaidoOp17, enelOp15, nicoRobinOp09], text: "The deck generally prefers going second because you naturally reach the 4 DON!! needed for the main combo. It can still perform well going first thanks to its different rested DON!! recovery effects. Against Enel, Kaido, and Robin, prefer going first." },
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span>Deck Guide</span><span>OP17 Format</span></div><h1>Luffy &amp; Ace ST30 Deck Guide</h1><p>Search for your combo pieces, execute the 4 DON!! Luffy → Sanji line, then keep the pressure on while saving DON!! to protect your board.</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Curve Guide</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div></div><div class="guide-icon"><img src={icon} alt="Luffy and Ace ST30 deck guide icon" loading="eager" /></div></div></section>
	<section id="decklist" class="list-section"><div class="container article-stack">
		<section class="glow-block"><div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>Copy for Sim</button></div></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><span class="deck-count">{entry.count}x</span><div><div class="deck-name">{entry.name}</div><div class="deck-code">{entry.code}</div></div></div><span class="deck-role">{entry.role}</span></button>)}</div></section>
		<section class="glow-block"><h2>Mulligan</h2><p>Above all, you need to assemble the pieces required for your 4 DON!! combo. The deck plays many searchers specifically to increase consistency, but it remains highly dependent on Monkey.D.Luffy OP12-015: when it is missing, your early turns become much more difficult.</p><div class="mulligan-list"><section class="mulligan-group"><h3>Priority Keeps</h3>{priorityKeeps.map((item) => <article class="content-item"><h4>{item.title}</h4><div class="item-row"><div class="card-set">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>{item.text}</p></div></article>)}</section><section class="mulligan-group"><h3>Searchers Can Make an Incomplete Hand Keepable</h3><p>You do not need to have every combo card immediately.</p><div class="item-row"><div class="card-set">{searcherCards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>With Jewelry Bonney, Nami OP01-016, Nami EB02-017, and Thousand Sunny, the list has many ways to find the missing pieces. A hand without the full combo but with several searchers can therefore still be completely playable.</p></div></section><section class="mulligan-group"><h3>Don't Keep a Weak Hand Just Because It Has One Combo Piece</h3><p>One combo piece is not necessarily enough.</p><p>The goal is to find a balance between combo pieces and the searchers that can recover the missing cards. When the deck does not find its combo, the game becomes noticeably harder; when it finds the combo quickly, its explosiveness is extremely high.</p></section><section class="mulligan-group"><h3>Going First or Second?</h3><p>The deck generally prefers going second, mainly because it lets you reach the 4 DON!! needed for the classic combo immediately.</p><p>It can still play very well going first thanks to the extra DON!! generated by its effects and its many searchers. The choice also depends on the matchup: against Kaido OP17, Enel OP17, and Robin OP17, go first; against other matchups, go second. This flexibility is one of the deck's strengths.</p></section></div></section>
		<section id="curve" class="glow-block"><h2>Curve Guide</h2><p>The deck first wants to reach its combo turn with Monkey.D.Luffy OP12-015, then chain Luffy → Sanji → Luffy.</p>{[["Going Second", goSecond], ["Going First", goFirst]].map(([heading, curve]) => <div class="curve-block"><h3>{heading}</h3><div class="curve-rows">{curve.map((slot) => <article class="curve-row"><div><div class="curve-label">{slot.label}</div><div class:list={["curve-cards", { "curve-cards-inline": slot.cards.length <= 3 }]}>{slot.cards.map((entry, index) => <><button class="mini-card curve-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>{index < slot.cards.length - 1 && <span class="curve-join">{slot.connectors?.[index] ?? "+"}</span>}</>)}</div></div><p class="curve-note">{slot.text}</p></article>)}</div></div>)}</section>
		<section class="glow-block"><h2>After Your Combo</h2><div class="item-row after-combo-row"><div class="card-set after-combo-cards">{[leader, luffy12, sanji, luffy21, luffySt30].map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>Once your board is established, your goal becomes much more straightforward: send multiple attacks at the opposing Leader. Because your Leader is also 6000 Power, you can quickly create attacks that are difficult to defend when several Luffy and Sanji cards stay on the board.</p></div><h3>Use Your DON!! to Protect the Board</h3><div class="item-row"><div class="card-set">{[gra].map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p>You do not always need to use all of your DON!! offensively once your board is in play. The decklist has no 2000 Counters and relies heavily on its defensive Events, so keeping one or more DON!! available can be important for protecting your Characters and maintaining pressure on the following turn. Your Luffy cards also gain +3000 Power during the opposing turn through your Leader effect, making your board difficult to remove directly through attacks.</p></div></section>
		<section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><div class="tech-list">{techCards.map((item) => <article class="tech-card"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={item.card.img} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>
		<section id="matchups" class="glow-block feature-block"><div class="section-header feature-header"><div><h2>Matchups</h2><p>OP17 matchup spread for Luffy &amp; Ace ST30.</p></div></div><div class="matchup-grid">{matchupGroups.map((group) => <div class="matchup-card"><div class={`matchup-badge badge-${group.tone}`}><span class="badge-icon" set:html={group.icon}></span><span>{group.label}</span></div><div class="matchup-list">{group.cards.map((entry) => <button class="matchup-entry" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img class="matchup-leader-icon" src={matchupIcons[entry.code] ?? entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div></div>)}</div></section>
		<section class="glow-block"><h2>Tips</h2><div class="tips-list">{tips.map((item) => <article class="tip-card"><div class:list={["card-set", { "tip-card-set-inline": item.cards.length === 3 }]}>{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></section>
	</div></section>
	<div class="card-modal" data-modal aria-hidden="true"><div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview"><button class="modal-close" type="button" data-close>Close</button><img src="" alt="" data-modal-image /></div></div>
</MainLayout>

<script>
	const modal = document.querySelector("[data-modal]"); const modalImage = document.querySelector("[data-modal-image]"); const closeModal = () => { modal?.classList.remove("is-open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; }; document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !modalImage) return; modalImage.src = button.dataset.full || ""; modalImage.alt = button.dataset.name || "Card preview"; modal.classList.add("is-open"); modal.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; })); document.querySelector("[data-close]")?.addEventListener("click", closeModal); modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); }); document.querySelectorAll("[data-copy-sim]").forEach((button) => button.addEventListener("click", async () => { const simDeck = button.dataset.simDeck; if (!simDeck) return; const previous = button.textContent?.trim() || "Copy for Sim"; try { if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(simDeck); } else { const textarea = document.createElement("textarea"); textarea.value = simDeck; textarea.setAttribute("readonly", ""); textarea.style.position = "fixed"; textarea.style.opacity = "0"; document.body.appendChild(textarea); textarea.select(); document.execCommand("copy"); textarea.remove(); } button.textContent = "Copied"; } catch { button.textContent = "Copy failed"; } window.setTimeout(() => { button.textContent = previous; }, 1800); }));
</script>

<style>
	.guide-hero{padding-top:3rem}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:2.5rem;align-items:center}.hero-tags,.hero-actions,.card-set{display:flex;flex-wrap:wrap;gap:.65rem;align-items:center}.hero-tags span{border:1px solid rgba(255,107,53,.45);border-radius:999px;padding:.35rem .7rem;font-size:.8rem;font-weight:800}.guide-icon img{width:100%;border-radius:18px;box-shadow:0 24px 52px rgba(0,0,0,.35)}.article-stack,.mulligan-list,.curve-rows,.tech-list,.tips-list{display:grid;gap:1rem}.glow-block{padding:1.25rem;border:1px solid rgba(255,107,53,.35);border-radius:24px;background:rgba(8,12,24,.82);box-shadow:0 0 28px rgba(255,107,53,.07)}.glow-block h2,.glow-block h3,.glow-block h4,.glow-block p{margin-top:0}.decklist-title-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1rem}.copy-sim-button{width:auto}.deck-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.85rem;margin-top:1rem}.deck-card{display:grid;gap:.55rem;padding:.7rem;border:1px solid rgba(255,107,53,.22);border-radius:16px;background:rgba(0,0,0,.22);color:inherit;text-align:left;cursor:pointer}.deck-card img{width:100%;max-width:110px;margin:auto;border-radius:12px}.deck-info{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.5rem;align-items:center}.deck-count{color:#ff8a42;font-weight:900}.deck-name{font-weight:700}.deck-code,.deck-role{display:block;color:var(--text-300);font-size:.75rem}.deck-role{text-transform:uppercase;letter-spacing:.05em}.mulligan-group{padding:1rem;border:1px solid rgba(255,107,53,.24);border-radius:18px;background:rgba(0,0,0,.16)}.mulligan-group h3{color:#ff8a42}.content-item+.content-item{margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(255,107,53,.25)}.item-row,.curve-row,.tech-card,.tip-card{display:grid;grid-template-columns:minmax(180px,300px) minmax(0,1fr);gap:1rem;align-items:center}.mini-card{border:0;padding:0;background:transparent;cursor:pointer}.mini-card img{display:bloc