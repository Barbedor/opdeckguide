---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Monkey D. Luffy OP17 Deck Guide: Elbaph Decklist, Mulligan & Curve";
const description =
	"Monkey D. Luffy OP17 Elbaph deck guide with the current decklist, mulligan priorities, curves, Luffy targets, tech cards, matchups, and gameplay tips.";
const icon = "/assets/guides/Monkey.D.Luffy%20op17.png";

const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;

	while (remaining > 4) {
		lines.push(`4x${code}`);
		remaining -= 4;
	}

	if (remaining > 0) {
		lines.push(`${remaining}x${code}`);
	}

	return lines;
};

const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });


const leader = card("OP17-079", "Monkey D. Luffy", "/Cards/OP17/New OP17/OP17-079.jpg", 1, "Leader");
const chopper = card("OP17-084", "Tony Tony Chopper", "/Cards/OP17/New OP17/OP17-084.jpg");
const rodo = card("OP17-094", "Rodo", "/Cards/OP17/New OP17/OP17-094.jpg");
const usopp = card("OP17-080", "Usopp", "/Cards/OP17/New OP17/OP17-080.jpg");
const gerd = card("OP17-081", "Gerd", "/Cards/OP17/New OP17/OP17-081.jpg");
const sanji = card("OP17-082", "Sanji", "/Cards/OP17/New OP17/OP17-082.jpg");
const robin = card("OP17-087", "Nico Robin", "/Cards/OP17/New OP17/OP17-087.jpg");
const franky = card("OP17-090", "Franky", "/Cards/OP17/New OP17/OP17-090.jpg");
const brook = card("OP17-091", "Brook", "/Cards/OP17/New OP17/OP17-091.jpg");
const zoro = card("OP17-095", "Roronoa Zoro", "/Cards/OP17/New OP17/OP17-095.jpg");
const saul = card("OP17-089", "Jaguar D. Saul", "/Cards/OP17/New OP17/OP17-089.jpg");
const docking = card("OP15-088", "Pirates Docking Six", "/Cards/OP15/OP15-088.jpg");
const loki = card("OP17-119", "Loki", "/Cards/OP17/New OP17/OP17-119.jpg");
const luffy = card("OP17-093", "Monkey D. Luffy", "/Cards/OP17/New OP17/OP17-093.jpg");
const kongGun = card("OP17-098", "Gum-Gum Kong Gun", "/Cards/OP17/New OP17/OP17-098.jpg", null, "Event");
const sunny = card("ST14-017", "Thousand Sunny", "/Cards/ST14/ST14-017.png", null, "Stage");
const tempestKick = card("OP07-096", "Tempest Kick", "/Cards/OP07/OP07-096.png", null, "Event");
const toySoldier = card("OP05-081", "One-Legged Soldier", "/Cards/OP05/OP05-081.png");
const feedOnRage = card("OP17-097", "I'll Feed on This Rage and Use It to Bring the World to Ruin!!!", "/Cards/OP17/New OP17/OP17-097.jpg", null, "Event");
const imLuffy = card("OP17-096", "I'm Luffy!! The Man Who's Gonna Become the King of the Pirates!!", "/Cards/OP17/New OP17/OP17-096.jpg", null, "Event");
const dorry = card("OP17-085", "Dorry", "/Cards/OP17/New OP17/OP17-085.jpg");
const brogy = card("OP17-092", "Brogy", "/Cards/OP17/New OP17/OP17-092.jpg");
const jinbe = card("OP17-083", "Jinbe", "/Cards/OP17/New OP17/OP17-083.jpg");
const stussy = card("OP07-085", "Stussy", "/Cards/OP07/OP07-085.png");

const decklist = [
	leader,
	{ ...chopper, count: 1 }, { ...rodo, count: 3 }, { ...usopp, count: 4 }, { ...gerd, count: 4 },
	{ ...sanji, count: 2 }, { ...robin, count: 4 }, { ...franky, count: 2 }, { ...brook, count: 3 },
	{ ...zoro, count: 4 }, { ...saul, count: 4 }, { ...docking, count: 4, role: "Character" },
	{ ...loki, count: 4 }, { ...luffy, count: 4 }, { ...kongGun, count: 3 }, { ...sunny, count: 4 },
];

const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const matchupGroups = [
	{ title: "Favorable", entries: [
		["Kaido OP17", "/assets/guides/Kaido%20op17.png"],
		["Rocks.D.Xebec OP17", "/assets/guides/Rocks.DXebec%20op17.png"],
	] },
	{ title: "Slightly Favorable", entries: [
		["Nico Robin OP09", "/assets/guides/Nico-Robin-op09.png"],
		["Shanks OP17", "/assets/guides/Shanks%20op17.png"],
		["Enel OP15", "/assets/guides/enel-op15.png"],
	] },
	{ title: "Even", entries: [["Boa Hancock OP14", "/assets/guides/boa-hancock-op14.png"]] },
	{ title: "Slightly Unfavorable", entries: [["Portgas.D.Ace OP16", "/assets/guides/Ace-op16.png"]] },
	{ title: "Unfavorable", entries: [
		["Sabo OP13", "/assets/guides/Sabo%20OP13-004.png"],
		["Dracule Mihawk OP14", "/assets/guides/dracule-mihawk-op14.png"],
		["Luffy and Ace ST30", "/assets/guides/Luffy-st30.png"],
	] },
];

const mulliganSections = [
	{ title: "Usopp", cards: [usopp], text: "Usopp is one of the best cards to see in your opening hand. He looks at the top 3 cards for an Elbaph card while sending the rest to your trash, so he finds future plays and starts preparing your trash at the same time. Filling the trash early is especially important for Roronoa Zoro, who can later protect your Characters from opposing removal." },
	{ title: "Jaguar D. Saul", cards: [saul], text: "Jaguar D. Saul is your other key Searcher. Like Usopp, he searches the top 3 cards while feeding your trash, giving you enough consistency to find the Elbaph pieces your curve is missing." },
	{ title: "Find a 12-Cost or Higher", cards: [loki, saul, gerd], text: "Your next priority is enabling the Characters that need a 12-cost or higher Character on your board. Loki is especially important: on your opponent's turn, his own effect and the Leader effect make him an 11K Blocker. Gerd also becomes a Blocker through the Leader while giving you access to the trash." },
	{ title: "Keep Priorities", cards: [usopp, loki], text: "Usopp plus a way to establish a 12-cost or higher Character is an excellent start. Don't keep an opening hand only because it has powerful late-game cards; keep the Searchers and the line that makes your future turns work." },
];

const goingFirstCurve = [
	{ label: "1 DON!! — No Play", cards: [], text: "This decklist does not play Nami, so there is usually no worthwhile play at 1 DON!!." },
	{ label: "3 DON!! — Usopp", cards: [usopp, rodo, franky], joins: ["or", "+"], text: "Play Usopp, then use your remaining DON!! on the Leader to attack at 6K. If an opposing 2-cost must be removed immediately, Rodo into Franky is the alternative line: Rodo gives you a 12-cost Character right away, enabling Franky to deal with that target before it attacks." },
	{ label: "5 DON!! — Pirates Docking Six or Jaguar D. Saul", cards: [docking, saul], joins: ["or"], text: "Play Pirates Docking Six when you do not need to establish a 12-cost immediately. It trashes 3 cards from your deck, then plays a 2-cost or lower Straw Hat Crew Character from your trash, improving both your trash and your board. If you need to activate your Cost 12+ synergies, Jaguar D. Saul is the other option for this turn." },
	{ label: "7 DON!! — Loki or Gum-Gum Kong Gun", cards: [loki, kongGun], joins: ["or"], text: "Loki is the main play: his On Play can K.O. multiple Characters as long as their combined cost is 4 or less, and he is usually best kept active as an 11K Blocker on the opponent's turn. If the opponent has two key targets, Gum-Gum Kong Gun can be better by removing up to two 6-cost Characters." },
	{ label: "9 DON!! — Luffy and a 2-Cost", cards: [luffy, robin, brook], joins: ["+", "or"], text: "Play Monkey D. Luffy after you establish a 12-cost or higher Character. He gains Rush, draws a card, and plays a 2-cost Character from your trash. Bring back Robin to reduce a target by 3K before Luffy attacks, or Brook to pressure the opponent's hand." },
];

const goingSecondCurve = [
	{ label: "2 DON!! — Usopp", cards: [usopp], text: "Start with Usopp to find the next pieces of your curve and begin filling your trash." },
	{ label: "4 DON!! — Jaguar D. Saul or Two 2-Costs", cards: [saul, usopp, zoro], joins: ["or", "+"], text: "Play Jaguar D. Saul to keep developing and establish a 12-cost. Alternatively, play two 2-cost Characters such as Usopp and Zoro: you build the board while Zoro protects your Characters on the following turn." },
	{ label: "6 DON!! — Loki or Pirates Docking Six and Thousand Sunny", cards: [loki, docking, sunny], joins: ["or", "+"], text: "Loki immediately controls the opposing board and establishes your 11K Blocker. The alternate line is Pirates Docking Six plus Thousand Sunny: Docking Six reaches 11 cost with its own effect, then Thousand Sunny raises it to 12, making it a 7K Blocker through the Leader while it recovers a 2-cost Straw Hat Crew Character from your trash." },
	{ label: "8 DON!! — Luffy and a 2-Cost", cards: [luffy, robin, gerd], joins: ["+", "or"], text: "Play Luffy with a 12-cost already in play to gain Rush, draw, and replay a 2-cost from your trash. Luffy plus Robin makes an 8K Rush attack much easier to convert. For defense, Gerd into Luffy into another Gerd creates multiple 12-cost Blockers while recycling your resources." },
	{ label: "10 DON!! and Beyond", cards: [luffy, loki, docking, kongGun], text: "Your turns are no longer fixed. Adapt between Luffy plus 2-costs, Loki, Pirates Docking Six, your Blockers, and Gum-Gum Kong Gun according to the board and the opponent's resources." },
];

const techCards = [
	{ card: tempestKick, title: "Tempest Kick", text: "Tempest Kick is a strong option for a cost-reduction package. It first draws 1 card; then, if your trash has 10 or more cards, it gives an opposing Character -3 cost. This makes it a useful cantrip while expanding Loki's range. A 7-cost Character reduced to 4 cost can then be K.O.'d by Loki." },
	{ card: toySoldier, title: "One-Legged Soldier", text: "One-Legged Soldier gives another -3 cost option while keeping a 2K Counter in the decklist. Once it is on the board, you can trash it for the reduction, making it useful for control without being dead when you simply need to defend." },
	{ card: feedOnRage, title: "I'll Feed on This Rage and Use It to Bring the World to Ruin!!!", text: "This Event is especially strong against wide boards because it gives every opposing Character -1 cost. Against four 2-cost Characters, it reduces them all to 1 cost; Loki can then K.O. all four because their total cost is 4." },
	{ card: imLuffy, title: "I'm Luffy!! The Man Who's Gonna Become the King of the Pirates!!", text: "If you prefer more defense over removal, this is a useful alternative. Once you control a 12-cost or higher Character, it gives 4K Counter—a condition this deck can meet consistently. Two copies are reasonable when you expect to need more protection." },
];

const tips = [
	{ cards: [leader], text: "Don't play this deck like Sabo. This Luffy build is more defensive and grind-focused: your 12-cost Characters become Blockers, letting you slow the game, protect resources, and gradually exhaust the opponent's hand." },
	{ cards: [loki], text: "Loki is usually more valuable active than attacking. On the opponent's turn he is an 11K Blocker, so giving up his 8K attack often forces the opponent to spend far more resources to break through your defense." },
	{ cards: [usopp, saul, zoro, docking], text: "Filling your trash is part of the core plan. Usopp and Jaguar D. Saul do more than search: they prepare Zoro, Pirates Docking Six, Gerd, and the different 2-cost targets for Luffy." },
	{ cards: [zoro], text: "Use Zoro to protect your smaller Characters. Once your trash is full enough, he can stop opposing removal from clearing a board of 2-costs that will later attack at 5K once a 12-cost is established." },
	{ cards: [luffy, robin, brook, sanji, chopper], text: "Choose Luffy's 2-cost target for the situation. Robin gives -3K Power, Brook attacks the opponent's hand, Sanji fixes an awkward hand, and Chopper gives Luffy Unblockable. The same Luffy can support an aggressive, defensive, or grind-focused turn." },
	{ cards: [gerd, luffy, zoro], text: "Gerd recycles important resources. By trashing an unneeded card, she can recover an 8-cost or lower Character other than Gerd, including Luffy or a Zoro 2K Counter when defense matters most." },
	{ cards: [gerd, luffy], text: "Use the Gerd → Luffy → Gerd loop. Gerd recovers Luffy from the trash, then Luffy replays another Gerd from the trash, giving you an 8K Rush attacker and more 12-cost Blockers." },
	{ cards: [docking, sunny], text: "Thousand Sunny transforms Pirates Docking Six. Docking Six reaches 11 cost with its own effect, then Sunny gives it the last cost it needs to become a 12-cost Blocker. The Stage is more than card draw—it enables this defensive interaction." },
	{ cards: [rodo, franky], text: "Franky can remove key small Characters very early. On your 3-DON!! turn, Rodo gives you a 12-cost Character immediately, enabling Franky to K.O. an opposing 2-cost before it attacks." },
	{ cards: [usopp, robin, brook, sanji], text: "Do not focus only on the opponent's large Characters. Once the board is established, your many 2-cost Characters attack at 5K. Repeated small attacks force Counters from the opponent while your large Blockers make their own turn much harder." },
	{ cards: [kongGun], text: "Gum-Gum Kong Gun is strongest when you are already ahead on board. Removing two opposing targets protects that lead while your smaller Characters keep attacking. It also remains a 3K Counter for your Leader in defense." },
	{ cards: [loki, robin, franky, kongGun], text: "Do not waste attacks when removal can do the job. Against Rocks, attacking a rested Character with Loki can be unnecessary if his effect already removes it. Check Loki, Robin, Franky, and Kong Gun first so more attacks can go to the opposing Leader." },
	{ cards: [brook], text: "Once you have enough Blockers, start attacking the opponent's hand. Brook becomes much stronger in long games: your Loki and other Blockers keep you alive while Brook gradually reduces the opponent's resources." },
];

const luffyTargets = [
	{ note: "Trade board", card: card("OP17-087", "Nico Robin", "/Cards/OP17/New OP17/OP17-087.jpg") },
	{ note: "Search and stack trash", card: card("OP17-080", "Usopp", "/Cards/OP17/New OP17/OP17-080.jpg") },
	{ note: "Protect board", card: card("OP17-095", "Roronoa Zoro", "/Cards/OP17/New OP17/OP17-095.jpg") },
	{ note: "Unblockable", card: card("OP17-084", "Tony Tony.Chopper", "/Cards/OP17/New OP17/OP17-084.jpg") },
	{ note: "Cycle your hand", card: card("OP17-082", "Sanji", "/Cards/OP17/New OP17/OP17-082.jpg") },
	{ note: "Gain tempo", card: card("OP17-091", "Brook", "/Cards/OP17/New OP17/OP17-091.jpg") },
	{ note: "Recycle and block", card: card("OP17-081", "Gerd", "/Cards/OP17/New OP17/OP17-081.jpg") },
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags">
					<span class="hero-chip">Deck Guide</span>
					<span class="hero-chip hero-chip-accent">OP17 Format</span>
				</div>
				<h1>Monkey D. Luffy OP17 Deck Guide</h1>
				<p class="hero-intro">Build an Elbaph board that turns your 12-cost Characters into Blockers, use the trash as a resource, and pressure with boosted 2-cost Characters. This guide covers the decklist, mulligan, curve lines, Luffy targets, tech choices, matchups, and gameplay tips.</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="#curve">Curve Guide</a>
					<a class="btn btn-secondary" href="#matchups">Matchups</a>
				</div>
			</div>
			<div class="guide-icon">
				<img src={icon} alt="Monkey.D.Luffy OP17 deck guide icon" loading="eager" />
			</div>
		</div>
	</section>

	<section id="decklist" class="list-section">
		<div class="container article-stack">
			<div class="glow-block feature-block">
				<div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>Copy for Sim</button></div><p>OP17 Elbaph Luffy built to establish 12-cost Blockers, pressure with 2-cost Characters, and recycle the trash.</p></div>
				<div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><span class="deck-count">{entry.count}x</span><div><div class="deck-name">{entry.name}</div><div class="deck-code">{entry.code}</div></div></div><span class="deck-role">{entry.role}</span></button>)}</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header"><div><h2>Mulligan</h2><p>Your opening hand should set up the trash, find your Elbaph pieces, and give you access to a 12-cost or higher Character quickly.</p></div></div>
				<div class="mulligan-list">{mulliganSections.map((section) => <article class="mulligan-priority"><h3>{section.title}</h3><div class="mulligan-cards">{section.cards.map((entry) => <button class="mini-card mulligan-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p class="curve-note">{section.text}</p></article>)}</div>
			</div>

			<div id="curve" class="glow-block feature-block">
				<div class="section-header feature-header"><div><h2>Curve Guide</h2><p>Your curve changes significantly depending on whether you go first or second. Going second is especially strong because the even DON!! steps chain your main plays naturally.</p></div></div>
				<div class="curve-guide-block"><h3>Going First</h3><div class="curve-rows">{goingFirstCurve.map((slot) => <div class={`curve-row ${slot.cards.length === 4 ? "curve-row-four" : slot.cards.length === 3 ? "curve-row-three" : slot.cards.length === 2 ? "curve-row-two" : ""}`}><div><div class="curve-label">{slot.label}</div>{slot.cards.length > 0 && <div class={`curve-cards ${slot.cards.length === 4 ? "curve-cards-four" : slot.cards.length === 3 ? "curve-cards-three" : ""}`}>{slot.cards.map((entry, index) => <span class="curve-card-group"><button class="mini-card curve-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>{slot.joins?.[index] && <span class={`curve-join ${slot.joins[index] === "or" ? "curve-join-or" : ""}`}>{slot.joins[index]}</span>}</span>)}</div>}</div><p class="curve-note">{slot.text}</p></div>)}</div></div>
				<div class="curve-guide-block"><h3>Going Second</h3><div class="curve-rows">{goingSecondCurve.map((slot) => <div class={`curve-row ${slot.cards.length === 4 ? "curve-row-four" : slot.cards.length === 3 ? "curve-row-three" : slot.cards.length === 2 ? "curve-row-two" : ""}`}><div><div class="curve-label">{slot.label}</div><div class={`curve-cards ${slot.cards.length === 4 ? "curve-cards-four" : slot.cards.length === 3 ? "curve-cards-three" : ""}`}>{slot.cards.map((entry, index) => <span class="curve-card-group"><button class="mini-card curve-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>{slot.joins?.[index] && <span class={`curve-join ${slot.joins[index] === "or" ? "curve-join-or" : ""}`}>{slot.joins[index]}</span>}</span>)}</div></div><p class="curve-note">{slot.text}</p></div>)}</div></div>
				<div class="curve-guide-block pressure-block"><h3>Pressure with 2-Cost Characters</h3><div class="support-row"><div class="support-card-list">{[usopp, robin, brook, sanji].map((entry) => <button class="mini-card support-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p class="curve-note">Once you establish a 12-cost or higher Character, your 2-cost Characters gain 3K Power. Those small bodies become real 5K attackers, letting you pressure the opposing Leader while you keep developing large Blockers.</p></div></div>
			</div>

			<div id="luffy-targets" class="glow-block guide-feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Possible Luffy's Target</h2>
						<p>
							Choose the 2-cost Character that best fits the board when Monkey.D.Luffy OP17-093 is played.
						</p>
					</div>
				</div>
				<div class="target-grid">
					{luffyTargets.map((target) => (
						<article class="target-option">
							<button
								class="mini-card target-card"
								type="button"
								data-card-preview
								data-full={target.card.img}
								data-name={`${target.card.code} ${target.card.name}`}
								data-code={target.card.code}
							>
								<img loading="lazy" src={target.card.img} alt={`${target.card.code} ${target.card.name}`} />
								<div class="mini-label">{target.card.name}</div>
							</button>
							<div class="target-copy">
								<strong>{target.note}</strong>
								<span>{target.card.name}</span>
							</div>
						</article>
					))}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header"><div><h2>Tech Cards</h2><p>Adjust these slots toward cost reduction and board control, or add more defense for the matchups you expect.</p></div></div>
				<div class="tech-grid">{techCards.map((entry) => <article class="tech-card"><button class="mini-card" type="button" data-card-preview data-full={entry.card.img} data-name={`${entry.card.code} ${entry.card.name}`} data-code={entry.card.code}><img src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} loading="lazy" /></button><div><h3>{entry.title}</h3><p class="curve-note">{entry.text}</p></div></article>)}</div>
				<div class="not-recommended"><h3>Not Recommended</h3><div class="support-row"><div class="support-card-list">{[dorry, brogy, stussy, jinbe].map((entry) => <button class="mini-card support-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p class="curve-note">Dorry, Brogy, Stussy, and Jinbe are not necessary in this version. Jinbe matters less here than in Sabo because the Leader already turns your 12-cost or higher Characters into Blockers, giving the deck far more natural defensive options.</p></div></div>
			</div>

			<div class="section-header feature-header"><div><h2>Matchups</h2><p class="matchup-stats-link">For the complete turn-order win rate breakdown, see the <a href="/meta-analysis/Monkey-D-Luffy-op17-stats-OP17-Format/">Monkey D. Luffy OP17 stats in OP17 Format</a>.</p></div></div>
			<div id="matchups" class="matchup-grid">
				{matchupGroups.map((group, groupIndex) => (
					<div class="matchup-card glow-block">
						<div class={`matchup-badge ${groupIndex < 2 ? "badge-up" : groupIndex === 2 ? "badge-even" : "badge-down"}`}><span class="badge-icon">{groupIndex === 0 ? "↑" : groupIndex === 1 ? "↗" : groupIndex === 2 ? "~" : "↓"}</span><span>{group.title}</span></div>
						<div class="matchup-row matchup-row-cards-only"><div class="tip-cards">{group.entries.map(([name, image]) => <div class="mini-card matchup-static-card" aria-label={name}><img class={name === "Nico Robin OP09" ? "nico-robin-matchup-image" : undefined} src={image} alt={name} loading="lazy" /></div>)}</div></div>
					</div>
				))}
			</div>

			<div class="glow-block feature-block"><div class="section-header feature-header"><div><h2>Tips</h2><p>Elbaph Luffy rewards deliberate trash management, patient defense, and precise 2-cost sequencing.</p></div></div><ol class="tips-list">{tips.map((tip) => <li class="tip-item"><div class={`tip-card-list ${tip.cards.length === 4 ? "tip-card-list-four" : ""}`}>{tip.cards.map((entry) => <button class="mini-card tip-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p class="curve-note">{tip.text}</p></li>)}</ol></div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true">
		<div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview">
			<button class="modal-close" type="button" data-close>Close</button>
			<img src="" alt="" data-modal-image />
		</div>
	</div>
</MainLayout>
<script>
	const previewButtons = document.querySelectorAll("[data-card-preview]");
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const modalEffect = document.querySelector("[data-modal-effect]");
	const closeButton = document.querySelector("[data-close]");
	const copyButtons = document.querySelectorAll("[data-copy-sim]");
	const keywordBadge = (icon, alt) => ({ type: "keyword", icon, alt });
	const decklistEffectTextByCode = {
		"OP17-079": [
			["All of your Characters with a cost of 12 or more gain ", keywordBadge("blocker", "Blocker"), "."],
			["(After your opponent attacks, you can rest this card and target this card for the next attack.)"],
		],
		"OP17-080": [
			["If there is a Character with a cost of 12 or more, this Character gains +3000 power."],
			[keywordBadge("on-play", "On Play"), " Look at the top 3 cards of your deck, reveal up to 1 {Elbaph} type card and add it to your hand. Then, trash the rest."],
		],
		"OP17-081": [
			["If your Leader has the {Elbaph} type, this Character gains +12 cost."],
			[keywordBadge("on-play", "On Play"), " You may trash 1 card from your hand: Add up to 1 Character with a cost of 8 or less from your trash other than [Gerd] to your hand."],
		],
		"OP17-082": [
			["If there is a Character with a cost of 12 or more, this Character gains +3000 power."],
			[keywordBadge("on-play", "On Play"), " Draw 2 cards and trash 2 cards from your hand."],
		],
		"OP17-083": [
			["If there is a Character with a cost of 12 or more, this Character gains ", keywordBadge("blocker", "Blocker"), " and +3000 power."],
			["(After your opponent declares an attack, you may rest this card to make it the new target of the attack.)"],
		],
		"OP17-084": [
			[keywordBadge("on-play", "On Play"), " If there is a Character with a cost of 12 or more, up to 1 of your Characters gains ", keywordBadge("unblockable", "Unblockable"), " during this turn."],
			["(This card cannot be blocked.)"],
		],
		"OP17-085": [
			["This Character gains +12 cost."],
			[keywordBadge("on-play", "On Play"), " If your Leader has the {Elbaph} type, play up to 1 [Brogy] with a cost of 5 or less from your hand or trash. Then, you cannot play Character cards during this turn."],
		],
		"OP17-086": [
			[keywordBadge("on-play", "On Play"), " You may trash 1 {Elbaph} type card from your hand: Draw 2 cards."],
		],
		"OP17-087": [
			["If there is a Character with a cost of 12 or more, this Character gains +3000 power."],
			[keywordBadge("on-play", "On Play"), " If there is a Character with a cost of 12 or more, give up to 1 of your opponent's Characters -3000 power during this turn."],
		],
		"OP17-089": [
			["This Character gains +12 cost."],
			[keywordBadge("on-play", "On Play"), " Look at 3 cards from the top of your deck; reveal up to 1 {Elbaph} type card and add it to your hand. Then, trash the rest."],
		],
		"OP17-091": [
			["If there is a Character with a cost of 12 or more, this Character gains +3000 power."],
			[keywordBadge("on-play", "On Play"), " If there is a Character with a cost of 12 or more, your opponent trashes 1 card from their hand."],
		],
		"OP17-092": [
			["This Character gains +12 cost."],
			[keywordBadge("on-play", "On Play"), " If your Leader has the {Elbaph} type, play up to 1 [Dorry] with a cost of 5 or less from your hand or trash. Then, you cannot play Character cards during this turn."],
		],
		"OP17-093": [
			["If there is a Character with a cost of 12 or more, this Character gains ", keywordBadge("rush", "Rush"), "."],
			[keywordBadge("on-play", "On Play"), " Draw 1 card, and play up to 1 Character card with a cost of 2 or less from your trash."],
		],
		"OP17-094": [
			["If your Leader has the {Elbaph} type, this Character gains +12 cost."],
		],
		"OP17-095": [
			["If there is a Character with a cost of 12 or more, this Character gains +3000 power."],
			["If one of your Characters would be removed from the field by your opponent's effect, you may place 3 cards from your trash at the bottom of your deck in any order instead."],
		],
		"OP17-097": [
			[keywordBadge("main", "Main"), " Give all of your opponent's Characters -1 cost during this turn."],
			[keywordBadge("counter", "Counter"), " Your Leader gains +3000 power during this battle."],
		],
		"OP17-098": [
			[keywordBadge("main", "Main"), " You may rest 6 of your DON!! cards: If there is a Character with a cost of 12 or more, K.O. up to 2 of your opponent's Characters with a cost of 6 or less."],
			[keywordBadge("counter", "Counter"), " Your Leader gains +3000 power during this battle."],
		],
		"OP17-119": [
			["This Character gains +12 cost, and during your opponent's turn, this Character gains +3000 power."],
			[keywordBadge("on-play", "On Play"), " K.O. any number of your opponent's Characters with a total cost of 4 or less."],
		],
	};

	const openModal = (button) => {
		if (!modal || !modalImage) return;
		const full = button.getAttribute("data-full");
		const name = button.getAttribute("data-name") || "Card preview";
		const code = button.getAttribute("data-code");
		const effectLines = code?.startsWith("OP17") ? decklistEffectTextByCode[code] : null;
		modalImage.setAttribute("src", full);
		modalImage.setAttribute("alt", name);
		if (modalEffect) {
			modalEffect.innerHTML = "";
			if (effectLines?.length) {
				effectLines.forEach((line) => {
					const paragraph = document.createElement("p");
					const normalizedLine = Array.isArray(line) ? line : [line];
					normalizedLine.forEach((part) => {
						if (typeof part === "string") {
							paragraph.appendChild(document.createTextNode(part));
							return;
						}
						if (part?.type === "keyword") {
							const image = document.createElement("img");
							image.className = "modal-keyword-badge";
							image.src = `/assets/keywords/${part.icon}.png`;
							image.alt = part.alt;
							paragraph.appendChild(image);
						}
					});
					modalEffect.appendChild(paragraph);
				});
				modalEffect.hidden = false;
			} else {
				modalEffect.hidden = true;
			}
		}
		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
		document.body.style.overflow = "hidden";
	};

	const closeModal = () => {
		if (!modal || !modalImage) return;
		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
		modalImage.setAttribute("src", "");
		modalImage.setAttribute("alt", "");
		if (modalEffect) {
			modalEffect.innerHTML = "";
			modalEffect.hidden = true;
		}
		document.body.style.overflow = "";
	};

	previewButtons.forEach((button) => {
		button.addEventListener("click", () => openModal(button));
	});

	closeButton?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (event) => {
		if (event.target === modal) closeModal();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && modal?.classList.contains("is-open")) {
			closeModal();
		}
	});

	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const simDeck = button.getAttribute("data-sim-deck");
			if (!simDeck) return;
			const previous = button.textContent?.trim();

			try {
				await navigator.clipboard.writeText(simDeck);
				button.textContent = "Copied";
				window.setTimeout(() => {
					button.textContent = previous ?? "Copy for Sim";
				}, 1800);
			} catch {
				button.textContent = "Copy failed";
				window.setTimeout(() => {
					button.textContent = previous ?? "Copy for Sim";
				}, 1800);
			}
		});
	});
</script>
