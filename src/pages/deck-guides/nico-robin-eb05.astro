---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Nico Robin EB05 Deck Guide: Decklist, Mulligan & Game Plan";
const description = "Nico Robin EB05 deck guide with decklist, mulligan priorities, game plan, tech cards, matchups, and practical tips for the EB05 format.";

const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });
const leader = card("EB05-010", "Nico Robin", "/Cards/EB05/EB05-010 Nico Robin .jpg", 1, "Leader");
const atlas = card("EB05-050", "Atlas", "/Cards/EB05/EB05-050 Atlas.jpg", 4);
const nicoOlivia = card("EB05-056", "Nico Olivia", "/Cards/EB05/EB05-056 Nico Olivia.jpg", 4);
const lilith = card("OP13-113", "Lilith", "/Cards/OP13/OP13-113.jpg", 4);
const nojiko = card("EB05-057", "Nojiko", "/Cards/EB05/EB05-057 Nojiko.jpg", 4);
const pudding = card("OP17-109", "Charlotte Pudding", "/Cards/OP17/New OP17/OP17-109.jpg", 4);
const megalo = card("EB04-018", "Megalo", "/Cards/EB04/EB04-018.jpg", 4);
const gloriosa = card("EB05-052", "Gloriosa", "/Cards/EB05/EB05-052 Gloriosa.jpg", 4);
const borsalino = card("EB04-058", "Borsalino", "/Cards/EB04/EB04-058.jpg", 4);
const nami = card("EB05-055", "Nami", "/Cards/EB05/EB05-055 Nami.jpg", 4);
const robin = card("EB05-016", "Nico Robin", "/Cards/EB05/EB05-016 Nico Robin.jpg", 4);
const trafalgarLaw = card("OP13-031", "Trafalgar Law", "/Cards/OP13/OP13-031.jpg", 4);
const rayleigh = card("OP14-108", "Silvers Rayleigh", "/Cards/OP14/OP14-108.jpg", 3);
const shanks = card("OP17-022", "Shanks", "/Cards/OP17/New OP17/OP17-022.jpg", 3);
const baby5 = card("OP12-112", "Baby 5", "/Cards/OP12/OP12-112.jpg");
const teach = card("OP16-119", "Teach", "/Cards/OP16/OP16-119.jpg");

const op14Law = card("OP14-001", "Trafalgar Law OP14", "/Cards/OP14/OP14-001.jpg", null, "Leader");
const rosinante = card("OP12-061", "Donquixote Rosinante OP12", "/Cards/OP12/OP12-061.jpg", null, "Leader");
const sabo = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg", null, "Leader");
const kuzan = card("OP12-040", "Kuzan OP12", "/Cards/OP12/OP12-040.jpg", null, "Leader");
const namiOp11 = card("OP11-041", "Nami OP11", "/Cards/OP11/OP11-041.jpg", null, "Leader");
const roger = card("OP13-003", "Gol.D.Roger OP13", "/Cards/OP13/OP13-003.jpg", null, "Leader");

const decklist = [leader, atlas, nicoOlivia, lilith, nojiko, pudding, megalo, gloriosa, borsalino, nami, robin, trafalgarLaw, rayleigh, shanks];
const simDeckCode = decklist.flatMap((entry) => entry.count ? [`${entry.count}x${entry.code}`] : []).join("\n");

const mulliganSections = [
  { title: "Cards to Prioritize", cards: [atlas, pudding, lilith], text: "Atlas EB05-050 is a very strong start. It immediately lets you search for a Wisdom card.\n\nCharlotte Pudding OP17-109 is also valuable very early. It provides card advantage and can later use your Leader effect to attack a second time when it remains at 6000 Power or less.\n\nLilith OP13-113 is another search option. It also has a Trigger, increasing the number of cards that can generate value from your Life." },
  { title: "Above All, Prepare Your Next Turns", cards: [gloriosa, nami, robin], text: "A good hand should also give you access to your 5- and 6-cost Characters, especially Gloriosa EB05-052, Nami EB05-055, and Nico Robin EB05-016.\n\nNami is especially important because it is one of your main healing sources. Nico Robin plus Nami is also a very strong sequence for developing your board while recovering a Life." },
  { title: "Avoid a Hand That Relies Too Much on Situational Cards", cards: [rayleigh, shanks], text: "Silvers Rayleigh OP14-108 is mainly included in this decklist for the strength of its Trigger, so it is not a card to build your opening hand around.\n\nFinally, Shanks OP17-022 is your late-game finisher: you do not need to have it from the start." },
];

const gamePlanSections = [
  { title: "Early Game - Search and Card Advantage", cards: [atlas, lilith, pudding], text: "Your early turns are mainly for finding your pieces and preparing your board. Atlas EB05-050 and Lilith OP13-113 give you access to your next cards, while Charlotte Pudding OP17-109 provides card advantage. Pudding can then become a real attacker: with 2 DON!! attached, it reaches 6000 Power, can attack, be made Active with the Leader effect, then attack a second time." },
  { title: "Mid Game - Play Your 5- and 6-Cost Characters", cards: [gloriosa, nami, robin], text: "This is where your board starts to gain real value. Gloriosa EB05-052, Nami EB05-055, and Nico Robin EB05-016 make up a large part of your important plays. The Nico Robin to Nami sequence is especially strong because it develops your board while recovering a Life. On the following turn, Nami and Robin can use your Leader effect to make multiple attacks while they remain at 6000 Power or less. Your goal is not simply to play one large Character: you gradually want several 6000-Power attackers that can apply repeated pressure." },
  { title: "Trafalgar Law - Develop Your Board While Reusing Nami", cards: [trafalgarLaw, nami], text: "Trafalgar Law OP13-031 can return Nami to your hand and let you play it again. This interaction is especially valuable because the Character played by Law arriving Rested is not a real problem for Nami: if your opponent KOs it, its removal can let you heal through your Leader effect; otherwise, you can use your Leader effect to make it Active. Law therefore gives you another way to use your Life-recovery effects while developing your board." },
  { title: "Use Your Leader to Multiply Attacks", cards: [leader, pudding, nami], text: "One of Robin's main strengths is being able to make a Character with 6000 Power or less Active, allowing it to attack again. This works especially well with Characters such as Pudding or Nami: instead of putting all your DON!! into one large attack, you can create several attacks around 6000 Power." },
  { title: "Manage Your Life as a Resource", cards: [nami, nojiko], text: "The deck has many ways to heal, but some cards become better as your Life decreases. Nami and Nojiko have Triggers that can only be used when you have 2 Life or less. Do not treat healing as something to trigger automatically: your Life total directly affects the value of some cards." },
  { title: "Late Game - Use Shanks to Open the Board and Finish", cards: [shanks], text: "Shanks OP17-022 is your main finisher. It becomes especially important against decks that protect themselves with several Blockers. In addition to having Rush, Shanks can rest those Blockers, then gives you another attack to use through the DON!! made Active. Against OP12 Rosinante in particular, stacking Blockers is not enough to stop Robin once Shanks is in play." },
  { title: "Watch Out for 7000+ Power Leaders", cards: [leader], text: "This is one of the deck's biggest weaknesses. Your Leader can only make a Character with 6000 Power or less Active. Against a Leader that reaches 7000 or 8000 Power, your first 6000-Power attack becomes ineffective. OP14 Law shows this clearly with EB04 Zoro, then OP17 Newgate: once the opposing Leader is at 7000 or 8000 Power, double 6000-Power attacks lose a great deal of value and your Leader effect becomes much harder to use." },
  { title: "The Weakness to Keep in Mind - Bottom Deck", cards: [leader], text: "Your healing plan works when one of your Wisdom Characters is KO'd, but not when it is sent to the bottom of the deck. This is especially problematic against cards such as Gravity Blade: you lose your Characters without receiving the expected heal. Against OP12 Kuzan in particular, several bottom-deck effects can gradually break your board and your ability to maintain pressure." },
];

const techCards = [
  { card: nojiko, title: "Nojiko EB05-057", text: "Nojiko is one of the most debatable cards in this version of the decklist. Its Trigger can provide value, but the condition tied to your Life total is regularly an issue: Robin heals enough that Nojiko is often revealed while you still have too much Life to use its Trigger. It still has the advantage of being a 2000 Counter and can be played when you do not have access to your Searchers early." },
  { card: rayleigh, title: "Silvers Rayleigh OP14-108", text: "The three Silvers Rayleigh are mainly included for their Trigger. It is one of the best yellow Triggers available, with the ability to KO a Character with 7000 base Power. Its inclusion adds another threat directly from your Life." },
  { card: megalo, title: "Megalo EB04-018", text: "Megalo has several roles in the deck. With 2 DON!!, it can reach 6000 Power, allowing it to attack and then use Robin's Leader effect to attack a second time. If you make it Rest with its On Play effect, it can KO a Rested Character with 8000 Power. Against OP12 Kuzan in particular, Megalo can be played as an answer to Issho." },
  { card: gloriosa, title: "Gloriosa EB05-052", text: "Gloriosa requires specific management. You can trash it to prevent taking damage, but this does not trigger Nico Robin's heal: Gloriosa trashes itself, so it is not KO'd. Conversely, if your opponent attacks Gloriosa and KOs it, you can use Robin's heal. It is better not to sacrifice Gloriosa too quickly and to save its effect for situations where preventing damage is truly necessary." },
  { card: borsalino, title: "Borsalino EB04-058", text: "Borsalino is mainly included to strengthen the deck's ability to recover Life. Together with Nami, the deck has multiple healing sources. Some situations even allow several heals in a row to quickly rebuild your Life and extend the game." },
];

const alternatives = [
  { title: "Baby 5", card: baby5, text: "Baby 5 is a possible replacement for Nojiko, which is too often limited by its Life condition." },
  { title: "Removal Protection", text: "Cards that protect against removal are also possible, especially Bonney or potentially Laboon. The goal would mainly be to protect your Characters from bottom-deck removal or being returned to hand, because those forms of removal bypass your ability to heal when a Character is KO'd." },
  { title: "Teach OP16", card: teach, text: "Teach OP16 could be interesting, but it is too slow." },
];

const matchups = [
  { leader: op14Law, title: "OP14 Law", points: ["The main problem appears when the Leader greatly increases its Power with EB04 Zoro or OP17 Newgate. At 7000 or 8000 Power, your 6000-Power Characters become much less effective and your Leader effect loses much of its value.", "While the Leader remains at normal Power, look to use your 6000-Power Characters to multiply attacks with Robin's effect.", "Your ability to heal with Nami, Borsalino, and Trafalgar Law can extend the game, but it does not solve the problem of a Leader that remains above 6000 Power.", "If your opponent keeps that high Power for several turns, you may have to slow down and wait for it to end instead of making several low-value attacks."] },
  { leader: rosinante, title: "OP12 Rosinante", points: ["The many Blockers do not necessarily stop Robin. Your number of attacks already lets you pressure them.", "Shanks OP17-022 becomes especially important in the late game: it can rest opposing Blockers and open the way for your attacks.", "Your healing can also offset damage from opposing Characters. Against opposing Rosinante and Law, the idea is to outheal their damage with Nami and Borsalino.", "Once your board is developed enough, keep multiplying 6000-Power attacks rather than letting opposing Blockers completely dictate your attacks."] },
  { leader: sabo, title: "OP13 Sabo", points: ["Sabo can make many attacks quickly, including several around 6000 or 7000 Power. You must be careful not to get overwhelmed before your board is established.", "Shanks OP17-022 can completely change a turn when the opposing board is full. It can deal with Loki, then help you regain control over the other Characters.", "Your Leader effect can help you attack opposing Characters several times to force Counter, but you need to actually remove them: putting several attacks into a Character that your opponent ultimately keeps can cost you a great deal of pressure.", "Do not rely on your opponent to KO your small Searchers and give you free healing."] },
  { leader: kuzan, title: "OP12 Kuzan", points: ["Bottom-deck removal is one of Robin's biggest problems. Unlike a KO, it does not let you use your heal when your Characters leave the board.", "Gravity Blade is especially problematic because it can remove your Characters without triggering your Life-recovery plan. Several Gravity Blades can significantly reduce your board pressure.", "Try to maintain pressure with repeated 6000-Power attacks when you have the opportunity. Waiting an extra turn to set up more attacks can give Kuzan time to find another answer and reduce your board again.", "Megalo EB04-018 can help handle threats such as Issho, but this matchup especially highlights the potential need for protection against removal other than KO effects."] },
  { leader: namiOp11, title: "7000+ Power Leaders", points: ["This weakness is not limited to OP14 Law. Leaders that can naturally or regularly stay above 6000 Power, such as OP11 Nami or OP13 Roger, are problematic.", "Your Leader can only make a Character with 6000 Power or less Active. You are therefore normally encouraged to build your double attacks around that threshold.", "Against a Leader with 7000 Power or more, the first 6000-Power attack becomes much less threatening, greatly reducing the value of your Leader ability."] },
];

const tips = [
  { cards: [pudding, nami, megalo], text: "Build your double attacks around Characters at 6000 Power. Pudding, Nami, and Megalo can use Robin's effect to attack, become Active, then attack a second time. Do not unnecessarily go above 6000 Power on the Character you want to make Active again." },
  { cards: [gloriosa, leader], text: "Do not sacrifice Gloriosa too easily. Its effect trashes it and therefore does not trigger Robin's heal. If your opponent attacks Gloriosa and KOs it, you can heal instead. Use its effect to prevent damage mainly when it becomes truly necessary." },
  { cards: [trafalgarLaw, nami], text: "Use Trafalgar Law to reuse Nami. Law can return Nami and let you play it again to recover Life once more. The fact that it enters Rested is not a problem: if your opponent then chooses to KO it, you can use the heal again." },
  { cards: [leader, nami], text: "Do not automatically protect every Character. Some can recover Life for you when they are KO'd. Depending on the situation, letting Nami or another relevant Character be removed can be better than spending several Counter cards to keep it." },
  { cards: [nami, nojiko], text: "Watch your Life total before relying on your Triggers. Nami and Nojiko can be in your Life without being able to fully use their Trigger while you are still too high on Life. The deck's substantial healing makes this situation relatively common." },
  { cards: [leader], text: "Adjust your attacks against high-Power Leaders. Against a 7000- or 8000-Power Leader, chaining 6000-Power attacks loses a great deal of value. This is a direct weakness of Robin because the Characters her effect can make Active are limited to 6000 Power or less." },
  { cards: [leader], text: "Identify removal that bypasses KO effects early. Your heal works with a KO, but bottom-deck removal or returning a Character to hand can remove your Characters without giving you that compensation. Gravity Blade is especially problematic for this reason." },
  { cards: [shanks], text: "Keep Shanks for situations where it truly opens your offense. It is especially effective against boards full of Blockers or when it lets you secure lethal." },
];
---

<MainLayout title={title} description={description}>
  <section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span class="hero-chip">Deck Guide</span><span class="hero-chip hero-chip-accent">EB05 Format</span></div><h1>Nico Robin EB05 Deck Guide</h1><div class="hero-actions"><a class="btn btn-primary" href="#curve">Game Plan &amp; Curve</a><a class="btn btn-secondary" href="#matchups">Matchups</a><a class="btn btn-secondary" href="/cards-list/EB05/">EB05 Cards List</a></div></div><div class="guide-icon"><img src="/assets/guides/Nico Robin EB05.png" alt="Nico Robin EB05 deck guide icon" loading="eager" /></div></div></section>
  <section id="decklist" class="list-section"><div class="container article-stack">
    <section class="glow-block"><div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim={simDeckCode}>Copy for Sim</button></div></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><span class="deck-count">{entry.count}x</span><span><span class="deck-name">{entry.name}</span><span class="deck-code">{entry.code}</span><span class="deck-role">{entry.role}</span></span></div></button>)}</div></section>
    <section id="mulligan" class="glow-block"><h2>Mulligan</h2><p>Your priority is to have a strong early game with your Searchers, so you can prepare your Wisdom Characters and your key plays for the following turns.</p><div class="mulligan-list">{mulliganSections.map((item) => <article class="content-item"><h3>{item.title}</h3><div class="item-row"><div class="card-set">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><div class="paragraphs">{item.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}</div></div></article>)}</div><div class="ideal-mulligan"><h3>Ideal Mulligan</h3><p>Look primarily for an opening hand with Atlas, Pudding, or Lilith, plus a way to continue developing with Gloriosa, Nami, or Nico Robin.</p><p>The goal is to avoid a hand full of late-game cards or cards whose Triggers only become truly useful once your Life is low enough.</p></div></section>
    <section id="curve" class="glow-block"><h2>Game Plan &amp; Curve</h2><div class="curve-rows">{gamePlanSections.map((item) => <article class="curve-row game-plan-row" style="display:flex;flex-direction:column;align-items:stretch;gap:1rem"><div class="curve-cards game-plan-cards" style="display:flex;flex-wrap:nowrap;align-items:flex-start;gap:.65rem;width:100%">{item.cards.map((entry) => <button class="mini-card curve-card" type="button" style={item.cards.length > 1 ? "flex:1 1 0;min-width:0" : undefined} data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} style={item.cards.length > 1 ? "width:100%;max-width:98px" : undefined} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><div><h3>{item.title}</h3><div class="curve-note paragraphs">{item.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}</div></div></article>)}</div></section>
    <section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><div class="tech-grid">{techCards.map((item) => <article class="tech-card"><button class="mini-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={getCardThumbnail(item.card.img)} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><div><h3>{item.title}</h3><div class="paragraphs">{item.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}</div></div></article>)}</div><div class="alternatives"><h3>Alternatives Considered</h3>{alternatives.map((item) => <article class:list={{ "alternative-with-card": Boolean(item.card) }}>{item.card ? <><button class="mini-card alternative-card" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={getCardThumbnail(item.card.img)} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><div><h4>{item.title}</h4><div class="paragraphs">{item.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}</div></div></> : <><h4>{item.title}</h4><div class="paragraphs">{item.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}</div></>}</article>)}</div></section>
    <section id="matchups" class="glow-block"><h2>Matchups</h2><div class="matchup-grid">{matchups.map((item) => <article class="matchup-card"><button class="mini-card matchup-leader-card" type="button" data-card-preview data-full={item.leader.img} data-name={item.leader.name}><img src={item.leader.img} alt={item.leader.name} loading="lazy" /></button><div><h3>{item.title}</h3><ul class="matchup-points">{item.points.map((point) => <li>{point}</li>)}</ul></div></article>)}</div></section>
    <section id="tips" class="glow-block"><h2>Tips</h2><div class="tips-list">{tips.map((item) => <article class="tip-card"><div class="tip-cards" style={`display:grid;grid-template-columns:repeat(${item.cards.length},minmax(0,1fr));width:100%;gap:.65rem`}>{item.cards.map((entry) => <button class="mini-card" type="button" style="min-width:0" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} style="width:100%;max-width:98px" alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><div class="paragraphs">{item.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}</div></article>)}</div></section>
  </div></section>
  <div class="card-modal" data-modal aria-hidden="true"><div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview"><button class="modal-close" type="button" data-close>Close</button><img src="" alt="" data-modal-image /></div></div>
</MainLayout>

<script>
  const modal = document.querySelector("[data-modal]");
  const modalImage = document.querySelector("[data-modal-image]");
  const closeModal = () => { modal?.classList.remove("is-open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; };
  document.querySelectorAll("[data-card-preview]").forEach((button) => button.addEventListener("click", () => { if (!modal || !modalImage) return; modalImage.src = button.dataset.full || ""; modalImage.alt = button.dataset.name || "Card preview"; modal.classList.add("is-open"); modal.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; }));
  document.querySelector("[data-close]")?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
  document.querySelectorAll("[data-copy-sim]").forEach((button) => button.addEventListener("click", async () => { const deck = button.dataset.copySim; if (!deck) return; const previous = button.textContent; try { await navigator.clipboard.writeText(deck); button.textContent = "Copied"; } catch { button.textContent = "Copy failed"; } window.setTimeout(() => { button.textContent = previous; }, 1800); }));
</script>

<style>
  .guide-hero{padding-top:3rem}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:2.5rem;align-items:center}.hero-tags,.hero-actions,.card-set,.curve-cards,.tip-cards{display:flex;flex-wrap:wrap;gap:.65rem;align-items:center}.hero-tags span{border:1px solid rgba(255,107,53,.45);border-radius:999px;padding:.35rem .7rem;font-size:.8rem;font-weight:800}.guide-icon{justify-self:end;width:210px}.guide-icon img{width:100%;border-radius:18px;box-shadow:0 24px 52px rgba(0,0,0,.35)}.article-stack,.mulligan-list,.curve-rows,.tech-grid,.tips-list,.matchup-grid{display:grid;gap:1rem}.glow-block{padding:1.25rem;border:2px solid rgba(255,107,53,.48);border-radius:18px;background:rgba(8,12,24,.82);box-shadow:0 0 28px rgba(255,107,53,.07)}.glow-block h2,.glow-block h3,.glow-block h4,.glow-block p{margin-top:0}.decklist-title-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1rem}.copy-sim-button{width:auto}.deck-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.85rem;margin-top:1rem}.deck-card{display:grid;gap:.55rem;padding:.7rem;border:1px solid rgba(255,107,53,.26);border-radius:12px;background:rgba(0,0,0,.22);color:inherit;text-align:left;cursor:pointer}.deck-card img{width:100%;max-width:110px;margin:auto;border-radius:10px}.deck-info{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.5rem;align-items:center}.deck-count{color:#ff8a42;font-weight:900}.deck-name{display:block;font-weight:700}.deck-code,.deck-role{display:block;color:var(--text-300);font-size:.75rem}.deck-role{text-transform:uppercase;letter-spacing:.05em}.content-item+.content-item,.alternatives{margin-top:1rem;padding-top:1rem;border-top:2px solid rgba(255,107,53,.42)}.item-row,.curve-row,.tech-card{display:grid;grid-template-columns:minmax(180px,330px) minmax(0,1fr);gap:1rem;align-items:center}.mini-card{border:0;padding:0;background:transparent;cursor:pointer}.mini-card img{display:block;width:98px;border-radius:10px}.ideal-mulligan{margin-top:1rem;padding-top:1rem;border-top:2px solid rgba(255,107,53,.42)}.curve-row,.tech-card,.tip-card,.matchup-card{padding:1rem;border:1px solid rgba(255,107,53,.3);border-radius:14px;background:rgba(0,0,0,.2)}.curve-row h3,.tech-card h3,.matchup-card h3{margin-bottom:.45rem}.curve-note,.tech-card p,.tip-card p{margin-bottom:0;line-height:1.6}.curve-card img{width:98px}.tech-card{align-items:start}.tech-card p{margin:0}.alternatives article+article{margin-top:1rem}.alternatives h4{margin-bottom:.3rem}.matchup-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.matchup-card{display:flex;flex-direction:column;align-items:flex-start;gap:1rem}.matchup-leader-card img{display:block;width:98px;max-width:none;height:137px;aspect-ratio:480 / 670;object-fit:contain;border-radius:10px}.matchup-points{display:grid;gap:.7rem;margin:0;padding-left:1.25rem;line-height:1.6}.tip-card{display:grid;grid-template-columns:minmax(180px,330px) minmax(0,1fr);gap:1rem;align-items:center}.card-modal{position:fixed;inset:0;z-index:40;display:grid;place-items:center;padding:1rem;background:rgba(0,0,0,.78)}.card-modal[aria-hidden="true"]{display:none}.card-modal-inner{position:relative;max-width:min(440px,92vw)}.card-modal img{display:block;width:100%;max-height:84vh;object-fit:contain}.modal-close{position:absolute;right:0;top:-2.5rem;border:0;border-radius:999px;padding:.5rem .9rem;background:#ff6b35;color:#fff;cursor:pointer}
