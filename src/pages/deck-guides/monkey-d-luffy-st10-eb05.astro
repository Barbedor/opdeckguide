---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Monkey.D.Luffy ST10 Deck Guide";
const description = "Monkey.D.Luffy ST10 deck guide for the EB05 format, with decklist, mulligan priorities, game plan, tech cards, matchups, and tips.";
const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const leader = card("ST10-002", "Monkey.D.Luffy", "/Cards/ST10/ST10-002.png", 1, "Leader");
const bonney = card("EB04-002", "Jewelry Bonney", "/Cards/EB04/EB04-002.jpg", 2);
const robin = card("EB05-033", "Nico Robin", "/Cards/EB05/EB05-033 Nico Robin.jpg", 4);
const nami = card("OP01-016", "Nami", "/Cards/OP01/OP01-016.png", 4);
const garp = card("OP13-016", "Monkey.D.Garp", "/Cards/OP13/OP13-016.jpg", 2);
const sanji = card("ST21-003", "Sanji", "/Cards/ST21/ST21-003.jpg", 1);
const zoroRamp = card("OP05-067", "Roronoa Zoro", "/Cards/OP05/OP05-067.png", 4);
const rakuyo = card("OP17-016", "Rakuyo", "/Cards/OP17/New OP17/OP17-016.jpg", 2);
const yamato = card("OP17-074", "Yamato", "/Cards/OP17/Yamato op17-074.jpg", 4);
const usohachi = card("ST18-001", "Usohachi", "/Cards/ST18/ST18-001.png", 2);
const mr2 = card("EB01-061", "Mr.2.Bon.Kurei (Bentham)", "/Cards/EB01/EB01-061.jpg", 4);
const zoro = card("EB04-007", "Roronoa Zoro", "/Cards/EB04/EB04-007.jpg", 4);
const roger = card("P-107", "Gold.D.Roger", "/Cards/P/P-107.jpg", 2);
const luffy = card("OP05-119", "Monkey.D.Luffy", "/Cards/OP05/OP05-119.png", 3);
const mamaragan = card("OP15-078", "Mamaragan", "/Cards/OP15/OP15-078.jpg", 4, "Event");
const giant = card("OP09-078", "Gum-Gum Giant", "/Cards/OP09/OP09-078.jpg", 4, "Event");
const sunny = card("ST31-005", "Thousand Sunny", "/Cards/ST31/ST31-005.jpg", 4, "Stage");
const buggy = card("OP09-042", "Buggy OP09", "/Cards/OP09/OP09-042.jpg", null, "Leader");
const luffyGb = card("OP16-022", "Green/Blue Luffy OP16", "/Cards/OP16/OP16-022.jpg", null, "Leader");
const bonneyLeader = card("EB04-001", "Jewelry Bonney EB04", "/Cards/EB04/EB04-001.jpg", null, "Leader");
const law = card("OP14-001", "Trafalgar Law OP14", "/Cards/OP14/OP14-001.jpg", null, "Leader");
const enel = card("OP15-058", "Purple Enel OP15", "/Cards/OP15/OP15-058.jpg", null, "Leader");
const luffyOp17Leader = card("OP17-079", "Monkey D. Luffy OP17", "/Cards/OP17/New OP17/OP17-079.jpg", null, "Leader");
const saboOp13Leader = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg", null, "Leader");

const decklist = [leader, bonney, robin, nami, garp, sanji, zoroRamp, rakuyo, yamato, usohachi, mr2, zoro, roger, luffy, mamaragan, giant, sunny];
const simDeckCode = decklist.map((entry) => `${entry.count}x${entry.code}`).join("\n");

const mulligan = [
  { title: "Roronoa Zoro — Your Priority", cards: [zoro], paragraphs: ["Roronoa Zoro EB04 is one of the most important cards to find.", "Your goal is to play him once you reach 7 DON!! to increase your Leader's Power and become much harder to attack. This protection is essential for buying the time you need before your big late-game turn.", "Access to a second Zoro can also let you maintain this Power for one more turn if you are not ready to start your combo yet."] },
  { title: "Keep a Ramp Source", cards: [yamato, mr2], paragraphs: ["You also want to start with a card that can accelerate your DON!! count.", "Yamato OP17-074 and Mr.2.Bon.Kurei EB01-061 are among your main options for accelerating your progress and reaching the turn when you can play Zoro sooner.", "Ramp is especially important because the deck needs to reach its major DON!! thresholds at the right time to chain its game plan."] },
  { title: "Use Your Searchers to Complete Your Hand", cards: [nami, bonney, garp, sunny], paragraphs: ["Nami OP01-016, Jewelry Bonney EB04-002, Monkey.D.Garp OP13-016, and Thousand Sunny ST31-005 give you several ways to search for the different pieces you need.", "Garp is especially useful because he can access cards your Straw Hat Searchers cannot find, including your Ramp options and Gold.D.Roger P-107.", "Your opening hand therefore does not need to contain every combo piece directly: a good Searcher together with Ramp and Zoro already gives you a solid foundation."] },
  { title: "Do Not Keep Nico Robin Without Her Setup", cards: [robin, luffy], paragraphs: ["Nico Robin EB05-033 is essential to your big turn with Monkey.D.Luffy OP05-119, but she depends on Luffy to really work.", "If you have to choose between the two, Luffy is generally more important because he is playable on his own, while Robin needs your sequence with Luffy to make full use of her effect."] },
  { title: "Ideal Mulligan", cards: [], paragraphs: ["Look primarily for a hand with:", "a Ramp source + Roronoa Zoro EB04 + a Searcher.", "If you already have these pieces, Monkey.D.Luffy OP05-119 becomes an excellent card to keep for your late game.", "The goal is to secure your progression toward 7 DON!! for Zoro, then reach your Luffy + Robin turn safely enough."] },
];

const gamePlan = [
  { title: "Early Game — Search & Ramp", cards: [nami, bonney, garp, sunny], paragraphs: ["Start by playing Nami OP01-016, Jewelry Bonney EB04-002, Monkey.D.Garp OP13-016, or Thousand Sunny ST31-005 to assemble the different pieces of your plan.", "Your main goals are to prepare your Ramp, find Roronoa Zoro EB04-007, then access Monkey.D.Luffy OP05-119 and Nico Robin EB05-033 for your late game.", "Yamato OP17-074 and Mr.2.Bon.Kurei EB01-061 are among your main Ramp cards. Roronoa Zoro OP05-067 also contributes to this acceleration because he can Ramp 1 Active DON!! when he attacks.", "Monkey.D.Garp OP13-016 complements your Straw Hat Searchers by accessing cards Nami and Bonney cannot find, including several of your Ramp cards and Gold.D.Roger P-107."] },
  { title: "Roronoa Zoro OP05-067 — Accelerate Your DON!!", cards: [zoroRamp], paragraphs: ["Roronoa Zoro OP05-067 helps you quickly increase your DON!! count.", "When he attacks, his 1 Active DON!! Ramp lets you accelerate your progress while continuing to apply pressure.", "This Active DON!! can also give you more flexibility during your turn: the goal is not only to reach 10 DON!! faster, but also to have enough resources to chain your different actions without giving up pressure."] },
  { title: "7 DON!! — Roronoa Zoro EB04-007", cards: [zoro], paragraphs: ["Roronoa Zoro EB04-007 is one of the most important pieces for transitioning from your Ramp into your late game.", "When you reach 7 DON!!, Zoro lets you increase your Leader's Power and become much harder to attack. This lets you save Counters and buy the time you need to reach your 10-DON!! turn.", "This Power increase is not only for defense, however. Zoro also has an offensive dimension through his Rush Character options, letting you immediately pressure opposing rested Characters when the situation calls for it.", "If your combo is not ready yet, playing another Zoro can let you keep your Leader's Power high for one more turn instead of rushing your late game."] },
  { title: "Gold.D.Roger — Another Way to Maintain Your Power", cards: [roger], paragraphs: ["Gold.D.Roger P-107 makes your plan more consistent when you do not have access to EB04-007 Zoro.", "He gives you another way to maintain high Leader Power and survive long enough to play your late-game combo.", "He also has the advantage of being accessible with Monkey.D.Garp, giving you another option when your Straw Hat Searchers cannot find the cards you need."] },
  { title: "Thousand Sunny — Turn DON!! Into Pressure", cards: [sunny], paragraphs: ["Thousand Sunny ST31-005 lets you search and increase your Leader's Power.", "The Stage becomes even more valuable during your late-game sequence: after you start rebuilding your DON!! with Luffy, your Leader, and Robin, you can use Sunny to attach a DON!! to your Leader and keep attacking at a meaningful value without using your Active DON!!."] },
  { title: "10 DON!! — Monkey.D.Luffy + Nico Robin", cards: [luffy, robin], paragraphs: ["Your main late-game sequence begins when you reach 10 DON!! with Monkey.D.Luffy OP05-119 and Nico Robin EB05-033 available.", "After playing Luffy and returning your DON!! to your DON!! Deck, you can immediately start rebuilding your resources:", "Leader effect → return to 1 DON!! → Luffy effect → return to 2 DON!! → play Nico Robin with your Active DON!!.", "Robin then becomes the piece that lets you quickly recover a large part of the resources invested in Luffy."] },
  { title: "Nico Robin — Rebuild Your DON!!", cards: [robin], paragraphs: ["Nico Robin EB05-033 first lets you draw 3 cards, then discard 2, which helps improve your hand and find the cards you will need for the rest of the game.", "She then lets you Ramp 4 DON!!, quickly bringing you back to 6 DON!! after your sequence with Luffy.", "Your opponent's DON!! count is essential. For your sequence to work correctly, you generally want them to be far enough along their own curve, usually at 8 DON!!.", "Therefore, avoid starting your Robin combo when your opponent is still only at 7 DON!!."] },
  { title: "Quickly Return to 10 DON!!", cards: [], paragraphs: ["Thanks to Robin's Ramp, you can start this turn at around 8 DON!!. You can then use your Leader to Ramp again.", "You must then choose between two plans: try to finish the game immediately or secure your position for the next turn."] },
  { title: "Secure the Game With Zoro + Gum-Gum Giant", cards: [zoro, giant], paragraphs: ["If you do not have a sufficiently safe lethal, Roronoa Zoro EB04-007 can be one of your best options.", "You can strengthen your Leader again while trying to keep enough DON!! for Gum-Gum Giant OP09-078.", "This combination lets you end your Luffy + Robin sequence with high Leader Power and a major defensive option available during your opponent's turn.", "You therefore do not need to turn your next turn into an all-in every time: if you can play Zoro while keeping Gum-Gum Giant available, extending the game can be much safer."] },
  { title: "Sanji — Bypass Blockers to Finish the Game", cards: [sanji], paragraphs: ["Sanji ST21-003 becomes especially dangerous when your opponent is trying to survive behind several Blockers.", "On the following turn, you can focus your DON!! on an unblockable attack and bypass their defense.", "This attack can reach extremely high Power with Luffy OP09 in play when you have a lot of DON!! to invest. It is therefore a real lethal option, but it should not push you into taking an unnecessary risk when you can simply secure the game with Zoro and Gum-Gum Giant."] },
  { title: "Your Overall Plan", cards: [], paragraphs: ["Your ideal progression therefore looks like this:", "Searchers → Ramp with Yamato / Mr.2 / Zoro OP05-067 → Roronoa Zoro EB04-007 at 7 DON!! → maintain high Leader Power → reach 10 DON!! → Monkey.D.Luffy OP05-119 → Nico Robin EB05-033 → rebuild your DON!! → lethal or Zoro EB04-007 + Gum-Gum Giant to secure the game.", "The strength of this sequence comes from the fact that Monkey.D.Luffy does not mark the end of your resources. Nico Robin lets you immediately rebuild your DON!! and make full use of Luffy's extra turn, while Zoro gives you a way to stay solid enough to reach that late game."] },
];

const techCards = [
  { card: robin, title: "Nico Robin EB05-033", paragraphs: ["Nico Robin is the piece that makes your combo with Monkey.D.Luffy really work.", "After returning your DON!! to your DON!! Deck with Luffy, you can use your Leader and then Luffy to recover enough DON!! to play Robin.", "She then lets you draw 3 cards and discard 2 before Ramp 4 DON!!. You therefore improve your hand while immediately rebuilding your resources for Luffy's extra turn.", "Simply pay attention to your opponent's DON!! count: you generally want to start this sequence when your opponent is at 8, not 7."] },
  { card: zoro, title: "Roronoa Zoro EB04-007", paragraphs: ["Zoro is your main way to survive until your late game.", "His Power increase makes your Leader much harder to attack and considerably reduces the amount of Counter needed to defend your Life.", "He also has real offensive utility through his Rush Character option. You can use Zoro to immediately attack rested Characters and force your opponent to spend Counter to protect them.", "In some situations, it is better to play another Zoro instead of forcing lethal: you remain difficult to attack and can keep DON!! for Gum-Gum Giant."] },
  { card: zoroRamp, title: "Roronoa Zoro OP05-067", paragraphs: ["Zoro OP05-067 provides another source of Ramp in the decklist.", "When he attacks, he can let you Ramp 1 Active DON!!, accelerating your progress toward important thresholds while maintaining pressure.", "He therefore complements Yamato and Mr.2 in your DON!! acceleration plan."] },
  { card: yamato, title: "Yamato OP17-074", paragraphs: ["Yamato is one of your main Ramp cards.", "She helps you reach your Zoro and then Luffy + Robin turns sooner, while also playing a Character Blocker onto the board.", "Her role becomes especially important when your hand already contains your big pieces but you are simply missing the acceleration needed to follow your curve."] },
  { card: mr2, title: "Mr.2.Bon.Kurei EB01-061", paragraphs: ["Mr.2 gives you both Ramp and a threat your opponent cannot always ignore.", "He is one of the cards you can search with Monkey.D.Garp, improving your access to Ramp even when your Straw Hat Searchers cannot find him."] },
  { card: roger, title: "Gold.D.Roger P-107", paragraphs: ["Roger makes your plan more consistent when you do not find Roronoa Zoro EB04-007.", "He is another option for strengthening your Leader and helping you hold on until your Luffy + Robin turn.", "His presence also makes Monkey.D.Garp OP13-016 more valuable, since Garp can search for him along with several of your Ramp cards and other tech options."] },
  { card: rakuyo, title: "Rakuyo OP17-016", paragraphs: ["Rakuyo is mainly included for specific matchups.", "He is especially useful against Purple Enel, Elbaf decks, and Green/Blue Luffy. In these matchups, he can answer important Characters and is one of your main tech cards.", "The main issue is that Rakuyo is not accessible with your Searchers. You therefore cannot always count on him, which is limiting in the matchups where he is especially strong."] },
  { card: garp, title: "Monkey.D.Garp OP13-016", paragraphs: ["Garp considerably expands your search options.", "Nami and Jewelry Bonney already cover much of your Straw Hat package, but they cannot find certain important cards such as Mr.2, Yamato, Rakuyo, or Roger.", "Garp therefore gives you access to a different part of your decklist and reduces your dependence on a single type of Searcher."] },
  { card: sanji, title: "ST21-003 Sanji", paragraphs: ["Sanji is your option for bypassing Blockers.", "He is most valuable during your lethal turns, when your opponent has enough Blockers to absorb your big attacks.", "You can then invest heavily in DON!! for a huge unblockable attack and force your opponent to defend only with Counters from their hand. Otherwise, he is still a 2000 Counter."] },
  { card: giant, title: "Gum-Gum Giant OP09-078", paragraphs: ["Gum-Gum Giant is your main safety option when you cannot finish the game immediately.", "After your Luffy + Robin sequence, you can choose to play Roronoa Zoro EB04-007 while keeping enough DON!! for Giant.", "This option keeps you from having to go all-in every time: if lethal is not safe enough, Zoro + Gum-Gum Giant lets you maintain a much harder-to-overturn position."] },
  { card: mamaragan, title: "Mamaragan OP15-078", paragraphs: ["Mamaragan is mainly used as Counter early in the game to refresh your hand.", "It can also be used with its Activate: Main to rest a Character with 5000 Power, but this use is much more situational.", "In most situations, its main function is therefore its +1000 Counter and the option to draw a card."] },
];

const matchups = [
  { title: "OP09 Buggy", leader: buggy, paragraphs: ["The Buggy matchup is mainly about holding on until your late-game sequence without losing too many defensive resources.", "Try to play Roronoa Zoro EB04-007 quickly. The increase to your Leader's Power makes opposing attacks much more difficult and helps you preserve your Counters.", "Use your Ramp to reach your Monkey.D.Luffy + Nico Robin turn before Buggy can fully take control of the board.", "As you prepare your Luffy turn, consider which Characters Buggy can send to the bottom of your deck. You can accept losing a less important piece if that protects the cards needed for your combo.", "Once Luffy + Robin are active, you can immediately rebuild your DON!! and use the extra turn to apply a great deal of pressure. If you have Gum-Gum Giant, you can also choose a safer line with Zoro instead of forcing lethal."] },
  { title: "OP16 Green/Blue Luffy", leader: luffyGb, paragraphs: ["This matchup can become very difficult if you do not find Roronoa Zoro EB04-007.", "Zoro is especially important for increasing your Leader's Power. Without this protection, the many opposing attacks can quickly exhaust your hand.", "Rakuyo OP17-016 is one of your best tech cards in this matchup, even though your Searchers cannot find him.", "Do not hesitate to use your offensive options to remove important rested Characters. Reducing the number of opposing attacks makes your defense considerably easier.", "After your Luffy + Robin combo, do not necessarily force lethal. If you can play Zoro and keep Gum-Gum Giant, you can build a much safer position before finishing the game."] },
  { title: "EB04 Jewelry Bonney", leader: bonneyLeader, paragraphs: ["Against Bonney, your goal is still to reach your Luffy + Robin turn, but you need to adapt your timing to the opponent's defensive tools.", "Roronoa Zoro EB04-007 lets you maintain high Leader Power and hold on more effectively while preparing your late game.", "Try to reduce your opponent's Life before your big turn. Your second turn with Luffy becomes much more dangerous if Bonney is already at 0 Life.", "Monkey.D.Luffy OP05-119 is especially useful when the opponent uses effects to strengthen their Characters or Blockers during your first turn: your second turn lets you start again from a new position and continue your pressure.", "Keep Gum-Gum Giant when it lets you both survive and preserve enough resources to play Luffy on the following turn."] },
  { title: "OP14 Red Law", leader: law, paragraphs: ["Red Law is the most difficult matchup.", "His Jewelry Bonney EB05-001 is especially problematic: her Power reductions can cancel a large part of the defensive advantage gained with Roronoa Zoro EB04-007.", "Law can develop his board, keep a large hand, and pressure your Leader at the same time. You can therefore run out of Counter quickly.", "Your Ramp Characters are also difficult to keep on the board since Law has the tools to remove them quickly.", "Even so, try to find Zoro early enough and progress toward your Luffy turn. The more the game forces you to defend before reaching your combo, the more difficult the matchup becomes."] },
  { title: "OP15 Purple Enel", leader: enel, paragraphs: ["Rakuyo OP17-016 is one of the best cards to have in your opening hand.", "Look to develop your Ramp as usual while playing Rakuyo when you have access to him.", "Rakuyo is an important answer to the cards Purple Enel uses and can keep the opponent from comfortably holding onto their utility pieces.", "Continue preparing your Zoro → Luffy + Robin plan rather than diverting all your resources into board control."] },
  { title: "Elbaf Deck", leaders: [luffyOp17Leader, saboOp13Leader], paragraphs: ["Rakuyo is also included in the decklist to improve your options against Elbaf decks.", "Rakuyo OP17-016 is your main tech card in this matchup.", "Your overall plan is still to Ramp quickly so you can reach Zoro and then your late-game sequence.", "Do not rely on Rakuyo alone, however: he is not searchable, and some games will have to be played without access to him.", "If you already have the essential pieces of your combo, Monkey.D.Garp can help you find cards outside your Straw Hat engine."] },
];

const tips = [
  { cards: [zoro], text: "Build your game around Roronoa Zoro EB04-007. Reaching Zoro early enough lets you increase your Leader's Power and save a lot of Counter before your Luffy + Robin turn." },
  { cards: [zoroRamp], text: "Use Roronoa Zoro OP05-067 to accelerate your curve. His 1 Active DON!! Ramp when he attacks helps you reach your different thresholds sooner while maintaining pressure." },
  { cards: [robin, luffy], text: "Do not play Nico Robin too early. Before starting your sequence with Monkey.D.Luffy, check your opponent's DON!! count." },
  { cards: [luffy, robin], text: "Prepare Luffy and Robin together. Monkey.D.Luffy can be used on his own, but Nico Robin depends much more on this combination. If you have to choose between them while searching, Luffy may therefore be the priority." },
  { cards: [robin], text: "Use Robin to prepare what comes next immediately. Her draw 3, then discard 2 is very useful for generating resources: use it to improve your hand and find Zoro or the cards needed for your second turn." },
  { cards: [sunny], text: "Remember Thousand Sunny. A rested DON!! can be attached to your Leader or Luffy Character to turn a resource you could not otherwise spend into additional Power." },
  { cards: [zoro, giant], text: "Do not always force lethal during Luffy's extra turn. If you can play Roronoa Zoro EB04-007 and keep enough DON!! for Gum-Gum Giant, this position may be much safer than an uncertain all-in." },
  { cards: [sanji], text: "Keep Sanji ST21-003 in mind against Blockers. When your opponent is trying to survive behind several Blockers, you can focus your DON!! on a huge unblockable attack and bypass that defense entirely." },
  { cards: [zoro], text: "Use EB04-007 Zoro offensively when needed. His value is not limited to increasing your Leader's Power: his Rush Character options can let you immediately attack an important rested Character and force Counter." },
  { cards: [rakuyo], text: "Keep Rakuyo for the matchups where he matters. He is included especially for Purple Enel, Elbaf, and Green/Blue Luffy, but your Searchers cannot find him. When you naturally have him in hand in these matchups, avoid using him as Counter." },
  { cards: [mamaragan], text: "Mamaragan can mainly be used to refresh your Counter. Its Activate: Main effect is situational; using its +1000 Counter and drawing a card may be more useful when you are still looking for the pieces needed for your combo." },
];

const simCode = simDeckCode;
const textParts = (text) => text.split(/(\*\*.*?\*\*)/g);
---

<MainLayout title={title} description={description}>
  <section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span class="hero-chip">Deck Guide</span><span class="hero-chip hero-chip-accent">EB05 Format</span></div><h1>Monkey.D.Luffy ST10 Deck Guide</h1><p class="hero-intro">Red/Purple Luffy follows a precise progression: accelerate your DON!!, use Roronoa Zoro EB04-007 to become harder to attack, then reach your Monkey.D.Luffy OP05-119 + Nico Robin EB05-033 sequence.</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Game Plan &amp; Curve</a><a class="btn btn-secondary" href="#matchups">Matchups</a></div></div><div class="guide-icon"><img src={leader.img} alt="ST10-002 Monkey.D.Luffy Leader card" loading="eager" /></div></div></section>
  <section id="decklist" class="list-section"><div class="container article-stack"><div class="glow-block feature-block"><div class="section-header decklist-header"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim={simCode}>Copy for Sim</button></div><p>ST10 Monkey.D.Luffy for the EB05 format.</p></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.code}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /><div class="deck-info"><span class="deck-count">{entry.count}x</span><div><div class="deck-name">{entry.name}</div><div class="deck-code">{entry.code}</div></div></div><span class="deck-role">{entry.role}</span></button>)}</div></div>
  <div class="glow-block feature-block"><h2>Mulligan</h2><div class="content-list">{mulligan.map((item) => <article class:list={["content-item", "mulligan-item", item.cards.length > 0 && "has-cards"]}><h3>{item.title}</h3>{item.cards.length > 0 && <div class:list={["card-row", item.cards.length === 4 && "card-row-four"]}>{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div>}<div class="paragraphs">{item.paragraphs.map((paragraph) => <p>{textParts(paragraph).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</p>)}</div></article>)}</div></div>
  <section id="curve" class="glow-block"><h2>Game Plan &amp; Curve</h2><p>Red/Purple Luffy follows a precise progression: accelerate your DON!!, use Roronoa Zoro EB04-007 to become harder to attack, then reach your Monkey.D.Luffy OP05-119 + Nico Robin EB05-033 sequence.</p><p>The decklist has several ways to Ramp and quickly reach its important thresholds. Once you are at 10 DON!!, Luffy gives you access to an extra turn, and Robin lets you rebuild a large part of the DON!! you just returned to your DON!! Deck.</p><div class="content-list">{gamePlan.map((item) => <article class:list={["content-item", "cards-above", item.cards.length > 0 && "has-cards"]}><h3>{item.title}</h3>{item.cards.length > 0 && <div class:list={["card-row", "cards-per-row", item.cards.length === 4 && "card-row-four"]} style={`grid-template-columns:repeat(${item.cards.length},minmax(0,98px))`}>{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div>}<div class="paragraphs">{item.paragraphs.map((paragraph) => <p>{textParts(paragraph).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</p>)}</div></article>)}</div></section>
  <section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><div class="content-list">{techCards.map((item) => <article class="tech-card"><button class="mini-card tech-card-image" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={getCardThumbnail(item.card.img)} alt={`${item.card.code} ${item.card.name}`} loading="lazy" /></button><h3>{item.title}</h3><div class="paragraphs">{item.paragraphs.map((paragraph) => <p>{textParts(paragraph).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</p>)}</div></article>)}</div></section>
  <section id="matchups" class="glow-block"><h2>Matchups</h2><div class="matchup-grid">{matchups.map((item) => <article class="matchup-card"><div class="matchup-heading"><div class="matchup-leader-cards">{(item.leaders ?? [item.leader]).map((entry) => <button class="mini-card matchup-leader-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><h3>{item.title}</h3></div><div class="paragraphs">{item.paragraphs.map((paragraph) => <p>{textParts(paragraph).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2, -2)}</strong> : part)}</p>)}</div></article>)}</div></section>
