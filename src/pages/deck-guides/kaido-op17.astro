---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Kaido OP17 Deck Guide";
const description =
	"Deck guide for Kaido OP17 for One Piece Card Game with leader ability, updated decklist, deck in a nutshell, best curve, even curve, raid bosses, strengths, weaknesses, and a conclusion for the OP17 format.";
const icon = "/assets/guides/Kaido%20op17.png";

const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;

	while (remaining > 4) {
		lines.push(`4x${code}`);
		remaining -= 4;
	}

	if (remaining > 0) {
		lines.push(`${remaining}x${code}`);
	}

	return lines;
};

const card = (code, name, img, count = null, role = "Character", effectCode = code) => ({
	code,
	name,
	img,
	count,
	role,
	effectCode,
});

const leader = card("OP17-058", "Kaido", "/Cards/OP17/New OP17/OP17-058.jpg", 1, "Leader");
const queenEb = card("EB04-032", "Queen", "/Cards/EB04/EB04-032.jpg", 4);
const basilHawkins = card("OP17-073", "Basil Hawkins", "/Cards/OP17/New OP17/OP17-073.jpg", 4, "Character", "OP17-BASIL-HAWKINS");
const yamato = card("OP17-074", "Yamato", "/Cards/OP17/New OP17/OP17-074.jpg", 4);
const usohachi = card("ST18-001", "Usohachi", "/Cards/ST18/ST18-001.png", 4);
const kingEb = card("EB04-031", "King", "/Cards/EB04/EB04-031.jpg", 4);
const kaidoEb = card("EB04-030", "Kaido", "/Cards/EB04/EB04-030.jpg", 2);
const leadPerformers = card("OP17-061", "Lead Performers", "/Cards/OP17/New OP17/OP17-061.jpg", 3);
const queenOp17 = card("OP17-065", "Queen", "/Cards/OP17/New OP17/OP17-065.jpg", 2);
const jack = card("OP17-069", "Jack", "/Cards/OP17/New OP17/OP17-069.jpg", 2, "Character", "OP17-JACK");
const kaidoBlocker = card("OP17-062", "Kaido", "/Cards/OP17/New OP17/OP17-062.jpg", 3);
const kaidoRaid = card("OP17-063", "Kaido", "/Cards/OP17/New OP17/OP17-063.jpg", 2);
const charlotteLinlin = card("ST34-004", "Charlotte Linlin", "/Cards/ST34/ST34-004.jpg", 3);
const mamaragan = card("OP15-078", "Mamaragan", "/Cards/OP15/OP15-078.jpg", 3, "Event");
const woRoRoRo = card(
	"OP17-076",
	"Wo Ro Ro Ro Ro!! I Think I've Sobered Up!!",
	"/Cards/OP17/New OP17/OP17-076.jpg",
	4,
	"Event",
	"OP17-WORORORO",
);
const claimOnePiece = card("OP07-077", "We're Going to Claim the One Piece!!!", "/Cards/OP07/OP07-077.png", 3, "Event");
const gundariMeteorShower = card("OP17-077", "Gundari Meteor Shower", "/Cards/OP17/New OP17/OP17-077.jpg", 3, "Event");
const saboOp13 = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg", null, "Leader");
const mihawkOp14 = card("OP14-020", "Dracule Mihawk OP14", "/Cards/OP14/OP14-020.jpg", null, "Leader");
const rocksOp17 = card("OP17-039", "Rocks D. Xebec OP17", "/Cards/OP17/New OP17/OP17-039.jpg", null, "Leader");
const aceOp16 = card("OP16-001", "Portgas D. Ace OP16", "/Cards/OP16/OP16-001.jpg", null, "Leader");
const robinOp09 = card("OP09-062", "Nico Robin OP09", "/Cards/OP09/OP09-062.jpg", null, "Leader");
const luffyOp17 = card("OP17-079", "Monkey D. Luffy OP17", "/Cards/OP17/New OP17/OP17-079.jpg", null, "Leader");
const linlinOp17 = card("OP17-099", "Charlotte Linlin OP17", "/Cards/OP17/New OP17/OP17-099.jpg", null, "Leader");
const shanksOp17 = card("OP17-020", "Shanks OP17", "/Cards/OP17/New OP17/OP17-020.jpg", null, "Leader");
const luffyAceSt30 = card("ST30-001", "Luffy & Ace ST30", "/Cards/ST30/ST30-001.jpg", null, "Leader");
const enelOp15 = card("OP15-058", "Enel OP15", "/Cards/OP15/OP15-058.jpg", null, "Leader");
const boaOp14 = card("OP14-041", "Boa Hancock OP14", "/Cards/OP14/OP14-041.jpg", null, "Leader");

const matchupIcons = {
	"OP15-058": "/assets/guides/enel-op15.png",
	"OP13-004": "/assets/guides/Sabo OP13-004.png",
	"OP17-039": "/assets/guides/Rocks.DXebec op17.png",
	"OP16-001": "/assets/guides/Ace-op16.png",
	"OP17-099": "/assets/guides/Charlotte Linlin op17.png",
	"OP09-062": "/assets/guides/Nico-Robin-op09.png",
	"OP14-020": "/assets/guides/dracule-mihawk-op14.png",
	"OP17-079": "/assets/guides/Monkey.D.Luffy op17.png",
	"OP17-020": "/assets/guides/Shanks op17.png",
	"ST30-001": "/assets/guides/Luffy-st30.png",
	"OP14-041": "/assets/guides/boa-hancock-op14.png",
};

const decklist = [
	leader,
	queenEb,
	basilHawkins,
	yamato,
	usohachi,
	kingEb,
	kaidoEb,
	leadPerformers,
	queenOp17,
	jack,
	kaidoBlocker,
	kaidoRaid,
	charlotteLinlin,
	mamaragan,
	woRoRoRo,
	claimOnePiece,
	gundariMeteorShower,
];

const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const favorableMatchups = [rocksOp17];

const slightlyFavorableMatchups = [saboOp13, robinOp09, aceOp16, shanksOp17, enelOp15];

const evenMatchups = [boaOp14];

const unfavorableMatchups = [mihawkOp14, luffyOp17, luffyAceSt30];

const nutshellForce = [
	"Massive late-game value and continuous DON!! recovery.",
	"Punishes opponent misplays instantly.",
	"Insane board control and defensive endurance.",
];

const nutshellWeakness = [
	"Inconsistent early game (can brick easily).",
	"Highly dependent on playing 6c King exactly on curve.",
	"Slow start makes it vulnerable to heavy Aggro.",
];

const coreEngine = [
	"1c Queen / 3C Yamato: Your early setup tools.",
	"6c King: The absolute MVP",
	"10c Bosses (Kaido / Linlin): Your win conditions. They clear the opponent's board, heal your Life, and refund DON!! to keep your defensive events active.",
];

const bestCurve = [
	{
		label: "2 DON!!",
		note: "Play Queen to cycle your hand. Its Activate: Main effect will matter on the next turn.",
		cards: [{ card: queenEb }],
	},
	{
		label: "3 DON!!",
		note: "Use Queen's effect to add 1 rested DON!!, then play We're Going to Claim the One Piece!!! to search.",
		cards: [{ card: queenEb, rested: true }, { card: claimOnePiece }],
	},
	{
		label: "6 DON!!",
		note: "Thanks to Queen's effect from the previous turn, you have 6 DON!! instead of 5, so you can play King. It's a core piece of the deck. It's very hard for the opponent to remove, and it lets you generate a lot of DON!! turn after turn.",
		cards: [{ card: kingEb }],
	},
	{
		label: "10 DON!!",
		note: "Thanks to your setup from the previous turns, you now reach 10 DON!!. From here, pick the Kaido that fits the board state. One line gives you the big defensive wall and DON!! recursion, while the other is the offensive payoff that can answer a cost 6 or lower Character immediately.",
		cards: [{ card: kaidoBlocker }, { card: kaidoRaid }],
		mode: "or",
	},
];

const evenCurve = [
	{
		label: "2 DON!!",
		note: "Play Queen to cycle your hand. Its Activate: Main effect will matter on the next turn. Then play We're Going to Claim the One Piece!!! to search.",
		cards: [{ card: queenEb }, { card: claimOnePiece }],
	},
	{
		label: "5 DON!!",
		note: "Use Queen's effect to add 1 rested DON!! so you now have 5 DON!!. Then attach 2 DON!! to your Leader and swing for 7k.",
		cards: [{ card: queenEb, rested: true }, { card: leader, rested: true }],
	},
	{
		label: "7 DON!!",
		note: "Play King. It's a core piece of the deck. It's very hard for the opponent to remove, and it lets you generate a lot of DON!! turn after turn.",
		cards: [{ card: kingEb }],
	},
	{
		label: "10 DON!!",
		note: "Thanks to your setup from the previous turns, you now reach 10 DON!!. From here, pick the Kaido that fits the board state. One line gives you the big defensive wall and DON!! recursion, while the other is the offensive payoff that can answer a cost 6 or lower Character immediately.",
		cards: [{ card: kaidoBlocker }, { card: kaidoRaid }],
		mode: "or",
	},
];

const raidBosses = [
	{
		card: kaidoRaid,
		copy: "Negates the effect of a 6-cost or lower Character and KOs it, completely bypassing KO protection! Even better: he turns all the unplayable bricks in your hand into +1000 Counters.",
	},
	{
		card: kaidoBlocker,
		copy: "A massive 12k Power Blocker that generates extra DON!! every turn when you return DON!! to your DON!! deck. It adds 1 DON!! from your deck as active, then re-stands 1 DON!! on your field, helping you maintain your defensive options even after committing resources.",
	},
	{
		card: charlotteLinlin,
		copy: "She drops an opponent's Character to 0 Power, setting up the perfect combo with the 0-cost event Mamaragan to wipe out huge threats for free.",
	},
	{
		card: leadPerformers,
		copy: "Drops as an 11k body that heals you for 1 Life immediately. You can then trash it to cheat out a Queen, Jack or King directly from your hand, swinging the tempo instantly in your favor.",
	},
	{
		card: queenOp17,
		copy: "A 10k Banish threat that replaces itself by drawing a card at the cost of DON!!-1. On play, he can also locks down two of your opponent's 5-cost or lower Characters, creating a brutal late-game chokehold.",
	},
	{
		card: jack,
		copy: "A 10k Rush Character that instantly drops an opposing Characterâ€™s power by -2000 on entry. Perfect for taking back the board and applying massive lethal pressure the turn he hits the field.",
	},
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags">
					<span class="hero-chip">Deck Guide</span>
					<span class="hero-chip hero-chip-accent">OP17 Format</span>
				</div>
				<h1>Kaido OP17 Deck Guide</h1>
				<p class="hero-intro">
					A quick OP17 mini-guide to help you master Kaido and his oppressive late-game plan. If you enjoy
					ramping fast, surviving the early turns, and dropping massive cost 10 bosses, this Leader is built
					for that style.
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="#curve">Curve Guide</a>
					<a class="btn btn-secondary" href="#matchups">Matchups</a>
				</div>
			</div>
			<div class="guide-icon">
				<img src={icon} alt="Kaido OP17 deck guide icon" loading="eager" />
			</div>
		</div>
	</section>

	<section id="decklist" class="list-section">
		<div class="container article-stack">
			<div class="glow-block">
				<div class="section-header decklist-header">
					<div class="decklist-title-row">
						<h2>Decklist</h2>
						<button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>
							Copy for Sim
						</button>
					</div>
				</div>
				<div class="deck-grid">
					{
						decklist.map((entry) => (
							<button
								class="deck-card"
								type="button"
								data-card-preview
								data-full={entry.img}
								data-name={`${entry.code} ${entry.name}`}
								data-code={entry.effectCode}
							>
								<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
								<div class="deck-info">
									<span class="deck-count">{entry.count}x</span>
									<div>
										<div class="deck-name">{entry.name}</div>
										<div class="deck-code">{entry.code}</div>
									</div>
								</div>
								<span class="deck-role">{entry.role}</span>
							</button>
						))
					}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2 id="curve">Your Best Curve</h2>
						<p>Going first is your best start.</p>
					</div>
				</div>
				<div class="curve-rows">
					{bestCurve.map((slot) => (
						<div class="curve-row">
							<div class="curve-label">{slot.label}</div>
							<div class="curve-cards">
								{slot.cards.map((entry, index) => (
									<>
										{index > 0 && (
											<span class={`curve-join ${slot.mode === "or" ? "curve-join-or" : ""}`}>{slot.mode === "or" ? "or" : "+"}</span>
										)}
										<button
											class={`mini-card curve-card ${entry.rested ? "is-rested" : ""}`}
											type="button"
											data-card-preview
											data-full={entry.card.img}
											data-name={`${entry.card.code} ${entry.card.name}`}
											data-code={entry.card.effectCode}
										>
											<div class="curve-card-frame">
												<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
												{entry.donAttached && (
													<div class="curve-don-attach" aria-label={`${entry.donAttached} DON attached`}>
														<img src="/Cards/Don/Don.png" alt="" aria-hidden="true" />
														<span>{entry.donAttached} DON!!</span>
													</div>
												)}
											</div>
										</button>
									</>
								))}
							</div>
							<div class="curve-note">{slot.note}</div>
						</div>
					))}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Even Curve</h2>
						<p>Still under optimization, but this is the current even-curve structure.</p>
					</div>
				</div>
				<div class="curve-rows">
					{evenCurve.map((slot) => (
						<div class="curve-row">
							<div class="curve-label">{slot.label}</div>
							<div class="curve-cards">
								{slot.cards.map((entry, index) => (
									<>
										{index > 0 && (
											<span class={`curve-join ${slot.mode === "or" ? "curve-join-or" : ""}`}>{slot.mode === "or" ? "or" : "+"}</span>
										)}
										<button
											class={`mini-card curve-card ${entry.rested ? "is-rested" : ""}`}
											type="button"
											data-card-preview
											data-full={entry.card.img}
											data-name={`${entry.card.code} ${entry.card.name}`}
											data-code={entry.card.effectCode}
										>
											<div class="curve-card-frame">
												<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
												{entry.donAttached && (
													<div class="curve-don-attach" aria-label={`${entry.donAttached} DON attached`}>
														<img src="/Cards/Don/Don.png" alt="" aria-hidden="true" />
														<span>{entry.donAttached} DON!!</span>
													</div>
												)}
											</div>
										</button>
									</>
								))}
							</div>
							<div class="curve-note">{slot.note}</div>
						</div>
					))}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Raid Bosses</h2>
						<p>The late game is where Kaido takes over. These are the payoff threats that matter most.</p>
					</div>
				</div>
				<div class="boss-grid">
					{raidBosses.map((entry) => (
						<article class="boss-card">
							<button
								class="mini-card boss-card-media"
								type="button"
								data-card-preview
								data-full={entry.card.img}
								data-name={`${entry.card.code} ${entry.card.name}`}
								data-code={entry.card.effectCode}
							>
								<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
								<div class="mini-label">{entry.card.name}</div>
							</button>
							<p class="curve-note">{entry.copy}</p>
						</article>
					))}
				</div>
			</div>

			<div class="glow-block feature-block" id="matchups">
				<div class="section-header feature-header">
					<div>
						<h2>Matchups</h2>
						<p>Quick OP17 matchup spread for Kaido.</p>
					</div>
				</div>
				<div class="matchup-grid">
					<div class="matchup-card glow-block">
						<div class="matchup-badge badge-up"><span class="badge-icon">&uarr;</span><span>Favorable</span></div>
						<div class="matchup-row matchup-row-cards-only">
							<div class="tip-cards">
								{favorableMatchups.map((entry) => (
									<button
										class="mini-card matchup-static-card"
										type="button"
										data-card-preview
										data-full={entry.img}
										data-name={`${entry.code} ${entry.name}`}
										data-code={entry.effectCode}
									>
										<img src={matchupIcons[entry.code] ?? entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
										<div class="mini-label">{entry.name}</div>
									</button>
								))}
							</div>
						</div>
					</div>
					<div class="matchup-card glow-block">
						<div class="matchup-badge badge-up"><span class="badge-icon">&nearr;</span><span>Slightly Favorable</span></div>
						<div class="matchup-row matchup-row-cards-only">
							<div class="tip-cards">
								{slightlyFavorableMatchups.map((entry) => (
									<button
										class="mini-card matchup-static-card"
										type="button"
										data-card-preview
										data-full={entry.img}
										data-name={`${entry.code} ${entry.name}`}
										data-code={entry.effectCode}
									>
										<img src={matchupIcons[entry.code] ?? entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
										<div class="mini-label">{entry.name}</div>
									</button>
								))}
							</div>
						</div>
					</div>
					<div class="matchup-card glow-block">
						<div class="matchup-badge badge-mid"><span class="badge-icon">~</span><span>Even</span></div>
						<div class="matchup-row matchup-row-cards-only">
							<div class="tip-cards">
								{evenMatchups.map((entry) => (
									<button
										class="mini-card matchup-static-card"
										type="button"
										data-card-preview
										data-full={entry.img}
										data-name={`${entry.code} ${entry.name}`}
										data-code={entry.effectCode}
									>
										<img src={matchupIcons[entry.code] ?? entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
										<div class="mini-label">{entry.name}</div>
									</button>
								))}
							</div>
						</div>
					</div>
					<div class="matchup-card glow-block">
						<div class="matchup-badge badge-down"><span class="badge-icon">&darr;</span><span>Unfavorable</span></div>
						<div class="matchup-row matchup-row-cards-only">
							<div class="tip-cards">
								{unfavorableMatchups.map((entry) => (
									<button
										class="mini-card matchup-static-card"
										type="button"
										data-card-preview
										data-full={entry.img}
										data-name={`${entry.code} ${entry.name}`}
										data-code={entry.effectCode}
									>
										<img src={matchupIcons[entry.code] ?? entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
										<div class="mini-label">{entry.name}</div>
									</button>
								))}
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Deck Overview</h2>
						<p>
							Ramp to 10 DON!! as fast as possible. Survive the early game so you can spam massive cost 10
							boss Characters that refund DON!!, heal you, and lock down the late-game board.
						</p>
					</div>
				</div>
				<div class="nutshell-grid">
					<div class="info-panel">
						<div class="section-tag section-tag-light">Strength</div>
						<ul class="summary-list">
							{nutshellForce.map((item) => <li>{item}</li>)}
						</ul>
					</div>
					<div class="info-panel">
						<div class="section-tag section-tag-light">Weakness</div>
						<ul class="summary-list">
							{nutshellWeakness.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>
				<div class="core-panel">
					<div class="section-tag section-tag-light">The Core Engine</div>
					<ul class="summary-list">
						{coreEngine.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>

			<div class="summary-grid">
				<div class="glow-block conclusions-card">
					<div class="section-tag section-tag-light">Conclusion</div>
					<p class="ability-copy">
						Kaido OP17 is a clean late-game purple strategy that rewards disciplined ramp lines and careful
						resource management. When the deck reaches cost 10 turns on schedule, it becomes very hard to
						outscale because every boss either stabilizes, heals, or creates another DON!! loop.
					</p>
				</div>
			</div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true">
		<div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview">
			<button class="modal-close" type="button" data-close>Close</button>
			<img src="" alt="" data-modal-image />
		</div>
	</div>
</MainLayout>
<script>
	const previewButtons = document.querySelectorAll("[data-card-preview]");
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const modalEffect = document.querySelector("[data-modal-effect]");
	const closeButton = document.querySelector("[data-close]");
	const copyButtons = document.querySelectorAll("[data-copy-sim]");
	const keywordBadge = (icon, alt) => ({ type: "keyword", icon, alt });
	const decklistEffectTextByCode = {
		"OP17-058": [
			[
				keywordBadge("when-attacking", "When Attacking"),
				" / ",
				keywordBadge("on-your-opponents-attack", "On Your Opponent's Attack"),
				" ",
				keywordBadge("once-per-turn", "Once Per Turn"),
				" DON!! -1: Up to 1 of your opponent's Characters gets -2000 power during this turn.",
			],
		],
		"OP17-061": [
			[keywordBadge("on-play", "On Play"), " DON!! -1: If your Leader has the {Animal Kingdom Pirates} type, add up to 1 card from the top of your deck to the top of your Life cards."],
			[keywordBadge("activate-main", "Activate: Main"), " You may trash this Character: Play up to 1 [King], [Queen], or [Jack] from your hand."],
		],
