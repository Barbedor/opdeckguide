---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Kaido OP17 Deck Guide: Decklist, Mulligan & Ramp Curve";
const description =
	"Kaido OP17 deck guide with decklist, mulligan priorities, ramp curves, recovery lines, tech cards, matchups, and gameplay tips for the OP17 format.";
const icon = "/assets/guides/Kaido%20op17.png";

const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;

	while (remaining > 4) {
		lines.push(`4x${code}`);
		remaining -= 4;
	}

	if (remaining > 0) {
		lines.push(`${remaining}x${code}`);
	}

	return lines;
};

const card = (code, name, img, count = null, role = "Character", effectCode = code) => ({
	code,
	name,
	img,
	count,
	role,
	effectCode,
});

const leader = card("OP17-058", "Kaido", "/Cards/OP17/New OP17/OP17-058.jpg", 1, "Leader");
const queenEb = card("EB04-032", "Queen", "/Cards/EB04/EB04-032.jpg", 4);
const basilHawkins = card("OP17-073", "Basil Hawkins", "/Cards/OP17/New OP17/OP17-073.jpg", 4, "Character", "OP17-BASIL-HAWKINS");
const yamato = card("OP17-074", "Yamato", "/Cards/OP17/New OP17/OP17-074.jpg", 4);
const sasaki = card("OP17-068", "Sasaki", "/Cards/OP17/New OP17/OP17-068.jpg", 3);
const kingEb = card("EB04-031", "King", "/Cards/EB04/EB04-031.jpg", 4);
const leadPerformers = card("OP17-061", "Lead Performers", "/Cards/OP17/New OP17/OP17-061.jpg", 4);
const queenOp17 = card("OP17-065", "Queen", "/Cards/OP17/New OP17/OP17-065.jpg", 2);
const jack = card("OP17-069", "Jack", "/Cards/OP17/New OP17/OP17-069.jpg", 2, "Character", "OP17-JACK");
const kaidoBlocker = card("OP17-062", "Kaido", "/Cards/OP17/New OP17/OP17-062.jpg", 4);
const kaidoRaid = card("OP17-063", "Kaido", "/Cards/OP17/New OP17/OP17-063.jpg", 2);
const charlotteLinlin = card("ST34-004", "Charlotte Linlin", "/Cards/ST34/ST34-004.jpg", 3);
const mamaragan = card("OP15-078", "Mamaragan", "/Cards/OP15/OP15-078.jpg", 4, "Event");
const woRoRoRo = card(
	"OP17-076",
	"Worororo! I Think I've Sobered Up",
	"/Cards/OP17/New OP17/OP17-076.jpg",
	2,
	"Event",
	"OP17-WORORORO",
);
const claimOnePiece = card("OP07-077", "We're Going to Claim the One Piece!!!", "/Cards/OP07/OP07-077.png", 4, "Event");
const slowSlowBeamSword = card("OP07-076", "Slow-Slow Beam Sword", "/Cards/OP07/OP07-076.png", 4, "Event");
const kundaiDragonSwarm = card("OP17-077", "Kundai Dragon Swarm", "/Cards/OP17/New OP17/OP17-077.jpg", 2, "Event");
const drunkenDragonBagua = card("OP17-078", "Drunken Dragon Bagua", "/Cards/OP17/New OP17/OP17-078.jpg", 2, "Event");
const blackMariaOp08 = card("OP08-074", "Black Maria", "/Cards/OP08/OP08-074.png");
const divineDeparture = card("OP13-076", "Divine Departure", "/Cards/OP13/OP13-076.jpg", null, "Event");
const xDrake = card("OP17-075", "X.Drake", "/Cards/OP17/New OP17/OP17-075.jpg");
const kanjuro = card("OP17-067", "Kanjuro", "/Cards/OP17/New OP17/OP17-067.jpg");
const blackMariaOp17 = card("OP17-072", "Black Maria", "/Cards/OP17/New OP17/OP17-072.jpg");
const saboOp13 = card("OP13-004", "Sabo OP13", "/Cards/OP13/OP13-004.jpg", null, "Leader");
const mihawkOp14 = card("OP14-020", "Dracule Mihawk OP14", "/Cards/OP14/OP14-020.jpg", null, "Leader");
const rocksOp17 = card("OP17-039", "Rocks D. Xebec OP17", "/Cards/OP17/New OP17/OP17-039.jpg", null, "Leader");
const aceOp16 = card("OP16-001", "Portgas D. Ace OP16", "/Cards/OP16/OP16-001.jpg", null, "Leader");
const robinOp09 = card("OP09-062", "Nico Robin OP09", "/Cards/OP09/OP09-062.jpg", null, "Leader");
const luffyOp17 = card("OP17-079", "Monkey D. Luffy OP17", "/Cards/OP17/New OP17/OP17-079.jpg", null, "Leader");
const linlinOp17 = card("OP17-099", "Charlotte Linlin OP17", "/Cards/OP17/New OP17/OP17-099.jpg", null, "Leader");
const shanksOp17 = card("OP17-020", "Shanks OP17", "/Cards/OP17/New OP17/OP17-020.jpg", null, "Leader");
const luffyAceSt30 = card("ST30-001", "Luffy & Ace ST30", "/Cards/ST30/ST30-001.jpg", null, "Leader");
const enelOp15 = card("OP15-058", "Enel OP15", "/Cards/OP15/OP15-058.jpg", null, "Leader");
const boaOp14 = card("OP14-041", "Boa Hancock OP14", "/Cards/OP14/OP14-041.jpg", null, "Leader");

const matchupIcons = {
	"OP15-058": "/assets/guides/enel-op15.png",
	"OP13-004": "/assets/guides/Sabo OP13-004.png",
	"OP17-039": "/assets/guides/Rocks.DXebec op17.png",
	"OP16-001": "/assets/guides/Ace-op16.png",
	"OP17-099": "/assets/guides/Charlotte Linlin op17.png",
	"OP09-062": "/assets/guides/Nico-Robin-op09.png",
	"OP14-020": "/assets/guides/dracule-mihawk-op14.png",
	"OP17-079": "/assets/guides/Monkey.D.Luffy op17.png",
	"OP17-020": "/assets/guides/Shanks op17.png",
	"ST30-001": "/assets/guides/Luffy-st30.png",
	"OP14-041": "/assets/guides/boa-hancock-op14.png",
};

const decklist = [
	leader,
	queenEb,
	sasaki,
	basilHawkins,
	yamato,
	kingEb,
	leadPerformers,
	queenOp17,
	kaidoBlocker,
	kaidoRaid,
	charlotteLinlin,
	mamaragan,
	woRoRoRo,
	drunkenDragonBagua,
	claimOnePiece,
	slowSlowBeamSword,
];

const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const favorableMatchups = [rocksOp17];

const slightlyFavorableMatchups = [saboOp13, robinOp09, aceOp16, shanksOp17, enelOp15];

const evenMatchups = [boaOp14];

const unfavorableMatchups = [mihawkOp14, luffyOp17, luffyAceSt30];

const goingFirstCurve = [
	{ label: "1 DON!! — Hand Fixing", cards: [claimOnePiece], text: "Use We're Going to Claim the One Piece!!! to search the top 5 cards of your deck for an Animal Kingdom Pirates or Big Mom Pirates card. The priority is to set up Yamato and King." },
	{ label: "3 DON!! — Yamato", cards: [yamato], text: "Play Yamato OP17-074 to add 1 rested DON!!. You move from 3 to 4 DON!! on your field while leaving behind a Blocker for your first layer of protection." },
	{ label: "6 DON!! — King", cards: [kingEb], text: "Play King EB04-031, then use Activate: Main to add 1 active DON!! and 1 rested DON!!. You finish this turn with 8 DON!! and naturally reach 10 DON!! on the following turn." },
	{ label: "10 DON!! — Kaido", cards: [kaidoBlocker], text: "You can now play Kaido OP17-062, your 12K Blocker. It is usually best to keep him active at first to stabilize your defense; his effect also helps recover DON!! after you return DON!! cards to your DON!! deck. From here, your plays become board-dependent: Charlotte Linlin, Lead Performers, the other Kaido, and multi-card turns are all live options." },
];

const goingSecondCurve = [
	{ label: "2 DON!! — Preparation", cards: [claimOnePiece], text: "Use We're Going to Claim the One Piece!!! to start shaping your hand for the next turns." },
	{ label: "4 DON!! — Queen", cards: [queenEb], text: "Play Queen EB04-032 and use Activate: Main by resting 2 DON!! to add 1 rested DON!!. You move from 4 to 5 DON!!." },
	{ label: "7 DON!! — King", cards: [kingEb], text: "You naturally reach 7 DON!! on the next turn. Play King for 6 DON!!, then use Activate: Main to add 1 active DON!! and 1 rested DON!!. You keep 1 DON!! after playing King, then end with 9 DON!! on your field and reach 10 DON!! next turn." },
];

const lateGameChoices = [
	{ card: kaidoBlocker, text: "Kaido OP17-062 when you need a massive Blocker to stabilize your defense." },
	{ card: kaidoRaid, text: "Kaido OP17-063 when you need to immediately deal with an opposing Character that costs 6 or less." },
	{ card: charlotteLinlin, text: "Charlotte Linlin ST34-004 to heal and reduce an opposing Character's base Power to 0." },
	{ card: leadPerformers, text: "Lead Performers OP17-061 to heal, then set up its replacement by playing a King, Queen, or Jack." },
];

const mulliganSections = [
	{ title: "Going First", text: "Yamato OP17-074 is your top priority. Your ideal progression is 3 DON!! → Yamato → 4 DON!! → 6 DON!! → King → 8 DON!! → 10 DON!!. Yamato gives you 1 rested DON!! while putting a Blocker into play, so you can reach the 6 DON!! needed for King on your third turn. King EB04-031 is therefore another essential keep: when you play him at 6 DON!!, he adds 1 active DON!! and 1 rested DON!! to reach 8 DON!! and naturally puts you at 10 DON!! on the following turn.", cards: [yamato, kingEb] },
	{ title: "Going Second", text: "Queen EB04-032 becomes your main ramp piece. At 4 DON!!, use Activate: Main by resting 2 DON!! to add 1 rested DON!!. You move to 5 DON!! and reach 7 DON!! next turn, letting you play King while keeping 1 DON!! available. King EB04-031 remains a high-priority keep because he is what accelerates you into the late game.", cards: [queenEb, kingEb] },
	{ title: "Hand Fixing", text: "If your opening hand is missing part of the ramp line, Queen EB04-032 can fix it by trashing an Animal Kingdom Pirates card to draw 2 cards and look for King or another missing piece. We're Going to Claim the One Piece!!! also finds an Animal Kingdom Pirates or Big Mom Pirates card from the top 5 cards of your deck. Mamaragan OP15-078 digs deeper early: while you have 6 DON!! or less, its 1K Counter also lets you draw a card, and it costs 0. Don't keep a hand only because it contains powerful 9- or 10-cost cards. Your mulligan priority is reaching the late game on the right turns through ramp.", cards: [queenEb, claimOnePiece, mamaragan] },
];

const rampSupport = [
	{ title: "If You Miss Your Ramp", cards: [basilHawkins, drunkenDragonBagua], text: "Basil Hawkins OP17-073 is the backup option when you miss ramp: trash a card from your hand to add 1 active DON!!. It isn't your first choice, but it can be correct when that extra DON!! lets you play King on time. Drunken Dragon Bagua OP17-078 is the key catch-up line once your curve is already broken. At 6 DON!! without King, pay 4 DON!! and trash 2 cards to add 3 rested DON!!, moving to 9 DON!! and reaching 10 DON!! on the following turn. Even from 5 DON!!, this line takes you to 8 DON!! and then 10 DON!! next turn." },
	{ title: "Watch Your DON!! -X Effects", cards: [kingEb, kaidoBlocker], text: "Once you reach the late game, don't treat 10 DON!! as permanent. Your Leader, Mamaragan, Linlin, and several other cards return DON!! to your DON!! deck. King and Kaido OP17-062 help offset that loss, so plan the order of your effects before paying any DON!! -X cost—especially when you are setting up your next 9- or 10-cost Character." },
];

const techCards = [
	{ card: card("ST18-001", "Uso-Hachi", "/Cards/ST18/ST18-001.png"), title: "Uso-Hachi ST18-001", text: "Uso-Hachi can replace Sasaki when you want to keep a 2K Counter while gaining late-game control. With 8 DON!! or more, his On Play can rest an opposing Character that costs 5 or less, including an awkward Blocker before your attacks." },
	{ card: blackMariaOp08, title: "Black Maria OP08-074", text: "Another possible Sasaki replacement. She temporarily adds 5 rested DON!!, then returns DON!! at the end of the turn until you have the same amount as your opponent. That temporary ramp can still be valuable with Kaido because you can spend it on DON!! -X effects before it disappears." },
	{ card: kundaiDragonSwarm, title: "Kundai Dragon Swarm OP17-077", text: "Can replace Drunken Dragon Bagua if you prefer the cheaper Counter. Kundai Dragon Swarm costs only 1 DON!! as a Counter, while Drunken Dragon Bagua costs 2 DON!! but gives 4K Counter to either your Leader or a Character. Drunken Dragon Bagua also offers a recovery line through its Main effect: pay 4 DON!! and trash 2 cards to add 3 rested DON!! and quickly work back toward 10 DON!!." },
	{ card: divineDeparture, title: "Divine Departure OP13-076", text: "Can take the place of Worororo! I Think I've Sobered Up. Both offer a similar 3K Counter for 0 DON!! by trashing another card. Divine Departure adds an offensive option: with a DON!! attached to your Leader or a Character, pay 5 DON!! to give an opposing Character -8K Power for the turn. Worororo! remains an Animal Kingdom Pirates card, which matters for the deck's synergies." },
	{ card: xDrake, title: "X.Drake OP17-075", text: "Another Sasaki alternative that keeps the 2K Counter role. With DON!! -2 on play, he forces your opponent to trash a card from hand, adding resource pressure without changing your 2K Counter count." },
	{ card: kanjuro, title: "Kanjuro OP17-067", text: "An additional board-control option. For 2 DON!!, his On Play uses DON!! -1 and can rest an opposing Character if you control a Character that costs 10 or more. He fills a role similar to Mamaragan's Main effect, but needs 2 active DON!!. Once Kaido OP17-062 is on the board, recovering 2 active DON!! becomes much easier." },
	{ card: blackMariaOp17, title: "Black Maria OP17-072", text: "The Blocker version of Black Maria can strengthen your defense. When your opponent attacks, you can trash a card from hand to give 1K Counter to your Leader or one of your Characters. She turns otherwise unhelpful cards in hand into defensive resources, although she isn't essential to the deck's core plan." },
	{ card: jack, title: "Jack OP17-069", text: "Jack can be an extra target for Lead Performers; splits such as 2 Queen + 1 Jack or 1 Queen + 1 Jack are viable. He has Rush: Character and his On Play uses DON!! -1 to give an opposing Character -2K Power. Combined with Kaido's Leader effect, that can total -4K Power on the same target. Queen is usually better for card draw and defense, but Jack gives you a more aggressive option when you need to remove a Character quickly." },
];

const tips = [
	{ cards: [queenEb, claimOnePiece, mamaragan], text: "Prioritize your curve above everything else. The deck is much weaker when you miss King at 6 DON!!. Use Queen, We're Going to Claim the One Piece!!!, and Mamaragan when necessary to find missing pieces instead of holding only your large Characters." },
	{ cards: [leader, kaidoBlocker], text: "Use the Leader effect both offensively and defensively. The -2K Power can help remove an opposing Character, but it can also shrink an attacker and save Counters. With multiple ways to recover DON!!, DON!! -1 is often less punishing than it looks." },
	{ cards: [sasaki], text: "Don't spend Sasaki just for ramp. He is mainly a 2K Counter; his effect costs 2 cards from hand to add 2 rested DON!!. Use it only when you truly have no other way to stay on curve." },
	{ cards: [yamato], text: "Yamato can be used as a Blocker early. Once she has ramped you, her main job is done. Because the list has relatively few conventional Counters, don't hesitate to use her to protect Life." },
	{ cards: [kaidoBlocker], text: "Usually keep your first Kaido OP17-062 active. His role as a Blocker is often more valuable than an immediate 12K attack. Once you have several large Characters and a stable position, start attacking with him to raise the pressure." },
	{ cards: [leader, kaidoBlocker, slowSlowBeamSword], text: "Use Kaido OP17-062 to preserve 2 active DON!!. After using the Leader's DON!! -1, his effect lets you recover DON!! and can leave you with resources for Counter Events, making Slow-Slow Beam Sword far more threatening." },
	{ cards: [slowSlowBeamSword], text: "Punish a poor attack order with Slow-Slow Beam Sword. If your opponent attacks with their Leader while a large Character has not attacked yet, Counter the Leader attack and rest that Character before it can swing. To play around it, they generally need to attack with their Characters before their Leader." },
	{ cards: [leader, slowSlowBeamSword], text: "Slow-Slow Beam Sword stacks well with the Leader effect. Reducing an attacker by 2K Power and then gaining 2K Counter already creates a major swing, with the option to rest another opposing attacker on top of it." },
	{ cards: [mamaragan, charlotteLinlin], text: "Mamaragan changes roles over the course of the game. Early, its 1K Counter with Draw 1 at 6 DON!! or less can help you find King. Late, hold it when you can set up the interaction with Charlotte Linlin to rest the Character whose base Power Linlin reduces to 0." },
	{ cards: [kingEb, kaidoBlocker], text: "Track the order of your DON!! -X effects. A DON!! returned to the DON!! deck is no longer on your field. Before using several effects in one turn, calculate what King and Kaido OP17-062 can actually recover so you don't compromise your next 9- or 10-cost Character." },
	{ cards: [leadPerformers, queenOp17], text: "Lead Performers doesn't need to be replaced immediately. You can play it to recover a Life, keep it on the board, attack for 11K next turn, and then trash it to play Queen. This lets you benefit from the heal, attack, and replacement." },
	{ cards: [kaidoBlocker, kaidoRaid], text: "Adapt your 10-cost play to the board. Kaido OP17-062 is the default stabilizer because of Blocker, while Kaido OP17-063 is especially strong when an opposing Character that costs 6 or less must be removed. His effect that turns Character cards into 1K Counters can also greatly improve a hand full of large Characters." },
	{ cards: [claimOnePiece, queenEb], text: "Keep your small cards relevant in the late game. We're Going to Claim the One Piece!!! remains useful whenever King or Kaido leaves you 1 DON!! available, and Queen can turn unneeded large Characters into fresh cards. The deck has several ways to recycle an awkward hand." },
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags">
					<span class="hero-chip">Deck Guide</span>
					<span class="hero-chip hero-chip-accent">OP17 Format</span>
				</div>
				<h1>Kaido OP17 Deck Guide</h1>
				<p class="hero-intro">Build your DON!! lead early, play King on curve, and turn 10 DON!! into a steady stream of massive threats, defense, and board control.</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="#curve">Curve Guide</a>
					<a class="btn btn-secondary" href="#matchups">Matchups</a>
				</div>
			</div>
			<div class="guide-icon">
				<img src={icon} alt="Kaido OP17 deck guide icon" loading="eager" />
			</div>
		</div>
	</section>

	<section id="decklist" class="list-section">
		<div class="container article-stack">
			<div class="glow-block">
				<div class="section-header decklist-header">
					<div class="decklist-title-row">
						<h2>Decklist</h2>
						<button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>
							Copy for Sim
						</button>
					</div>
				</div>
				<div class="deck-grid">
					{
						decklist.map((entry) => (
							<button
								class="deck-card"
								type="button"
								data-card-preview
								data-full={entry.img}
								data-name={`${entry.code} ${entry.name}`}
								data-code={entry.effectCode}
							>
								<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
								<div class="deck-info">
									<span class="deck-count">{entry.count}x</span>
									<div>
										<div class="deck-name">{entry.name}</div>
										<div class="deck-code">{entry.code}</div>
									</div>
								</div>
								<span class="deck-role">{entry.role}</span>
							</button>
						))
					}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header"><div><h2>Mulligan</h2><p>Your opening hand needs to ramp efficiently and play King on time. The priority shifts slightly depending on whether you go first or second.</p></div></div>
				<div class="mulligan-list">
					{mulliganSections.map((section) => (
						<article class="mulligan-priority"><h3>{section.title}</h3><div class="mulligan-cards">{section.cards.map((entry) => <button class="mini-card mulligan-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.effectCode}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div><p class="curve-note">{section.text}</p></article>
					))}
				</div>
			</div>

			<div class="glow-block feature-block" id="curve">
				<div class="section-header feature-header"><div><h2>Curve Guide</h2><p>This curve shows the ideal DON!! progression. If you miss a piece, the deck has several ways to return to 10 DON!!. Account for your DON!! -X effects, which can change how much DON!! you have available on the following turn.</p></div></div>
				<div class="curve-guide-block"><h3>Going First</h3><div class="curve-rows">{goingFirstCurve.map((slot) => <div class="curve-row"><div><div class="curve-label">{slot.label}</div><div class="curve-cards">{slot.cards.map((entry) => <button class="mini-card curve-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.effectCode}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div></div><p class="curve-note">{slot.text}</p></div>)}</div></div>
				<div class="curve-guide-block"><h3>Going Second</h3><div class="curve-rows">{goingSecondCurve.map((slot) => <div class="curve-row"><div><div class="curve-label">{slot.label}</div><div class="curve-cards">{slot.cards.map((entry) => <button class="mini-card curve-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.effectCode}><img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" /></button>)}</div></div><p class="curve-note">{slot.text}</p></div>)}</div>
					<div class="curve-row late-game-row"><div><div class="curve-label">10 DON!! — Late Game</div><div class="curve-cards">{lateGameChoices.map((entry) => <button class="mini-card curve-card" type="button" data-card-preview data-full={entry.card.img} data-name={`${entry.card.code} ${entry.card.name}`} data-code={entry.card.effectCode}><img src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} loading="lazy" /></button>)}</div></div><ul class="summary-list">{lateGameChoices.map((entry) => <li>{entry.text}</li>)}</ul></div>
				</div>
				<div class="curve-guide-block support-guides">
					{rampSupport.map((support) => (
						<article class={`support-row ${support.cards.length === 2 ? "support-row-featured" : ""}`}>
							<div class={`support-card-list ${support.cards.length === 2 ? "support-card-list-featured" : ""}`}>
								{support.cards.map((entry) => (
									<button class="mini-card support-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`} data-code={entry.effectCode}>
										<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
									</button>
								))}
							</div>
							<div><h3>{support.title}</h3><p class="curve-note">{support.text}</p></div>
						</article>
					))}
				</div>
			</div>

			<div class="glow-block feature-block"><div class="section-header feature-header"><div><h2>Tech Cards</h2><p>This list can be adjusted for the matchups you expect. Sasaki slots are especially flexible because he is usually a 2K Counter rather than a true ramp piece.</p></div></div><div class="tech-grid">{techCards.map((entry) => <article class="tech-card"><button class="mini-card" type="button" data-card-preview data-full={entry.card.img} data-name={`${entry.card.code} ${entry.card.name}`} data-code={entry.card.effectCode}><img src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} loading="lazy" /></button><div><h3>{entry.title}</h3><p class="curve-note">{entry.text}</p></div></article>)}</div></div>

			<div class="glow-block feature-block" id="matchups">
				<div class="section-header feature-header">
					<div>
						<h2>Matchups</h2>
						<p>Quick OP17 matchup spread for Kaido.</p>
					</div>
				</div>
				<div class="matchup-grid">
					<div class="matchup-card glow-block">
						<div class="matchup-badge badge-up"><span class="badge-icon">&uarr;</span><span>Favorable</span></div>
						<div class="matchup-row matchup-row-cards-only">
							<div class="tip-cards">
								{favorableMatchups.map((entry) => (
									<button
										class="mini-card matchup-static-card"
										type="button"
										data-card-preview
										data-full={entry.img}
										data-name={`${entry.code} ${entry.name}`}
										data-code={entry.effectCode}
									>
										<img src={matchupIcons[entry.code] ?? entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
										<div class="mini-label">{entry.name}</div>
									</button>
								))}
							</div>
						</div>
					</div>
					<div class="matchup-card glow-block">
