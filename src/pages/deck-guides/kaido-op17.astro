<script>
	const previewButtons = document.querySelectorAll("[data-card-preview]");
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const modalEffect = document.querySelector("[data-modal-effect]");
	const closeButton = document.querySelector("[data-close]");
	const copyButtons = document.querySelectorAll("[data-copy-sim]");
	const keywordBadge = (icon, alt) => ({ type: "keyword", icon, alt });
	const decklistEffectTextByCode = {
		"OP17-058": [
			[
				keywordBadge("when-attacking", "When Attacking"),
				" / ",
				keywordBadge("on-your-opponents-attack", "On Your Opponent's Attack"),
				" ",
				keywordBadge("once-per-turn", "Once Per Turn"),
				" DON!! -1: Up to 1 of your opponent's Characters gets -2000 power during this turn.",
			],
		],
		"OP17-061": [
			[keywordBadge("on-play", "On Play"), " DON!! -1: If your Leader has the {Animal Kingdom Pirates} type, add up to 1 card from the top of your deck to the top of your Life cards."],
			[keywordBadge("activate-main", "Activate: Main"), " You may trash this Character: Play up to 1 [King], [Queen], or [Jack] from your hand."],
		],
		"OP17-062": [
			[keywordBadge("blocker", "Blocker")],
			[keywordBadge("your-turn", "Your Turn"), " ", keywordBadge("once-per-turn", "Once Per Turn"), " When a DON!! card on your field is returned to your DON!! deck, add up to 1 DON!! card from your DON!! deck and set it as active. Then, set up to 1 of your DON!! cards as active."],
		],
		"OP17-063": [
			["All of your Character cards without a Counter in your hand have a +1000 Counter."],
			[keywordBadge("activate-main", "Activate: Main"), " ", keywordBadge("once-per-turn", "Once Per Turn"), " DON!! -1: If this Character was played on this turn, negate the effect of up to 1 of your opponent's Characters with a cost of 6 or less, and K.O. that Character."],
		],
		"OP17-074": [
			[keywordBadge("blocker", "Blocker"), " (After your opponent declares an attack, you may rest this card to make it the new target of the attack.)"],
			[keywordBadge("on-play", "On Play"), " Add up to 1 DON!! card as rested from your DON!! deck."],
		],
		"OP17-BASIL-HAWKINS": [
			[keywordBadge("on-play", "On Play"), " You may trash 1 card from your hand: If your Leader has the {Animal Kingdom Pirates} type, add up to 1 DON!! card from your DON!! deck and set it as active."],
		],
		"OP17-076": [
			[keywordBadge("on-play", "On Play"), " DON!! -2: Trash 1 card from your opponent's hand."],
		],
		"OP17-JACK": [
			[keywordBadge("rush", "Rush: Character")],
			[keywordBadge("on-play", "On Play"), " DON!! -1: If your Leader has the {Animal Kingdom Pirates} type, give up to 1 of your opponent's Characters -2000 power during this turn."],
		],
		"OP17-WORORORO": [
			[keywordBadge("counter", "Counter"), " You may trash 1 card from your hand: Up to 1 of your Leader or Character cards gains +3000 power during this battle."],
		],
		"EB04-031": [
			[keywordBadge("on-play", "On Play"), " If your Leader has the {Animal Kingdom Pirates} type, add up to 1 DON!! from your DON!! deck and set it as active. Then, K.O. up to 1 of your opponent's Characters with 3000 power or less."],
		],
		"EB04-032": [
			[keywordBadge("on-play", "On Play"), " Look at 5 cards from the top of your deck; reveal up to 1 purple card other than [Queen] and add it to your hand. Then, place the rest at the bottom of the deck in any order."],
		],
		"ST18-001": [
			[keywordBadge("blocker", "Blocker"), " (After your opponent declares an attack, you may rest this card to make it the new target of the attack.)"],
		],
		"ST34-004": [
			[keywordBadge("on-play", "On Play"), " Give up to 1 of your opponent's Characters -10000 power during this turn."],
		],
		"OP15-078": [
			[keywordBadge("counter", "Counter"), " If your Leader has a type including {Animal Kingdom Pirates}, draw 1 card if you have 6 DON!! cards or less on your field. Then, up to 1 of your Leader or Character cards gains +1000 power during this battle."],
		],
		"OP07-077": [
			[keywordBadge("counter", "Counter"), " If your Leader has a {The Four Emperors} type card, give up to 1 of your Leader or Character cards +3000 power during this battle."],
		],
	};

	const openModal = (button) => {
		if (!modal || !modalImage) return;
		const full = button.getAttribute("data-full");
		const name = button.getAttribute("data-name") || "Card preview";
		const code = button.getAttribute("data-code");
		const effectLines = code?.startsWith("OP17") ? decklistEffectTextByCode[code] : null;
		modalImage.setAttribute("src", full);
		modalImage.setAttribute("alt", name);
		if (modalEffect) {
			modalEffect.innerHTML = "";
			if (effectLines?.length) {
				effectLines.forEach((line) => {
					const paragraph = document.createElement("p");
					const normalizedLine = Array.isArray(line) ? line : [line];
					normalizedLine.forEach((part) => {
						if (typeof part === "string") {
							paragraph.appendChild(document.createTextNode(part));
							return;
						}
						if (part?.type === "keyword") {
							const image = document.createElement("img");
							image.className = "modal-keyword-badge";
							image.src = `/assets/keywords/${part.icon}.png`;
							image.alt = part.alt;
							paragraph.appendChild(image);
						}
					});
					modalEffect.appendChild(paragraph);
				});
				modalEffect.hidden = false;
			} else {
				modalEffect.hidden = true;
			}
		}
		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
	};

	const closeModal = () => {
		if (!modal) return;
		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
	};

	previewButtons.forEach((button) => {
		button.addEventListener("click", () => openModal(button));
	});

	closeButton?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (event) => {
		if (event.target === modal) closeModal();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeModal();
	});

	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const value = button.getAttribute("data-sim-deck") ?? "";
			if (!value) return;
			try {
				await navigator.clipboard.writeText(value);
				const previous = button.textContent;
				button.textContent = "Copied!";
				setTimeout(() => {
					button.textContent = previous ?? "Copy for Sim";
				}, 1400);
			} catch {
				button.textContent = "Copy failed";
				setTimeout(() => {
					button.textContent = "Copy for Sim";
				}, 1400);
			}
		});
	});
</script>

