---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Rocks.D.Xebec OP17 First Look";
const description =
	"First look at Rocks.D.Xebec OP17 for One Piece Card Game with leader ability, sample decklist, strengths, weaknesses, and conclusions for the OP17 format.";

const publishedAt = "August 3, 2026";
const icon = "/assets/guides/Rocks.DXebec%20op17.png";

const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const leader = card("OP17-039", "Rocks.D.Xebec", "/Cards/OP17/OP%2017-039%20ALT.jpg", 1, "Leader");

const decklist = [
	card("OP17-039", "Rocks.D.Xebec", "/Cards/OP17/OP%2017-039%20ALT.jpg", 1, "Leader"),
	card("OP17-050", "Streusen", "/Cards/OP17/Streusen%20op17-050.jpg", 4, "Character"),
	card("OP17-045", "Kyo", "/Cards/OP17/Kyo%20op17-045.jpg", 2, "Character"),
	card("OP17-052", "Don Marlon", "/Cards/OP17/Don%20Marlon%20op17-052.jpg", 3, "Character"),
	card("OP17-054", "Miss Buckingham Stussy", "/Cards/OP17/OP17-054%20ALT.jpg", 4, "Character"),
	card("OP17-044", "Captain John", "/Cards/OP17/Captain%20John%20op17-044.jpg", 4, "Character"),
	card("OP17-046", "Gloriosa", "/Cards/OP17/Gloriosa%20op17-046.jpg", 4, "Character"),
	card("OP17-043", "Ganzui", "/Cards/OP17/Ganzui%20op17-043.jpg", 2, "Character"),
	card("OP17-049", "Charlotte Linlin", "/Cards/OP17/OP17-049%20ALT.jpg", 4, "Character"),
	card("OP17-040", "Edward.Newgate", "/Cards/OP17/op17-040%20TREASURE%20RARE.jpg", 4, "Character"),
	card("OP17-048", "Shiki", "/Cards/OP17/OP17-048%20ALT.jpg", 3, "Character"),
	card("OP17-118", "Rocks.D.Xebec", "/Cards/OP17/op17-118.jpg", 4, "Character"),
	card("OP17-055", "There's No Authority in the World That Lasts Forever!!!", "/Cards/OP17/op17-055.jpg", 4, "Event"),
	card("OP17-056", "Rocks Pirates", "/Cards/OP17/op17-056.jpg", 4, "Event"),
	card("OP17-057", "Fullalead", "/Cards/OP17/Fullalead%20op17-057.jpg", 4, "Stage"),
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags">
					<span class="hero-chip">First Look</span>
					<span class="hero-chip hero-chip-accent">OP17 Format</span>
				</div>
				<h1>Rocks.D.Xebec OP17 First Look</h1>
				<p class="hero-intro">
					An early OP17 look at Rocks.D.Xebec, including its leader effect, a first sample decklist,
					strengths, weaknesses, and a conclusion on the deck’s first direction.
				</p>
				<div class="publish-banner">Published {publishedAt}</div>
			</div>
			<div class="guide-icon">
				<img src={icon} alt="Rocks.D.Xebec OP17 first look icon" loading="eager" />
			</div>
		</div>
	</section>

	<section id="decklist" class="list-section">
		<div class="container article-stack">
			<div class="leader-panel glow-block">
				<div class="leader-grid">
					<div class="leader-tag-wrap">
						<div class="section-tag">LEADER</div>
					</div>
					<div class="ability-tag-wrap">
						<div class="section-tag section-tag-light">Ability</div>
					</div>
					<div class="leader-card-wrap">
						<button
							class="detail-card"
							type="button"
							data-card-preview
							data-full={leader.img}
							data-name={`${leader.code} ${leader.name}`}
						>
							<img src={leader.img} alt={`${leader.code} ${leader.name}`} loading="lazy" />
						</button>
					</div>
					<div class="leader-details">
						<div class="info-box">
							<p class="ability-meta">Type &amp; Attribute: Rocks Pirates - Slash</p>
							<p class="ability-copy">
								<img class="keyword-badge" src="/assets/keywords/when-attacking.png" alt="When Attacking" /><br />
								You may trash 1 card from your hand:<br />
								Reveal 1 card from the top of your deck.<br />
								If the revealed card's type includes "Rocks Pirates",<br />
								draw 2 cards.
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="glow-block">
				<div class="section-header decklist-header">
					<div>
						<h2>Decklist</h2>
						<p>Sample first-look OP17 list for Rocks.D.Xebec.</p>
					</div>
				</div>
				<div class="deck-grid">
					{
						decklist.map((entry) => (
							<button
								class="deck-card"
								type="button"
								data-card-preview
								data-full={entry.img}
								data-name={`${entry.code} ${entry.name}`}
							>
								<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
								<div class="deck-info">
									<span class="deck-count">{entry.count}x</span>
									<div>
										<div class="deck-name">{entry.name}</div>
										<div class="deck-code">{entry.code}</div>
									</div>
								</div>
								<span class="deck-role">{entry.role}</span>
							</button>
						))
					}
				</div>
			</div>

			<div class="summary-grid">
				<div class="glow-block">
					<div class="section-tag section-tag-light">Strength</div>
					<ul class="summary-list">
						<li>Crazy leader ability</li>
						<li>Overstatted body</li>
						<li>Draw power</li>
						<li>Powerful tempo play</li>
					</ul>
				</div>
				<div class="glow-block">
					<div class="section-tag section-tag-light">Weakness</div>
					<ul class="summary-list">
						<li>No counter hand without stage</li>
						<li>Slash attribute against Mihawk</li>
						<li>6k base power leader</li>
						<li>Small space for deckbuilding</li>
					</ul>
				</div>
				<div class="glow-block conclusions-card">
					<div class="section-tag section-tag-light">Conclusion</div>
					<p class="ability-copy">
						The leader ability is one of the strongest of the set and leads you to always have cards in hand.<br />
						The "Rocks Pirates" limitation doesn't seem like a problem, but it allows little margin for deck
						building or for some tech.<br />
						I'm afraid decks like Buffy or aggro decks will suffer, but we'll see how the meta will evolve.<br />
						I really like the concept that recalls manga, Rocks fight only for themselves!
					</p>
				</div>
			</div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true">
		<div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview">
			<button class="modal-close" type="button" data-close>Close</button>
			<img src="" alt="" data-modal-image />
		</div>
	</div>
</MainLayout>
<script>
	const previewButtons = document.querySelectorAll("[data-card-preview]");
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const closeButton = document.querySelector("[data-close]");

	const openModal = (button) => {
		if (!modal || !modalImage) return;
		const full = button.getAttribute("data-full");
		const name = button.getAttribute("data-name") || "Card preview";
		modalImage.setAttribute("src", full);
		modalImage.setAttribute("alt", name);
		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
	};

	const closeModal = () => {
		if (!modal) return;
		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
	};

	previewButtons.forEach((button) => {
		button.addEventListener("click", () => openModal(button));
	});

	closeButton?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (event) => {
		if (event.target === modal) closeModal();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeModal();
	});
</script>

<style>
	.guide-hero {
		padding: 3rem 0 2rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
		gap: 3rem;
		align-items: center;
	}

	.hero-copy {
		min-width: 0;
		max-width: 760px;
	}

	.hero-copy h1 {
		margin: 0;
		font-size: clamp(2.1rem, 5vw, 3.3rem);
		line-height: 1.05;
	}

	.hero-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.hero-chip,
	.publish-banner,
	.section-tag {
		border-radius: 999px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero-chip {
		padding: 0.45rem 0.9rem;
		background: rgba(44, 117, 255, 0.16);
		color: #9ec0ff;
		border: 1px solid rgba(68, 143, 255, 0.28);
	}

	.hero-chip-accent {
		background: rgba(255, 138, 42, 0.14);
		color: var(--accent);
		border-color: rgba(255, 138, 42, 0.28);
	}

	.publish-banner {
		display: inline-flex;
		margin-top: 1rem;
		padding: 0.7rem 1.1rem;
		background: linear-gradient(135deg, rgba(255, 138, 42, 0.16), rgba(44, 117, 255, 0.14));
		border: 1px solid rgba(255, 138, 42, 0.28);
		color: var(--text-100);
	}

	.hero-intro {
		max-width: 56ch;
		margin: 1rem 0 0;
		color: var(--text-200);
		font-size: 1.02rem;
		line-height: 1.6;
	}

	.detail-card,
	.deck-card {
		background: transparent;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.guide-icon img {
		width: min(320px, 100%);
		border-radius: 18px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
	}

	.article-stack,
	.summary-grid,
	.leader-details {
		display: grid;
		gap: 1.4rem;
	}

	.glow-block {
		background: rgba(12, 17, 30, 0.9);
		border: 1px solid rgba(255, 138, 42, 0.24);
		border-radius: 26px;
		padding: 1.25rem;
	}

	.section-tag {
		display: inline-flex;
		padding: 0.45rem 0.9rem;
		background: rgba(44, 117, 255, 0.2);
		color: #dfe9ff;
		margin-bottom: 1rem;
	}

	.section-tag-light {
		font-weight: 500;
	}

	.leader-grid {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		grid-template-areas:
			"leaderTag abilityTag"
			"card ability";
		gap: 1.5rem;
		align-items: start;
	}

	.leader-tag-wrap {
		grid-area: leaderTag;
	}

	.ability-tag-wrap {
		grid-area: abilityTag;
	}

	.detail-card img {
		width: 100%;
		max-width: 220px;
		border-radius: 16px;
	}

	.info-box {
		background: rgba(8, 12, 22, 0.92);
		border: 1px solid rgba(68, 143, 255, 0.2);
		border-radius: 22px;
		padding: 1rem 1.1rem;
	}

	.leader-card-wrap {
		grid-area: card;
	}

	.leader-details {
		grid-area: ability;
	}

	.info-title,
	.info-line {
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.info-line-normal {
		text-transform: none;
		letter-spacing: 0.02em;
	}

	.ability-meta {
		margin: 0 0 0.85rem;
		color: var(--accent);
		font-size: 0.95rem;
		line-height: 1.45;
		font-weight: 400;
	}

	.caps-copy,
	.caps-list {
		font-size: clamp(1rem, 1.8vw, 1.35rem);
		font-weight: 800;
		line-height: 1.35;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		margin: 0;
	}

	.ability-copy {
		font-size: clamp(1rem, 1.35vw, 1.2rem);
		font-weight: 400;
		line-height: 1.55;
		letter-spacing: 0;
		text-transform: none;
		margin: 0;
	}

	.summary-list {
		margin: 0;
		padding-left: 1.2rem;
		font-size: clamp(1rem, 1.35vw, 1.2rem);
		font-weight: 400;
		line-height: 1.55;
		letter-spacing: 0;
		text-transform: none;
	}

	.keyword-badge {
		display: inline-block;
		height: 1.9rem;
		width: auto;
		vertical-align: middle;
		margin-bottom: 0.45rem;
	}

	.deck-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
		gap: 1rem;
	}

	.deck-card {
		background: rgba(10, 14, 24, 0.92);
		border: 1px solid rgba(255, 138, 42, 0.22);
		border-radius: 18px;
		padding: 0.9rem;
		display: grid;
		gap: 0.85rem;
		text-align: left;
	}

	.deck-card img {
		width: 100%;
		max-width: 150px;
		margin: 0 auto;
		border-radius: 14px;
	}

	.deck-info {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.6rem;
		align-items: center;
	}

	.deck-count {
		background: rgba(255, 107, 61, 0.15);
		color: var(--accent);
		font-weight: 700;
		border-radius: 999px;
		padding: 0.3rem 0.7rem;
		font-size: 0.9rem;
	}

	.deck-name {
		font-weight: 600;
	}

	.deck-code {
		color: var(--text-300);
		font-size: 0.85rem;
	}

	.deck-role {
		color: var(--text-300);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.summary-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.conclusions-card {
		grid-column: 1 / -1;
	}

	.card-modal {
		position: fixed;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: center;
		background: rgba(5, 8, 16, 0.82);
		padding: 1.5rem;
		z-index: 50;
	}

	.card-modal.is-open {
		display: flex;
	}

	.card-modal-inner {
		position: relative;
		max-width: min(92vw, 520px);
	}

	.card-modal-inner img {
		width: 100%;
		border-radius: 20px;
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
	}

	.modal-close {
		position: absolute;
		top: -0.75rem;
		right: -0.75rem;
		border: none;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		padding: 0.55rem 0.85rem;
		font-weight: 700;
		cursor: pointer;
	}

	@media (max-width: 1100px) {
	}

	@media (max-width: 900px) {
		.hero-grid,
		.summary-grid {
			grid-template-columns: 1fr;
		}

		.guide-icon {
			justify-self: center;
		}

		.detail-card {
			justify-self: center;
		}
	}

	@media (min-width: 901px) {
		.deck-grid {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}

		.deck-card {
			padding: 0.75rem;
			gap: 0.65rem;
		}

		.deck-card img {
			max-width: 110px;
		}

		.deck-count {
			padding: 0.22rem 0.55rem;
			font-size: 0.8rem;
		}

		.deck-name {
			font-size: 0.92rem;
		}

		.deck-code,
		.deck-role {
			font-size: 0.78rem;
		}
	}

	@media (max-width: 560px) {
		.leader-grid {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
			grid-template-areas:
				"leaderTag abilityTag"
				"card ability";
			align-items: start;
			gap: 1rem;
		}

		.leader-details {
			display: block;
		}

		.detail-card img {
			max-width: 100%;
		}

		.ability-copy {
			font-size: 0.98rem;
			line-height: 1.5;
		}

		.keyword-badge {
			height: 1.6rem;
		}

		.guide-hero {
			padding-top: 2rem;
		}

		.glow-block {
			padding: 1rem;
			border-radius: 22px;
		}
	}
</style>
