---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Rocks.D.Xebec OP17 Deck Guide";
const description =
	"Deck guide for Rocks.D.Xebec OP17 for One Piece Card Game with leader ability, updated decklist, curve guide, odd curve, 10 DON!! plays, matchup notes, defensive transformation, strengths, weaknesses, and conclusions for the OP17 format.";
const icon = "/assets/guides/Rocks.DXebec%20op17.png";

const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;

	while (remaining > 4) {
		lines.push(`4x${code}`);
		remaining -= 4;
	}

	if (remaining > 0) {
		lines.push(`${remaining}x${code}`);
	}

	return lines;
};

const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const buckin = card("OP08-051", "Buckin", "/Cards/OP08/OP08-051.png", 3, "Character");
const streusen = card("OP17-050", "Streusen", "/Cards/OP17/New OP17/OP17-050.jpg", 4, "Character");
const kyo = card("OP17-045", "Kyo", "/Cards/OP17/New OP17/OP17-045.jpg", 4, "Character");
const donMarlon = card("OP17-052", "Don Marlon", "/Cards/OP17/New OP17/OP17-052.jpg", 2, "Character");
const missBuckingham = card("OP17-054", "Miss Buckingham Stussy", "/Cards/OP17/New OP17/OP17-054.jpg", 4, "Character");
const kaido = card("OP17-042", "Kaido", "/Cards/OP17/New OP17/OP17-042.jpg", 2, "Character");
const captainJohn = card("OP17-044", "Captain John", "/Cards/OP17/New OP17/OP17-044.jpg", 3, "Character");
const gloriosa = card("OP17-046", "Gloriosa", "/Cards/OP17/New OP17/OP17-046.jpg", 4, "Character");
const charlotteLinlin = card("OP17-049", "Charlotte Linlin", "/Cards/OP17/New OP17/OP17-049.jpg", 4, "Character");
const edwardNewgate = card("OP17-040", "Edward.Newgate", "/Cards/OP17/New OP17/OP17-040.jpg", 4, "Character");
const shiki = card("OP17-048", "Shiki", "/Cards/OP17/New OP17/OP17-048.jpg", 4, "Character");
const rocksXebecCharacter = card("OP17-118", "Rocks.D.Xebec", "/Cards/OP17/New OP17/OP17-118.jpg", 4, "Character");
const noAuthority = card("OP17-055", "There's No Authority in the World That Lasts Forever!!!", "/Cards/OP17/New OP17/OP17-055.jpg", 4, "Event");
const rocksPirates = card("OP17-056", "Rocks Pirates", "/Cards/OP17/New OP17/OP17-056.jpg", 4, "Event");
const fullalead = card("OP17-057", "Fullalead", "/Cards/OP17/New OP17/OP17-057.jpg", null, "Stage");

const decklist = [
	card("OP17-039", "Rocks.D.Xebec", "/Cards/OP17/New OP17/OP17-039.jpg", 1, "Leader"),
	buckin,
	streusen,
	kyo,
	donMarlon,
	missBuckingham,
	kaido,
	captainJohn,
	gloriosa,
	charlotteLinlin,
	edwardNewgate,
	shiki,
	rocksXebecCharacter,
	noAuthority,
	rocksPirates,
];

const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const bestCurve = [
	{
		label: "2 DON!!",
		notes: "Kyo is the cleanest even-curve opener because playing it immediately draws 1, so your hand does not lose momentum while you develop the board. The important part is what happens after that: as long as Kyo stays in play, whenever one of your Characters would be removed by an opponent’s effect, you can trash 2 cards from hand instead. That means it is not just a tempo starter, it is also a protection piece that helps your key bodies survive and lets you keep your even curve online into Captain John, Edward.Newgate, and beyond.",
		cards: [kyo],
	},
	{
		label: "4 DON!!",
		notes: "Captain John is your four-DON!! stabilizer because once it is rested, the opponent can no longer attack your other cards freely and has to go through it first. That makes it excellent for protecting the rest of your board and forcing awkward combat patterns. On top of that, it can rest itself to draw 1 and trash 1, which fixes weak cards in hand and prepares stronger follow-up turns. In practice, this card is doing two jobs at once: it locks combat around itself and smooths your resources for the bigger turns that come next.",
		cards: [captainJohn],
	},
	{
		label: "6 DON!!",
		notes: "Edward.Newgate is the even-curve pivot because it gives you a strong body while turning the rest of your hand into real combat value. In this deck, that matters on both sides of the turn: offensively, it helps you pressure the opponent with stronger attacks and forces more demanding responses; defensively, it lets you preserve your board and life total by making your exchanges much harder to win cleanly. The card is strong here because it does not ask you to choose between defense and pressure, it gives you both at the same time.",
		cards: [edwardNewgate],
	},
	{
		label: "8 DON!!",
		notes: "Shiki is your high-end even-curve payoff when you want a large threat that changes combat math immediately. It turns otherwise weak cards in hand into a meaningful swing, which makes the turn powerful offensively because you can push damage while keeping pressure on the board. But the role of the card does not stop there: since the effect also functions during the opponent’s attack, Shiki can protect you on the following turn cycle as well. That is why this play is so important in the curve: it gives you a big body, stronger attacks, and a real defensive follow-up if the game keeps going.",
		cards: [shiki],
	},
];

const oddCurve = [
	{
		label: "1 DON!!",
		notes: "Streusen is your cleanest odd-curve opener because it looks at the top 2 cards, lets you reorder them or send them to the bottom, then draws 1. That means it improves hand quality immediately while also setting up the top of your deck so your next turns and leader effect stay consistent.",
		cards: [streusen],
	},
	{
		label: "3 DON!!",
		notes: "Kyo is the bridge card of the odd curve. On play it replaces itself with a draw, and once it is on board it forces the opponent to respect your protection line because any effect removal on one of your characters can be answered by trashing 2 from hand instead. It is what lets you keep developing without folding to effect-based interaction.",
		cards: [kyo],
	},
	{
		label: "5 DON!!",
		notes: "Charlotte Linlin is your five-DON!! stabilizer when you want a real body on board without giving up defensive texture. In this shell, it helps convert awkward cards in hand into extra counter value, so the turn is not just offensive pressure: it also makes your following exchanges safer and keeps the leader engine live longer.",
		cards: [charlotteLinlin],
	},
	{
		label: "7 DON!!",
		notes: "Shiki is the odd-curve payoff because it gives you a large body while turning weak cards in hand into a big swing in combat. The important part is that the effect is not only offensive: it also works during the opponent’s attack, so Shiki can turn a 7-DON!! turn into both pressure on your turn and protection on theirs.",
		cards: [shiki],
	},
];

const tenDonPlays = [
	{
		label: "10 DON!! Play",
		notes: "Rocks.D.Xebec turns your 10-DON!! turn into a flexible payoff depending on what the matchup asks for.",
		leaderCard: rocksXebecCharacter,
		pairs: [
			[edwardNewgate, missBuckingham],
			[shiki, kyo],
			[charlotteLinlin, gloriosa],
			[charlotteLinlin, kaido],
		],
	},
];

const favorableMatchups = [
	{ name: "Sabo OP13", image: "/assets/guides/Sabo%20OP13-004.png", alt: "Sabo OP13" },
	{ name: "Portgas D. Ace OP16", image: "/assets/guides/Ace-op16.png", alt: "Portgas D. Ace OP16" },
	{ name: "Nico Robin OP09", image: "/assets/guides/Nico-Robin-op09.png", alt: "Nico Robin OP09" },
	{ name: "Charlotte Linlin OP17", image: "/assets/guides/Charlotte%20Linlin%20op17.png", alt: "Charlotte Linlin OP17" },
	{ name: "Shanks OP17", image: "/assets/guides/Shanks%20op17.png", alt: "Shanks OP17" },
	{ name: "Luffy and Ace ST30", image: "/assets/guides/Luffy-st30.png", alt: "Luffy and Ace ST30" },
	{ name: "Enel OP15", image: "/assets/guides/enel-op15.png", alt: "Enel OP15" },
];

const slightlyUnfavorableMatchups = [
	{ name: "Kaido OP17", image: "/assets/guides/Kaido%20op17.png", alt: "Kaido OP17" },
];

const unfavorableMatchups = [
	{ name: "Dracule Mihawk OP14", image: "/assets/guides/dracule-mihawk-op14.png", alt: "Dracule Mihawk OP14" },
	{ name: "Monkey D. Luffy OP17", image: "/assets/guides/Luffy%20OP17.png", alt: "Monkey D. Luffy OP17" },
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags">
					<span class="hero-chip">Deck Guide</span>
					<span class="hero-chip hero-chip-accent">OP17 Format</span>
				</div>
				<h1>Rocks.D.Xebec OP17 Deck Guide</h1>
				<p class="hero-intro">
					A compact OP17 guide for Rocks.D.Xebec, including its leader effect, the updated decklist, your
					best curve, the odd curve, key 10 DON!! plays, matchup notes, defensive transformation lines,
					strengths, weaknesses, and a short conclusion on the deck’s current direction.
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="#curve">Curve Guide</a>
					<a class="btn btn-secondary" href="#matchups">Matchups</a>
				</div>
			</div>
			<div class="guide-icon">
				<img src={icon} alt="Rocks.D.Xebec OP17 first look icon" loading="eager" />
			</div>
		</div>
	</section>

	<section id="decklist" class="list-section">
		<div class="container article-stack">
			<div class="glow-block">
				<div class="section-header decklist-header">
					<div class="decklist-title-row">
						<h2>Decklist</h2>
						<button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>
							Copy for Sim
						</button>
					</div>
					<div>
						<p>Updated OP17 list for Rocks.D.Xebec.</p>
					</div>
				</div>
				<div class="deck-grid">
					{
						decklist.map((entry) => (
							<button
								class="deck-card"
								type="button"
								data-card-preview
								data-full={entry.img}
								data-name={`${entry.code} ${entry.name}`}
								data-code={entry.code}
							>
								<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
								<div class="deck-info">
									<span class="deck-count">{entry.count}x</span>
									<div>
										<div class="deck-name">{entry.name}</div>
										<div class="deck-code">{entry.code}</div>
									</div>
								</div>
								<span class="deck-role">{entry.role}</span>
							</button>
						))
					}
				</div>
			</div>

			<div class="curve-block glow-block">
				<h3>Curve Guide</h3>
				<p class="curve-intro">
					Going second is your best start. The curve shown is just an example, because Xebec’s lines can
					change a lot depending on the matchup and your hand texture.
				</p>
				<div class="curve-rows">
					{bestCurve.map((slot) => (
						<div class="curve-row">
							<div class="curve-label">{slot.label}</div>
							<div class="curve-cards">
								{slot.cards.map((entryCard) => (
									<button
										class="mini-card curve-card"
										type="button"
										data-card-preview
										data-full={entryCard.img}
										data-name={`${entryCard.code} ${entryCard.name}`}
										data-code={entryCard.code}
									>
										<img loading="lazy" src={entryCard.img} alt={`${entryCard.code} ${entryCard.name}`} />
										<div class="mini-label">{entryCard.name}</div>
									</button>
								))}
							</div>
							<div class="curve-note">{slot.notes}</div>
						</div>
					))}
				</div>
			</div>

			<div class="curve-block glow-block">
				<h3>Odd Curve</h3>
				<p class="curve-intro">
					The curve shown is just an example. Xebec’s plays vary greatly depending on the matchup.
				</p>
				<div class="curve-rows">
					{oddCurve.map((slot) => (
						<div class="curve-row">
							<div class="curve-label">{slot.label}</div>
							<div class="curve-cards">
								{slot.cards.map((entryCard) => (
									<button
										class="mini-card curve-card"
										type="button"
										data-card-preview
										data-full={entryCard.img}
										data-name={`${entryCard.code} ${entryCard.name}`}
										data-code={entryCard.code}
									>
										<img loading="lazy" src={entryCard.img} alt={`${entryCard.code} ${entryCard.name}`} />
										<div class="mini-label">{entryCard.name}</div>
									</button>
								))}
							</div>
							<div class="curve-note">{slot.notes}</div>
						</div>
					))}
				</div>
			</div>

			<div id="curve" class="curve-block glow-block">
				<h3>10 DON!! Plays</h3>
				<div class="ten-don-header">
					<button
						class="detail-card ten-don-leader"
						type="button"
						data-card-preview
						data-full={rocksXebecCharacter.img}
						data-name={`${rocksXebecCharacter.code} ${rocksXebecCharacter.name}`}
						data-code={rocksXebecCharacter.code}
					>
						<img src={rocksXebecCharacter.img} alt={`${rocksXebecCharacter.code} ${rocksXebecCharacter.name}`} loading="lazy" />
					</button>
					<div class="ten-don-intro">
						<div class="ten-don-intro-chip">10 DON!! payoff</div>
						<p class="curve-note ten-don-note">
							Rocks.D.Xebec OP17-118 turns your 10-DON!! turn into a flexible double-deploy. Pick the pair that best matches the board state and matchup.
						</p>
					</div>
				</div>
				<div class="ten-don-plays">
					{tenDonPlays[0].pairs.map((pair) => (
						<div class="ten-don-row">
							<div class="curve-cards ten-don-pair">
								{pair.map((entryCard, index) => (
									<>
										{index > 0 && <span class="combo-plus" aria-hidden="true">+</span>}
										<button
											class="mini-card curve-card"
											type="button"
											data-card-preview
											data-full={entryCard.img}
											data-name={`${entryCard.code} ${entryCard.name}`}
											data-code={entryCard.code}
										>
											<img loading="lazy" src={entryCard.img} alt={`${entryCard.code} ${entryCard.name}`} />
											<div class="mini-label">{entryCard.name}</div>
										</button>
									</>
								))}
							</div>
						</div>
					))}
				</div>
			</div>

			<div class="glow-block">
				<div class="section-header">
					<div>
						<h2 id="matchups">Matchups</h2>
						<p>See Xebec&apos;s win rates when going first or second in <a href="/meta-analysis/Rocks-D-Xebec-op17-stats/">OP17 Rocks D. Xebec stats in OP17 Format.</a></p>
						<p>
							Xebec looks like one of the more complete decks in the current field. It pressures slower
							leaders, keeps cards flowing, and has enough high-end tempo to stay favored across a large
							part of the matchup spread.
						</p>
					</div>
				</div>
				<div class="matchup-grid">
					<div class="matchup-card glow-block">
						<div class="matchup-badge badge-up"><span class="badge-icon">&uarr;</span><span>Favorable</span></div>
						<div class="matchup-row matchup-row-cards-only">
							<div class="tip-cards">
								{favorableMatchups.map((entry) => (
									<div class="mini-card matchup-static-card" aria-label={entry.alt}>
										<img src={entry.image} alt={entry.alt} loading="lazy" />
										<div class="mini-label">{entry.name}</div>
									</div>
								))}
							</div>
						</div>
					</div>
					<div class="matchup-card glow-block">
						<div class="matchup-badge badge-mid"><span class="badge-icon">~</span><span>Slightly Unfavorable</span></div>
						<div class="matchup-row matchup-row-cards-only">
							<div class="tip-cards">
								{slightlyUnfavorableMatchups.map((entry) => (
									<div class="mini-card matchup-static-card" aria-label={entry.alt}>
										<img src={entry.image} alt={entry.alt} loading="lazy" />
										<div class="mini-label">{entry.name}</div>
									</div>
								))}
							</div>
						</div>
					</div>
					<div class="matchup-card glow-block">
						<div class="matchup-badge badge-down"><span class="badge-icon">&darr;</span><span>Unfavorable</span></div>
						<div class="matchup-row matchup-row-cards-only">
							<div class="tip-cards">
								{unfavorableMatchups.map((entry) => (
									<div class="mini-card matchup-static-card" aria-label={entry.alt}>
										<img src={entry.image} alt={entry.alt} loading="lazy" />
										<div class="mini-label">{entry.name}</div>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="summary-grid">
				<div class="glow-block">
					<div class="section-tag section-tag-light">Strength</div>
					<ul class="summary-list">
						<li>Crazy leader ability</li>
						<li>Overstatted body</li>
						<li>Draw power</li>
						<li>Powerful tempo play</li>
					</ul>
				</div>
				<div class="glow-block">
					<div class="section-tag section-tag-light">Weakness</div>
					<ul class="summary-list">
						<li>No counter hand without stage</li>
						<li>Slash attribute against Mihawk</li>
						<li>6k base power leader</li>
						<li>Small space for deckbuilding</li>
					</ul>
				</div>
				<div class="glow-block">
					<div class="section-tag section-tag-light">Defensive Transformation</div>
					<ul class="summary-list">
						<li>Newgate / Shiki: Turn bricks into +3000 / -3000 swings.</li>
						<li>Linlin / Fullalead: Turn bricks into +1000 Counters.</li>
						<li>Ganzui: Turns Leader into a 6000 Power wall.</li>
					</ul>
				</div>
				<div class="glow-block conclusions-card">
					<div class="section-tag section-tag-light">Conclusion</div>
					<p class="ability-copy">
						The leader ability is one of the strongest of the set and leads you to always have cards in hand.<br />
						Aggressive decks like Black Luffy OP17 could end up struggling because of it.<br />
						The "Rocks Pirates" limitation doesn't seem like a problem, but it allows little margin for deck
						building or for some tech.
					</p>
				</div>
			</div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true">
		<div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview">
			<button class="modal-close" type="button" data-close>Close</button>
			<img src="" alt="" data-modal-image />
		</div>
	</div>
</MainLayout>
<script>
	const previewButtons = document.querySelectorAll("[data-card-preview]");
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const modalEffect = document.querySelector("[data-modal-effect]");
	const closeButton = document.querySelector("[data-close]");
	const copyButtons = document.querySelectorAll("[data-copy-sim]");
	const keywordBadge = (icon, alt) => ({ type: "keyword", icon, alt });
	const decklistEffectTextByCode = {
		"OP08-051": [[keywordBadge("counter", "Counter"), " If your Leader has the {Rocks Pirates} type, this card gains +3000 counter instead of +2000 during this battle."]],
		"OP17-042": [[keywordBadge("on-play", "On Play"), " If your Leader's type includes \"Rocks Pirates\", set up to 1 of your DON!! cards as active."]],
		"OP17-043": [
			"If this Character would be removed from the field, you may trash 2 cards from your hand instead.",
			[keywordBadge("on-play", "On Play"), " Your Leader's base power becomes 6000 until the end of your opponent's next End Phase."],
		],
		"OP17-044": [
			"If your Leader's type includes \"Rocks Pirates\" and this Character is rested, your opponent can't attack any card other than [Captain John].",
			[keywordBadge("activate-main", "Activate: Main"), " You may rest this Character: Draw 1 card and trash 1 card from your hand."],
		],
		"OP17-045": [
			"If one of your Characters would be removed from the field by your opponent's effect, you may trash 2 cards from your hand instead.",
			[keywordBadge("on-play", "On Play"), " Draw 1 card."],
		],
		"OP17-046": [
			[keywordBadge("blocker", "Blocker")],
			[keywordBadge("on-play", "On Play"), " Place up to 1 Character with a cost of 5 or less at the bottom of the owner's deck."],
		],
		"OP17-050": [[keywordBadge("on-play", "On Play"), " Look at 2 cards from the top of your deck, reorganize them in any order and place them at the top or bottom of your deck. Then, draw 1 card."]],
		"OP17-052": [[keywordBadge("on-play", "On Play"), " Add up to 1 blue Event with a cost of 0 from your trash to your hand."]],
		"OP17-055": [
			[keywordBadge("main", "Main"), " You may rest 1 of your DON!! cards: Up to 1 of your [Rocks.D.Xebec] gains ", keywordBadge("unblockable", "Unblockable"), " during this turn."],
			[keywordBadge("counter", "Counter"), " Up to 1 of your Leader with a type including \"Rocks Pirates\" or up to 1 of your Characters with a type including \"Rocks Pirates\" gains +2000 power during this battle."],
		],
		"OP17-056": [
			[keywordBadge("main", "Main"), " You may rest 5 of your DON!! cards: Return up to 1 Character with a cost of 6 or less to the owner's hand."],
			[keywordBadge("counter", "Counter"), " Up to 1 of your Leader with a type including \"Rocks Pirates\" or up to 1 of your Characters with a type including \"Rocks Pirates\" gains +2000 power during this battle."],
		],
		"OP17-057": [
			[keywordBadge("on-your-opponents-attack", "On Your Opponent's Attack"), " You may rest this Stage and trash 1 card from your hand: Up to 1 of your Leader with a type including \"Rocks Pirates\" or up to 1 of your Characters with a type including \"Rocks Pirates\" gains +1000 power during this battle."],
		],
	};

	const openModal = (button) => {
		if (!modal || !modalImage) return;
		const full = button.getAttribute("data-full");
		const name = button.getAttribute("data-name") || "Card preview";
		const code = button.getAttribute("data-code");
		const effectLines = code?.startsWith("OP17") ? decklistEffectTextByCode[code] : null;
		modalImage.setAttribute("src", full);
		modalImage.setAttribute("alt", name);
		if (modalEffect) {
			modalEffect.innerHTML = "";
			if (effectLines?.length) {
				effectLines.forEach((line) => {
					const paragraph = document.createElement("p");
					const normalizedLine = Array.isArray(line) ? line : [line];
					normalizedLine.forEach((part) => {
						if (typeof part === "string") {
							paragraph.appendChild(document.createTextNode(part));
							return;
						}
						if (part?.type === "keyword") {
							const image = document.createElement("img");
							image.className = "modal-keyword-badge";
							image.src = `/assets/keywords/${part.icon}.png`;
							image.alt = part.alt;
							paragraph.appendChild(image);
						}
					});
					modalEffect.appendChild(paragraph);
				});
				modalEffect.hidden = false;
			} else {
				modalEffect.hidden = true;
			}
		}
		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
	};

	const closeModal = () => {
		if (!modal) return;
		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
	};

	previewButtons.forEach((button) => {
		button.addEventListener("click", () => openModal(button));
	});

	closeButton?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (event) => {
		if (event.target === modal) closeModal();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeModal();
	});

	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const value = button.getAttribute("data-sim-deck") ?? "";
			if (!value) return;
			try {
				await navigator.clipboard.writeText(value);
				const previous = button.textContent;
				button.textContent = "Copied!";
				setTimeout(() => {
					button.textContent = previous ?? "Copy for Sim";
				}, 1400);
			} catch {
				button.textContent = "Copy failed";
				setTimeout(() => {
					button.textContent = "Copy for Sim";
				}, 1400);
			}
		});
	});
</script>

