---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Nico Robin OP09 Deck Guide";
const description =
	"OP17 format deck guide for Nico Robin OP09 with updated decklist, curve guide, hybrid tactics and combos, deck in a nutshell, and matchups.";

const icon = "/assets/guides/Nico-Robin-op09.png";

const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;
	while (remaining > 4) {
		lines.push(`4x${code}`);
		remaining -= 4;
	}
	if (remaining > 0) lines.push(`${remaining}x${code}`);
	return lines;
};

const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const leader = card("OP09-062", "Nico Robin", "/Cards/OP09/OP09-062.jpg", 1, "Leader");
const puddingSearcher = card("OP11-070", "Charlotte Pudding", "/Cards/OP11/OP11-070.jpg", 3);
const brulee = card("ST34-003", "Charlotte Brulee", "/Cards/ST34/ST34-003.jpg", 4);
const streusen = card("OP17-113", "Streusen", "/Cards/OP17/New OP17/OP17-113.jpg", 4);
const yamato = card("OP17-074", "Yamato", "/Cards/OP17/New OP17/OP17-074.jpg", 4);
const daifuku = card("OP17-107", "Charlotte Daifuku", "/Cards/OP17/New OP17/OP17-107.jpg", 4);
const puddingOp17 = card("OP17-109", "Charlotte Pudding", "/Cards/OP17/New OP17/OP17-109.jpg", 4);
const oven = card("OP17-102", "Charlotte Oven", "/Cards/OP17/New OP17/OP17-102.jpg", 4);
const borsalino = card("EB04-058", "Borsalino", "/Cards/EB04/EB04-058.jpg", 2);
const smoothie = card("OP17-106", "Charlotte Smoothie", "/Cards/OP17/New OP17/OP17-106.jpg", 4);
const sweet3 = card("OP17-114", "Sweet 3 Generals", "/Cards/OP17/New OP17/OP17-114.jpg", 4);
const perospero = card("OP17-110", "Charlotte Perospero", "/Cards/OP17/New OP17/OP17-110.jpg", 4);
const linlin = card("OP17-112", "Charlotte Linlin", "/Cards/OP17/New OP17/OP17-112.jpg", 4);
const gumGumGiant = card("OP09-078", "Gum-Gum Giant", "/Cards/OP09/OP09-078.jpg", 2, "Event");
const itsToDieFor = card("OP08-076", "It's to Die For♡", "/Cards/OP08/OP08-076.png", 3, "Event");

const robinRamp = card("OP06-062", "Nico Robin", "/Cards/OP06/OP06-062.png");

const decklist = [
	leader,
	puddingSearcher,
	brulee,
	streusen,
	yamato,
	daifuku,
	puddingOp17,
	oven,
	borsalino,
	smoothie,
	sweet3,
	perospero,
	linlin,
	gumGumGiant,
	itsToDieFor,
];

const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const goFirst = [
	{
		label: "1 DON!!",
		cards: [{ card: puddingSearcher }],
		text: "Charlotte Pudding is your searcher and helps you find a Big Mom Pirates card to set up your next turns.",
	},
	{
		label: "3 DON!!",
		cards: [{ card: puddingOp17 }, { card: leader, rested: true }],
		text: "Charlotte Pudding lets you draw 3 cards while placing 1 strategic card in the trash, then Nico Robin attacks so you can reach 6 DON!!.",
	},
	{
		label: "6 DON!!",
		cards: [{ card: itsToDieFor }, { card: oven }],
		text: "It's to Die For♡ pushes you up by as much as 2 DON!!, and Charlotte Oven gives you access to the Character you trashed with Pudding if Oven gets K.O.'d.",
	},
	{
		label: "10 DON!!",
		cards: [{ card: linlin }],
		text: "Because of the previous turns, you can reach 10 DON!! as early as turn 4 and land Charlotte Linlin to add a large body, increase board pressure, draw 1 card, and either add 1 Life or trash 1 of your opponent's Life depending on the situation.",
	},
];

const goSecond = [
	{
		label: "2 DON!!",
		cards: [{ card: streusen }, { card: puddingSearcher }],
		text: "Streusen and Charlotte Pudding help you find your Big Mom Pirates cards to set up your next turns.",
	},
	{
		label: "4 DON!!",
		cards: [{ card: puddingOp17 }, { card: leader, rested: true }],
		text: "Charlotte Pudding draws 3 and loads the trash, then Nico Robin attacks so you keep converting the turn into extra DON!!.",
	},
	{
		label: "7 DON!!",
		cards: [{ card: itsToDieFor }, { card: oven }],
		text: "It's to Die For♡ again pushes the DON!! count forward, and Charlotte Oven keeps the discarded Character line available if Oven is removed.",
	},
	{
		label: "10 DON!!",
		cards: [{ card: linlin }],
		text: "The same payoff arrives here as well: Charlotte Linlin gives you the big body, extra pressure, a draw, and the choice between adding 1 Life or trashing 1 of your opponent's Life.",
	},
];

const strengths = [
	"Leader has Banish built in, starving the opponent of life cards right from the start.",
	"Unbelievable ramp speed for a deck that runs Yellow triggers.",
	"Access to broken Purple defensive events like Gum Gum Giant.",
];

const weaknesses = [
	"Ramping too fast without searchers or drawers (like 3c Pudding) will completely empty your hand.",
	"Relies on seeing specific cards early to establish the ramp curve.",
	"Susceptible to Aggro if you don't hit your healing in the mid/late game.",
];

const coreEngine = [
	"Leader Robin: Toss a trigger, get a DON!!, and swing with Banish.",
	"10c Linlin: Linlin buffs your board and allows you to heal or damage your opponent",
];

const matchupGroups = [
	{
		title: "Favorable",
		tone: "up",
		entries: [
			{ name: "Dracule Mihawk OP14", image: "/assets/guides/dracule-mihawk-op14.png" },
			{ name: "Charlotte Linlin OP17", image: "/assets/guides/Charlotte Linlin op17.png" },
		],
	},
	{
		title: "Slightly Favorable",
		tone: "slight-up",
		entries: [
			{ name: "Portgas.D.Ace OP16", image: "/assets/guides/Ace-op16.png" },
		],
	},
	{
		title: "Even",
		tone: "even",
		entries: [
			{ name: "Sabo OP13", image: "/assets/guides/Sabo%20OP13-004.png" },
			{ name: "Kaido OP17", image: "/assets/guides/Kaido%20op17.png" },
		],
	},
	{
		title: "Slightly Unfavorable",
		tone: "slight-down",
		entries: [
			{ name: "Enel OP15", image: "/assets/guides/enel-op15.png" },
		],
	},
	{
		title: "Unfavorable",
		tone: "down",
		entries: [
			{ name: "Rocks.D.Xebec OP17", image: "/assets/guides/Rocks.DXebec%20op17.png" },
			{ name: "Monkey.D.Luffy OP17", image: "/assets/guides/Luffy OP17.png" },
			{ name: "Shanks OP17", image: "/assets/guides/Shanks%20op17.png" },
			{ name: "Luffy and Ace ST30", image: "/assets/guides/Luffy-st30.png" },
		],
	},
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags">
					<span class="hero-chip">Deck Guide</span>
					<span class="hero-chip hero-chip-accent">OP17 Format</span>
				</div>
				<h1>Nico Robin OP09 Deck Guide</h1>
				<p class="hero-intro">
					Banish, ramp, and Yellow payoff cards all in one shell. Purple/Yellow Nico Robin stands out in the
					OP17 format thanks to built-in Banish, very fast DON!! acceleration, and access to major Big Mom
					cards.
				</p>
			</div>
			<div class="guide-icon">
				<img src={icon} alt="Nico Robin OP09 deck guide icon" loading="eager" />
			</div>
		</div>
	</section>

	<section class="list-section">
		<div class="container article-stack">
			<div class="glow-block">
				<div class="section-header decklist-header">
					<div class="decklist-title-row">
						<h2>Decklist</h2>
						<button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>Copy for Sim</button>
					</div>
				</div>
				<div class="deck-grid">
					{
						decklist.map((entry) => (
							<button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}>
								<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
								<div class="deck-info">
									<span class="deck-count">{entry.count}x</span>
									<div>
										<div class="deck-name">{entry.name}</div>
										<div class="deck-code">{entry.code}</div>
									</div>
								</div>
								<span class="deck-role">{entry.role}</span>
							</button>
						))
					}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Curve Guide</h2>
					</div>
				</div>

				<div class="curve-guide-block">
					<h3>Go First</h3>
					<p class="curve-heading-copy">Going first is your best start. It allows you to drop Linlin on turn 4 optimizing ramping and board pressure</p>
					<div class="curve-rows">
						{goFirst.map((slot) => (
							<div class="curve-row">
								<div class="curve-label">{slot.label}</div>
								<div class="curve-cards">
									{slot.cards.map((entry, index) => (
										<>
											{index > 0 && <span class="curve-join">+</span>}
											<button class={`mini-card curve-card ${entry.rested ? "is-rested" : ""} ${entry.card.code === "OP09-062" ? "curve-card-leader" : ""}`} type="button" data-card-preview data-full={entry.card.img} data-name={`${entry.card.code} ${entry.card.name}`}>
												<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
											</button>
										</>
									))}
								</div>
								<p class="curve-note">{slot.text}</p>
							</div>
						))}
					</div>
				</div>

				<div class="curve-guide-block">
					<h3>Go Second</h3>
					<div class="curve-rows">
						{goSecond.map((slot) => (
							<div class="curve-row">
								<div class="curve-label">{slot.label}</div>
								<div class="curve-cards">
									{slot.cards.map((entry, index) => (
										<>
											{index > 0 && <span class="curve-join">+</span>}
											<button class={`mini-card curve-card ${entry.rested ? "is-rested" : ""} ${entry.card.code === "OP09-062" ? "curve-card-leader" : ""}`} type="button" data-card-preview data-full={entry.card.img} data-name={`${entry.card.code} ${entry.card.name}`}>
												<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
											</button>
										</>
									))}
								</div>
								<p class="curve-note">{slot.text}</p>
							</div>
						))}
					</div>
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Hybrid Tactics &amp; Combos</h2>
					</div>
				</div>
				<div class="mind-games-grid">
					<button class="detail-card mind-game-hero" type="button" data-card-preview data-full={leader.img} data-name={`${leader.code} ${leader.name}`}>
						<img src={leader.img} alt={`${leader.code} ${leader.name}`} loading="lazy" />
					</button>
					<div class="mind-games-copy">
						<div class="mind-game-block">
							<h3>The Banish Threat</h3>
							<p>Robin's built in Banish is a psychological weapon.</p>
							<p>
								Opponents hate taking Banish damage, so they will waste Counters early just to block your
								5000 power Leader attacks. This drains their hand extremely fast.
							</p>
						</div>
						<div class="mind-game-block">
							<h3>Gum Gum Giant Abuse</h3>
							<p>Since you run Purple, you have access to the 1 cost Gum Gum Giant event.</p>
							<p>
								It gives +4000 Power for free just by trashing a brick from your hand, letting you defend
								your board
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Deck In A Nutshell</h2>
					</div>
				</div>
				<div class="core-panel">
					<div class="section-tag section-tag-light">The Mechanic</div>
					<p class="nutshell-copy">
						The "Rope-a-Dope" Strategy. Drag your opponent into deep waters. Spam your board with
						4k-Power Trigger characters that punish the opponent for KO'ing them. Then, drop the 10c
						Linlin to magically buff all your 4k bodies into 8k Bosses for massive lethal swings.
					</p>
				</div>
				<div class="nutshell-grid">
					<div class="info-panel">
						<div class="section-tag section-tag-light">Strength</div>
						<ul class="summary-list">{strengths.map((item) => <li>{item}</li>)}</ul>
					</div>
					<div class="info-panel">
						<div class="section-tag section-tag-light">Weakness</div>
						<ul class="summary-list">{weaknesses.map((item) => <li>{item}</li>)}</ul>
					</div>
				</div>
				<div class="core-panel">
					<div class="section-tag section-tag-light">The Core Engine</div>
					<ul class="summary-list">{coreEngine.map((item) => <li>{item}</li>)}</ul>
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Matchups</h2>
					</div>
				</div>
				<div class="matchup-grid">
					{
						matchupGroups.map((group) => (
							<div class="matchup-card">
								<div class={`matchup-badge matchup-${group.tone}`}>{group.title}</div>
								<div class="matchup-cards">
									{
										group.entries.map((entry) => (
											<div class="matchup-entry">
												<img src={entry.image} alt={entry.name} loading="lazy" />
												<div class="matchup-name">{entry.name}</div>
											</div>
										))
									}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true">
		<div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview">
			<button class="modal-close" type="button" data-close>Close</button>
			<img src="" alt="" data-modal-image />
		</div>
	</div>
</MainLayout>

<script>
	const previewButtons = document.querySelectorAll("[data-card-preview]");
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const closeButton = document.querySelector("[data-close]");
	const copyButtons = document.querySelectorAll("[data-copy-sim]");

	const openModal = (button) => {
		if (!modal || !modalImage) return;
		const full = button.getAttribute("data-full");
		const name = button.getAttribute("data-name") || "Card preview";
		modalImage.setAttribute("src", full);
		modalImage.setAttribute("alt", name);
		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
		document.body.style.overflow = "hidden";
	};

	const closeModal = () => {
		if (!modal || !modalImage) return;
		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
		modalImage.setAttribute("src", "");
		modalImage.setAttribute("alt", "");
		document.body.style.overflow = "";
	};

	previewButtons.forEach((button) => button.addEventListener("click", () => openModal(button)));
	closeButton?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
	document.addEventListener("keydown", (event) => { if (event.key === "Escape" && modal?.classList.contains("is-open")) closeModal(); });

	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const simDeck = button.getAttribute("data-sim-deck");
			if (!simDeck) return;
			const previous = button.textContent?.trim();
			try {
				await navigator.clipboard.writeText(simDeck);
				button.textContent = "Copied";
				window.setTimeout(() => { button.textContent = previous ?? "Copy for Sim"; }, 1800);
			} catch {
				button.textContent = "Copy failed";
				window.setTimeout(() => { button.textContent = previous ?? "Copy for Sim"; }, 1800);
			}
		});
	});
</script>

<style>
	:root {
		--first-look-accent: #b77cff;
		--first-look-accent-soft: rgba(183, 124, 255, 0.18);
		--first-look-border: rgba(183, 124, 255, 0.28);
	}

	.guide-hero { padding-top: 3.2rem; }
	.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 415px); gap: 2rem; align-items: center; }
	.hero-tags { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1rem; }
	.hero-chip {
		display: inline-flex;
		align-items: center;
		padding: 0.7rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--first-look-border);
		background: rgba(12, 17, 30, 0.85);
		color: #f3f7ff;
	}
	.hero-chip { font-size: 0.95rem; font-weight: 600; }
	.hero-chip-accent { color: var(--accent); }
	.hero-intro { max-width: 60ch; }
	.guide-icon { display: flex; justify-content: center; }
	.guide-icon img {
		width: min(415px, 100%);
		border-radius: 18px;
		border: 1px solid rgba(255,255,255,0.08);
		box-shadow: 0 30px 60px rgba(0,0,0,0.35);
	}

	.article-stack,
	.leader-details,
	.feature-block,
	.curve-guide-block,
	.curve-rows,
	.nutshell-grid,
	.info-panel,
	.core-panel {
		display: grid;
		gap: 1rem;
	}

	.glow-block {
		background: rgba(12, 17, 30, 0.9);
		border: 1px solid var(--first-look-border);
		border-radius: 26px;
		padding: 1.25rem;
		box-shadow: 0 0 0 1px rgba(183,124,255,0.16), 0 0 22px rgba(183,124,255,0.08), 0 0 52px rgba(183,124,255,0.05);
	}

	.section-tag {
		display: inline-flex;
		padding: 0.45rem 0.9rem;
		background: var(--first-look-accent-soft);
		color: #f3e8ff;
		margin-bottom: 1rem;
		border-radius: 999px;
		font-weight: 600;
	}

	.section-tag-light { font-weight: 500; }
	.detail-card, .deck-card, .mini-card { background: transparent; border: none; padding: 0; cursor: pointer; }

	.decklist-header { display: block; width: 100%; }
	.decklist-title-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		column-gap: 1rem;
		width: 100%;
	}
	.decklist-title-row h2, .curve-guide-block h3, .curve-note { margin: 0; }
	.copy-sim-button { justify-self: end; margin-left: 0; }
	.curve-heading-copy, .nutshell-copy { margin: 0; line-height: 1.6; }

	.deck-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.9rem;
		margin-top: 1rem;
	}

	.deck-card {
		background: rgba(12, 17, 30, 0.9);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: 0.75rem;
		display: grid;
		gap: 0.65rem;
		text-align: left;
		transition: transform 0.2s ease, border 0.2s ease, box-shadow 0.2s ease;
	}

	.deck-card:hover,
	.deck-card:focus-visible,
	.detail-card:hover,
	.detail-card:focus-visible,
	.mini-card:hover,
	.mini-card:focus-visible {
		transform: translateY(-4px);
		outline: none;
	}

	.deck-card img { width: 100%; max-width: 110px; margin: 0 auto; border-radius: 12px; }
	.deck-info { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; align-items: center; }
	.deck-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.22rem 0.55rem;
		border-radius: 999px;
		background: rgba(255, 107, 61, 0.12);
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.deck-name { font-size: 0.92rem; font-weight: 600; line-height: 1.25; }
	.deck-code, .deck-role { color: var(--text-300); font-size: 0.78rem; }
	.deck-role { text-transform: uppercase; letter-spacing: 1px; }

	.curve-guide-block + .curve-guide-block { margin-top: 1rem; }
	.curve-row {
		display: grid;
		gap: 0.75rem;
		padding: 1rem;
		border-radius: 22px;
		border: 1px solid var(--first-look-border);
		background: rgba(8,12,22,0.72);
	}

	.curve-label { color: var(--accent); font-weight: 700; }
	.curve-cards { display: flex; align-items: center; flex-wrap: wrap; gap: 0.9rem; justify-content: flex-start; }
	.curve-card img, .mind-game-hero img { max-width: 120px; border-radius: 14px; box-shadow: 0 16px 32px rgba(0,0,0,0.28); }
	.curve-card.is-rested img { transform: rotate(90deg); transform-origin: center; }
	.curve-card-leader.is-rested { margin-left: 0.8rem; }
	.curve-join {
		color: var(--accent);
		font-size: 1.8rem;
		font-weight: 700;
		line-height: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.1rem;
		align-self: center;
	}
	.curve-note { line-height: 1.6; }

	.mind-games-grid { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 1.25rem; align-items: start; }
	.mind-games-copy { display: grid; gap: 1rem; }
	.mind-game-block h3 { margin: 0 0 0.5rem; color: #ff8d76; font-size: 1.25rem; }
	.mind-game-block p { margin: 0; line-height: 1.6; }

	.nutshell-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.info-panel, .core-panel {
		padding: 1rem;
		border-radius: 22px;
		border: 1px solid var(--first-look-border);
		background: rgba(8,12,22,0.72);
	}
	.info-panel {
		grid-template-rows: max-content 1fr;
		align-content: start;
	}
