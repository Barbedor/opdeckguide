---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "Dracule Mihawk OP14 Deck Guide";
const description =
	"OP17 format deck guide for Dracule Mihawk OP14 with updated decklist, curve guide, 10 DON!! combo, deck in a nutshell, and matchups.";

const icon = "/assets/guides/dracule-mihawk-op14.png";

const expandSimLines = (count, code) => {
	const lines = [];
	let remaining = count;
	while (remaining > 4) {
		lines.push(`4x${code}`);
		remaining -= 4;
	}
	if (remaining > 0) lines.push(`${remaining}x${code}`);
	return lines;
};

const card = (code, name, img, count = null, role = "Character") => ({ code, name, img, count, role });

const leader = card("OP14-020", "Dracule Mihawk", "/Cards/OP14/OP14-020.jpg", 1, "Leader");
const otama = card("OP07-022", "Otama", "/Cards/OP07/OP07-022.png", 4);
const perona = card("OP12-034", "Perona", "/Cards/OP12/OP12-034.jpg", 4);
const kinemon = card("ST32-001", "Kin'emon", "/Cards/ST32/ST32-001.jpg", 4);
const vanderDecken = card("OP06-033", "Vander Decken IX", "/Cards/OP06/OP06-033.png", 4);
const kawamatsu = card("OP12-023", "Kawamatsu", "/Cards/OP12/OP12-023.jpg", 4);
const yasopp = card("OP17-031", "Yasopp", "/Cards/OP17/New OP17/OP17-031.jpg", 4);
const oden = card("ST32-002", "Kouzuki Oden", "/Cards/ST32/ST32-002.jpg", 4);
const law = card("OP13-031", "Trafalgar Law", "/Cards/OP13/OP13-031.jpg", 4);
const hody = card("OP06-035", "Hody Jones", "/Cards/OP06/OP06-035.png", 1);
const shanks = card("OP17-022", "Shanks", "/Cards/OP17/New OP17/OP17-022.jpg", 4);
const samourai = card("OP01-055", "You Can Be My Samourai!!", "/Cards/OP01/OP01-055.png", 4, "Event");
const trichiliocosm = card("OP06-038", "The Billion-fold World Trichiliocosm", "/Cards/OP06/OP06-038.png", 3, "Event");
const miniLuna = card("OP13-040", "I Know You're Strong... So I'll Go All Out from the Very Start!!!", "/Cards/OP13/OP13-040.jpg", 2, "Event");
const coffinBoat = card("OP14-039", "Coffin Boat", "/Cards/OP14/OP14-039.jpg", 2, "Stage");
const electricalLuna = card("OP08-036", "Electrical Luna", "/Cards/OP08/OP08-036.png", 2, "Event");

const decklist = [
	leader,
	otama,
	perona,
	kinemon,
	vanderDecken,
	kawamatsu,
	yasopp,
	oden,
	law,
	hody,
	shanks,
	samourai,
	trichiliocosm,
	miniLuna,
	coffinBoat,
	electricalLuna,
];

const simDeckCode = decklist.flatMap((entry) => expandSimLines(entry.count, entry.code)).join("\n");

const goFirst = [
	{ label: "1 DON!!", cards: [{ card: perona }], text: "Start with Perona so you can find the missing piece for the rest of your curve and prepare your next turns cleanly." },
	{ label: "3 DON!!", cards: [{ card: perona }, { card: otama }, { card: samourai }], text: "Play Perona and Otama to keep searching for the cards you need, then play You Can Be My Samourai!! to rest the Characters you played earlier so you can draw 2 cards." },
	{ label: "5 DON!!", cards: [{ card: yasopp }], text: "Yasopp is your clean midgame stabilizer here. He keeps your hand moving, applies pressure, and helps control a key opposing threat." },
	{ label: "7 DON!!", cards: [{ card: law }, { card: oden, rested: true }], text: "Play Trafalgar Law to return Otama to your hand so you get a +2000 Counter, then play Oden from your hand to draw 1 card and stop one of your opponent’s Characters from attacking next turn so you can slow their game plan down." },
];

const goSecond = [
	{ label: "2 DON!!", cards: [{ card: perona }, { card: otama }], text: "Play Perona and Otama to keep searching for the cards you need and prepare the rest of your curve." },
	{ label: "4 DON!!", cards: [{ card: samourai }, { card: kinemon }], text: "Play Kin'emon to draw and filter your hand, then use You Can Be My Samourai!! so you keep improving your hand quality for the next turns." },
	{ label: "6 DON!!", cards: [{ card: yasopp }], text: "At 6 DON!!, Yasopp gives you a clean midgame turn by drawing 1 card while resting an opposing threat, which helps you stay ahead on tempo." },
	{ label: "8 DON!!", cards: [{ card: law }, { card: oden, rested: true }], text: "Play Trafalgar Law to return Otama to your hand so you get a +2000 Counter, then play Oden from your hand to draw 1 card and stop one of your opponent’s Characters from attacking next turn so you can slow their game plan down." },
];

const comboSteps = [
	{
		cards: [{ card: shanks }],
		text: "For 10 DON!! Play your big Shanks. Then untap 2 DON!! and rest the opponent’s board",
	},
	{
		cards: [{ card: vanderDecken }],
		text: "Tap 2 and play Vander Decken to K.O. one big body by trashing 1 fishman from your hand (typically Kawamatsu searched by perona or otama)",
	},
	{
		cards: [{ card: vanderDecken, rested: true }],
		text: "Tap Vander Decken by leader’s effect to Untap 3 DON!!",
	},
	{
		cards: [{ card: miniLuna }, { card: electricalLuna }],
		text: "Luna or Mini Luna if necessary or leave open DON!! for defensive events",
	},
];

const strengths = [
	"Absolute board dominance: you wipe threats and generate free DON!! on the same turn.",
	"Endless card advantage through searchers, Yasopp, and events.",
];

const weaknesses = [
	"Very reliant on finding specific combo pieces in the late game (Shanks + Decken + Fishman).",
	"Vulnerable to decks that reduce base power (like Purple Linlin) if your Shanks stays rested.",
	"Can struggle if starved of cards early by smart opponents who refuse to attack your life.",
];

const coreEngine = [
	"Leader Mihawk: Rests a character to restand 3 DON!!",
	"10c Shanks & Vander Decken: The Exodia board wipe combo",
	"5c Yasopp: Draws a card, rests an 8 cost threat, and restands himself at the end of the turn.",
];

const matchupGroups = [
	{
		title: "Favorable",
		tone: "up",
		entries: [
			{ name: "Rocks.D.Xebec OP17", image: "/assets/guides/Rocks.DXebec%20op17.png" },
			{ name: "Kaido OP17", image: "/assets/guides/Kaido%20op17.png" },
			{ name: "Charlotte Linlin OP17", image: "/assets/guides/Charlotte Linlin op17.png" },
			{ name: "Monkey.D.Luffy OP17", image: "/assets/guides/Luffy OP17.png" },
			{ name: "Shanks OP17", image: "/assets/guides/Shanks%20op17.png" },
		],
	},
	{
		title: "Slightly Favorable",
		tone: "slight-up",
		entries: [
			{ name: "Luffy and Ace ST30", image: "/assets/guides/Luffy-st30.png" },
		],
	},
	{
		title: "Even",
		tone: "even",
		entries: [{ name: "Enel OP15", image: "/assets/guides/enel-op15.png" }],
	},
	{
		title: "Slightly Unfavorable",
		tone: "slight-down",
		entries: [
			{ name: "Sabo OP13", image: "/assets/guides/Sabo%20OP13-004.png" },
			{ name: "Boa Hancock OP14", image: "/assets/guides/boa-hancock-op14.png" },
		],
	},
	{
		title: "Unfavorable",
		tone: "down",
		entries: [
			{ name: "Portgas.D.Ace OP16", image: "/assets/guides/Ace-op16.png" },
			{ name: "Nico Robin OP09", image: "/assets/guides/Nico-Robin-op09.png" },
		],
	},
];
---

<MainLayout title={title} description={description}>
	<section class="hero guide-hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<div class="hero-tags">
					<span class="hero-chip">Deck Guide</span>
					<span class="hero-chip hero-chip-accent">OP17 Format</span>
				</div>
				<h1>Dracule Mihawk OP14 Deck Guide</h1>
				<p class="hero-intro">
					Be the most hated player at your locals. OP17 "Fishhawk" is the undisputed Best Deck in Format.
					Combine the oppressive control of Green Mihawk with an explosive Fishman removal package. Swipe to
					learn how to completely break the OP17 meta!
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="#curve">Curve Guide</a>
					<a class="btn btn-secondary" href="#matchups">Matchups</a>
				</div>
			</div>
			<div class="guide-icon">
				<img src={icon} alt="Dracule Mihawk OP14 deck guide icon" loading="eager" />
			</div>
		</div>
	</section>

	<section class="list-section">
		<div class="container article-stack">
			<div class="glow-block">
				<div class="section-header decklist-header">
					<div class="decklist-title-row">
						<h2>Decklist</h2>
						<button class="btn btn-primary copy-sim-button" type="button" data-copy-sim data-sim-deck={simDeckCode}>Copy for Sim</button>
					</div>
				</div>
				<div class="deck-grid">
					{
						decklist.map((entry) => (
							<button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}>
								<img src={entry.img} alt={`${entry.code} ${entry.name}`} loading="lazy" />
								<div class="deck-info">
									<span class="deck-count">{entry.count}x</span>
									<div>
										<div class="deck-name">{entry.name}</div>
										<div class="deck-code">{entry.code}</div>
									</div>
								</div>
								<span class="deck-role">{entry.role}</span>
							</button>
						))
					}
				</div>
			</div>

			<div id="curve" class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Curve Guide</h2>
					</div>
				</div>

				<div class="curve-guide-block">
					<h3>Go First</h3>
					<div class="curve-rows">
						{goFirst.map((slot) => (
							<div class="curve-row">
								<div class="curve-label">{slot.label}</div>
								<div class={`curve-cards ${slot.cards.length >= 3 ? "curve-cards-triple" : ""}`}>
									{slot.cards.map((entry, index) => (
										<>
											{index > 0 && <span class="curve-join">+</span>}
											<button class={`mini-card curve-card ${entry.rested ? "is-rested" : ""} ${entry.card.code === "ST32-002" ? "curve-card-oden" : ""}`} type="button" data-card-preview data-full={entry.card.img} data-name={`${entry.card.code} ${entry.card.name}`}>
												<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
											</button>
										</>
									))}
								</div>
								<p class="curve-note">{slot.text}</p>
							</div>
						))}
					</div>
				</div>

				<div class="curve-guide-block">
					<h3>Go Second</h3>
					<div class="curve-rows">
						{goSecond.map((slot) => (
							<div class="curve-row">
								<div class="curve-label">{slot.label}</div>
								<div class={`curve-cards ${slot.cards.length >= 3 ? "curve-cards-triple" : ""}`}>
									{slot.cards.map((entry, index) => (
										<>
											{index > 0 && <span class="curve-join">+</span>}
											<button class={`mini-card curve-card ${entry.rested ? "is-rested" : ""} ${entry.card.code === "ST32-002" ? "curve-card-oden" : ""}`} type="button" data-card-preview data-full={entry.card.img} data-name={`${entry.card.code} ${entry.card.name}`}>
												<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
											</button>
										</>
									))}
								</div>
								<p class="curve-note">{slot.text}</p>
							</div>
						))}
					</div>
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>10 DON!! Combo</h2>
					</div>
				</div>
				<div class="combo-rows">
					{comboSteps.map((step) => (
						<div class="combo-row">
							<div class="combo-cards">
								{step.cards.map((entry, index) => (
									<>
										{index > 0 && <span class="curve-join">OR</span>}
										<button class={`mini-card curve-card ${entry.rested ? "is-rested" : ""}`} type="button" data-card-preview data-full={entry.card.img} data-name={`${entry.card.code} ${entry.card.name}`}>
											<img loading="lazy" src={entry.card.img} alt={`${entry.card.code} ${entry.card.name}`} />
										</button>
									</>
								))}
							</div>
							<p class="curve-note">{step.text}</p>
						</div>
					))}
				</div>
			</div>

			<div class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Deck Overview</h2>
					</div>
				</div>
				<div class="core-panel">
					<div class="section-tag section-tag-light">The Mechanic</div>
					<p class="nutshell-copy">
						The "Shanks & Decken" Loop. You play 10c Shanks to rest your opponent's entire board and get 2
						DON!! back. You use those 2 DON!! to play Vander Decken, trashing a Fishman to instantly KO any
						rested character. Then, you rest Vander Decken with Mihawk's Leader ability to restand 3 MORE
						DON!! and push for game!
					</p>
				</div>
				<div class="nutshell-grid">
					<div class="info-panel">
						<div class="section-tag section-tag-light">Strength</div>
						<ul class="summary-list">{strengths.map((item) => <li>{item}</li>)}</ul>
					</div>
					<div class="info-panel">
						<div class="section-tag section-tag-light">Weakness</div>
						<ul class="summary-list">{weaknesses.map((item) => <li>{item}</li>)}</ul>
					</div>
				</div>
				<div class="core-panel">
					<div class="section-tag section-tag-light">The Core Engine</div>
					<ul class="summary-list">{coreEngine.map((item) => <li>{item}</li>)}</ul>
				</div>
			</div>

			<div id="matchups" class="glow-block feature-block">
				<div class="section-header feature-header">
					<div>
						<h2>Matchups</h2>
						<p class="matchup-stats-link">
							For the complete turn-order win rate breakdown, see the
							<a href="/meta-analysis/Green-Dracule-Mihawk-op14-stats-OP17-Format/">Dracule Mihawk OP14 stats in OP17 Format</a>.
						</p>
					</div>
				</div>
				<div class="matchup-grid">
					<div class="matchup-column">
						{matchupGroups.slice(0, 1).map((group) => (
							<div class="matchup-card">
								<div class={`matchup-badge matchup-${group.tone}`}>{group.title}</div>
								<div class="matchup-cards">
									{group.entries.map((entry) => (
										<div class="matchup-entry">
											<img class={entry.name === "Nico Robin OP09" ? "nico-robin-matchup-image" : undefined} src={entry.image} alt={entry.name} loading="lazy" />
											<div class="matchup-name">{entry.name}</div>
										</div>
									))}
								</div>
							</div>
						))}
					</div>
					<div class="matchup-column">
						{matchupGroups.slice(1).map((group) => (
							<div class="matchup-card">
								<div class={`matchup-badge matchup-${group.tone}`}>{group.title}</div>
								<div class="matchup-cards">
									{group.entries.map((entry) => (
										<div class="matchup-entry">
											<img class={entry.name === "Nico Robin OP09" ? "nico-robin-matchup-image" : undefined} src={entry.image} alt={entry.name} loading="lazy" />
											<div class="matchup-name">{entry.name}</div>
										</div>
									))}
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true">
		<div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview">
			<button class="modal-close" type="button" data-close>Close</button>
			<img src="" alt="" data-modal-image />
		</div>
	</div>
</MainLayout>

<script>
	const previewButtons = document.querySelectorAll("[data-card-preview]");
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const closeButton = document.querySelector("[data-close]");
	const copyButtons = document.querySelectorAll("[data-copy-sim]");

	const openModal = (button) => {
		if (!modal || !modalImage) return;
		const full = button.getAttribute("data-full");
		const name = button.getAttribute("data-name") || "Card preview";
		modalImage.setAttribute("src", full);
		modalImage.setAttribute("alt", name);
		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
		document.body.style.overflow = "hidden";
	};

	const closeModal = () => {
		if (!modal || !modalImage) return;
		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
		modalImage.setAttribute("src", "");
		modalImage.setAttribute("alt", "");
		document.body.style.overflow = "";
	};

	previewButtons.forEach((button) => button.addEventListener("click", () => openModal(button)));
	closeButton?.addEventListener("click", closeModal);
	modal?.addEventListener("click", (event) => { if (event.target === modal) closeModal(); });
	document.addEventListener("keydown", (event) => { if (event.key === "Escape" && modal?.classList.contains("is-open")) closeModal(); });

	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const simDeck = button.getAttribute("data-sim-deck");
			if (!simDeck) return;
			const previous = button.textContent?.trim();
			try {
				await navigator.clipboard.writeText(simDeck);
				button.textContent = "Copied";
				window.setTimeout(() => { button.textContent = previous ?? "Copy for Sim"; }, 1800);
			} catch {
				button.textContent = "Copy failed";
				window.setTimeout(() => { button.textContent = previous ?? "Copy for Sim"; }, 1800);
			}
		});
	});
</script>

<style>
	:root {
		--first-look-accent: #46c269;
		--first-look-accent-soft: rgba(70, 194, 105, 0.18);
		--first-look-border: rgba(70, 194, 105, 0.28);
	}

	.guide-hero { padding-top: 3.2rem; }
	.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 415px); gap: 2rem; align-items: center; }
	.hero-tags { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1rem; }
	.hero-chip {
		display: inline-flex;
		align-items: center;
		padding: 0.7rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--first-look-border);
		background: rgba(12, 17, 30, 0.85);
		color: #f3f7ff;
	}
	.hero-chip { font-size: 0.95rem; font-weight: 600; }
	.hero-chip-accent { color: var(--accent); }
	.hero-intro { max-width: 60ch; }
	.guide-icon { display: flex; justify-content: center; }
	.guide-icon img { width: min(415px, 100%); border-radius: 18px; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 30px 60px rgba(0,0,0,0.35); }

	.article-stack, .feature-block, .curve-guide-block, .curve-rows, .combo-rows, .nutshell-grid, .info-panel, .core-panel {
		display: grid;
		gap: 1rem;
	}

	.glow-block {
		background: rgba(12, 17, 30, 0.9);
		border: 1px solid var(--first-look-border);
		border-radius: 26px;
		padding: 1.25rem;
		box-shadow: 0 0 0 1px rgba(70,194,105,0.16), 0 0 22px rgba(70,194,105,0.08), 0 0 52px rgba(70,194,105,0.05);
	}

	.section-tag {
		display: inline-flex;
		padding: 0.45rem 0.9rem;
		background: var(--first-look-accent-soft);
		color: #eafff0;
		margin-bottom: 1rem;
		border-radius: 999px;
		font-weight: 600;
	}
	.section-tag-light { font-weight: 500; }

	.detail-card, .deck-card, .mini-card { background: transparent; border: none; padding: 0; cursor: pointer; }
	.decklist-header { display: block; width: 100%; }
	.decklist-title-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		column-gap: 1rem;
		width: 100%;
	}
	.decklist-title-row h2, .curve-guide-block h3, .curve-note { margin: 0; }
	.copy-sim-button { justify-self: end; margin-left: 0; }

	.deck-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.9rem;
		margin-top: 1rem;
	}
	.deck-card {
		background: rgba(12, 17, 30, 0.9);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: 0.75rem;
		display: grid;
		gap: 0.65rem;
		text-align: left;
		transition: transform 0.2s ease, border 0.2s ease, box-shadow 0.2s ease;
	}
	.deck-card:hover, .deck-card:focus-visible, .mini-card:hover, .mini-card:focus-visible {
		transform: translateY(-4px);
		outline: none;
	}
	.deck-card img { width: 100%; max-width: 110px; margin: 0 auto; border-radius: 12px; }
	.deck-info { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; align-items: center; }
	.deck-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.22rem 0.55rem;
		border-radius: 999px;
		background: rgba(255, 107, 61, 0.12);
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
	}
	.deck-name { font-size: 0.92rem; font-weight: 600; line-height: 1.25; }
	.deck-code, .deck-role { color: var(--text-300); font-size: 0.78rem; }
	.deck-role { text-transform: uppercase; letter-spacing: 1px; }

	.curve-guide-block + .curve-guide-block { margin-top: 1rem; }
	.curve-row, .combo-row {
		display: grid;
		gap: 0.75rem;
		padding: 1rem;
		border-radius: 22px;
		border: 1px solid var(--first-look-border);
		background: rgba(8,12,22,0.72);
	}
	.curve-label { color: var(--accent); font-weight: 700; }
	.curve-cards, .combo-cards { display: flex; align-items: center; flex-wrap: wrap; gap: 0.9rem; justify-content: flex-start; }
