---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCardThumbnail } from "../../lib/assets";

const title = "Ms. All Sunday OP18 Deck Guide";
const description = "OP18 Ms. All Sunday deck guide with decklist, mulligan priorities, curve guide, tech cards, matchups, and gameplay tips.";
const guideIcon = "/assets/guides/Ms.%20All%20Sunday%20OP18.png";
const card = (code, name, file, count = null, role = "Character") => ({ code, name, img: `/Cards/${file}`, count, role });

const leader = card("OP18-041", "Ms. All Sunday", "OP18/OP18-041 Ms. All Sunday.jpg", 1, "Leader");
const mr3Search = card("OP09-056", "Mr.3 (Galdino)", "OP09/OP09-056.jpg", 4);
const mr1 = card("OP18-047", "Mr.1 (Daz.Bonez)", "OP18/OP18-047 Mr.1 (Daz.Bonez).jpg", 2);
const mr4 = card("OP18-051", "Mr.4 & Miss MerryChristmas", "OP18/OP18-051 Mr4 and Miss.MerryChristmas.jpg", 4);
const mr7 = card("OP18-053", "Mr.7 & Miss Father's Day", "OP18/OP18-053 Mr. 7 and Ms. Fathersday.jpg", 4);
const mr8 = card("OP18-054", "Mr.8 & Ms. Monday", "OP18/OP18-054 Mr.8 and Ms. Monday .jpg", 4);
const beans = card("OP18-044", "Mr.Beans & Miss.Catherina", "OP18/OP18-044 Mr.Beans and Miss.Katherina.jpg", 4);
const mr3Delay = card("OP16-056", "Mr.3 (Galdino)", "OP16/OP16-056.jpg", 4);
const bonKurei = card("OP18-049", "Mr.2 Bon Kurei (Bentham)", "OP18/OP18-049 Mr. 2 Bon Kurei (Bentham).jpg", 4);
const goldenweek = card("OP18-050", "Mr.3 & Miss Goldenweek", "OP18/OP18-050 Mr. 3 and Ms. Goldenweek .jpg", 4);
const mr5 = card("OP18-052", "Mr.5 & Miss Valentine", "OP18/OP18-052 Mr.5 and Miss.Valentine.jpg", 4);
const doublefinger = card("OP18-048", "Mr.1 & Miss Doublefinger", "OP18/OP18-048 Mr.1 and Ms Doublefinger.jpg", 4);
const mr0 = card("OP18-046", "Mr.0 & Ms. All Sunday", "OP18/OP18-046 Mr. 0 and Ms All Sunday.jpg", 4);
const event = card("OP18-059", "I Pray For Your Success!", "OP18/OP18-059 I Pray For Your Success !.jpg", 4, "Event");
const karooLeader = card("OP18-001", "Karoo", "OP18/OP18-001 Karoo .jpg", null, "Leader");
const gunkoLeader = card("OP18-060", "Saint Gunko", "OP18/OP18-060 Saint Gunko.jpg", null, "Leader");
const buggyLeader = card("OP09-042", "Buggy", "OP09/OP09-042.jpg", null, "Leader");
const decklist = [leader, mr3Search, mr1, mr4, mr7, mr8, beans, mr3Delay, bonKurei, goldenweek, mr5, doublefinger, mr0, event];
const simDeckCode = decklist.flatMap((entry) => {
  const lines = []; let remaining = entry.count;
  while (remaining > 4) { lines.push(`4x${entry.code}`); remaining -= 4; }
  if (remaining > 0) lines.push(`${remaining}x${entry.code}`);
  return lines;
}).join("\n");
const mulligan = [
  { title: "Build Your Board Early", cards: [], paragraphs: ["You want to set up consistent board development from the first turns. Ms. All Sunday relies on multiplying Baroque Works Characters to make the most of OP18-046 Mr. 0 & Ms. All Sunday in the late game.", "You should therefore prioritize a hand with a Searcher, Characters for your early game, and development options for your mid game."] },
  { title: "OP09-056 Mr.3 (Galdino)", cards: [mr3Search], paragraphs: ["Mr.3 (Galdino) is your main card to look for.", "This Searcher helps you find the pieces needed to complete your curve. If your hand is short on Characters to play in the early or mid game, prioritize those when searching.", "Conversely, if you already have good development options, you can pick up OP18-046 Mr. 0 & Ms. All Sunday to secure your late game."] },
  { title: "OP18-044 Mr.Beans & Miss.Catherina", cards: [beans], paragraphs: ["Mr.Beans & Miss.Catherina is an excellent option for your early game.", "Its effect lets you draw a card and then discard one, helping you refresh your hand.", "With its 1000 Power bonus when a DON!! is attached, it is also an interesting attacker for later turns. This lets you start putting pressure on your opponent without investing much DON!! in your attacks."] },
  { title: "OP18-052 Mr.5 & Miss Valentine", cards: [mr5], paragraphs: ["Mr.5 & Miss Valentine is especially interesting if you already have a 3-Cost Character to play with it.", "It lets you play two Characters during the same turn, including Mr.Beans & Miss.Catherina so you can also benefit from its draw effect.", "However, Mr.5 & Miss Valentine has a 2000 Counter. If your hand already has enough development options, you can keep it in hand to defend your Leader instead of always playing it."] },
  { title: "OP18-048 Mr.1 & Miss Doublefinger", cards: [doublefinger], paragraphs: ["Mr.1 & Miss Doublefinger is one of your best mid-game options, especially when you go second.", "With its Rush effect and ability to play an additional Character, it lets you develop your board while continuing to pressure your opponent.", "A particularly interesting combination is to play OP18-050 Mr. 3 & Miss Goldenweek with it. You get an additional Blocker while preventing an opposing Character with a Cost of 7 or less from attacking during their next turn.", "This sequence is especially useful when your opponent starts developing dangerous Characters and you need to slow their pressure before your late game."] },
  { title: "OP18-046 Mr. 0 & Ms. All Sunday", cards: [mr0], paragraphs: ["Mr. 0 & Ms. All Sunday is your main late-game card.", "Its effect lets you draw two cards and attach two DON!! to your Leader and each of your other Characters. It turns your board into a series of powerful attacks while letting you strengthen your Leader to 7000 Power during your opponent's turn.", "You can keep one copy in your opening hand if you already have enough cards to ensure your development.", "However, avoid keeping multiple copies at the expense of your early- and mid-game cards. Without enough Characters on the board, you will not be able to make full use of its effect."] },
  { title: "OP18-059 I Pray For Your Success!", cards: [event], paragraphs: ["This Event can also help when your hand is missing an important piece.", "By using its draw effect for 1 DON!!, you can discard a Baroque Works card from your hand to draw two cards and look for a Character you need for your next turn.", "However, it is still better to start with a hand that can naturally follow your curve rather than depend on this Event to find your development cards."] },
];

const curveFirst = [
  { title: "1 DON!! — Mr.3 (Galdino)", cards: [mr3Search], paragraphs: ["Ideally, start with OP09-056 Mr.3 (Galdino) to search for the missing pieces in your hand.", "If you already have your early-game Characters, you can pick up OP18-046 Mr. 0 & Ms. All Sunday directly. Otherwise, prioritize a card that will let you follow your curve next turn."] },
  { title: "3 DON!! — Mr.Beans & Miss.Catherina", cards: [beans], paragraphs: ["OP18-044 Mr.Beans & Miss.Catherina is an excellent option at this point in the game.", "You start building your board while refreshing your hand with its draw effect. This Character can then join your attacks with a limited DON!! investment thanks to its Power bonus."] },
  { title: "5 DON!! — Mr.5 & Miss Valentine", cards: [mr5, beans, goldenweek, mr3Delay], connectors: ["+", "OR", "OR"], paragraphs: ["OP18-052 Mr.5 & Miss Valentine lets you accelerate your development by playing an additional 3-Cost Character from your hand.", "You can play Mr.Beans & Miss.Catherina with it to benefit from its draw effect and, in doing so, add two Characters to your board during the same turn.", "If your opponent already has a major threat, you can also use OP18-050 Mr. 3 & Miss Goldenweek to play a Blocker while preventing an opposing Character with a Cost of 7 or less from attacking.", "OP16-056 Mr.3 (Galdino) is another option if you want to prepare a delay effect for the next turns."] },
  { title: "7 DON!! — Develop or Remove", cards: [doublefinger, goldenweek, mr4], connectors: ["+", "OR"], paragraphs: ["At 7 DON!!, you have two main options depending on the state of your opponent's board.", "**OP18-048 Mr.1 & Miss Doublefinger → OP18-050 Mr. 3 & Miss Goldenweek**", "This combination lets you play two Characters, get an additional attack from Mr.1 & Miss Doublefinger's Rush, and temporarily neutralize an opposing threat.", "It is an excellent option for completing your board before your next turn.", "**OP18-051 Mr.4 & Miss MerryChristmas**", "If your opponent has several problematic Characters, you can play Mr.4 & Miss MerryChristmas and pay an additional 5 DON!! for its effect to Bottom Deck a Character with a Cost of 6 or less and a Character with a Cost of 5 or less.", "This considerably slows your opponent's development while adding a Character to your own board, unlike a standard Removal Event."] },
  { title: "9 DON!! — Mr. 0 & Ms. All Sunday", cards: [mr0], paragraphs: ["OP18-046 Mr. 0 & Ms. All Sunday is your main late-game turn.", "Its effect lets you draw two cards and attach two DON!! to your Leader and each of your other Characters.", "With the Power bonuses your Baroque Works Characters get when a DON!! is attached, you can make a series of attacks at 6000, 7000, or 8000 Power without investing your DON!! individually.", "It also strengthens your Leader to 7000 Power during your opponent's turn, forcing your opponent to invest more resources in their attacks.", "Try to keep as many Characters capable of attacking as possible to make full use of this turn."] },
];
const curveSecond = [
  { title: "2 DON!! — Search", cards: [mr3Search, mr7], connectors: ["OR"], paragraphs: ["As when going first, use OP09-056 Mr.3 (Galdino) to prepare your curve.", "You can also play Mr. 7 & Miss. Father's Day to rearrange the cards in your deck if you do not have a Searcher in hand."] },
  { title: "4 DON!! — Prepare Your Mid Game", cards: [mr3Delay], paragraphs: ["This turn lets you start developing your board before playing Mr.1 & Miss Doublefinger.", "OP16-056 Mr.3 (Galdino) is an interesting option. You can play it now so you have its delay and draw effect available when your opponent starts playing their big threats.", "You can also keep playing your small Characters or search for the pieces you need for your next turn."] },
  { title: "6 DON!! — Mr.1 & Miss Doublefinger", cards: [doublefinger, goldenweek], connectors: ["+"], paragraphs: ["This is one of the main advantages of going second.", "OP18-048 Mr.1 & Miss Doublefinger lets you play multiple Characters while adding an attack with its Rush.", "You can play OP18-050 Mr. 3 & Miss Goldenweek with it to get an additional Blocker and prevent an opposing Character from attacking.", "This combination lets you start applying offensive pressure while limiting your opponent's options."] },
  { title: "8 DON!! — Complete Your Board", cards: [doublefinger, mr4], connectors: ["OR"], paragraphs: ["You cannot play Mr. 0 & Ms. All Sunday yet, but this turn lets you prepare even more for its arrival.", "You can use Mr.1 & Miss Doublefinger to keep playing multiple Characters or Mr.4 & Miss MerryChristmas if you need to manage your opponent's board.", "If your board is already sufficiently full, prioritize actions that let you keep your Characters and prepare as many attacks as possible for the next turn."] },
  { title: "10 DON!! — Mr. 0 & Ms. All Sunday", cards: [mr0], paragraphs: ["You can finally play your 9-Cost card while keeping one additional DON!! available.", "If you have not found OP18-046 Mr. 0 & Ms. All Sunday yet, you can use OP09-056 Mr.3 (Galdino) before playing it.", "The DON!! used for your Searcher can then be reused with Mr. 0 & Ms. All Sunday's effect, which attaches DON!! in Rested state.", "If your board is complete, you can strengthen your Leader and your other Characters at the same time to apply significant pressure."] },
];

const techCards = [
  { card: mr1, title: "OP18-047 Mr.1 (Daz.Bonez) — Unblockable", paragraphs: ["Mr.1 lets you make one of your Leader's attacks Unblockable, which is an excellent way to finish the game against decks with many Blockers.", "This card lets you get around your opponent's defense. Even if your opponent still has several Active Blockers, they will have to use Counters to survive your Leader's attack.", "When your opponent is at 0 Life, start by attacking with your other Characters to reduce the defensive resources in their hand, then finish with a big Unblockable attack from your Leader.", "Mr.1 also has a 2000 Counter, but it is sometimes better to keep it in hand rather than use it to defend, especially if you think you can finish the game next turn."] },
  { card: event, title: "OP18-059 I Pray For Your Success! — Counter & Card Draw", paragraphs: ["This Event gives you interesting flexibility through its two uses.", "**Main:** By using 1 DON!! and discarding a card from your hand, you can draw two cards.", "**Counter:** For 0 DON!!, you can discard a card from your hand to get a 3000 Power bonus during a battle.", "The first effect is especially interesting when you absolutely need to find a missing piece for your next turn.", "For example, if you have not found OP18-048 Mr.1 & Miss Doublefinger or OP18-046 Mr. 0 & Ms. All Sunday yet, you can use this Event to refresh your hand.", "Remember to keep enough cards in hand to pay its discard costs. This Event's value comes more from its flexibility and ability to refresh your resources than from a true card advantage."] },
  { card: mr3Delay, title: "OP16-056 Mr.3 (Galdino) — Delay", paragraphs: ["Unlike OP18-050 Mr. 3 & Miss Goldenweek, you can play this Mr.3 before your opponent plays their main threat.", "You can then wait for the right moment to use its effect, draw two cards, and prevent an opposing Character with a Cost of 9 or less from attacking during their next turn.", "This lets you anticipate your opponent's big development turns.", "Its effect is also useful when your board starts running out of space: you can free up a slot while refreshing your hand and slowing your opponent down."] },
  { card: mr4, title: "OP18-051 Mr.4 & Miss MerryChristmas — Situational Removal", paragraphs: ["One of the main benefits of Mr.4 & Miss MerryChristmas is using it against Characters whose On K.O. effects you want to avoid.", "By sending them to the bottom of the deck instead of K.O.'ing them, you can get around those effects. This is especially valuable against strategies that benefit from their own Characters being K.O.'d.", "However, this card is much less useful against decks that mainly play high-Cost Characters or have protection against Removal.", "Against Buggy, for example, the big Characters played with its Leader and the protection from ST25-003 Crocodile & Mihawk can considerably limit your Removal options.", "In this situation, feel free to use Mr.4 & Miss MerryChristmas as a 1000 Counter rather than keep it while waiting for an opportunity that may never come."] },
];

const matchups = [
  { title: "OP18 Karoo", leader: karooLeader, intro: "Karoo can apply significant pressure with its Characters that have Rush and Banish. Ms. All Sunday, however, has several tools to slow its attacks and prepare for the late game.", bullets: ["Neutralize Characters with Banish. Use OP16-056 Mr.3 (Galdino) or OP18-050 Mr. 3 & Miss Goldenweek to prevent opposing threats from attacking. This way, you avoid losing Life to Banish attacks that would trash those cards instead of adding them to your hand.", "Adjust your attack Power to opposing Blockers. Avoid 5000-Power attacks if your opponent has a 6000-Power Blocker that can stop them for free. Investing a few additional DON!! may force them to use Counter.", "Make use of your Leader at 7000 Power. Once Mr. 0 & Ms. All Sunday is on the board, opposing attacks become much less threatening. Karoo has to invest more DON!! to get its Rush or Banish attacks through.", "Save Mr.1 (Daz.Bonez) to finish the game. Karoo may have several Blockers, including Vivi. Your Unblockable attack lets you get around this defense when your opponent is at 0 Life."] },
  { title: "OP18 Gunko", leader: gunkoLeader, intro: "This matchup has an interesting feature: both Leaders make K.O.'ing their Characters unfavorable for the opponent. Gunko can recover some of its Characters, while Ms. All Sunday forces the opponent to discard a card when they K.O. your Characters.", bullets: ["Prioritize delaying big threats. Mr. 3 & Miss Goldenweek lets you prevent Killingham from attacking without having to K.O. it.", "Avoid focusing your attacks unnecessarily on Shamrock. Its ability to return to the board makes destroying it less worthwhile. You can instead use your attacks to pressure the opposing Leader.", "Protect your Characters when it costs you very little Counter. Even though your Leader rewards you when your Characters are K.O.'d, keeping your attackers is still essential to make use of your Mr. 0 & Ms. All Sunday play.", "Watch out for Killingham's effects. Its ability to prevent some of your Characters from attacking can considerably reduce the effectiveness of your 9- or 10-DON!! turn. Before playing Mr. 0 & Ms. All Sunday, check how many of your Characters will actually be able to benefit from its DON!! attachments."] },
  { title: "OP09 Buggy", leader: buggyLeader, intro: "Buggy has particularly powerful board development and several big Characters that are difficult to manage. Its Bottom Deck effects are also a major threat to Ms. All Sunday.", bullets: ["Do not rely too much on Mr.4 & Miss MerryChristmas. The big Characters played with Buggy's Leader often exceed its Cost restrictions. In addition, ST25-003 Crocodile & Mihawk can protect its Characters from your Removal. You can therefore prioritize using it as a 1000 Counter.", "Attack the Characters needed for OP09-051 Buggy. If your opponent has exactly four Characters with a Cost of 5 or more, removing one can prevent them from playing their 10-Cost Buggy in good conditions. Even if your attack does not go through, you can force them to use Counters to keep their board.", "Anticipate the Bottom Deck effect on Mr. 0 & Ms. All Sunday. OP09-051 Buggy can remove your 9-Cost card before your opponent even starts attacking, preventing you from strengthening your Leader to 7000 Power. Unlike a K.O., Bottom Decking does not trigger your Ms. All Sunday Leader effect.", "Use Unblockable to get around Buggy's many Blockers. Between Dracule Mihawk and the other Cross Guild Blockers, your opponent may have significant defense even at 0 Life. Start by attacking with your Characters to use up their Counters, then use OP18-047 Mr.1 (Daz.Bonez) to finish with a big attack from your Leader."] },
];
const tips = [
  { cards: [leader, mr0], text: "Your Leader effect lets you draw a card while forcing your opponent to discard one when your Characters are K.O.'d. It is therefore not always necessary to use a lot of Counter to save a small Character. You can accept losing it if that lets you keep your defensive resources. Conversely, if you are preparing a turn with Mr. 0 & Ms. All Sunday, protecting your Characters becomes more valuable so you keep as many attackers as possible." },
  { cards: [beans, mr7, mr8], text: "Several of your Characters get a 1000 Power bonus when a DON!! is attached. Take advantage of this to make multiple 5000- or 6000-Power attacks without investing too much DON!!. This lets you apply constant pressure to your opponent while keeping enough resources to develop your board." },
  { cards: [leader], text: "Your Leader rewards you when your Characters are K.O.'d, but not when an opposing effect sends them directly to the bottom of the deck or to the Trash. Against decks with this kind of Removal, your opponent can reduce your board without suffering the consequences of your Leader effect. It is especially important to make use of your Characters to attack before they are removed." },
  { cards: [mr0], text: "Avoid playing your 9-Cost card onto a board that is too undeveloped. Its offensive potential depends directly on how many Characters can attack during that turn. Also consider opposing effects that prevent your Characters from attacking. A full board does not guarantee a good offensive turn if several of your Characters are neutralized." },
  { cards: [mr3Delay, goldenweek], text: "You do not need to remove every opposing Character to gain the advantage. Use your different Mr.3 cards to prevent big opposing Characters from attacking while you continue developing your board. This can buy you the time needed to prepare a decisive offensive turn without investing all your resources in Removal." },
  { cards: [mr1, doublefinger], text: "Even if your opponent still has several Blockers, you can finish the game with Mr.1 (Daz.Bonez) and its Unblockable attack. Also remember Mr.1 & Miss Doublefinger's Rush when calculating your available attacks. Your opponent may think they are sufficiently protected against your current board without anticipating this additional attack." },
];
const renderText = (text) => text.split(/(\*\*.*?\*\*)/g);
---

<MainLayout title={title} description={description}>
  <section class="hero guide-hero"><div class="container hero-grid"><div class="hero-copy"><div class="hero-tags"><span class="hero-chip">Deck Guide</span><span class="hero-chip hero-chip-accent">OP18 Format</span></div><h1>Ms. All Sunday OP18 Deck Guide</h1><p class="hero-intro">You want to set up consistent board development from the first turns. Ms. All Sunday relies on multiplying Baroque Works Characters to make the most of OP18-046 Mr. 0 &amp; Ms. All Sunday in the late game.</p><div class="hero-actions"><a class="btn btn-primary" href="#curve">Game Plan &amp; Curve</a><a class="btn btn-secondary" href="#matchups">Matchups</a><a class="btn btn-secondary btn-card-list" href="/cards-list/OP18/">Card List OP18</a></div></div><div class="guide-icon"><img src={guideIcon} alt="Ms. All Sunday OP18 deck guide icon" loading="eager" /></div></div></section>
  <div class="container article-stack">
    <section id="decklist" class="glow-block"><div class="decklist-title-row"><h2>Decklist</h2><button class="btn btn-primary copy-sim-button" type="button" data-copy-sim={simDeckCode}>Copy for Sim</button></div><div class="deck-grid">{decklist.map((entry) => <button class="deck-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy"/><div class="deck-info"><b class="deck-count">{entry.count}x</b><span>{entry.name}<small class="deck-code">{entry.code}</small><small class="deck-role">{entry.role}</small></span></div></button>)}</div></section>
    <section id="mulligan" class="glow-block"><h2>Mulligan</h2><p>You want to set up consistent board development from the first turns. Ms. All Sunday relies on multiplying Baroque Works Characters to make the most of OP18-046 Mr. 0 &amp; Ms. All Sunday in the late game.</p><p>You should therefore prioritize a hand with a Searcher, Characters for your early game, and development options for your mid game.</p><div class="content-list">{mulligan.slice(1).map((item) => <article class="content-item has-cards"><h3>{item.title}</h3><div class="card-row">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy"/></button>)}</div><div class="paragraphs">{item.paragraphs.map((text) => <p>{renderText(text).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2,-2)}</strong> : part)}</p>)}</div></article>)}</div></section>
    <section id="curve" class="glow-block"><h2>Game Plan &amp; Curve</h2><p>Ms. All Sunday has several development options depending on whether you go first or second. Going first lets you play Mr. 0 &amp; Ms. All Sunday on your 9 DON!! turn, while going second lets you play Mr.1 &amp; Miss Doublefinger on your 6 DON!! turn.</p>{[["Going First", curveFirst], ["Going Second", curveSecond]].map(([heading, curve]) => <div class="curve-block"><h3>{heading}</h3>{curve.map((item) => <article class="curve-item"><strong>{item.title}</strong><div class="curve-content">{item.cards.length === 4 ? <div class="four-card-lines"><div class="four-card-line"><button class="mini-card" type="button" data-card-preview data-full={item.cards[0].img} data-name={`${item.cards[0].code} ${item.cards[0].name}`}><img src={getCardThumbnail(item.cards[0].img)} alt={`${item.cards[0].code} ${item.cards[0].name}`} loading="lazy"/></button><span class="connector">{item.connectors?.[0]}</span><button class="mini-card" type="button" data-card-preview data-full={item.cards[1].img} data-name={`${item.cards[1].code} ${item.cards[1].name}`}><img src={getCardThumbnail(item.cards[1].img)} alt={`${item.cards[1].code} ${item.cards[1].name}`} loading="lazy"/></button></div><div class="four-card-line"><span class="connector">{item.connectors?.[1]}</span><button class="mini-card" type="button" data-card-preview data-full={item.cards[2].img} data-name={`${item.cards[2].code} ${item.cards[2].name}`}><img src={getCardThumbnail(item.cards[2].img)} alt={`${item.cards[2].code} ${item.cards[2].name}`} loading="lazy"/></button><span class="connector">{item.connectors?.[2]}</span><button class="mini-card" type="button" data-card-preview data-full={item.cards[3].img} data-name={`${item.cards[3].code} ${item.cards[3].name}`}><img src={getCardThumbnail(item.cards[3].img)} alt={`${item.cards[3].code} ${item.cards[3].name}`} loading="lazy"/></button></div></div> : <div class={`card-set ${item.connectors?.length ? "connected" : ""}`}>{item.cards.map((entry, index) => <>{index > 0 && item.connectors?.[index - 1] && <span class="connector">{item.connectors[index - 1]}</span>}<button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy"/></button></>)}</div>}<div class="curve-note">{item.paragraphs.map((text) => <p>{renderText(text).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2,-2)}</strong> : part)}</p>)}</div></div></article>)}</div>)}<p>Going First or Going Second? Both curves have advantages. Going first gives you access to your 9-Cost card sooner, while going second lets you play Mr.1 &amp; Miss Doublefinger at 6 DON!! and gives you an extra turn to complete your board before your late game. At this point, neither option is clearly better.</p></section>
    <section id="tech-cards" class="glow-block"><h2>Tech Cards</h2><div class="content-list">{techCards.map((item) => <article class="tech-card"><button class="mini-card tech-card-image" type="button" data-card-preview data-full={item.card.img} data-name={`${item.card.code} ${item.card.name}`}><img src={getCardThumbnail(item.card.img)} alt={`${item.card.code} ${item.card.name}`} loading="lazy"/></button><h3>{item.title}</h3><div class="paragraphs">{item.paragraphs.map((text) => <p>{renderText(text).map((part) => part.startsWith("**") && part.endsWith("**") ? <strong>{part.slice(2,-2)}</strong> : part)}</p>)}</div></article>)}</div></section>
    <section id="matchups" class="glow-block"><h2>Matchups</h2><div class="content-list">{matchups.map((item) => <article class="content-item matchup-card"><div class="matchup-heading"><button class="mini-card matchup-leader-card" type="button" data-card-preview data-full={item.leader.img} data-name={`${item.leader.code} ${item.leader.name}`}><img src={getCardThumbnail(item.leader.img)} alt={`${item.leader.code} ${item.leader.name} Leader`} loading="lazy"/></button><h3>{item.title}</h3></div><p>{item.intro}</p><ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul></article>)}</div></section>
    <section id="tips" class="glow-block"><h2>Tips</h2><div class="content-list">{tips.map((item) => <article class="tip-card"><div class="tip-card-images">{item.cards.map((entry) => <button class="mini-card" type="button" data-card-preview data-full={entry.img} data-name={`${entry.code} ${entry.name}`}><img src={getCardThumbnail(entry.img)} alt={`${entry.code} ${entry.name}`} loading="lazy"/></button>)}</div><p>{item.text}</p></article>)}</div></section>
  </div>
  <div class="card-modal" data-modal aria-hidden="true"><div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview"><button class="modal-close" type="button" data-close>Close</button><img src="" alt="" data-modal-image/></div></div>
</MainLayout>

<script>
  const modal = document.querySelector("[data-modal]"); const modalImage = document.querySelector("[data-modal-image]");
  const closeModal = () => { modal?.classList.remove("is-open"); modal?.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; };
