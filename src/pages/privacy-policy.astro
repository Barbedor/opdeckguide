---
import MainLayout from "../layouts/MainLayout.astro";

const title = "Privacy Policy";
const description =
	"Privacy policy for OPDeckGuide, including the use of Google Analytics and possible future use of Google AdSense.";
const isDevelopment = import.meta.env.DEV;
---

<MainLayout title={title} description={description}>
	<section class="hero">
		<div class="container">
			<span class="hero-badge">Privacy</span>
			<h1>Privacy Policy</h1>
			<p>
				This page explains what OPDeckGuide collects, why it is collected, and how it is used.
			</p>
		</div>
	</section>

	<section class="list-section">
		<div class="container legal-copy">
			<h2>What this site does</h2>
			<p>
				OPDeckGuide publishes English-language strategy content about the One Piece Card Game.
			</p>

			<h2>Analytics</h2>
			<p>
				This site uses Google Analytics 4 to measure traffic and understand which pages are viewed, how visitors
				reach the site, and which content is used the most.
			</p>
			<p>
				This analytics setup is used only for audience measurement and site improvement. It is not used to serve
				ads through Google Analytics itself, sell profiles, or create user accounts on this site.
			</p>

			<h2>Data processed</h2>
			<p>
				Google Analytics may process technical usage data such as page views, approximate location, device or
				browser information, referring source, and on-site navigation events.
			</p>

			<h2>What this site does not offer</h2>
			<p>
				This site does not provide account registration, comments, or checkout features at this time.
			</p>

			<h2>Advertising</h2>
			<p>
				OPDeckGuide may use Google AdSense to support the site. If AdSense is used, Google and its partners may
				use cookies, identifiers, or similar technologies to serve, measure, and, where allowed, personalize ads.
			</p>
			<p>
				Where required, visitors can manage or refuse consent choices. For visitors in the EEA, the United
				Kingdom, and Switzerland, consent management may be handled through a CMP that is configured to meet
				Google’s requirements.
			</p>

			<section id="us-privacy-rights" class="us-privacy-rights" hidden>
				<h2>US Privacy Rights</h2>
				<p>
					If US state privacy laws apply to you, you can opt out of the sale or sharing of your personal
					information and of targeted advertising.
				</p>
				<button id="us-privacy-opt-out" class="us-privacy-control" type="button" hidden>
					Do Not Sell or Share My Personal Information
				</button>
				<p id="us-privacy-status" class="us-privacy-status" aria-live="polite" hidden></p>
			</section>

			<h2>Third-party service</h2>
			<p>
				Analytics data is processed through Google Analytics, and advertising-related processing may be handled by
				Google AdSense. You can learn more about how Google handles data on Google’s own privacy pages.
			</p>

			<h2>Your choices</h2>
			<p>
				You can limit analytics collection by using browser privacy settings, content blockers, or Google’s own
				privacy controls.
			</p>

			<h2>Updates</h2>
			<p>
				This page may be updated if the site’s analytics setup or site features change.
			</p>
		</div>
	</section>
</MainLayout>

<script is:inline define:vars={{ isDevelopment }}>
	const usPrivacySection = document.getElementById("us-privacy-rights");
	const usPrivacyOptOutButton = document.getElementById("us-privacy-opt-out");
	const usPrivacyStatus = document.getElementById("us-privacy-status");

	const showUsPrivacySection = () => {
		usPrivacySection?.removeAttribute("hidden");
	};

	const showUsPrivacyStatus = (message) => {
		if (!usPrivacyStatus) return;
		usPrivacyStatus.textContent = message;
		usPrivacyStatus.removeAttribute("hidden");
	};

	if (isDevelopment) {
		const isVisualTest = new URLSearchParams(window.location.search).get("test-us-privacy") === "1";

		if (isVisualTest) {
			showUsPrivacySection();
			if (usPrivacyOptOutButton instanceof HTMLButtonElement) {
				usPrivacyOptOutButton.removeAttribute("hidden");
				usPrivacyOptOutButton.disabled = true;
				usPrivacyOptOutButton.setAttribute("aria-describedby", "us-privacy-status");
			}
			showUsPrivacyStatus("Development preview only. No privacy choice has been sent to Google.");
		}
	} else {
		const renderUsPrivacyRights = (status) => {
			const statusEnum = googlefc.usstatesoptout.InitialUsStatesOptOutStatusEnum;

			if (status !== statusEnum.NOT_OPTED_OUT && status !== statusEnum.OPTED_OUT) return;

			showUsPrivacySection();

			if (status === statusEnum.NOT_OPTED_OUT && usPrivacyOptOutButton instanceof HTMLButtonElement) {
				usPrivacyOptOutButton.removeAttribute("hidden");
				usPrivacyOptOutButton.addEventListener(
					"click",
					() =>
						googlefc.usstatesoptout.openConfirmationDialog((userOptedOut) => {
							if (!userOptedOut) return;
							usPrivacyOptOutButton.hidden = true;
							showUsPrivacyStatus("Your opt-out choice is active.");
						}),
				);
			} else if (status === statusEnum.OPTED_OUT) {
				showUsPrivacyStatus("Your opt-out choice is active.");
			}
		};

		window.addEventListener("opdeckguide-us-states-opt-out-status", (event) => {
			renderUsPrivacyRights(event.detail);
		});

		if (typeof window.__opdeckguideUsStatesOptOutStatus !== "undefined") {
			renderUsPrivacyRights(window.__opdeckguideUsStatesOptOutStatus);
		}
	}
</script>

<style>
	.legal-copy {
		max-width: 760px;
	}

	.legal-copy h2 {
		margin: 2rem 0 0.75rem;
		font-size: 1.5rem;
	}

	.legal-copy p {
		margin: 0.75rem 0;
		color: var(--text-200);
	}

	.us-privacy-rights {
		margin: 2.5rem 0;
		padding: 1.25rem 1.4rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: rgba(17, 24, 39, 0.55);
	}

	.us-privacy-rights h2 {
		margin-top: 0;
	}

	.us-privacy-control {
		margin-top: 0.35rem;
		padding: 0.7rem 1rem;
		border: 1px solid rgba(255, 107, 61, 0.55);
		border-radius: 999px;
		background: transparent;
		color: var(--text-100);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.us-privacy-control:hover,
	.us-privacy-control:focus-visible {
		border-color: var(--accent);
		background: rgba(255, 107, 61, 0.12);
		outline: none;
	}

	.us-privacy-control:disabled {
		cursor: not-allowed;
		opacity: 0.7;
	}

	.us-privacy-status {
		margin-bottom: 0;
	}
</style>
