---
import MainLayout from "../../../layouts/MainLayout.astro";
import TournamentDecklistsView from "../../../components/TournamentDecklistsView.astro";
import {
	getTournamentEntriesByFormat,
	tournamentFormats,
} from "../../../lib/tournamentDecklists";

export const getStaticPaths = () =>
	tournamentFormats
		.filter((format) => format.slug !== "op17-east")
		.map((format) => ({
		params: { format: format.slug },
		props: { format },
	}));

const { format } = Astro.props;
const entries = getTournamentEntriesByFormat(format.slug);
const isOp17Format = format.entryFormat === "op17";
const regionLabel = format.region === "west" ? "West" : "East";
const regionName = format.region === "west" ? "Western" : "Eastern";
const title = isOp17Format
	? `One Piece TCG OP17 ${regionLabel} Tournament Decklists | Winners & Meta`
	: `One Piece TCG ${regionLabel} Tournament Decklists | Winners & Meta`;
const description = isOp17Format
	? `Browse winning One Piece TCG OP17 ${regionName} tournament decklists. Track ${regionLabel} leader share, recent results, and competitive builds from the current ${regionName.toLowerCase()} meta.`
	: `Browse winning One Piece TCG ${regionName} tournament decklists. Track ${regionLabel} leader share, recent results, and competitive builds.`;
const heroTitle = isOp17Format
	? `One Piece TCG OP17 ${regionLabel} Tournament Decklists`
	: `One Piece TCG ${regionLabel} Tournament Decklists`;
const heroIntro = isOp17Format
	? `Track winning OP17 decklists from the ${regionName} tournament scene. Browse recent ${regionLabel} results, leading decks, and the builds shaping the current regional meta.`
	: `Track winning decklists from the ${regionName} tournament scene. Browse recent ${regionLabel} results, leading decks, and the builds shaping the current regional meta.`;
---

<MainLayout title={title} description={description}>
	<TournamentDecklistsView
		currentFormat={format.slug}
		entries={entries}
		formatConfig={format}
		heroTitle={heroTitle}
		heroIntro={heroIntro}
		showSeoContent={true}
	/>
</MainLayout>
