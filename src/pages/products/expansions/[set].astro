---
import MainLayout from "../../../layouts/MainLayout.astro";
import ManualAd from "../../../components/ManualAd.astro";
import { boosterSets, getProductImageUrl } from "../../../lib/products";
import { siteUrl } from "../../../lib/site";

export const getStaticPaths = () => boosterSets.map((set) => ({ params: { set: set.slug } }));
const set = boosterSets.find((entry) => entry.slug === Astro.params.set);
if (!set) return Astro.redirect("/products/expansions/");
const displayName = set.name.toLowerCase().startsWith(set.code.toLowerCase()) ? set.name : `${set.code} ${set.name}`;
const title = `${displayName} Sealed Products`;
const eb04SeoNote = set.code === "OP15"
	? "In western releases, the EB04 Egghead Crisis set was split between OP14-EB04 and OP15-EB04: OP15-EB04 contains the red, black, and yellow cards, while OP14-EB04 contains the green, blue, and purple cards."
	: set.code === "OP14"
		? "In western releases, the EB04 Egghead Crisis set was split between OP14-EB04 and OP15-EB04. OP14-EB04 contains the green, blue, and purple cards, while OP15-EB04 contains the red, black, and yellow cards."
		: "";
const description = `Browse sealed One Piece Card Game products from the ${displayName}.${eb04SeoNote ? ` ${eb04SeoNote}` : ""}`;
const expansionTheme = {
	OP17: "The great powers of the world and Elbaf, including Emperors and characters connected to recent story events.",
	OP16: "Marineford and the Paramount War, with the Marines, Admirals, Whitebeard, and the Summit War at the center.",
	OP15: "Skypiea, with Luffy, Enel, Shandia, and the people of Skypiea, alongside the OP15-EB04 portion linked to Egghead Crisis.",
	OP14: "The Seven Great Warlords, or Shichibukai, including Mihawk, Doflamingo, Boa Hancock, Crocodile, Moria, Jinbe, and Law, alongside the OP14-EB04 portion.",
	OP13: "Luffy, Ace, and Sabo, with inherited will, Roger, Imu, the Five Elders, and the major legacy themes of the story.",
} as Record<string, string>;
const themeDescription = expansionTheme[set.code] ?? "The characters, stories, and themes introduced by this One Piece Card Game expansion.";
const structuredData = [
	{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl }, { "@type": "ListItem", position: 2, name: "Products", item: `${siteUrl}/products/` }, { "@type": "ListItem", position: 3, name: "Expansions", item: `${siteUrl}/products/expansions/` }, { "@type": "ListItem", position: 4, name: set.code, item: `${siteUrl}/products/expansions/${set.slug}/` }] },
	{ "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: `${siteUrl}/products/expansions/${set.slug}/`, inLanguage: "en" },
];
---

<MainLayout title={title} description={description} structuredData={structuredData}>
	<section class="hero"><div class="container"><a class="breadcrumb" href="/products/expansions/">← All expansions</a><span class="hero-badge">{set.code}</span><h1>{title}</h1><p>{set.description} This page will collect the sealed products available for this expansion.</p></div></section>
	<ManualAd variant="rectangle" />
	{set.imageFile && <section class="set-visual-section" aria-label={`${set.code} expansion visual`}><div class="container"><img class:list={["set-visual", `set-visual--${set.code.toLowerCase()}`]} src={getProductImageUrl(set.imageFile)} alt={set.imageAlt} /></div></section>}
	<section class="list-section" aria-labelledby="set-products-title"><div class="container"><div class="section-header"><div><h2 id="set-products-title">{set.code} sealed products</h2><p>Browse sealed products from this expansion and check current availability.</p></div></div>{set.products.length > 0 ? <div class="product-grid">{set.products.map((product) => <article class="product-card"><div class:list={["product-image", product.name.toLowerCase().includes("booster box") && "product-image--box"]}><img src={getProductImageUrl(product.imageFile)} alt={product.imageAlt} loading="lazy" /></div><div class="product-content"><h3>{product.name}</h3><p class="product-description">{product.description}</p><a class="product-link" href={product.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">{product.price}</a></div></article>)}</div> : <div class="empty-state"><p>Products for this expansion are being added soon. Check back for booster boxes and other sealed releases from {set.code}.</p></div>}</div></section>
	<section class="seo-block"><div class="container copy-grid"><div><h2>What is {set.code}?</h2><p>{set.name} is a One Piece Card Game expansion. Its main themes include {themeDescription} Its sealed lineup can include booster boxes, booster packs, collections, and other release formats.</p></div><div><h2>How to choose a sealed {set.code} product</h2><p>Check the product format, edition, seller details, and current availability before ordering.</p></div>{eb04SeoNote && <div class="internal-links expansion-note"><h2>How EB04 is split in western releases</h2><p>{eb04SeoNote}</p></div>}<div class="internal-links"><h2>Continue exploring OPDeckGuide</h2><p>Browse all <a href="/products/expansions/">One Piece Card Game Expansions</a> or return to the <a href="/products/">sealed products hub</a>.</p></div></div></section>
</MainLayout>

<style>
	.breadcrumb { display:inline-block; margin:0 1rem 1rem 0; color:var(--text-200); font-size:.92rem; } .breadcrumb:hover { color:var(--accent); }
	.set-visual-section { padding:1rem 0 1.5rem; }
	.set-visual { display:block; width:100%; aspect-ratio:3.2 / 1; max-height:170px; border:1px solid var(--border); border-radius:var(--radius-md); object-fit:cover; object-position:center 22%; box-shadow:0 10px 26px rgba(0,0,0,.2); }
	.set-visual--op16 { object-position:center 22%; }
	.set-visual--op17 { object-position:center 22%; }
	.set-visual--op15 { object-position:center 38%; }
	@media (min-width:651px) { .set-visual--op13 { object-position:center 36%; } }
	.product-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
	.product-card { display:flex; flex-direction:column; min-width:0; overflow:hidden; border:1px solid var(--border); border-radius:var(--radius-md); background:rgba(12,17,30,.72); }
	.product-image { position:relative; display:grid; place-items:center; height:180px; overflow:hidden; padding:1rem; background:rgba(255,107,61,.08); }
	.product-image img { display:block; width:auto; height:auto; max-width:78%; max-height:128px; object-fit:contain; }
	.product-image--box img { max-width:90%; max-height:145px; }
	.product-content { display:flex; flex:1; flex-direction:column; align-items:flex-start; padding:1rem; }
	.product-code { color:var(--accent); font-size:.72rem; font-weight:700; letter-spacing:.03em; line-height:1.2; overflow-wrap:anywhere; text-transform:uppercase; }
	.product-content h3 { margin:.45rem 0 0; font-size:1.05rem; line-height:1.25; overflow-wrap:anywhere; }
	.product-description { margin:.65rem 0 1rem; color:var(--text-200); font-size:.9rem; line-height:1.5; }
	.product-link { margin-top:auto; display:inline-flex; align-items:center; justify-content:center; min-height:2.4rem; padding:.55rem 1rem; border-radius:999px; background:linear-gradient(135deg,#ff6b3d,#ff9f1c); color:#160d09; font-size:.85rem; font-weight:700; text-decoration:none; }
	.product-link:hover { filter:brightness(1.08); transform:translateY(-1px); }
	.empty-state { padding:2rem; border:1px solid var(--border); border-radius:var(--radius-md); background:rgba(12,17,30,.72); color:var(--text-200); }
	@media (min-width:651px) { .product-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } }
	.seo-block { padding-top:3.5rem; } .copy-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; } .copy-grid h2 { font-size:1.35rem; } .copy-grid p { color:var(--text-200); } .internal-links { grid-column:1 / -1; } .internal-links a { color:var(--accent); font-weight:600; } @media (max-width:650px) { .set-visual-section { padding:1rem 0 1.25rem; } .set-visual { aspect-ratio:3 / 1; max-height:120px; border-radius:12px; } .product-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:.55rem; } .product-image { height:145px; padding:.65rem; } .product-image img { max-width:76%; max-height:103px; } .product-image--box img { max-width:88%; max-height:116px; } .product-content { padding:.7rem; } .product-content h3 { font-size:.9rem; line-height:1.2; } .product-description { font-size:.78rem; } .product-link { width:100%; padding:.5rem .65rem; font-size:.78rem; } .copy-grid { grid-template-columns:1fr; gap:1rem; } .internal-links { grid-column:auto; } }
</style>
