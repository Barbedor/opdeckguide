---
import MainLayout from "../../../layouts/MainLayout.astro";
import { boosterSets } from "../../../lib/products";
import { siteUrl } from "../../../lib/site";

export const getStaticPaths = () => boosterSets.map((set) => ({ params: { set: set.slug } }));
const set = boosterSets.find((entry) => entry.slug === Astro.params.set);
if (!set) return Astro.redirect("/products/expansions/");
const title = `${set.code} ${set.name} Sealed Products`;
const description = `Browse sealed One Piece Card Game products from the ${set.code} ${set.name} expansion.`;
const structuredData = [
	{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl }, { "@type": "ListItem", position: 2, name: "Products", item: `${siteUrl}/products/` }, { "@type": "ListItem", position: 3, name: "Expansions", item: `${siteUrl}/products/expansions/` }, { "@type": "ListItem", position: 4, name: set.code, item: `${siteUrl}/products/expansions/${set.slug}/` }] },
	{ "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: `${siteUrl}/products/expansions/${set.slug}/`, inLanguage: "en" },
];
---

<MainLayout title={title} description={description} structuredData={structuredData}>
	<section class="hero"><div class="container"><a class="breadcrumb" href="/products/expansions/">← All expansions</a><span class="hero-badge">{set.code}</span><h1>{title}</h1><p>{set.description} This page will collect the sealed products available for this expansion.</p></div></section>
	<section class="list-section" aria-labelledby="set-products-title"><div class="container"><div class="section-header"><div><h2 id="set-products-title">{set.code} sealed products</h2><p>Open an expansion to browse its available products.</p></div></div><div class="empty-state"><p>Products for this expansion are being added soon. Check back for booster boxes and other sealed releases from {set.code}.</p></div></div></section>
	<section class="seo-block"><div class="container copy-grid"><div><h2>What is {set.code}?</h2><p>{set.name} is a One Piece Card Game expansion. Its sealed lineup can include booster boxes, booster packs, collections, and other release formats.</p></div><div><h2>How to choose a sealed {set.code} product</h2><p>Check the product format, language, edition, seller details, and current availability before ordering.</p></div><div class="internal-links"><h2>Continue exploring OPDeckGuide</h2><p>Browse all <a href="/products/expansions/">One Piece Card Game Expansions</a> or return to the <a href="/products/">sealed products hub</a>.</p></div></div></section>
</MainLayout>

<style>
	.breadcrumb { display:inline-block; margin:0 1rem 1rem 0; color:var(--text-200); font-size:.92rem; } .breadcrumb:hover { color:var(--accent); }
	.empty-state { padding:2rem; border:1px solid var(--border); border-radius:var(--radius-md); background:rgba(12,17,30,.72); color:var(--text-200); }
	.seo-block { padding-top:3.5rem; } .copy-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; } .copy-grid h2 { font-size:1.35rem; } .copy-grid p { color:var(--text-200); } .internal-links { grid-column:1 / -1; } .internal-links a { color:var(--accent); font-weight:600; } @media (max-width:650px) { .copy-grid { grid-template-columns:1fr; gap:1rem; } .internal-links { grid-column:auto; } }
</style>
