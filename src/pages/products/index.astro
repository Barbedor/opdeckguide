---
import MainLayout from "../../layouts/MainLayout.astro";
import { getProductImageUrl, productCategories } from "../../lib/products";
import { siteUrl } from "../../lib/site";

const title = "One Piece Card Game Sealed Products";
const description = "Browse One Piece Card Game sealed products by category. Start with ready-to-play starter decks, then find the release that suits your collection or first games.";
const structuredData = { "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: `${siteUrl}/products/`, inLanguage: "en", mainEntity: { "@type": "ItemList", itemListElement: productCategories.map((category, index) => ({ "@type": "ListItem", position: index + 1, name: category.title, url: `${siteUrl}/products/${category.slug}/` })) } };
---

<MainLayout title={title} description={description} structuredData={structuredData}>
	<section class="hero"><div class="container"><span class="hero-badge">Sealed Products</span><h1>One Piece Card Game Sealed Products</h1><p>Explore sealed One Piece Card Game releases by product type. This product hub will bring together starter decks, booster products, collections, and other sealed releases.</p></div></section>
	<section class="list-section" aria-labelledby="product-categories-title"><div class="container"><div class="section-header"><div><h2 id="product-categories-title">Browse product categories</h2><p>Choose a category to compare the sealed products currently available.</p></div></div><div class="category-grid">{productCategories.map((category) => (<section class="category-group" aria-labelledby={`${category.slug}-title`}><a class="category-card" href={`/products/${category.slug}/`}><div class="category-image"><img src={getProductImageUrl(category.imageFile)} alt={category.title} /></div><div class="category-content"><span>{category.label}</span><h3 id={`${category.slug}-title`}>{category.title}</h3><p>{category.description}</p><strong>Explore category</strong></div></a></section>))}</div></div></section>
	<section class="seo-block"><div class="container"><h2>One Piece Card Game product hub</h2><p>Use this page to browse sealed One Piece Card Game products by category. Each category page brings together product formats, release details, and retailer links in one place.</p><p>We are adding categories gradually so every product page stays clear and useful for players, collectors, and gift buyers.</p></div></section>
</MainLayout>

<style>
	.category-grid { display: grid; gap: 1.5rem; }
	.category-group { display: grid; grid-template-columns: minmax(0, 360px); }
	.category-card { overflow: hidden; border: 2px solid #ff6b3d !important; border-radius: var(--radius-lg); background: rgba(12,17,30,.9); box-shadow: 0 0 0 1px rgba(255,107,61,.22), 0 0 12px rgba(255,107,61,.32), 0 0 28px rgba(255,107,61,.1) !important; transition: transform .2s ease, box-shadow .2s ease; }
	.category-card:hover, .category-card:focus-visible { transform: translateY(-4px); border-color: #ff6b3d !important; box-shadow: 0 0 0 1px rgba(255,107,61,.3), 0 0 16px rgba(255,107,61,.4), 0 0 32px rgba(255,107,61,.14) !important; outline: none; }
	.category-image { min-height: 180px; background: radial-gradient(ellipse 38% 62% at 12% 76%, rgba(255,91,45,.38) 0%, rgba(255,91,45,.18) 30%, transparent 72%), radial-gradient(ellipse 42% 55% at 88% 28%, rgba(255,159,26,.3) 0%, rgba(255,159,26,.12) 34%, transparent 74%), radial-gradient(ellipse 32% 38% at 52% 8%, rgba(255,107,61,.2) 0%, transparent 72%), radial-gradient(ellipse 28% 35% at 66% 88%, rgba(255,126,48,.16) 0%, transparent 75%), rgba(12,17,30,.3); }
	.category-image img { width: 100%; height: 220px; object-fit: contain; }
	.category-content { padding: 1.2rem; }
	.category-content span, .category-content strong { color: var(--accent); font-size: .85rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
	.category-content h3 { margin: .3rem 0 .6rem; font-size: 1.4rem; }
	.category-content p, .seo-block p { color: var(--text-200); }
	.category-content p { margin: 0 0 1rem; }
	.seo-block { padding-top: 3.5rem; } .seo-block p { max-width: 820px; } .seo-block a { color: var(--accent); font-weight: 600; }
</style>
