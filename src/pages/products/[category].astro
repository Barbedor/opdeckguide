---
import MainLayout from "../../layouts/MainLayout.astro";
import { getProductCategory, getProductImageUrl, productCategories } from "../../lib/products";
import { siteUrl } from "../../lib/site";

export const getStaticPaths = () => productCategories.map((category) => ({ params: { category: category.slug } }));
const category = getProductCategory(Astro.params.category);
if (!category) return Astro.redirect("/products/");
const title = category.title;
const description = `Browse ${category.title}. Compare the original One Piece Card Game starter deck releases and find the deck that fits your collection or first game.`;
const structuredData = [{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl }, { "@type": "ListItem", position: 2, name: "Products", item: `${siteUrl}/products/` }, { "@type": "ListItem", position: 3, name: category.title, item: `${siteUrl}/products/${category.slug}/` }] }, { "@context": "https://schema.org", "@type": "ItemList", name: category.title, itemListElement: category.products.map((product, index) => ({ "@type": "ListItem", position: index + 1, name: `${product.code} ${product.name}` })) }];
---

<MainLayout title={title} description={description} structuredData={structuredData}>
	<section class="hero"><div class="container"><a class="breadcrumb" href="/products/">← All sealed products</a><span class="hero-badge">{category.label}</span><h1>{category.title}</h1><p>Browse the original One Piece Card Game starter deck lineup. Every starter deck is ready to play out of the box and built around a distinct leader and theme.</p></div></section>
	<section class="list-section" aria-labelledby="starter-decks-title"><div class="container"><div class="section-header"><div><h2 id="starter-decks-title">One Piece Card Game starter deck guide</h2><p>Availability and prices vary by retailer. Always check the listing details before ordering.</p></div></div><div class="product-grid">{category.products.map((product) => (<article class="product-card"><div class="product-image"><img src={getProductImageUrl(product.imageFile)} alt={product.imageAlt} loading="lazy" /></div><div class="product-content"><span class="product-code">{product.code}</span><h3>{product.name}</h3><p>{product.description}</p>{product.affiliateUrl ? (<a class="product-link" href={product.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">{product.price}</a>) : (<span class="product-link is-unavailable">Link soon</span>)}</div></article>))}</div></div></section>
	<section class="seo-block"><div class="container copy-grid"><div><h2>What is a One Piece Card Game starter deck?</h2><p>A starter deck is a pre-constructed, ready-to-play deck. It gives new players an immediate way to learn the game and gives collectors a focused release built around a specific crew, character, or theme.</p></div><div><h2>Which starter deck should I choose?</h2><p>Choose the theme or leader you enjoy most. For a first game, a starter deck is a straightforward place to begin; for collecting, consider the characters and card style that matter most to you.</p></div><div class="internal-links"><h2>Continue exploring OPDeckGuide</h2><p>Looking for individual cards? Browse the <a href="/cards-list/">One Piece Card List</a>. Want gameplay context? Read the <a href="/deck-guides/">Deck Guides</a> before choosing your next deck.</p></div></div></section>
	<section class="faq-section"><div class="container"><div class="section-header faq-header"><div><h2>Starter Deck FAQ</h2></div></div><div class="faq-grid"><article class="faq-card"><h3>Are starter decks ready to play?</h3><p>Yes. Starter decks are pre-built and intended to let players start learning and playing right away.</p></article><article class="faq-card"><h3>Do starter decks include different themes?</h3><p>Yes. Each deck focuses on a different leader, crew, or story theme from One Piece.</p></article><article class="faq-card"><h3>Where can I see the cards from a starter deck?</h3><p>Use the <a href="/cards-list/">One Piece Card List</a> and search for its ST code to browse its cards.</p></article></div></div></section>
</MainLayout>

<style>
	.breadcrumb { display: inline-block; margin-bottom: 1rem; color: var(--text-200); font-size: .92rem; } .breadcrumb:hover { color: var(--accent); }
	.product-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; } .product-card { display:flex; flex-direction:column; min-width:0; overflow:hidden; border:1px solid var(--border); border-radius:var(--radius-md); background:rgba(12,17,30,.9); } .product-image { position:relative; height:180px; overflow:hidden; background:linear-gradient(135deg,rgba(255,107,61,.2),rgba(255,159,26,.06)); } .product-image img { position:absolute; inset:.5rem; display:block; width:calc(100% - 1rem); height:calc(100% - 1rem); max-width:none; max-height:none; object-fit:contain; } .product-content { display:flex; flex:1; flex-direction:column; align-items:flex-start; min-width:0; padding:.9rem; } .product-code { color:var(--accent); font-size:.76rem; font-weight:700; letter-spacing:.06em; } .product-content h3 { margin:.2rem 0 0; font-size:1rem; line-height:1.25; } .product-content p { margin:.55rem 0 1rem; color:var(--text-200); font-size:.88rem; } .product-link { margin-top:auto; padding:.55rem .75rem; border-radius:999px; background:linear-gradient(120deg,var(--accent),var(--accent-2)); color:#0b0f1a; font-size:.8rem; font-weight:700; white-space:nowrap; } .product-link.is-unavailable { background:rgba(255,255,255,.07); color:var(--text-300); } .seo-block { padding-top:3.5rem; } .copy-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; } .copy-grid h2 { font-size:1.35rem; } .copy-grid p { color:var(--text-200); } .internal-links { grid-column:1 / -1; } .internal-links a, .faq-card a { color:var(--accent); font-weight:600; } @media (max-width:650px) { .product-grid { gap:.45rem; } .product-card { border-radius:10px; } .product-image { height:112px; } .product-image img { inset:.25rem; width:calc(100% - .5rem); height:calc(100% - .5rem); } .product-content { padding:.55rem; } .product-code { font-size:.65rem; } .product-content h3 { font-size:.75rem; line-height:1.2; } .product-content p { display:none; } .product-link { width:100%; padding:.42rem .2rem; font-size:.66rem; text-align:center; } .copy-grid { grid-template-columns:1fr; gap:1rem; } .internal-links { grid-column:auto; } }
</style>
