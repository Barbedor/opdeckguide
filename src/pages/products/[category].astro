---
import MainLayout from "../../layouts/MainLayout.astro";
import ManualAd from "../../components/ManualAd.astro";
import { boosterSets, getProductCategory, getProductImageUrl, productCategories } from "../../lib/products";
import { siteUrl } from "../../lib/site";

export const getStaticPaths = () => productCategories.map((category) => ({ params: { category: category.slug } }));
const category = getProductCategory(Astro.params.category);
if (!category) return Astro.redirect("/products/");
const title = category.title;
const isExpansions = category.slug === "expansions";
const productType = isExpansions ? "booster box" : "starter deck";
const description = isExpansions
	? `Browse One Piece Card Game expansions. Explore each set and compare its sealed products, release details, and retailer links.`
	: `Browse ${category.title}. Compare the original One Piece Card Game starter deck releases and find the deck that fits your collection or first game.`;
const intro = isExpansions
	? "Browse One Piece Card Game expansions and open a set page to discover the sealed products released for that extension."
	: "Browse the original One Piece Card Game starter deck lineup. Every starter deck is ready to play out of the box and built around a distinct leader and theme.";
const guideHeading = isExpansions ? "Browse One Piece Card Game expansions" : "One Piece Card Game starter deck guide";
const definition = isExpansions
	? "A booster box is a sealed display containing multiple randomized booster packs from one One Piece Card Game expansion. It is designed for opening packs, collecting a set, and finding cards for deck building."
	: "A starter deck is a pre-constructed, ready-to-play deck. It gives new players an immediate way to learn the game and gives collectors a focused release built around a specific crew, character, or theme.";
const choosing = isExpansions
	? "Choose a box by expansion code, language, and the cards you want to collect. Always verify the set, edition, and retailer listing before ordering."
	: "Choose the theme or leader you enjoy most. For a first game, a starter deck is a straightforward place to begin; for collecting, consider the characters and card style that matter most to you.";
const faqHeading = isExpansions ? "Expansion FAQ" : "Starter Deck FAQ";
const faqOne = isExpansions ? "What can I find on an expansion page?" : "Are starter decks ready to play?";
const faqOneAnswer = isExpansions ? "Each expansion page groups the sealed products released for that set, such as booster boxes, packs, and collections." : "Yes. Starter decks are pre-built and intended to let players start learning and playing right away.";
const faqTwo = isExpansions ? "Which expansion should I choose?" : "Do starter decks include different themes?";
const faqTwoAnswer = isExpansions ? "Start with the set whose cards, leaders, or artwork interest you most, then check the language and edition before ordering." : "Yes. Each deck focuses on a different leader, crew, or story theme from One Piece.";
const faqThree = isExpansions ? "Where can I see cards from an expansion?" : "Where can I see the cards from a starter deck?";
const faqThreeAnswer = isExpansions ? "Use the One Piece Card List and search for the expansion code to browse the cards included in a set." : "Use the One Piece Card List and search for its ST code to browse its cards.";
const structuredData = [{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl }, { "@type": "ListItem", position: 2, name: "Products", item: `${siteUrl}/products/` }, { "@type": "ListItem", position: 3, name: category.title, item: `${siteUrl}/products/${category.slug}/` }] }, { "@context": "https://schema.org", "@type": "ItemList", name: category.title, itemListElement: category.products.map((product, index) => ({ "@type": "ListItem", position: index + 1, name: `${product.code} ${product.name}` })) }];
---

<MainLayout title={title} description={description} structuredData={structuredData}>
	<section class="hero"><div class="container"><a class="breadcrumb" href="/products/">← All sealed products</a><span class="hero-badge">{category.label}</span><h1>{category.title}</h1><p>{intro}</p></div></section>
	<ManualAd variant="banner" />
	<section class="list-section" aria-labelledby="product-list-title"><div class="container"><div class="section-header"><div><h2 id="product-list-title">{guideHeading}</h2><p>Open an expansion to browse its sealed product lineup.</p></div></div>{isExpansions ? <div class="set-grid">{boosterSets.map((set) => (<a class="set-card" href={`/products/expansions/${set.slug}/`}><span class="product-code">{set.code}</span><div class="set-media">{set.imageFile ? <img class="set-image" src={getProductImageUrl(set.imageFile)} alt={set.imageAlt} loading="lazy" /> : <span class="set-placeholder" aria-hidden="true">{set.code}</span>}<div class="set-overlay"><h3>{set.name}</h3></div></div><p>{set.description}</p><strong>Explore {set.code}</strong></a>))}</div> : category.products.length ? <div class="product-grid">{category.products.map((product) => (<article class="product-card"><div class="product-image"><img src={getProductImageUrl(product.imageFile)} alt={product.imageAlt} loading="lazy" /></div><div class="product-content"><span class="product-code">{product.code}</span><h3>{product.name}</h3>{product.affiliateUrl ? (<a class="product-link" href={product.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">{product.price}</a>) : (<span class="product-link is-unavailable">Link soon</span>)}</div></article>))}</div> : <div class="empty-state"><p>Booster box listings are being added soon. Check back for sealed displays from the latest One Piece Card Game expansions.</p></div>}</div></section>
	<ManualAd variant="rectangle" />
	<section class="seo-block"><div class="container copy-grid"><div><h2>What is a One Piece Card Game {productType}?</h2><p>{definition}</p></div><div><h2>Which {productType} should I choose?</h2><p>{choosing}</p></div><div class="internal-links"><h2>Continue exploring OPDeckGuide</h2><p>Looking for individual cards? Browse the <a href="/cards-list/">One Piece Card List</a>. Want gameplay context? Read the <a href="/deck-guides/">Deck Guides</a> before choosing your next sealed product.</p></div></div></section>
	<section class="faq-section"><div class="container"><div class="section-header faq-header"><div><h2>{faqHeading}</h2></div></div><div class="faq-grid"><article class="faq-card"><h3>{faqOne}</h3><p>{faqOneAnswer}</p></article><article class="faq-card"><h3>{faqTwo}</h3><p>{faqTwoAnswer}</p></article><article class="faq-card"><h3>{faqThree}</h3><p>{faqThreeAnswer}</p></article></div></div></section>
	<ManualAd variant="banner" />
</MainLayout>

<style>
	.breadcrumb { display: inline-block; margin: 0 1rem 1rem 0; color: var(--text-200); font-size: .92rem; } .breadcrumb:hover { color: var(--accent); }
	.empty-state { padding: 2rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: rgba(12,17,30,.72); color: var(--text-200); }
	.set-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; } .set-card { position:relative; display:block; min-height:360px; overflow:hidden; padding:1.2rem; border:1px solid var(--border); border-radius:var(--radius-md); background:rgba(12,17,30,.9); transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease; } .set-card:hover,.set-card:focus-visible { transform:translateY(-3px); border-color:var(--accent); box-shadow:0 0 18px rgba(255,107,61,.2); outline:none; } .set-media { position:absolute; z-index:0; inset:0; height:auto; margin:0; overflow:hidden; background:rgba(12,17,30,.48); pointer-events:none; } .set-image { display:block; width:100%; height:100%; object-fit:cover; opacity:.95; filter:none; transform:scale(1.02); mask-image:linear-gradient(to bottom, #000 0%, rgba(0,0,0,.18) 64%, transparent 100%); -webkit-mask-image:linear-gradient(to bottom, #000 0%, rgba(0,0,0,.18) 64%, transparent 100%); } .set-placeholder { position:absolute; inset:0; display:grid; place-items:center; color:rgba(255,159,26,.22); font-size:clamp(4rem,10vw,8rem); font-weight:800; letter-spacing:.08em; } .set-overlay { position:absolute; inset:0; display:flex; align-items:flex-start; justify-content:center; padding:8rem 1rem 0; background:linear-gradient(180deg,rgba(8,12,22,.12) 0%,rgba(8,12,22,.18) 42%,rgba(8,12,22,.9) 100%); } .set-overlay h3 { margin:0; color:#fff; font-size:1.3rem; line-height:1.15; text-align:center; text-shadow:0 2px 10px rgba(0,0,0,.9); } .set-card > .product-code { position:relative; z-index:1; display:block; font-size:1.45rem; letter-spacing:.08em; text-shadow:0 2px 10px rgba(0,0,0,.7); } .set-card > p,.set-card > strong { position:relative; z-index:1; } .set-card > p { margin-top:230px; color:var(--text-200); } .set-card strong { color:var(--accent); font-size:.85rem; letter-spacing:.05em; text-transform:uppercase; }
	.product-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; } .product-card { display:flex; flex-direction:column; min-width:0; overflow:hidden; border:1px solid var(--border); border-radius:var(--radius-md); background:rgba(12,17,30,.9); } .product-image { position:relative; height:180px; overflow:hidden; background:linear-gradient(135deg,rgba(255,107,61,.2),rgba(255,159,26,.06)); } .product-image img { position:absolute; inset:.5rem; display:block; width:calc(100% - 1rem); height:calc(100% - 1rem); max-width:none; max-height:none; object-fit:contain; } .product-content { display:flex; flex:1; flex-direction:column; align-items:flex-start; min-width:0; padding:.9rem; } .product-code { color:var(--accent); font-size:.76rem; font-weight:700; letter-spacing:.06em; } .product-content h3 { margin:.2rem 0 0; font-size:1rem; line-height:1.25; } .product-link { margin-top:auto; padding:.55rem .75rem; border-radius:999px; background:linear-gradient(120deg,var(--accent),var(--accent-2)); color:#0b0f1a; font-size:.8rem; font-weight:700; white-space:nowrap; } .product-link.is-unavailable { background:rgba(255,255,255,.07); color:var(--text-300); } .seo-block { padding-top:3.5rem; } .copy-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; } .copy-grid h2 { font-size:1.35rem; } .copy-grid p { color:var(--text-200); } .internal-links { grid-column:1 / -1; } .internal-links a, .faq-card a { color:var(--accent); font-weight:600; } @media (min-width:901px) { .product-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } } @media (max-width:650px) { .product-grid { gap:.45rem; } .set-grid { grid-template-columns:1fr; } .set-card { min-height:330px; } .set-media { height:auto; } .set-overlay { padding:7rem .7rem 0; } .set-overlay h3 { font-size:1rem; } .set-card > p { margin-top:195px; } .product-card { border-radius:10px; } .product-image { height:112px; } .product-image img { inset:.25rem; width:calc(100% - .5rem); height:calc(100% - .5rem); } .product-content { padding:.55rem; } .product-code { font-size:.65rem; } .product-content h3 { font-size:.75rem; line-height:1.2; } .product-link { width:100%; padding:.42rem .2rem; font-size:.66rem; text-align:center; } .copy-grid { grid-template-columns:1fr; gap:1rem; } .internal-links { grid-column:auto; } }
</style>
