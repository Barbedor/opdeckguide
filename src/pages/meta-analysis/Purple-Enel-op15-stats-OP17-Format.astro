---
import MainLayout from "../../layouts/MainLayout.astro";

const title = "OP15 Enel Stats In OP17 Format";
const description =
	"Turn-order win rate article for Purple Enel in the OP17 format, with a visual breakdown of first and second player performance.";

const summary = {
	totalGames: "34210",
	winRate: "50.0%",
	wins: "17099",
	losses: "17111",
};

const leaderHeroArt = "/assets/guides/enel-op15.png";
const getRateTone = (value: string) => {
	const numeric = Number.parseFloat(value.replace("%", "").trim());
	if (numeric < 50) return "turn-rate-negative";
	if (numeric > 50) return "turn-rate-positive";
	return "turn-rate-neutral";
};

const featuredTurnOrderStats = [
	{ label: "Nico Robin", code: "OP09", art: "/assets/guides/Nico-Robin-op09.png", first: "59.6%", second: "36.4%" },
	{ label: "Dracule Mihawk", code: "OP14", art: "/assets/guides/dracule-mihawk-op14.png", first: "53.3%", second: "38.8%" },
	{ label: "Sabo", code: "OP13", art: "/assets/guides/Sabo OP13-004.png", first: "64.9%", second: "52.7%" },
	{ label: "Rocks D. Xebec", code: "OP17-039", art: "/assets/guides/Rocks.DXebec op17.png", first: "43.9%", second: "34.6%" },
	{ label: "Luffy & Ace", code: "ST30", art: "/assets/guides/Luffy-st30.png", first: "60.3%", second: "41.5%" },
	{ label: "Enel", code: "OP15-058", art: "/assets/guides/enel-op15.png", first: "63.4%", second: "36.6%" },
	{ label: "Kaido", code: "OP17", art: "/assets/guides/Kaido op17.png", first: "59.8%", second: "40.1%" },
	{ label: "Monkey D. Luffy", code: "OP17", art: "/assets/guides/Luffy OP17.png", first: "46.5%", second: "42.8%" },
	{ label: "Portgas D. Ace", code: "OP16", art: "/assets/guides/Ace-op16.png", first: "65.2%", second: "56.8%" },
	{ label: "Boa Hancock", code: "OP14", art: "/assets/guides/boa-hancock-op14.png", first: "44.5%", second: "32.3%" },
	{ label: "Edward Newgate", code: "OP17", art: "/assets/guides/Edward.Newgate op17.png", first: "28.3%", second: "28.2%" },
	{ label: "Shanks", code: "OP17", art: "/assets/guides/Shanks op17.png", first: "59.1%", second: "43.8%" },
	{ label: "Yamato", code: "OP16", art: "/assets/guides/yamato-op16.png", first: "60.8%", second: "41%" },
	{ label: "Monkey D. Luffy", code: "OP13", art: "/assets/guides/monkey-d-luffy-op13.png", first: "45.9%", second: "25%" },
	{ label: "Marshall D. Teach", code: "OP09", art: "/assets/guides/Marshall D. Teach OP09-081.png", first: "60.1%", second: "62.8%" },
	{ label: "Charlotte Linlin", code: "OP17", art: "/assets/guides/Charlotte Linlin op17.png", first: "44.1%", second: "25.5%" },
	{ label: "Pudding", code: "OP08", art: "/assets/guides/Pudding op08.png", first: "75%", second: "49.1%" },
	{ label: "Enel", code: "OP05", art: "/assets/guides/Enel OP05-098.png", first: "21.6%", second: "31.7%" },
	{ label: "Monkey D. Luffy", code: "ST10", art: "/assets/guides/Luffy ST10-002.png", first: "78.8%", second: "63.5%" },
	{ label: "Gecko Moria", code: "OP14", art: "/assets/guides/Gecko Moria OP14-080.png", first: "34.4%", second: "34.8%" },
	{ label: "Nami", code: "OP11", art: "/assets/guides/nami-op11.png", first: "25.7%", second: "15.2%" },
	{ label: "Jewelry Bonney", code: "OP13", art: "/assets/guides/Bonney op13.png", first: "50.8%", second: "45.2%" },
	{ label: "Monkey D. Luffy", code: "OP16", art: "/assets/guides/Luffy op16.png", first: "77.1%", second: "76.7%" },
	{ label: "Koala", code: "OP12", art: "/assets/guides/Koala op12.png", first: "62.3%", second: "70.6%" },
	{ label: "Marshall D. Teach", code: "OP16", art: "/assets/guides/Teach-op16.png", first: "33.3%", second: "21.7%" },
	{ label: "Yamato", code: "OP06", art: "/assets/guides/Yamato op06.png", first: "78.1%", second: "73.3%" },
	{ label: "Crocodile", code: "OP14", art: "/assets/guides/crocodile-op14.png", first: "72.1%", second: "48%" },
	{ label: "Monkey D. Luffy", code: "OP11", art: "/assets/guides/luffy op11.png", first: "74.4%", second: "70%" },
];
---

<MainLayout title={title} description={description}>
	<section class="hero meta-article-hero">
		<div class="container article-hero-grid">
			<div>
				<span class="hero-badge">Meta Article</span>
				<h1>OP15 Enel Stats In OP17 Format</h1>
				<div class="article-leader-hero">
					<img src={leaderHeroArt} alt="Purple Enel leader art" loading="eager" />
				</div>
				<p class="article-kicker">Turn-order stats for Purple Enel in the OP17 field.</p>
				<p>
					Purple Enel is a strong contender for players looking for a leader that controls the pace of the game through
					DON!! manipulation and efficient value plays.
				</p>
				<p>
					Built around resource control, flexible DON!! usage, and consistent pressure, the deck rewards tight sequencing
					and smart decision-making to outvalue opponents over time.
				</p>
			</div>
			<div class="article-hero-side">
				<div class="hero-summary-card">
					<div class="hero-summary-label">Format</div>
						<strong>OP17</strong>
					<div class="hero-summary-divider"></div>
					<div class="hero-summary-label">Source Sample</div>
					<strong>{summary.totalGames} Games</strong>
				</div>
			</div>
		</div>
	</section>

	<section class="stats-section">
		<div class="container stats-stack">
			<article class="stats-panel">
				<div class="section-header">
					<div>
						<h2>1st / 2nd Win Rate Stats</h2>
						<p>
							How does Purple Enel perform going 1st vs. 2nd? These win rate stats show how turn order affects Enel&apos;s gameplay—crucial
							insight for deciding how to approach specific matchups.
						</p>
					</div>
				</div>

				<div class="summary-metrics">
					<div class="summary-metric">
						<span class="summary-label">Total Games</span>
						<strong>{summary.totalGames}</strong>
					</div>
					<div class="summary-metric">
						<span class="summary-label">Winrate</span>
						<strong>{summary.winRate}</strong>
					</div>
					<div class="summary-metric">
						<span class="summary-label">W / L</span>
						<strong class="wl-stat">
							<span class="wl-win">{summary.wins}</span>/<span class="wl-loss">{summary.losses}</span>
						</strong>
					</div>
				</div>

				<div class="turn-order-grid">
					{featuredTurnOrderStats.map((entry) => (
						<div class="turn-order-card">
							<div class="leader-art-frame">
								{entry.art ? (
									<img src={entry.art} alt={`${entry.label} leader art`} loading="lazy" />
								) : (
									<div class="leader-art-placeholder">{entry.code}</div>
								)}
							</div>
							<div class="turn-order-meta">
								<div class="turn-order-name">{entry.label}</div>
								<div class="turn-order-code">{entry.code}</div>
							</div>
							<div class="turn-order-split">
								<div class={`turn-rate ${getRateTone(entry.first)}`}>
									<span class="turn-label">1st</span>
									<strong>{entry.first}</strong>
								</div>
								<div class={`turn-rate ${getRateTone(entry.second)}`}>
									<span class="turn-label">2nd</span>
									<strong>{entry.second}</strong>
								</div>
							</div>
						</div>
					))}
				</div>
			</article>
		</div>
	</section>
</MainLayout>

<style>
	.meta-article-hero {
		padding-bottom: 34px;
	}

	.article-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) 260px;
		gap: 1.5rem;
		align-items: start;
	}

	.article-kicker {
		color: var(--text-200);
		font-weight: 600;
	}

	.article-leader-hero {
		margin: 1.15rem 0 1.1rem;
		border-radius: 20px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background:
			radial-gradient(circle at left, rgba(117, 51, 142, 0.26), transparent 36%),
			radial-gradient(circle at right, rgba(218, 100, 204, 0.18), transparent 40%),
			rgba(8, 11, 19, 0.96);
		box-shadow: var(--shadow);
	}

	.article-leader-hero img {
		display: block;
		width: 100%;
		aspect-ratio: 3.2 / 1;
		object-fit: cover;
		object-position: center 18%;
	}

	.hero-summary-card {
		background:
			radial-gradient(circle at top left, rgba(117, 51, 142, 0.34), transparent 46%),
			radial-gradient(circle at top right, rgba(218, 100, 204, 0.2), transparent 44%),
			linear-gradient(135deg, rgba(78, 28, 98, 0.26), rgba(132, 50, 126, 0.16) 58%, rgba(12, 17, 30, 0.94));
		border: 1px solid rgba(201, 101, 205, 0.24);
		border-radius: 20px;
		padding: 1rem 1.1rem;
		display: grid;
		gap: 0.45rem;
		box-shadow: var(--shadow);
	}

	.hero-summary-label {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-300);
	}

	.hero-summary-divider {
		height: 1px;
		background: rgba(255, 255, 255, 0.08);
		margin: 0.2rem 0 0.15rem;
	}

	.stats-section {
		padding: 0 0 56px;
	}

	.stats-stack {
		display: grid;
		gap: 1.2rem;
	}

	.stats-panel {
		background: rgba(10, 14, 24, 0.82);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 22px;
		padding: 1.25rem;
		display: grid;
		gap: 1rem;
	}

	.section-header h2 {
		margin-bottom: 0.55rem;
	}

	.section-header p {
		margin: 0;
		max-width: 760px;
		color: var(--text-200);
	}

	.summary-metrics {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.summary-metric {
		background: rgba(8, 11, 19, 0.92);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 18px;
		padding: 0.95rem 0.9rem;
		display: grid;
		gap: 0.3rem;
	}

	.summary-label {
		font-size: 0.74rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #8fb3ff;
	}

	.summary-metric strong {
		font-size: 1rem;
	}

	.wl-stat {
		display: inline-flex;
		gap: 0.05rem;
		align-items: baseline;
	}

	.wl-win {
		color: #57d18b;
	}

	.wl-loss {
		color: #ff8d6f;
	}

	.turn-order-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 1rem;
	}

	.turn-order-card {
		border: 1px solid var(--border);
		border-radius: 18px;
		padding: 0.8rem;
		background: rgba(7, 10, 18, 0.92);
		display: grid;
		gap: 0.7rem;
	}

	.leader-art-frame img,
	.leader-art-placeholder {
		width: 100%;
		aspect-ratio: 1.75 / 1;
		border-radius: 14px;
		display: block;
	}

	.leader-art-frame img {
		object-fit: cover;
		object-position: center top;
	}

	.leader-art-placeholder {
		display: grid;
		place-items: center;
		background:
			radial-gradient(circle at top left, rgba(117, 51, 142, 0.28), transparent 45%),
			radial-gradient(circle at bottom right, rgba(218, 100, 204, 0.22), transparent 48%),
			rgba(12, 17, 30, 0.96);
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: var(--text-100);
		font-weight: 800;
	}

	.turn-order-meta {
		display: grid;
		gap: 0.18rem;
	}

	.turn-order-name {
		font-weight: 800;
		line-height: 1.2;
	}

	.turn-order-code {
		color: #9fb7ff;
		font-size: 0.82rem;
	}

	.turn-order-split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.turn-rate {
		border-radius: 14px;
		padding: 0.55rem 0.45rem;
		display: grid;
		justify-items: center;
		gap: 0.2rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.02);
	}

	.turn-rate-positive {
		background: rgba(19, 76, 52, 0.36);
		border-color: rgba(70, 200, 128, 0.28);
	}

	.turn-rate-negative {
		background: rgba(82, 28, 38, 0.32);
		border-color: rgba(215, 92, 122, 0.24);
	}

	.turn-rate-neutral {
		background: rgba(55, 68, 95, 0.3);
		border-color: rgba(149, 165, 195, 0.18);
	}

	.turn-label {
		color: var(--text-300);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.turn-rate strong {
		color: var(--text-100);
		font-size: 0.94rem;
	}

	.analysis-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.analysis-card {
		background: rgba(8, 11, 19, 0.92);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 18px;
		padding: 1rem;
	}

	.analysis-card h3 {
		margin-bottom: 0.4rem;
		font-size: 1.05rem;
	}

	.analysis-card p {
		margin: 0;
		color: var(--text-200);
	}

	.deck-guide-link-copy {
		margin-top: 0.2rem;
	}

	.deck-guide-link {
		color: #ff8b3d;
		font-weight: 700;
	}

	.deck-guide-link:hover {
		color: #ffb06f;
	}

	@media (max-width: 900px) {
		.article-hero-grid {
			grid-template-columns: 1fr;
		}

		.summary-metrics,
		.analysis-grid {
			grid-template-columns: 1fr;
		}

		.turn-order-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.article-leader-hero img {
			object-position: center 18%;
		}

		.turn-order-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.8rem;
		}

		.turn-order-card {
			padding: 0.7rem;
		}
	}
</style>
