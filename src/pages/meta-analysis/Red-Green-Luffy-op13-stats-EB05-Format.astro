---
import MainLayout from "../../layouts/MainLayout.astro";
import { getOptimizedAssetUrl } from "../../lib/assets";

const title = "OP13 Red/Green Monkey D. Luffy 1st/2nd Win Rates";
const description =
	"Turn-order win rates for OP13 Red/Green Monkey D. Luffy in the EB05 format, with a matchup-by-matchup breakdown of first and second player performance.";

const summary = {
	totalGames: "12434",
	winRate: "56.9%",
	wins: "7039",
	losses: "5395",
};

const leaderHeroArt = "/assets/guides/monkey-d-luffy-op13.png";
const getRateTone = (value: string) => {
	const numeric = Number.parseFloat(value.replace("%", "").trim());
	if (numeric < 50) return "turn-rate-negative";
	if (numeric > 50) return "turn-rate-positive";
	return "turn-rate-neutral";
};

const featuredTurnOrderStats = [
	{ label: "Rocks D. Xebec", code: "OP17-039", art: "/assets/guides/Rocks.DXebec op17.png", first: "46.8%", second: "49.6%" },
	{ label: "Monkey D. Luffy", code: "OP13", art: "/assets/guides/monkey-d-luffy-op13.png", first: "48.1%", second: "51.9%" },
	{ label: "Kaido", code: "OP17", art: "/assets/guides/Kaido op17.png", first: "58.2%", second: "47.5%" },
	{ label: "Enel", code: "OP05", art: "/assets/guides/Enel OP05-098.png", first: "43.8%", second: "51.2%" },
	{ label: "Buggy", code: "OP09", art: "/assets/guides/BuggY OP09.png", first: "74.3%", second: "51.1%" },
	{ label: "Enel", code: "OP15-058", art: "/assets/guides/enel-op15.png", first: "72.9%", second: "64.3%" },
	{ label: "Shanks", code: "OP17", art: "/assets/guides/Shanks op17.png", first: "56.2%", second: "53%" },
	{ label: "Sabo", code: "OP13", art: "/assets/guides/Sabo OP13-004.png", first: "62.6%", second: "75.9%" },
	{ label: "Boa Hancock", code: "OP14", art: "/assets/guides/boa-hancock-op14.png", first: "48.5%", second: "64.5%" },
	{ label: "Monkey D. Luffy", code: "OP17", art: "/assets/guides/Luffy OP17.png", first: "72.3%", second: "72.3%" },
	{ label: "Luffy & Ace", code: "ST30", art: "/assets/guides/Luffy-st30.png", first: "79.7%", second: "80%" },
	{ label: "Marshall D. Teach", code: "OP16", art: "/assets/guides/Teach-op16.png", first: "43.7%", second: "61.5%" },
	{ label: "Monkey D. Luffy", code: "OP16", art: "/assets/guides/Luffy op16.png", first: "69.6%", second: "78.8%" },
	{ label: "Nico Robin", code: "EB05", art: "/assets/guides/Nico Robin EB05.png", first: "70%", second: "64.7%" },
	{ label: "Nico Robin", code: "OP09", art: "/assets/guides/Nico-Robin-op09.png", first: "60%", second: "49.3%" },
	{ label: "Pudding", code: "OP08", art: "/assets/guides/Pudding op08.png", first: "68%", second: "69%" },
	{ label: "Marshall D. Teach", code: "OP09", art: "/assets/guides/Marshall D. Teach OP09-081.png", first: "29.4%", second: "20.2%" },
	{ label: "Donquixote Rosinante", code: "OP12", art: "/assets/guides/rosinante-op12.png", first: "61.4%", second: "72.7%" },
	{ label: "Trafalgar Law", code: "OP14", art: "/assets/guides/trafalgar-law-op14.png", first: "69.7%", second: "67.9%" },
	{ label: "Portgas D. Ace", code: "OP16", art: "/assets/guides/Ace-op16.png", first: "57.1%", second: "78.6%" },
	{ label: "Gecko Moria", code: "OP14", art: "/assets/guides/Gecko Moria OP14-080.png", first: "52.3%", second: "63.9%" },
	{ label: "Monkey D. Luffy", code: "ST10", art: "/assets/guides/Luffy ST10-002.png", first: "77.6%", second: "71.7%" },
	{ label: "Yamato", code: "OP16", art: "/assets/guides/yamato-op16.png", first: "74.1%", second: "75%" },
	{ label: "Sugar", code: "OP10", art: "/assets/guides/Sugar OP10.png", first: "44.4%", second: "67.6%" },
	{ label: "Shirahoshi", code: "OP11", art: "/assets/guides/ShiraoshiOP11-022.png", first: "75%", second: "71%" },
	{ label: "Charlotte Linlin", code: "OP17", art: "/assets/guides/Charlotte Linlin op17.png", first: "43.5%", second: "68.4%" },
	{ label: "Imu", code: "OP13", art: "/assets/guides/Imu OP13-079.png", first: "50%", second: "75%" },
];
---

<MainLayout title={title} description={description}>
	<section class="hero meta-article-hero">
		<div class="container article-hero-grid">
			<div>
				<span class="hero-badge">Meta Article</span>
				<h1>OP13 Red/Green Monkey D. Luffy 1st/2nd Win Rates</h1>
				<div class="article-leader-hero">
					<img src={getOptimizedAssetUrl(leaderHeroArt)} alt="Red/Green Monkey D. Luffy leader art" loading="eager" />
				</div>
				<p class="article-kicker">Turn-order stats for Red/Green Luffy in the EB05 field.</p>
				<p>
					If you&apos;re looking for a deck that rewards smart resource management, strong defensive sequencing, and explosive mid-to-late game
					pressure, Red/Green Monkey D. Luffy is exactly what you need. The deck thrives on banking DON!! to unlock powerful defensive turns
					while setting up efficient counterplay and threatening attackers. Understanding your matchups, managing your DON!! carefully, and
					knowing when to shift between defense and aggression are all key to maximizing the deck&apos;s potential and keeping control of the game
					from start to finish.
				</p>
				<p>
					How does <strong>Red/Green Luffy</strong> perform going 1st vs. 2nd? These win rate stats break down how turn order affects
					Luffy&apos;s gameplay—crucial insight for deciding how to approach specific matchups.
				</p>
			</div>
			<div class="article-hero-side">
				<div class="hero-summary-card">
					<div class="hero-summary-label">Format</div>
					<strong>EB05</strong>
					<div class="hero-summary-divider"></div>
					<div class="hero-summary-label">Source Sample</div>
					<strong>{summary.totalGames} Games</strong>
				</div>
			</div>
		</div>
	</section>

	<section class="stats-section">
		<div class="container stats-stack">
			<article class="stats-panel">
				<div class="section-header"><div><h2>1st / 2nd Win Rate Stats</h2><p>How does Red/Green Luffy perform going 1st vs. 2nd? These win rate stats break down how turn order affects Luffy&apos;s gameplay—crucial insight for deciding how to approach specific matchups.</p></div></div>
				<div class="summary-metrics">
					<div class="summary-metric"><span class="summary-label">Total Games</span><strong>{summary.totalGames}</strong></div>
					<div class="summary-metric"><span class="summary-label">Winrate</span><strong>{summary.winRate}</strong></div>
					<div class="summary-metric"><span class="summary-label">W / L</span><strong class="wl-stat"><span class="wl-win">{summary.wins}</span>/<span class="wl-loss">{summary.losses}</span></strong></div>
				</div>
				<div class="turn-order-grid">
					{featuredTurnOrderStats.map((entry) => (
						<div class="turn-order-card">
							<div class="leader-art-frame">{entry.art ? <img src={getOptimizedAssetUrl(entry.art)} alt={`${entry.label} leader art`} loading="lazy" /> : <div class="leader-art-placeholder">{entry.code}</div>}</div>
							<div class="turn-order-meta"><div class="turn-order-name">{entry.label}</div><div class="turn-order-code">{entry.code}</div></div>
							<div class="turn-order-split"><div class={`turn-rate ${getRateTone(entry.first)}`}><span class="turn-label">1st</span><strong>{entry.first}</strong></div><div class={`turn-rate ${getRateTone(entry.second)}`}><span class="turn-label">2nd</span><strong>{entry.second}</strong></div></div>
						</div>
					))}
				</div>
			</article>
		</div>
	</section>
</MainLayout>

<style>
	.meta-article-hero { padding-bottom: 34px; }
	.article-hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) 260px; gap: 1.5rem; align-items: start; }
	.article-kicker { color: var(--text-200); font-weight: 600; }
	.article-leader-hero { margin: 1.15rem 0 1.1rem; border-radius: 20px; overflow: hidden; border: 1px solid rgba(255,255,255,.08); background: radial-gradient(circle at left, rgba(137,49,42,.26), transparent 36%), radial-gradient(circle at right, rgba(43,117,84,.18), transparent 40%), rgba(8,11,19,.96); box-shadow: var(--shadow); }
	.article-leader-hero img { display: block; width: 100%; aspect-ratio: 3.2 / 1; object-fit: cover; object-position: center 45%; }
	.hero-summary-card { background: radial-gradient(circle at top left, rgba(137,49,42,.34), transparent 46%), radial-gradient(circle at top right, rgba(43,117,84,.2), transparent 44%), linear-gradient(135deg, rgba(86,35,37,.26), rgba(35,91,65,.16) 58%, rgba(12,17,30,.94)); border: 1px solid rgba(170,103,89,.24); border-radius: 20px; padding: 1rem 1.1rem; display: grid; gap: .45rem; box-shadow: var(--shadow); }
	.hero-summary-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-300); }
	.hero-summary-divider { height: 1px; background: rgba(255,255,255,.08); margin: .2rem 0 .15rem; }
	.stats-section { padding: 0 0 56px; }
	.stats-stack { display: grid; gap: 1.2rem; }
	.stats-panel { background: rgba(10,14,24,.82); border: 1px solid rgba(255,255,255,.08); border-radius: 22px; padding: 1.25rem; display: grid; gap: 1rem; }
	.section-header h2 { margin-bottom: .55rem; }
	.section-header p { margin: 0; max-width: 760px; color: var(--text-200); }
	.summary-metrics { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: .85rem; }
	.summary-metric { background: rgba(8,11,19,.92); border: 1px solid rgba(255,255,255,.08); border-radius: 18px; padding: .95rem .9rem; display: grid; gap: .3rem; }
	.summary-label { font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: #8fb3ff; }
	.summary-metric strong { font-size: 1rem; }
	.wl-stat { display: inline-flex; gap: .05rem; align-items: baseline; }
	.wl-win { color: #57d18b; }
	.wl-loss { color: #ff8d6f; }
	.turn-order-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 1rem; }
	.turn-order-card { border: 1px solid var(--border); border-radius: 18px; padding: .8rem; background: rgba(7,10,18,.92); display: grid; gap: .7rem; }
	.leader-art-frame img, .leader-art-placeholder { width: 100%; aspect-ratio: 1.75 / 1; border-radius: 14px; display: block; }
	.leader-art-frame img { object-fit: cover; object-position: center top; }
	.leader-art-placeholder { display: grid; place-items: center; background: rgba(35,42,60,.9); border: 1px solid rgba(255,255,255,.08); color: var(--text-100); font-weight: 800; }
	.turn-order-meta { display: grid; gap: .18rem; }
	.turn-order-name { font-weight: 800; line-height: 1.2; }
	.turn-order-code { color: #9fb7ff; font-size: .82rem; }
	.turn-order-split { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .5rem; }
	.turn-rate { border-radius: 14px; padding: .55rem .45rem; display: grid; justify-items: center; gap: .2rem; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); }
	.turn-rate-positive { background: rgba(19,76,52,.36); border-color: rgba(70,200,128,.28); }
	.turn-rate-negative { background: rgba(82,28,38,.32); border-color: rgba(215,92,122,.24); }
	.turn-rate-neutral { background: rgba(55,68,95,.3); border-color: rgba(149,165,195,.18); }
	.turn-label { color: var(--text-300); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; }
	.turn-rate strong { color: var(--text-100); font-size: .94rem; }
	@media (max-width: 900px) { .article-hero-grid { grid-template-columns: 1fr; } .summary-metrics { grid-template-columns: 1fr; } .turn-order-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }
	@media (max-width: 640px) { .article-leader-hero img { object-position: center 45%; } .turn-order-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: .8rem; } .turn-order-card { padding: .7rem; } }
</style>
