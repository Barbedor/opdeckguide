---
import MainLayout from "../../layouts/MainLayout.astro";
import { getOptimizedAssetUrl } from "../../lib/assets";

const title = "OP17 Purple Kaido 1st/2nd Win Rates";
const description =
	"Turn-order win rates for Purple Kaido in the OP17 format, with a matchup-by-matchup breakdown of first and second player performance.";

const summary = {
	totalGames: "37670",
	winRate: "49.4%",
	wins: "18627",
	losses: "19043",
};

const leaderHeroArt = "/assets/guides/Kaido op17.png";
const getRateTone = (value: string) => {
	const numeric = Number.parseFloat(value.replace("%", "").trim());
	if (numeric < 50) return "turn-rate-negative";
	if (numeric > 50) return "turn-rate-positive";
	return "turn-rate-neutral";
};

const featuredTurnOrderStats = [
	{ label: "Rocks D. Xebec", code: "OP17-039", art: "/assets/guides/Rocks.DXebec op17.png", first: "56.8%", second: "44.7%" },
	{ label: "Luffy & Ace", code: "ST30", art: "/assets/guides/Luffy-st30.png", first: "33.4%", second: "22.1%" },
	{ label: "Monkey D. Luffy", code: "OP17", art: "/assets/guides/Luffy OP17.png", first: "43%", second: "42%" },
	{ label: "Kaido", code: "OP17", art: "/assets/guides/Kaido op17.png", first: "65.4%", second: "34.6%" },
	{ label: "Sabo", code: "OP13", art: "/assets/guides/Sabo OP13-004.png", first: "59.1%", second: "47.9%" },
	{ label: "Nico Robin", code: "OP09", art: "/assets/guides/Nico-Robin-op09.png", first: "57.4%", second: "48.5%" },
	{ label: "Enel", code: "OP15-058", art: "/assets/guides/enel-op15.png", first: "65.6%", second: "42.7%" },
	{ label: "Shanks", code: "OP17", art: "/assets/guides/Shanks op17.png", first: "46.6%", second: "37.8%" },
	{ label: "Pudding", code: "OP08", art: "/assets/guides/Pudding op08.png", first: "54.9%", second: "43.8%" },
	{ label: "Boa Hancock", code: "OP14", art: "/assets/guides/boa-hancock-op14.png", first: "52.7%", second: "53.8%" },
	{ label: "Portgas D. Ace", code: "OP16", art: "/assets/guides/Ace-op16.png", first: "57.6%", second: "45.1%" },
	{ label: "Enel", code: "OP05", art: "/assets/guides/Enel OP05-098.png", first: "59.5%", second: "60.8%" },
	{ label: "Donquixote Rosinante", code: "OP12", art: "/assets/guides/rosinante-op12.png", first: "52%", second: "32.3%" },
	{ label: "Yamato", code: "OP16", art: "/assets/guides/yamato-op16.png", first: "41.6%", second: "38.5%" },
	{ label: "Charlotte Linlin", code: "OP17", art: "/assets/guides/Charlotte Linlin op17.png", first: "49.5%", second: "51.5%" },
	{ label: "Imu", code: "OP13", art: "/assets/guides/Imu OP13-079.png", first: "48.3%", second: "52.8%" },
	{ label: "Nami", code: "OP11", art: "/assets/guides/nami-op11.png", first: "64.5%", second: "57.3%" },
	{ label: "Monkey D. Luffy", code: "OP13", art: "/assets/guides/monkey-d-luffy-op13.png", first: "65.5%", second: "52.6%" },
	{ label: "Roronoa Zoro", code: "OP12", art: "/assets/guides/Roronoa Zoro OP12-020.png", first: "57.3%", second: "55.6%" },
	{ label: "Portgas D. Ace", code: "OP13", art: "/assets/guides/portgas-d-ace-op13.png", first: "73.8%", second: "68.6%" },
	{ label: "Marshall D. Teach", code: "OP16", art: "/assets/guides/Teach-op16.png", first: "44%", second: "67.4%" },
	{ label: "Brook", code: "OP16", art: "/assets/guides/Brook OP15-022.png", first: "46.8%", second: "41.9%" },
	{ label: "Gecko Moria", code: "OP14", art: "/assets/guides/Gecko Moria OP14-080.png", first: "55.2%", second: "51.9%" },
	{ label: "Edward Newgate", code: "OP17", art: "/assets/guides/Edward.Newgate op17.png", first: "77.9%", second: "77.6%" },
	{ label: "Marshall D. Teach", code: "OP09", art: "/assets/guides/Marshall D. Teach OP09-081.png", first: "48.4%", second: "73.7%" },
	{ label: "Monkey D. Luffy", code: "OP16", art: "/assets/guides/Luffy op16.png", first: "30.5%", second: "24.5%" },
	{ label: "Gol D. Roger", code: "OP13", art: "/assets/guides/Gol.D.Roger OP13-003.png", first: "82.3%", second: "85.1%" },
	{ label: "Kalgara", code: "OP08", art: "/assets/guides/Kalgara OP08-098.png", first: "69%", second: "36.7%" },
];
---

<MainLayout title={title} description={description}>
	<section class="hero meta-article-hero">
		<div class="container article-hero-grid">
			<div>
				<span class="hero-badge">Meta Article</span>
				<h1>OP17 Purple Kaido 1st/2nd Win Rates</h1>
				<div class="article-leader-hero">
					<img src={getOptimizedAssetUrl(leaderHeroArt)} alt="Purple Kaido leader art" loading="eager" />
				</div>
				<p class="article-kicker">Turn-order stats for Purple Kaido in the OP17 field.</p>
				<p>Purple Kaido is a leader that leverages DON!! acceleration, powerful Characters, and protective effects.</p>
				<p>
					How does <strong>Purple Kaido</strong> perform going 1st vs. 2nd? These win rate stats break down how turn order affects
					<strong>Purple Kaido&apos;s gameplay</strong>, providing crucial insight into how to approach different matchups and maximize
					the deck&apos;s strengths.
				</p>
				<p class="deck-guide-link-copy">
					Learn how to play Kaido with the
					<a class="deck-guide-link" href="/deck-guides/kaido-op17/">Kaido OP17 Deck Guide</a>.
				</p>
			</div>
			<div class="article-hero-side">
				<div class="hero-summary-card">
					<div class="hero-summary-label">Format</div>
					<strong>OP17</strong>
					<div class="hero-summary-divider"></div>
					<div class="hero-summary-label">Source Sample</div>
					<strong>{summary.totalGames} Games</strong>
				</div>
			</div>
		</div>
	</section>

	<section class="stats-section">
		<div class="container stats-stack">
			<article class="stats-panel">
				<div class="section-header">
					<div>
						<h2>1st / 2nd Win Rate Stats</h2>
						<p>
							How does Purple Kaido perform going 1st vs. 2nd? These win rate stats break down how turn order affects Purple Kaido&apos;s
							gameplay, providing crucial insight into how to approach different matchups.
						</p>
					</div>
				</div>

				<div class="summary-metrics">
					<div class="summary-metric"><span class="summary-label">Total Games</span><strong>{summary.totalGames}</strong></div>
					<div class="summary-metric"><span class="summary-label">Winrate</span><strong>{summary.winRate}</strong></div>
					<div class="summary-metric">
						<span class="summary-label">W / L</span>
						<strong class="wl-stat"><span class="wl-win">{summary.wins}</span>/<span class="wl-loss">{summary.losses}</span></strong>
					</div>
				</div>

				<div class="turn-order-grid">
					{featuredTurnOrderStats.map((entry) => (
						<div class="turn-order-card">
							<div class="leader-art-frame">
								{entry.art ? <img src={getOptimizedAssetUrl(entry.art)} alt={`${entry.label} leader art`} loading="lazy" /> : <div class="leader-art-placeholder">{entry.code}</div>}
							</div>
							<div class="turn-order-meta"><div class="turn-order-name">{entry.label}</div><div class="turn-order-code">{entry.code}</div></div>
							<div class="turn-order-split">
								<div class={`turn-rate ${getRateTone(entry.first)}`}><span class="turn-label">1st</span><strong>{entry.first}</strong></div>
								<div class={`turn-rate ${getRateTone(entry.second)}`}><span class="turn-label">2nd</span><strong>{entry.second}</strong></div>
							</div>
						</div>
					))}
				</div>
			</article>
		</div>
	</section>
</MainLayout>

<style>
	.meta-article-hero { padding-bottom: 34px; }
	.article-hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) 260px; gap: 1.5rem; align-items: start; }
	.article-kicker { color: var(--text-200); font-weight: 600; }
	.article-leader-hero { margin: 1.15rem 0 1.1rem; border-radius: 20px; overflow: hidden; border: 1px solid rgba(255,255,255,.08); background: radial-gradient(circle at left, rgba(117,51,142,.26), transparent 36%), radial-gradient(circle at right, rgba(218,100,204,.18), transparent 40%), rgba(8,11,19,.96); box-shadow: var(--shadow); }
	.article-leader-hero img { display: block; width: 100%; aspect-ratio: 3.2 / 1; object-fit: cover; object-position: center 30%; }
	.hero-summary-card { background: radial-gradient(circle at top left, rgba(117,51,142,.34), transparent 46%), radial-gradient(circle at top right, rgba(218,100,204,.2), transparent 44%), linear-gradient(135deg, rgba(78,28,98,.26), rgba(132,50,126,.16) 58%, rgba(12,17,30,.94)); border: 1px solid rgba(201,101,205,.24); border-radius: 20px; padding: 1rem 1.1rem; display: grid; gap: .45rem; box-shadow: var(--shadow); }
	.hero-summary-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-300); }
	.hero-summary-divider { height: 1px; background: rgba(255,255,255,.08); margin: .2rem 0 .15rem; }
	.stats-section { padding: 0 0 56px; }
	.stats-stack { display: grid; gap: 1.2rem; }
	.stats-panel { background: rgba(10,14,24,.82); border: 1px solid rgba(255,255,255,.08); border-radius: 22px; padding: 1.25rem; display: grid; gap: 1rem; }
	.section-header h2 { margin-bottom: .55rem; }
	.section-header p { margin: 0; max-width: 760px; color: var(--text-200); }
	.summary-metrics { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: .85rem; }
	.summary-metric { background: rgba(8,11,19,.92); border: 1px solid rgba(255,255,255,.08); border-radius: 18px; padding: .95rem .9rem; display: grid; gap: .3rem; }
	.summary-label { font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: #8fb3ff; }
	.summary-metric strong { font-size: 1rem; }
	.wl-stat { display: inline-flex; gap: .05rem; align-items: baseline; }
	.wl-win { color: #57d18b; }
	.wl-loss { color: #ff8d6f; }
	.turn-order-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 1rem; }
	.turn-order-card { border: 1px solid var(--border); border-radius: 18px; padding: .8rem; background: rgba(7,10,18,.92); display: grid; gap: .7rem; }
	.leader-art-frame img, .leader-art-placeholder { width: 100%; aspect-ratio: 1.75 / 1; border-radius: 14px; display: block; }
	.leader-art-frame img { object-fit: cover; object-position: center top; }
	.leader-art-placeholder { display: grid; place-items: center; background: radial-gradient(circle at top left, rgba(117,51,142,.28), transparent 45%), radial-gradient(circle at bottom right, rgba(218,100,204,.22), transparent 48%), rgba(12,17,30,.96); border: 1px solid rgba(255,255,255,.08); color: var(--text-100); font-weight: 800; }
	.turn-order-meta { display: grid; gap: .18rem; }
	.turn-order-name { font-weight: 800; line-height: 1.2; }
	.turn-order-code { color: #9fb7ff; font-size: .82rem; }
	.turn-order-split { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .5rem; }
	.turn-rate { border-radius: 14px; padding: .55rem .45rem; display: grid; justify-items: center; gap: .2rem; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); }
	.turn-rate-positive { background: rgba(19,76,52,.36); border-color: rgba(70,200,128,.28); }
	.turn-rate-negative { background: rgba(82,28,38,.32); border-color: rgba(215,92,122,.24); }
	.turn-rate-neutral { background: rgba(55,68,95,.3); border-color: rgba(149,165,195,.18); }
	.turn-label { color: var(--text-300); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; }
	.turn-rate strong { color: var(--text-100); font-size: .94rem; }
	.deck-guide-link-copy { margin: .2rem 0 0; }
	.deck-guide-link { color: #ff8b3d; font-weight: 700; text-decoration: none; }
	.deck-guide-link:hover { color: #ffb06f; text-decoration: underline; }
	@media (max-width: 900px) { .article-hero-grid { grid-template-columns: 1fr; } .summary-metrics { grid-template-columns: 1fr; } .turn-order-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }
	@media (max-width: 640px) { .article-leader-hero img { object-position: center 30%; } .turn-order-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: .8rem; } .turn-order-card { padding: .7rem; } }
</style>
