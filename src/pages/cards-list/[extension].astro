				" Add up to 1 black card from your trash to your hand.",
			],
		],
	},
	"ST31-004": {
		rarity: "Gold",
		stats: "Red / Cost 7 / Strike / Power 9000",
		traits: "The Four Emperors/Straw Hat Crew",
		effectLines: [
			[
				"If you have a total of 3 or more given DON!! cards, this Character gains ",
				keyword("rush", "Rush"),
				".",
			],
			["(This card can attack on the turn in which it is played.)"],
			[
				keyword("on-play", "On Play"),
				" For every {Straw Hat Crew} type card on your field, give up to 1 of your opponent's Characters -1000 power during this turn.",
			],
		],
	},
	"OP16-098": {
		rarity: "SP",
		stats: "Black / Cost 6 / Strike / Power 5000 / Counter 1000",
		traits: "Land of Wano",
		effectLines: [
			[
				keyword("on-play", "On Play"),
				" Draw 1 card and trash 1 card from your hand.",
			],
			[
				keyword("activate-main", "Activate: Main"),
				" You may trash this Character: Play up to 1 black [Yamato] with a cost of 8 from your trash.",
			],
		],
	},
};
const getLeakSortRank = (card) => {
	if (card.edition === "PIRATE CREW SUPER ALT MANGA") return 1;
	if (card.code === "OP01-016") return 6;
	if (extension.toUpperCase() === "EB05" && card.rarity === "Leader Card" && card.edition === "ALT") return 7;
	if (extension.toUpperCase() === "OP18" && card.code === "OP17-119" && card.edition === "ALT") return 1;
	if (card.rarity === "SP") return 2;
	if (card.code === "OP17-040") return 0;
	if (card.rarity === "Treasure Rare") return 3;
	if (card.rarity === "Gold") return 4;
	if (card.code.startsWith("OP17-DON")) return 5;
	if (card.code.startsWith("OP17-")) return 0;
	if (card.code.startsWith("OP18-")) return 0;
	return 2;
};

const getLeakSortCode = (code) => {
	if (code === "OP17-0XX") return "OP17-086";
	return code;
};

const getLeakDisplaySortCode = (card) => {
	const explicitAnchors = {
		"OP17-119-ALT": "OP18-999",
		"OP17-HARUTA": "OP17-018.7",
		"OP17-RAKUYO": "OP17-018.8",
		"OP17-017": "OP17-018.85",
		"OP17-GURARARARA": "OP17-018.9",
		"OP17-077": "OP17-077.95",
		"OP17-JACK": "OP17-077.6",
		"OP17-BASIL-HAWKINS": "OP17-077.7",
		"OP17-SASAKI": "OP17-077.8",
		"OP17-WORORORO": "OP17-077.9",
		"OP17-DAIFUKU": "OP17-115.5",
		"OP17-MONT-DOR": "OP17-115.6",
		"OP17-OVEN": "OP17-115.7",
		"OP17-PEROSPERO": "OP17-115.8",
		"OP17-CODE-OF-HONOR": "OP17-115.9",
	};
	if (explicitAnchors[card.code]) return explicitAnchors[card.code];
	if (/^OP17-[A-Z]/.test(card.code) && !card.code.startsWith("OP17-DON")) {
		return `${card.code}-${card.name}`;
	}
	return getLeakSortCode(card.code);
};

const leakCards = isLeakPage
	? cards
			.map((card) => {
				const details = leakCardDetails[card.code];
				const rarity = details?.rarity ?? "";
				const hideEditionChip = rarity === "SP" || rarity === "Gold";
				const hasStandaloneSpecialRarity = card.edition === "PIRATE CREW SUPER ALT MANGA";
				const useHeaderAltBadge =
					extension.toUpperCase() === "EB05" && details?.rarity === "Leader Card" && card.edition === "ALT";
				const useOp18LokiAltBadge =
					extension.toUpperCase() === "OP18" && card.code === "OP17-119" && card.edition === "ALT";
				const staticVariantLabel =
					!useHeaderAltBadge &&
					!useOp18LokiAltBadge &&
					!hasStandaloneSpecialRarity &&
					(card.variants?.length ?? 0) === 0 &&
					["ALT", "ALT BAKI"].includes(card.edition ?? "")
						? card.edition
						: null;
				return details
					? {
							...card,
							...details,
							rarity: hasStandaloneSpecialRarity ? card.edition : details.rarity,
							headerBadge:
								useHeaderAltBadge || useOp18LokiAltBadge ? "ALT" : details.headerBadge ?? card.headerBadge ?? null,
							edition: hideEditionChip ? null : details.edition ?? card.edition ?? null,
							variants: [
								...(card.variants ?? []),
								...(staticVariantLabel
									? [
											{
												label: staticVariantLabel,
												fullUrl: card.fullUrl,
												smallUrl: card.smallUrl,
												disabled: true,
											},
										]
									: []),
							],
						}
					: null;
			})
			.filter(Boolean)
			.sort((a, b) => {
				const rankDiff = getLeakSortRank(a) - getLeakSortRank(b);
				if (rankDiff !== 0) return rankDiff;
				return getLeakDisplaySortCode(a).localeCompare(getLeakDisplaySortCode(b), "en");
			})
	: [];
const leakCount = leakCards.length;

const title = isLeakPage
	? revealPageConfig.title
	: `${extensionLabel} Card List | One Piece Card Game`;
const description = isLeakPage
	? revealPageConfig.description
	: `Browse the full ${extensionLabel} card list, search exact card numbers, and open full-size One Piece Card Game previews instantly.`;
---

<MainLayout title={title} description={description}>
	<section class="hero">
		<div class="container">
			<span class="hero-badge">{heroBadgeLabel}</span>
			<h1>{isLeakPage ? `${extensionLabel} Revealed Cards List` : `${extensionLabel} Card List`}</h1>
			{isLeakPage ? (
				<>
					<p>{revealPageConfig.intro}</p>
				</>
			) : (
				<p>
					Every {extensionLabel} card is listed on this page. Open any card for the full-size image, or
					use search if you want to jump straight to an exact card number.
				</p>
			)}
		</div>
	</section>

	<section class="list-section">
		<div class="container">
			<div class="section-header">
				<div>
					<h2>{isLeakPage ? `${extensionLabel} Revealed Cards` : `${extensionLabel} Cards`}</h2>
					<p>
						{isLeakPage
							? `${leakCount} officially revealed cards currently available on this page.`
							: `${cards.length} cards available in this extension.`}
					</p>
				</div>
				<a href="/cards-list/">Back to all extensions</a>
			</div>
			{isLeakPage ? (
				<div class="leak-cards-grid">
					{leakCards.map((card) => {
						return (
						<article class="leak-card">
							<div class="card-thumb-shell leak-card-thumb-shell">
								<button
									class="card-thumb leak-card-thumb"
									type="button"
									data-card
									data-full={card.fullUrl}
									data-name={card.code}
								>
									<img loading="lazy" src={card.smallUrl} alt={`${card.code} ${card.name} card`} />
								</button>
							</div>
							<div class="leak-card-copy">
								<div class="leak-card-header">
									<p class="leak-card-code">{card.code}</p>
									<div class="leak-card-rarity-group">
										<p class="leak-card-rarity">{card.rarity}</p>
										{card.headerBadge ? <p class="leak-card-rarity">{card.headerBadge}</p> : null}
									</div>
								</div>
								<h3>{card.name}</h3>
								<div class="leak-card-meta">
									{card.notes?.map((note) => <p class="leak-chip">{note}</p>)}
								</div>
								{card.variants.length > 0 && (
									<div class="leak-card-variants">
										{card.variants.map((variant) => (
											variant.disabled ? (
												<button type="button" class="variant-button variant-button-static" disabled>
													{variant.label}
												</button>
											) : (
												<button
													type="button"
													class="variant-button"
													data-card
													data-full={variant.fullUrl}
													data-name={`${card.code} ${variant.label}`}
												>
													{variant.label}
												</button>
											)
										))}
									</div>
								)}
								{card.traits && <p class="leak-card-traits">{card.traits}</p>}
								<div class="leak-card-effects">
									{card.effectLines.map((line) => (
										<p class="leak-effect-line">
											{line.map((part) =>
												typeof part === "string" ? (
													<span>{part}</span>
												) : (
													<img
														class="keyword-badge"
														src={`${keywordAssetBase}/${part.icon}.png`}
														alt={part.alt}
													/>
												)
											)}
										</p>
									))}
								</div>
							</div>
						</article>
					)})}
				</div>
			) : (
				<>
					<div
						class:list={["cards-grid", { "cards-grid-expanded-mobile": useExpandedMobileCardGrid }]}
						data-card-grid
					>
						{initialCards.map((card) => {
							const affiliateCard = shouldShowAffiliateLink(card)
								? getCardsListAffiliateCard(card.code, card.edition)
								: null;
							return (
								<div class="card-thumb-shell">
									<button
										class="card-thumb"
										type="button"
										data-card
										data-full={card.fullUrl}
										data-name={card.code}
									>
										<img loading="lazy" src={card.smallUrl} alt={`${card.code} card`} />
									</button>
									{
										affiliateCard && (
											<a
												class="card-affiliate-link"
												href={affiliateCard.affiliateUrl}
												target="_blank"
												rel="nofollow sponsored noopener"
											>
												{affiliateCard.price}
											</a>
										)
									}
								</div>
							);
						})}
					</div>
					{remainingCards.length > 0 && (
						<div class="load-more">
							<button type="button" class="btn btn-secondary" data-load-more>Load more cards</button>
							<p>{remainingCards.length} more cards available</p>
						</div>
					)}
				</>
			)}
		</div>
	</section>

	<section class="faq-section">
		<div class="container">
			<div class="section-header faq-header">
				<div>
					<h2>{extensionLabel} FAQ</h2>
					<p>{isLeakPage ? revealPageConfig.faqIntro : "Quick answers for the most common card list questions."}</p>
				</div>
			</div>
			<div class="faq-grid">
				<article class="faq-card">
					<h3>{isLeakPage ? `Can I browse every ${extensionLabel} card here?` : `Can I browse every ${extensionLabel} card here?`}</h3>
					<p>
						{isLeakPage
							? revealPageConfig.faqCards
							: `Yes. This page lists the full ${extensionLabel} card pool in one place.`}
					</p>
				</article>
				<article class="faq-card">
					<h3>{isLeakPage ? revealPageConfig.faqSecondaryTitle : "Where can I find deck context?"}</h3>
					<p>
						{isLeakPage ? (
							<>{revealPageConfig.faqSecondaryAnswer}</>
						) : (
							<>Use <a href="/deck-guides/">Deck Guides</a> to see how cards show up in real lists.</>
						)}
					</p>
				</article>
			</div>
		</div>
	</section>

	<div class="card-modal" data-modal aria-hidden="true">
		<div class="card-modal-inner" role="dialog" aria-modal="true" aria-label="Card preview">
			<button class="modal-close" type="button" data-close>Close</button>
			<img src="" alt="" data-modal-image />
		</div>
	</div>
</MainLayout>

<script
	define:vars={{
		remainingCards,
		cardsListAffiliateCards,
		cardsListVariantAffiliateCards,
		isLeakPage,
		op17AffiliateEditionsByCode,
	}}
>
	const modal = document.querySelector("[data-modal]");
	const modalImage = document.querySelector("[data-modal-image]");
	const closeButton = document.querySelector("[data-close]");
	const grid = document.querySelector("[data-card-grid]");
	const loadMoreButton = document.querySelector("[data-load-more]");
	const op17AffiliateEditions = op17AffiliateEditionsByCode ?? {};
	const isOp17YamatoSpecial = (card) =>
		card.code === "OP16-098" && /\/Cards\/OP17\/Yamato SPOP16-098_p2\./i.test(card.fullUrl ?? "");
	let remaining = remainingCards ?? [];
	const batchSize = 96;

	const openModal = (fullUrl, name) => {
		if (!modal || !modalImage) return;
		modalImage.setAttribute("src", fullUrl);
		modalImage.setAttribute("alt", `${name} card`);
		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
	};

	const closeModal = () => {
		if (!modal) return;
		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
	};

	document.addEventListener("click", (event) => {
		const cardButton = event.target.closest("[data-card]");
		if (cardButton) {
			const fullUrl = cardButton.getAttribute("data-full");
			const name = cardButton.getAttribute("data-name");
			if (!fullUrl) return;
			openModal(fullUrl, name);
			return;
		}

		if (event.target === modal) {
			closeModal();
		}
	});

	closeButton?.addEventListener("click", closeModal);
	window.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			closeModal();
		}
	});

	const appendBatch = () => {
		if (!grid || remaining.length === 0) return;
		const batch = remaining.splice(0, batchSize);
		batch.forEach((card) => {
			const shell = document.createElement("div");
			shell.className = "card-thumb-shell";

			const button = document.createElement("button");
			button.type = "button";
			button.className = "card-thumb";
			button.setAttribute("data-card", "");
			button.setAttribute("data-full", card.fullUrl);
			button.setAttribute("data-name", card.code);
			const img = document.createElement("img");
			img.loading = "lazy";
			img.src = card.smallUrl;
			img.alt = `${card.code} card`;
			button.appendChild(img);
			shell.appendChild(button);
			const affiliateCard = !isLeakPage
				? (card.edition ? cardsListVariantAffiliateCards[`${card.code}::${card.edition}`] : null) ??
					cardsListAffiliateCards[card.code]
				: null;
			const shouldShowAffiliateLink =
				affiliateCard &&
				(card.code !== "OP16-098" || isOp17YamatoSpecial(card)) &&
				!(
					op17AffiliateEditions[card.code] &&
					!op17AffiliateEditions[card.code].includes(card.edition ?? "")
				) &&
				!(
					card.fullUrl &&
					(
						/\/Cards\/OP17\/Charlottte Linlin op17-099\.png$/i.test(card.fullUrl) ||
						/^\/Cards\/OP17\/SP /i.test(card.fullUrl) ||
						/\/Cards\/OP17\/Gold Luffy\./i.test(card.fullUrl)
					)
				);
			if (shouldShowAffiliateLink) {
				const link = document.createElement("a");
				link.className = "card-affiliate-link";
				link.href = affiliateCard.affiliateUrl;
				link.target = "_blank";
				link.rel = "nofollow sponsored noopener";
				link.textContent = affiliateCard.price;
				shell.appendChild(link);
			}
			grid.appendChild(shell);
		});
		if (remaining.length === 0 && loadMoreButton) {
			loadMoreButton.closest(".load-more")?.remove();
		} else if (loadMoreButton) {
			const note = loadMoreButton.nextElementSibling;
			if (note) {
				note.textContent = `${remaining.length} more cards available`;
			}
		}
	};

	loadMoreButton?.addEventListener("click", appendBatch);
</script>

<style>
	.hero-links {
		margin-top: 1rem;
	}

	.leak-note {
		margin-top: 0.9rem;
		padding: 0.9rem 1rem;
		border: 1px solid rgba(255, 107, 61, 0.24);
		border-radius: var(--radius-md);
		background: rgba(255, 107, 61, 0.08);
		color: var(--text-200);
	}

	.hero-links a {
		color: var(--accent) !important;
		font-weight: 600;
		text-decoration: none;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(120px, 120px));
		gap: 0.8rem;
		justify-content: start;
	}

	:global(.card-thumb-shell) {
		position: relative;
		width: 120px;
		max-width: 120px;
		line-height: 0;
	}

	.leak-cards-grid {
		display: grid;
		gap: 1.15rem;
	}

	.leak-card {
		display: grid;
		grid-template-columns: minmax(148px, 188px) minmax(0, 1fr);
		gap: 1.2rem;
		align-items: stretch;
		padding: 1.1rem;
		border-radius: 18px;
		border: 1px solid rgba(255, 138, 42, 0.42);
		background:
			linear-gradient(135deg, rgba(255, 149, 56, 0.34), rgba(255, 122, 26, 0.18) 28%, rgba(255, 122, 26, 0.07) 52%, rgba(10, 14, 24, 0.92) 78%),
			linear-gradient(180deg, rgba(255, 190, 120, 0.08), rgba(255, 255, 255, 0.02));
		box-shadow:
			0 0 0 1px rgba(255, 168, 76, 0.08),
			inset 0 1px 0 rgba(255, 255, 255, 0.03),
			0 18px 40px rgba(0, 0, 0, 0.22);
		position: relative;
		overflow: hidden;
	}

	.leak-card::before {
		content: "";
		position: absolute;
		inset: 0 auto 0 0;
		width: 4px;
		background: linear-gradient(180deg, #ffb347, #ff7a1a 55%, #ff5a1f);
	}

	.leak-card-thumb {
		width: 100%;
		max-width: 188px;
		align-self: center;
		position: relative;
		z-index: 1;
	}

	.leak-card-thumb-shell {
		width: 100%;
		max-width: 188px;
	}

	.leak-card-thumb img {
		border: 1px solid rgba(255, 138, 42, 0.28);
		box-shadow: 0 14px 28px rgba(0, 0, 0, 0.28);
	}

	.leak-card-copy {
		min-width: 0;
		display: grid;
		gap: 0.7rem;
		align-content: start;
		position: relative;
		z-index: 1;
	}

	.leak-card-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}

	.leak-card-rarity-group {
		display: inline-flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		align-self: center;
		gap: 0.65rem;
		white-space: nowrap;
		width: max-content;
		max-width: 100%;
	}

	.leak-card-copy h3 {
		margin: 0;
		font-size: clamp(1.2rem, 1rem + 0.55vw, 1.55rem);
		line-height: 1.08;
		color: var(--text-100);
	}

	.leak-card-copy p {
		margin: 0;
		line-height: 1.45;
		color: var(--text-200);
	}

	.leak-card-code {
		color: var(--accent) !important;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.8rem;
	}

	.leak-card-rarity {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
		flex: 0 0 auto;
		color: #ffd6b0 !important;
		font-weight: 700;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.28rem 0.55rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 138, 42, 0.4);
