	"OP12-056": {
		rarity: "SP",
		stats: "Blue / Cost 1 / Event",
		traits: "Navy",
		effectLines: [
			[
				keyword("on-play", "On Play"),
				" You may trash 1 card from your hand: Play up to 1 blue {Navy} Character card with a power of 8000 or less other than [Monkey.D.Garp] from your hand.",
			],
		],
	},
	"OP14-108": {
		rarity: "SP",
		stats: "Yellow / Cost 6 / Slash / Power 6000 / Counter 1000",
		traits: "Former Roger Pirates",
		effectLines: [
			[
				keyword("on-play", "On Play"),
				" If your Leader is multicolored and your opponent has 3 or less Life cards, K.O. up to 1 of your opponent's Characters with 7000 base power or less.",
			],
			[
				keyword("trigger", "Trigger"),
				" Activate this card's ",
				keyword("on-play", "On Play"),
				" effect.",
			],
		],
	},
	"P-107": {
		rarity: "SP",
		stats: "Purple / Cost 8 / Special / Power 10000",
		traits: "King of the Pirates/Roger Pirates",
		effectLines: [
			["[When Played] If you or your opponent has 10 DON!! cards on their field, your Leader gets +2000 Power until the end of your opponent's next End Phase."],
		],
	},
	"ST32-002": {
		rarity: "SP",
		stats: "Green / Cost 5 / Slash / Power 6000 / Counter 1000",
		traits: "Land of Wano/Kouzuki Clan",
		effectLines: [
			[
				keyword("on-play", "On Play"),
