const revealPageConfig = revealPageConfigs[extension.toUpperCase()] ?? null;
const extensionLabel = revealPageConfig?.displayLabel ?? (extension === "P" ? "Promo" : extension);
const heroBadgeLabel = revealPageConfig?.badgeLabel ?? extensionLabel;
const isLeakPage = Boolean(revealPageConfig);
const useExpandedMobileCardGrid = !isLeakPage && /^(OP|EB)/i.test(extension.toUpperCase());
const op17AffiliateEditionsByCode = {
	"OP17-001": ["ALT"],
	"OP17-005": ["ALT", "MANGA"],
	"OP17-020": ["ALT"],
	"OP17-031": ["ALT"],
	"OP17-046": ["ALT"],
	"OP17-049": ["ALT"],
	"OP17-114": ["ALT"],
};
const isOp17YamatoSpecial = (card) =>
	card.code === "OP16-098" && extension.toUpperCase() === "OP17" && /\/Cards\/OP17\/Yamato SPOP16-098_p2\./i.test(card.fullUrl);
const shouldShowAffiliateLink = (card) => {
	if (card.code === "OP16-098") return isOp17YamatoSpecial(card);
	if (extension.toUpperCase() !== "OP17") return true;
	const allowedEditions = op17AffiliateEditionsByCode[card.code];
	if (allowedEditions) return allowedEditions.includes(card.edition ?? "");
	if (/\/Cards\/OP17\/Charlottte Linlin op17-099\.png$/i.test(card.fullUrl)) return false;
	if (/^\/Cards\/OP17\/SP /i.test(card.fullUrl)) return false;
	if (/\/Cards\/OP17\/Gold Luffy\./i.test(card.fullUrl)) return false;
	return true;
};
